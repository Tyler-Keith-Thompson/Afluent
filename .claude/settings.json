{
  "permissions": {
    "allow": [
      "Bash(just *)",
      "Bash(bazel build *)",
      "Bash(bazel test *)",
      "Bash(bazel query *)",
      "Bash(bazel cquery *)",
      "Bash(python3 scripts/modules.py)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/load-gate",
            "timeout": 660
          }
        ]
      }
    ]
  }
}
