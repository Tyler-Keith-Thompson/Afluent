{"abstract":[{"type":"text","text":"Assigns the output of an asynchronous unit of work to a key path on an object when the work completes successfully."}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"assign"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Root"},{"kind":"text","text":">("},{"kind":"externalParam","text":"to"},{"kind":"text","text":" "},{"kind":"internalParam","text":"keyPath"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ReferenceWritableKeyPath","preciseIdentifier":"s:s24ReferenceWritableKeyPathC"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Root"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork\/Success","kind":"typeIdentifier","text":"Success","preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP7SuccessQa"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"on"},{"kind":"text","text":" "},{"kind":"internalParam","text":"object"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Root"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Root"},{"kind":"text","text":" : AnyObject, "},{"kind":"typeIdentifier","text":"Root"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The key path to assign the output to."}]}],"name":"keyPath"},{"content":[{"inlineContent":[{"text":"The object to assign the output to.","type":"text"}],"type":"paragraph"}],"name":"object"}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"This method allows you to bind the result of the asynchronous operation to a property of an object, updating that property automatically upon completion."},{"type":"text","text":" "},{"type":"text","text":"The object is held weakly to avoid retain cycles, so if the object is deallocated before the asynchronous work completes, the assignment will not occur."}],"type":"paragraph"},{"anchor":"Example","level":2,"type":"heading","text":"Example"},{"syntax":"swift","type":"codeListing","code":["class MyModel: Sendable {","    var value: Int = 0","}","","let model = MyModel()","let unitOfWork: AsynchronousUnitOfWork<Int> = ...","","Task {","    try await unitOfWork.assign(to: \\.value, on: model)","    print(\"Model value updated to \\(model.value)\")","}"]},{"name":"Throws","style":"note","content":[{"inlineContent":[{"text":"Rethrows any error thrown by the asynchronous unit of work.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"name":"Note","style":"note","content":[{"inlineContent":[{"type":"text","text":"This method is asynchronous and will complete when the assignment has been made or the operation fails."}],"type":"paragraph"}],"type":"aside"}]}],"variants":[{"paths":["\/documentation\/afluent\/asynchronousunitofwork\/assign(to:on:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork"]]},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork\/assign(to:on:)","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"assign"},{"kind":"text","text":"<"},