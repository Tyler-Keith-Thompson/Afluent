ation.finish()","    }","}","","let cancellable = publisher.sink(","    receiveCompletion: { completion in","        switch completion {","        case .finished:","            print(\"Stream completed successfully\")","        case .failure(let error):","            print(\"Stream failed with error: \\(error)\")","        }","    },","    receiveOutput: { value in","        print(\"Received value: \\(value)\")","    }",")","","\/\/ To cancel early:","\/\/ cancellable.cancel()"],"syntax":"swift"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/afluent\/asynchronousunitofworksequence\/sink(receivecompletion:receiveoutput:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Starts processing the elements of this async sequence, handling output and completion events,","type":"text"},{"text":" ","type":"text"},{"text":"and returns an ","type":"text"},{"code":"AnyCancellable","type":"codeVoice"},{"text":" token that can be used to cancel the subscription.","type":"text"}],"metadata":{"externalID":"s:Sci7Afluents8SendableRzrlE4sink17receiveCompletion0D6OutputAA14AnyCancellableCyAA14AsyncSequencesO0E0Oy_s5Error_pGYaYbcSg_y7ElementQzYaYbKcSgtF::SYNTHESIZED::s:7Afluent30AsynchronousUnitOfWorkSequenceV","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/Subscription\/AnyCancellable.swift#L163","fileName":"AnyCancellable.swift"},"roleHeading":"Instance Method","conformance":{"constraints":[{"code":"Self","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"modules":[{"relatedModules":["_Concurrency"],"name":"Afluent"}],"title":"sink(receiveCompletion:receiveOutput:)","symbolKind":"method","role":"symbol","extendedModule":"_Concurrency","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"