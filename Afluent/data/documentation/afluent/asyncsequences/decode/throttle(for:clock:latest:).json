":"\/documentation\/afluent\/asyncsequences\/decode\/throttle(for:clock:latest:)"},"doc://Afluent/documentation/Afluent/AsyncSequences/Decode":{"type":"topic","role":"symbol","kind":"symbol","title":"AsyncSequences.Decode","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Decode","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Decode","kind":"identifier"}],"navigatorTitle":[{"text":"Decode","kind":"identifier"}],"url":"\/documentation\/afluent\/asyncsequences\/decode","abstract":[{"type":"text","text":"Used as the implementation detail for the "},{"code":"AsyncSequence\/decode(type:decoder:)","type":"codeVoice"},{"type":"text","text":" operator."}]},"doc://Afluent/documentation/Afluent/AsyncSequences/Throttle":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Throttle"}],"title":"AsyncSequences.Throttle","type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Throttle","url":"\/documentation\/afluent\/asyncsequences\/throttle","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Throttle"}],"abstract":[]},"doc://Afluent/documentation/Afluent":{"type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent","url":"\/documentation\/afluent","abstract":[],"role":"collection","title":"Afluent","kind":"symbol"}}}