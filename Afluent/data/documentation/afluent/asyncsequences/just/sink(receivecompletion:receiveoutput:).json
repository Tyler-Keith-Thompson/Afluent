"type":"codeVoice","code":".failure"},{"type":"text","text":". Called exactly once."}]}]},{"name":"receiveOutput","content":[{"type":"paragraph","inlineContent":[{"text":"An optional async throwing closure invoked for each element produced by the sequence.","type":"text"},{"text":" ","type":"text"},{"text":"If this closure throws an error, the sequence is terminated and completion closure is called with ","type":"text"},{"code":".failure","type":"codeVoice"},{"text":".","type":"text"}]}]}],"kind":"parameters"},{"content":[{"text":"Return Value","type":"heading","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"AnyCancellable"},{"type":"text","text":" token that can be stored and used to cancel the ongoing subscription."}]}],"kind":"content"},{"content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"This method allows you to asynchronously receive each element emitted by the sequence and respond"},{"type":"text","text":" "},{"type":"text","text":"to completion or failure. The stream runs until all elements are consumed, an error occurs,"},{"type":"text","text":" "},{"type":"text","text":"or cancellation is triggered via the returned token."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Usage example:"}],"type":"paragraph"},{"code":["let publisher: AsyncStream<Int> = AsyncStream { continuation in","    Task {","        for i in 1...5 {","            continuation.yield(i)","            try await Task.sleep(nanoseconds: 500_000_000)","        }","        continuation.finish()","    }","}","","let cancellable = publisher.sink(","    receiveCompletion: { completion in","        switch completion {","        case .finished:","            print(\"Stream completed successfully\")","        case .failure(let error):","            print(\"Stream failed with error: \\(error)\")","        }","    },","    receiveOutput: