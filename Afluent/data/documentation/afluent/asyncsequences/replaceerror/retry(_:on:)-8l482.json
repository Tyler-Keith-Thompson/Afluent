e in sequence {","    print(value) \/\/ prints 55 after retry on NetworkError.timeout","}"]},{"name":"Important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Not every "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" can be retried, for this to work the sequence has to implement an iterator that doesn’t preserve state across various creations."}],"type":"paragraph"}],"style":"important"},{"name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"AsyncStream","type":"codeVoice"},{"type":"text","text":" and "},{"code":"AsyncThrowingStream","type":"codeVoice"},{"type":"text","text":" are notable sequences which cannot be retried on their own."}]}],"style":"note"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/ReplaceError"]]},"variants":[{"paths":["\/documentation\/afluent\/asyncsequences\/replaceerror\/retry(_:on:)-8l482"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"method","remoteSource":{"fileName":"RetrySequence.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SequenceOperators\/RetrySequence.swift#L413"},"externalID":"s:Sci7Afluents8SendableRzsAB7ElementRpzrlE5retry_2onAA14AsyncSequencesO11RetryOnCastCy_xqd__AA0H15ByCountStrategyCGSu_qd__mts5ErrorRd__lF::SYNTHESIZED::s:7Afluent14AsyncSequencesO12ReplaceErrorV","role":"symbol","modules":[{"name":"Afluent","relatedModules":["_Concurrency"]}],"title":"retry(_:on:)","extendedModule":"_Concurrency","roleHeading":"Instance Method","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"code":"Self","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Element","type":"codeVoice"},