ts elements from an upstream sequence to multiple concurrent consumers."}],"navigatorTitle":[{"kind":"identifier","text":"AsyncBroadcastSequence"}],"kind":"symbol","role":"symbol","type":"topic","url":"\/documentation\/afluent\/asyncbroadcastsequence","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncBroadcastSequence","title":"AsyncBroadcastSequence"}}}