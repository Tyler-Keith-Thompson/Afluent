) -> Int {","        count += 1","        return count","    }","}","","enum NetworkError: Error {","    case timeout","    case unknown","}","","let counter = CallCounter()","","let sequence = DeferredTask {","    let attempt = await counter.increment()","    if attempt < 2 {","        throw NetworkError.timeout","    }","    return 55","}",".toAsyncSequence()",".retry(3, on: NetworkError.self)","","for try await value in sequence {","    print(value) \/\/ prints 55 after retry on NetworkError.timeout","}"]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Not every "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" can be retried, for this to work the sequence has to implement an iterator that doesn’t preserve state across various creations."}]}],"style":"important","name":"Important"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AsyncThrowingStream"},{"type":"text","text":" are notable sequences which cannot be retried on their own."}],"type":"paragraph"}],"style":"note","name":"Note"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/asyncsequences\/timersequence\/retry(_:on:)-2hgqb"]}],"references":{"doc://Afluent/documentation/Afluent":{"type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent","url":"\/documentation\/afluent","abstract":[],"role":"collection","title":"Afluent","kind":"symbol"},"doc://Afluent/documentation/Afluent/AsyncSequences/TimerSequence/retry(_:on:)-2hgqb":{"type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/TimerSequence\/retry(_:on:)-2hgqb","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" c