uent\/CurrentValueSubject\/AsyncSequence-Implementations","doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/AsyncSequence-Implementations"]}],"variants":[{"paths":["\/documentation\/afluent\/currentvaluesubject"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/Sci"],"kind":"relationships"}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"abstract":[{"text":"A subject that broadcasts its current value and all subsequent values to multiple consumers.","type":"text"},{"text":" ","type":"text"},{"text":"It can also handle completion events, including normal termination and failure with an error.","type":"text"},{"text":" ","type":"text"},{"text":"This is an ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s CurrentValueSubject.","type":"text"}],"references":{"doc://Afluent/documentation/Afluent":{"type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent","url":"\/documentation\/afluent","abstract":[],"role":"collection","title":"Afluent","kind":"symbol"},"doc://Afluent/documentation/Afluent/CurrentValueSubject/value":{"kind":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Element","kind":"typeIdentifier"}],"url":"\/documentation\/afluent\/currentvaluesubject\/value","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/value","role":"symbol","abstract":[{"type":"text","text":"The current value of the subject. This property is thread-safe."},{"type":"text","text":" "},{"type":"text","text":"Updating this property will also broadcast the new value to all active consumers."}],"title":"value"},"doc://Afluent/documentation/Afluent/CurrentValueSubject/m