:"codeVoice"},{"type":"text","text":" property (an async property that awaits completion):"}],"type":"paragraph"},{"code":["let deferred = DeferredTask<Int> {","    10 * 5","}","let value = await deferred.result","print(\"Value is \\(value)\")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Running the operation without awaiting its result immediately, via "},{"type":"codeVoice","code":"run()"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let deferred = DeferredTask<Int> {","    7 + 3","}","deferred.run()","\/\/ Later, you may await the result property or handle completion otherwise"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Subscribing to the task’s events using ","type":"text"},{"code":"subscribe()","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let deferred = DeferredTask<String> {","    \"Hello, World!\"","}","let cancellable = deferred.subscribe { event in","    switch event {","    case .success(let value):","        print(\"Completed with value: \\(value)\")","    case .failure(let error):","        print(\"Failed with error: \\(error)\")","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Storing the subscription in a collection for lifecycle management:","type":"text"}],"type":"paragraph"},{"code":["var cancellables = Set<AnyCancellable>()","let deferred = DeferredTask<Void> {","    print(\"Task executed\")","}","deferred.subscribe().store(in: &cancellables)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Chaining with operators:","type":"text"}],"type":"paragraph"},{"code":["let result = try await DeferredTask { 21 }","    .map { $0 * 2 }","    .execute() \/\/ result is 42"],"type":"codeListing","syntax":"swift"}]}],"references":{"doc://Afluent/ScA":{"title":"_Concurrency.Actor","identifier":"doc:\/\/Afluent\/ScA","type":"unresolvable"},"doc://Afluent/s8SendableP":{"identifier":"doc:\/\/Afluent\/s8SendableP"