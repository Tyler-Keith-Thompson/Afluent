object to assign the output to."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"This method allows you to bind the result of the asynchronous operation to a property of an object, updating that property automatically upon completion.","type":"text"},{"text":" ","type":"text"},{"text":"The object is held weakly to avoid retain cycles, so if the object is deallocated before the asynchronous work completes, the assignment will not occur.","type":"text"}]},{"type":"heading","text":"Example","anchor":"Example","level":2},{"syntax":"swift","type":"codeListing","code":["class MyModel: Sendable {","    var value: Int = 0","}","","let model = MyModel()","let unitOfWork: AsynchronousUnitOfWork<Int> = ...","","Task {","    try await unitOfWork.assign(to: \\.value, on: model)","    print(\"Model value updated to \\(model.value)\")","}"]},{"style":"note","name":"Throws","type":"aside","content":[{"inlineContent":[{"text":"Rethrows any error thrown by the asynchronous unit of work.","type":"text"}],"type":"paragraph"}]},{"style":"note","name":"Note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"This method is asynchronous and will complete when the assignment has been made or the operation fails."}],"type":"paragraph"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/SingleValueChannel\/assign(to:on:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/afluent\/singlevaluechannel\/assign(to:on:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Assigns the output of an asynchronous unit of work to a key path on an object when the work completes successfully."}],"metadata":{"roleHeading":"Instance Method","externalID":"s:7Afluent22AsynchronousUnitOfWorkPAAE6assign2to2onys24ReferenceWritableKeyPathCyqd__7SuccessQzG_qd__tYaKRld__Cs8SendableRd__lF::SYNTHES