of an object, updating that property automatically upon completion.","type":"text"},{"text":" ","type":"text"},{"text":"The object is held weakly to avoid retain cycles, so if the object is deallocated before the asynchronous work completes, the assignment will not occur.","type":"text"}]},{"level":2,"anchor":"Example","text":"Example","type":"heading"},{"code":["class MyModel: Sendable {","    var value: Int = 0","}","","let model = MyModel()","let unitOfWork: AsynchronousUnitOfWork<Int> = ...","","Task {","    try await unitOfWork.assign(to: \\.value, on: model)","    print(\"Model value updated to \\(model.value)\")","}"],"type":"codeListing","syntax":"swift"},{"name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Rethrows any error thrown by the asynchronous unit of work."}]}],"type":"aside","style":"note"},{"name":"Note","content":[{"inlineContent":[{"text":"This method is asynchronous and will complete when the assignment has been made or the operation fails.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"}]}],"abstract":[{"text":"Assigns the output of an asynchronous unit of work to a key path on an object when the work completes successfully.","type":"text"}],"references":{"doc://Afluent/documentation/Afluent/SingleValueSubject":{"navigatorTitle":[{"kind":"identifier","text":"SingleValueSubject"}],"url":"\/documentation\/afluent\/singlevaluesubject","type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SingleValueSubject","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SingleValueSubject"}],"kind":"symbol","title":"SingleValueSubject","abstract":[{"text":"A subject for bridging callback-based APIs to async\/await, emitting a single value or error.","type":"text"}],"role":"symbol"},"doc://Afluent/documentation/Afluent/AsynchronousUnitOfWork/Success":{"role":"symbol","type":"topic","url":"\/documentation\/afluent\/asynchronousunitofwork\/