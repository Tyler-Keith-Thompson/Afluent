ragraph","inlineContent":[{"text":"This is typically used to decode raw data (such as JSON ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":") emitted by an upstream asynchronous unit of work into a strongly typed model.","type":"text"},{"text":" ","type":"text"},{"text":"It simplifies chaining asynchronous operations that involve fetching raw encoded data and decoding it into usable Swift types.","type":"text"}]},{"type":"heading","text":"Example","level":2,"anchor":"Example"},{"type":"codeListing","code":["struct User: Decodable, Sendable {","    let id: Int","    let name: String","}","","let jsonDataTask: DeferredTask<Data> = DeferredTask {","    \/\/ Imagine this fetches JSON data asynchronously","    Data(\"\"\"{\"id\": 1, \"name\": \"Alice\"}\"\"\".utf8)","}","","let userTask = jsonDataTask.decode(type: User.self, decoder: JSONDecoder())","","let user = try await userTask.operation()","print(user.name) \/\/ prints \"Alice\""],"syntax":"swift"},{"name":"Note","type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The generic constraint "},{"type":"codeVoice","code":"Success == D.Input"},{"type":"text","text":" ensures that the upstream unit of work emits a compatible type for the decoder."}]}]}]}],"references":{"doc://Afluent/documentation/Afluent":{"abstract":[],"identifier":"doc:\/\/Afluent\/documentation\/Afluent","type":"topic","title":"Afluent","url":"\/documentation\/afluent","role":"collection","kind":"symbol"},"doc://Afluent/documentation/Afluent/SingleValueSubject/decode(type:decoder:)":{"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"decode","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"D","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"type","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":".Type, ","kind"