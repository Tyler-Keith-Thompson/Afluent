# GENERATED by scripts/modules.py — edit the table there, then run `just modules`.

load("@rules_apple//apple:macos.bzl", "macos_unit_test")
load("//tools:swift_rules.bzl", "swift_library", "swift_test")

# The tests, built once and linked into two runners.
# Tagged `debug-only`: none of these relies on speed, so
# `--config=release` neither builds nor runs them (.bazelrc).
swift_library(
    name = "AfluentTestsLibrary",
    testonly = True,
    # Tests are found through metadata the linker would otherwise drop, since nothing
    # references them by name.
    alwayslink = True,
    srcs = glob(["**/*.swift"]),
    module_name = "AfluentTests",
    tags = ["debug-only"],
    # Read by //:package_swift_test, which checks Package.swift against the Bazel graph.
    visibility = ["//:__pkg__"],
    deps = [
        "//Sources/Afluent",
        "//Sources/AfluentTesting",
        "@swiftpkg_swift_concurrency_extras//:ConcurrencyExtras",
        "@swiftpkg_swift_clocks//:Clocks",
    ] + select({
        # Apple-only packages (APPLE_ONLY_PACKAGES in scripts/modules.py).
        "@platforms//os:macos": [
            "@swiftpkg_ohhttpstubs//:OHHTTPStubs",
            "@swiftpkg_ohhttpstubs//:OHHTTPStubsSwift",
        ],
        "//conditions:default": [],
    }),
)

# `bazel test` / `just test`: a standalone executable, fast to start and run in Bazel's sandbox.
swift_test(
    name = "AfluentTests",
    size = "small",
    tags = ["debug-only"],
    deps = [":AfluentTestsLibrary"],
)

# The generated Xcode project: a real .xctest bundle (an MH_BUNDLE), which is what Xcode's test
# runner loads. `manual` keeps it out of `bazel test //...`; it runs through xcodebuild, so it
# is only for Xcode. XCTest refuses exit tests in a sandboxed host, hence `no-sandbox`.
macos_unit_test(
    name = "AfluentTestsBundle",
    bundle_name = "AfluentTests",
    size = "small",
    minimum_os_version = "13.0",
    tags = ["manual", "no-sandbox"],
    # Visible so `//:xcodeproj` can name it as a top-level target.
    visibility = ["//visibility:public"],
    deps = [":AfluentTestsLibrary"],
)
