{"sections":[],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/batch(strategy:)"},"abstract":[{"type":"text","text":"Gathers elements into arrays and emits each array when the strategy says to flush."}],"metadata":{"roleHeading":"Instance Method","platforms":[{"deprecated":false,"unavailable":false,"introducedAt":"16.0","name":"iOS","beta":false},{"deprecated":false,"unavailable":false,"introducedAt":"16.0","name":"iPadOS","beta":false},{"deprecated":false,"unavailable":false,"introducedAt":"16.0","name":"Mac Catalyst","beta":false},{"deprecated":false,"unavailable":false,"introducedAt":"13.0","name":"macOS","beta":false},{"deprecated":false,"unavailable":false,"introducedAt":"16.0","name":"tvOS","beta":false},{"deprecated":false,"unavailable":false,"introducedAt":"1.0","name":"visionOS","beta":false},{"deprecated":false,"unavailable":false,"introducedAt":"9.0","name":"watchOS","beta":false}],"externalID":"s:Sci7Afluents8SendableRzsAB7ElementRpzrlE5batch8strategyAA14AsyncSequencesO5BatchVy_xqd__Gqd___tAA0H8StrategyRd__ACQyd__ADRSlF","modules":[{"relatedModules":["_Concurrency"],"name":"Afluent"}],"extendedModule":"_Concurrency","remoteSource":{"fileName":"BatchSequence.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SequenceOperators\/BatchSequence.swift#L221"},"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":"."}]},"role":"symbol","title":"batch(strategy:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batch","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Strategy","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"strategy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Strategy","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"AsyncSequences","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO"},{"text":".","kind":"text"},{"text":"Batch","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO5BatchV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Strategy","kind":"typeIdentifier"},{"text":">","kind":"text"}],"symbolKind":"method"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"batch"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Strategy"},{"kind":"text","text":">("},{"kind":"externalParam","text":"strategy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"AsyncSequences","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Batch","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Batch","preciseIdentifier":"s:7Afluent14AsyncSequencesO5BatchV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"BatchStrategy","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","preciseIdentifier":"s:7Afluent13BatchStrategyP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:Sci7ElementQa"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/Element","preciseIdentifier":"s:7Afluent13BatchStrategyP7ElementQa"}]}],"kind":"declarations"},{"parameters":[{"name":"strategy","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When to emit the gathered elements; its "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" is this"},{"type":"text","text":" "},{"type":"text","text":"sequence’s, inferred from the call."}]}]}],"kind":"parameters"},{"content":[{"text":"Return Value","type":"heading","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A sequence of the upstream’s elements, in order, in arrays of one or more."}]}],"kind":"content"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"The strategy decides when the pending elements are flushed: every so many elements","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/count(_:)","isActive":true,"type":"reference"},{"text":"), every interval","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/time(interval:clock:tolerance:)","isActive":true,"type":"reference"},{"text":"), on a signal or a unit of work","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","isActive":true,"type":"reference"},{"text":"), whenever any of several does","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/either(_:_:)","isActive":true,"type":"reference"},{"text":"), or by a rule of your own (","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","isActive":true,"type":"reference"},{"text":"). After every","type":"text"},{"text":" ","type":"text"},{"text":"flush, each strategy starts over. A flush with nothing pending emits nothing; the","type":"text"},{"text":" ","type":"text"},{"text":"sequence never emits an empty array.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When the upstream finishes, the pending elements, if any, are emitted as a last array and"},{"type":"text","text":" "},{"type":"text","text":"the sequence finishes. When the upstream throws, the pending elements are dropped and the"},{"type":"text","text":" "},{"type":"text","text":"sequence throws the same error. A signal that finishes stops firing while the batches go"},{"type":"text","text":" "},{"type":"text","text":"on; a signal that throws ends the sequence with its error."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The upstream and the strategy run in tasks of their own, started when iteration begins,"},{"type":"text","text":" "},{"type":"text","text":"so the upstream is read ahead of the consumer, and arrays the consumer hasn’t taken yet"},{"type":"text","text":" "},{"type":"text","text":"are buffered. Cancelling the consumer, or dropping its iterator, cancels both. An"},{"type":"text","text":" "},{"type":"text","text":"upstream or signal that ignores cancellation keeps the internal task alive until its"},{"type":"text","text":" "},{"type":"text","text":"pending "},{"code":"next()","type":"codeVoice"},{"type":"text","text":" returns, and is not read again after that; the batched sequence itself"},{"type":"text","text":" "},{"type":"text","text":"ends at once."}],"type":"paragraph"},{"inlineContent":[{"text":"Batching needs iOS 16, Mac Catalyst 16, macOS 13, tvOS 16, watchOS 9 or visionOS 1.","type":"text"}],"type":"paragraph"},{"anchor":"Example","type":"heading","level":2,"text":"Example"},{"type":"codeListing","syntax":"swift","code":["for try await batch in [1, 2, 3, 4].async.batch(strategy: .either(.count(3), .time(interval: .seconds(1), clock: ContinuousClock()))) {","    print(batch) \/\/ Prints [1, 2, 3], then [4]","}"]},{"content":[{"inlineContent":[{"text":"Any error the upstream or the strategy throws.","type":"text"}],"type":"paragraph"}],"name":"Throws","type":"aside","style":"note"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/afluent\/_concurrency\/asyncsequence\/batch(strategy:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency","doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence"]]},"references":{"doc://Afluent/documentation/Afluent/BatchStrategy/time(interval:clock:tolerance:)":{"url":"\/documentation\/afluent\/batchstrategy\/time(interval:clock:tolerance:)","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/time(interval:clock:tolerance:)","title":"time(interval:clock:tolerance:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"time","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Batched","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"interval","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:12_Concurrency5ClockP8DurationQa","text":"Duration","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":", ","kind":"t