r":"discussion"},{"inlineContent":[{"text":"This method allows you to bind the result of the asynchronous operation to a property of an object, updating that property automatically upon completion.","type":"text"},{"text":" ","type":"text"},{"text":"The object is held weakly to avoid retain cycles, so if the object is deallocated before the asynchronous work completes, the assignment will not occur.","type":"text"}],"type":"paragraph"},{"text":"Example","level":2,"type":"heading","anchor":"Example"},{"syntax":"swift","code":["class MyModel: Sendable {","    var value: Int = 0","}","","let model = MyModel()","let unitOfWork: AsynchronousUnitOfWork<Int> = ...","","Task {","    try await unitOfWork.assign(to: \\.value, on: model)","    print(\"Model value updated to \\(model.value)\")","}"],"type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Rethrows any error thrown by the asynchronous unit of work.","type":"text"}]}],"name":"Throws","style":"note","type":"aside"},{"content":[{"type":"paragraph","inlineContent":[{"text":"This method is asynchronous and will complete when the assignment has been made or the operation fails.","type":"text"}]}],"name":"Note","style":"note","type":"aside"}],"kind":"content"}],"kind":"symbol","references":{"doc://Afluent/documentation/Afluent/AnyAsynchronousUnitOfWork/assign(to:on:)":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AnyAsynchronousUnitOfWork\/assign(to:on:)","url":"\/documentation\/afluent\/anyasynchronousunitofwork\/assign(to:on:)","title":"assign(to:on:)","kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"assign","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Root","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ReferenceWritableKeyPath","kind":"typeIdentifier","preciseIdentifier":"s:s24ReferenceWritableKeyPathC"},{"text":"<","kind":"tex