]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method allows you to bind the result of the asynchronous operation to a property of an object, updating that property automatically upon completion."},{"type":"text","text":" "},{"type":"text","text":"The object is held weakly to avoid retain cycles, so if the object is deallocated before the asynchronous work completes, the assignment will not occur."}]},{"type":"heading","anchor":"Example","level":2,"text":"Example"},{"type":"codeListing","syntax":"swift","code":["class MyModel: Sendable {","    var value: Int = 0","}","","let model = MyModel()","let unitOfWork: AsynchronousUnitOfWork<Int> = ...","","Task {","    try await unitOfWork.assign(to: \\.value, on: model)","    print(\"Model value updated to \\(model.value)\")","}"]},{"type":"aside","name":"Throws","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Rethrows any error thrown by the asynchronous unit of work."}]}]},{"type":"aside","name":"Note","style":"note","content":[{"inlineContent":[{"type":"text","text":"This method is asynchronous and will complete when the assignment has been made or the operation fails."}],"type":"paragraph"}]}]}],"abstract":[{"text":"Assigns the output of an asynchronous unit of work to a key path on an object when the work completes successfully.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"metadata":{"symbolKind":"method","title":"assign(to:on:)","externalID":"s:7Afluent22AsynchronousUnitOfWorkPAAE6assign2to2onys24ReferenceWritableKeyPathCyqd__7SuccessQzG_qd__tYaKRld__Cs8SendableRd__lF::SYNTHESIZED::s:7Afluent25AnyAsynchronousUnitOfWorkV","role":"symbol","extendedModule":"Afluent","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"assign"},{"kind":"text","text":"<"},{"kind":"genericParameter"