xt","text":"This method allows you to bind the result of the asynchronous operation to a property of an object, updating that property automatically upon completion."},{"type":"text","text":" "},{"type":"text","text":"The object is held weakly to avoid retain cycles, so if the object is deallocated before the asynchronous work completes, the assignment will not occur."}],"type":"paragraph"},{"anchor":"Example","level":2,"text":"Example","type":"heading"},{"type":"codeListing","code":["class MyModel: Sendable {","    var value: Int = 0","}","","let model = MyModel()","let unitOfWork: AsynchronousUnitOfWork<Int> = ...","","Task {","    try await unitOfWork.assign(to: \\.value, on: model)","    print(\"Model value updated to \\(model.value)\")","}"],"syntax":"swift"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"Rethrows any error thrown by the asynchronous unit of work."}],"type":"paragraph"}],"type":"aside","name":"Throws"},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"This method is asynchronous and will complete when the assignment has been made or the operation fails."}],"type":"paragraph"}],"type":"aside","name":"Note"}]}],"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/AnyAsynchronousUnitOfWork\/assign(to:on:)","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/anyasynchronousunitofwork\/assign(to:on:)"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"metadata":{"modules":[{"name":"Afluent"}],"roleHeading":"Instance Method","externalID":"s:7Afluent22AsynchronousUnitOfWorkPAAE6assign2to2onys24ReferenceWritableKeyPathCyqd__7SuccessQzG_qd__tYaKRld__Cs8SendableRd__lF::SYNTHESIZED::s:7Afluent25AnyAsynchronousUnitOfWorkV","symbolKind":"method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/Workers\/Assign.swift#L36","fileName":"Assign.swift"},"fragments"