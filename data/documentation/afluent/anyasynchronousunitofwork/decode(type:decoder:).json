cussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"This is typically used to decode raw data (such as JSON "},{"code":"Data","type":"codeVoice"},{"type":"text","text":") emitted by an upstream asynchronous unit of work into a strongly typed model."},{"type":"text","text":" "},{"type":"text","text":"It simplifies chaining asynchronous operations that involve fetching raw encoded data and decoding it into usable Swift types."}],"type":"paragraph"},{"anchor":"Example","type":"heading","text":"Example","level":2},{"type":"codeListing","syntax":"swift","code":["struct User: Decodable, Sendable {","    let id: Int","    let name: String","}","","let jsonDataTask: DeferredTask<Data> = DeferredTask {","    \/\/ Imagine this fetches JSON data asynchronously","    Data(\"\"\"{\"id\": 1, \"name\": \"Alice\"}\"\"\".utf8)","}","","let userTask = jsonDataTask.decode(type: User.self, decoder: JSONDecoder())","","let user = try await userTask.operation()","print(user.name) \/\/ prints \"Alice\""]},{"style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"The generic constraint "},{"type":"codeVoice","code":"Success == D.Input"},{"type":"text","text":" ensures that the upstream unit of work emits a compatible type for the decoder."}],"type":"paragraph"}],"name":"Note"}],"kind":"content"}],"sections":[],"abstract":[{"type":"text","text":"Decodes the output from the upstream "},{"type":"codeVoice","code":"AsynchronousUnitOfWork"},{"type":"text","text":" into a model of type "},{"type":"codeVoice","code":"T"},{"type":"text","text":" using the given top-level decoder."}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AnyAsynchronousUnitOfWork"]]},"metadata":{"externalID":"s:7Afluent22AsynchronousUnitOfWorkPAAE6decode4type7decoderQrqd__m_qd_0_tSeRd__s8SendableRd__AA15TopLevelDecoderRd_0_5InputQyd_0_7SuccessRtzr0_lF::SYNTHESIZED::s:7Afluent25AnyAsynchronousUn