xt":"C","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP8DurationQa"},{"text":"? = nil, ","kind":"text"},{"text":"jitter","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7Afluent13BackoffJitterV","text":"BackoffJitter","kind":"typeIdentifier","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter"},{"text":" = .none) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP","text":"AsynchronousUnitOfWork","kind":"typeIdentifier","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP7SuccessQa","text":"Success","kind":"typeIdentifier","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork\/Success"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Clock","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP"},{"text":"\n","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The duration to delay the output, conforming to the clock’s associated "},{"type":"codeVoice","code":"Duration"},{"type":"text","text":" type."}],"type":"paragraph"}],"name":"duration"},{"content":[{"inlineContent":[{"text":"The clock used for timekeeping.","type":"text"}],"type":"paragraph"}],"name":"clock"},{"content":[{"inlineContent":[{"type":"text","text":"An optional tolerance for the delay. Defaults to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"tolerance"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"How the delay is randomized. Defaults to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/none"},{"type":"text","text":". Decorrelated"},{"type":"text","text":" "},{"type":"text","text":"jitter waits at most three times "},{"type":"codeVoice","code":"duration"},{"type":"text","text":"."}]}],"name":"jitter"}]},{"content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"code":"AsynchronousUnitOfWork","type":"codeVoice"},{"text":" that emits the upstream output after the specified delay.","type":"text"}]}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"This operator suspends the emission of output for the specified duration according to the provided clock.","type":"text"}],"type":"paragraph"},{"text":"Discussion","anchor":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Delaying work using a custom clock is beneficial when you need precise control over timing behavior,","type":"text"},{"text":" ","type":"text"},{"text":"such as testing with test clocks or synchronizing work with specific time sources.","type":"text"},{"text":" ","type":"text"},{"text":"Use this operator to implement retry backoff, throttling, or scheduled tasks that depend on a particular clock implementation.","type":"text"}],"type":"paragraph"},{"text":"Example","anchor":"Example","level":2,"type":"heading"},{"code":["let start = Date()","let clock = SuspendingClock()","let delayedTask = DeferredTask {","    \"Delayed with custom clock\"","}.delay(for: .seconds(1), clock: clock, tolerance: .milliseconds(100))","let result = try await delayedTask.execute()","let elapsed = Date().timeIntervalSince(start)","print(\"Result: \\(result) after \\(elapsed) seconds\")"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Availability: macOS 13.0, iOS 16.0, watchOS 9.0, tvOS 16.0, visionOS 1.0 and above."}]}]}],"type":"unorderedList"},{"style":"note","content":[{"inlineContent":[{"text":"On WASI, a sleep on a real clock (","type":"text"},{"code":"ContinuousClock","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SuspendingClock","type":"codeVoice"},{"text":") holds the one thread","type":"text"},{"text":" ","type":"text"},{"text":"until its deadline, even when other work is ready, and cancelling it doesn’t end it sooner. So the","type":"text"},{"text":" ","type":"text"},{"text":"delay always waits out its whole duration, even when cancelled. A test clock is unaffected.","type":"text"}],"type":"paragraph"}],"name":"Note","type":"aside"}],"kind":"content"}],"kind":"symbol","abstract":[{"type":"text","text":"Delays the emission of output from the upstream "},{"code":"AsynchronousUnitOfWork","type":"codeVoice"},{"type":"text","text":" by a specified duration using a given clock."}],"references":{"doc://Afluent/documentation/Afluent":{"type":"topic","url":"\/documentation\/afluent","abstract":[],"identifier":"doc:\/\/Afluent\/documentation\/Afluent","kind":"symbol","role":"collection","title":"Afluent"},"doc://Afluent/documentation/Afluent/AnyAsynchronousUnitOfWork/delay(for:clock:tolerance:jitter:)":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AnyAsynchronousUnitOfWork\/delay(for:clock:tolerance:jitter:)","abstract":[{"text":"Delays the emission of output from the upstream ","type":"text"},{"type":"codeVoice","code":"AsynchronousUnitOfWork"},{"text":" by a specified duration using a given clock.","type":"text"}],"url":"\/documentation\/afluent\/anyasynchronousunitofwork\/delay(for:clock:tolerance:jitter:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"delay"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externa