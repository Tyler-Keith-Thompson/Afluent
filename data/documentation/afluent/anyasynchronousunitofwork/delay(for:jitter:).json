ind":"typeIdentifier","text":"Success"},{"kind":"text","text":">\n"}],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The duration to delay the output.","type":"text"}]}],"name":"duration"},{"content":[{"inlineContent":[{"type":"text","text":"How the delay is randomized. Defaults to "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/none","isActive":true},{"type":"text","text":". Decorrelated"},{"type":"text","text":" "},{"type":"text","text":"jitter waits at most three times "},{"type":"codeVoice","code":"duration"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"jitter"}]},{"kind":"content","content":[{"anchor":"return-value","text":"Return Value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"AsynchronousUnitOfWork"},{"type":"text","text":" that emits the upstream output after the specified delay."}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This operator suspends the emission of output for the given duration before returning the value."}]},{"type":"heading","level":2,"text":"Discussion","anchor":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Delayed work is useful in scenarios such as throttling requests, implementing retry backoff strategies,","type":"text"},{"text":" ","type":"text"},{"text":"or scheduling work to occur after a fixed interval. By delaying the emission, you can control timing","type":"text"},{"text":" ","type":"text"},{"text":"behavior in asynchronous workflows in a straightforward and composable manner.","type":"text"}]},{"type":"heading","level":2,"text":"Example","anchor":"Example"},{"type":"codeListing","code":["let start = Date()","let delayedTask = DeferredTask {","    \"Hello, world!\"","}.delay(for: .seconds(2))","let result = try await delayedTask.execute()","let elapsed = Date().timeIntervalSince(start)","print(\"Result: \\(result) after \\(elapsed) seconds\")"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Availability: macOS 13.0, iOS 16.0, watchOS 9.0, tvOS 16.0, visionOS 1.0 and above."}]}]}]},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"On WASI, a sleep on a real clock ("},{"code":"ContinuousClock","type":"codeVoice"},{"type":"text","text":", "},{"code":"SuspendingClock","type":"codeVoice"},{"type":"text","text":") holds the one thread"},{"type":"text","text":" "},{"type":"text","text":"until its deadline, even when other work is ready, and cancelling it doesn’t end it sooner. So the"},{"type":"text","text":" "},{"type":"text","text":"delay always waits out its whole duration, even when cancelled. A test clock is unaffected."}]}],"type":"aside","name":"Note"}]}],"references":{"doc://Afluent/documentation/Afluent/AnyAsynchronousUnitOfWork/delay(for:jitter:)":{"title":"delay(for:jitter:)","url":"\/documentation\/afluent\/anyasynchronousunitofwork\/delay(for:jitter:)","type":"topic","role":"symbol","abstract":[{"text":"Delays the emission of output from the upstream ","type":"text"},{"code":"AsynchronousUnitOfWork","type":"codeVoice"},{"text":" by a specified duration.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AnyAsynchronousUnitOfWork\/delay(for:jitter:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"delay","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":", ","kind":"text"},{"text":"jitter","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"BackoffJitter","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent1