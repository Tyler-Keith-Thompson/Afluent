 emits the elements it has gathered."}],"navigatorTitle":[{"text":"BatchStrategy","kind":"identifier"}],"title":"BatchStrategy","kind":"symbol"},"doc://Afluent/documentation/Afluent":{"url":"\/documentation\/afluent","type":"topic","kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent","title":"Afluent","abstract":[],"role":"collection"},"doc://Afluent/documentation/Afluent/BatchStrategy/either(_:_:)":{"title":"either(_:_:)","type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/either(_:_:)","url":"\/documentation\/afluent\/batchstrategy\/either(_:_:)","abstract":[{"type":"text","text":"Flushes when any of the given strategies does."}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"either"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Batched"},{"kind":"text","text":">(any "},{"preciseIdentifier":"s:7Afluent13BatchStrategyP","kind":"typeIdentifier","text":"BatchStrategy"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Batched"},{"kind":"text","text":">, any "},{"preciseIdentifier":"s:7Afluent13BatchStrategyP","kind":"typeIdentifier","text":"BatchStrategy"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Batched"},{"kind":"text","text":">...) -> "},{"preciseIdentifier":"s:7Afluent19EitherBatchStrategyV","kind":"typeIdentifier","text":"EitherBatchStrategy"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Batched"},{"kind":"text","text":">"}]},"doc://Afluent/documentation/Afluent/BatchStrategy/count(_:)":{"title":"count(_:)","type":"topic","url":"\/documentation\/afluent\/batchstrategy\/count(_:)","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/count(_:)","abstract":[{"text":"Flushes whenever the given number of elements is pending.","type":"text"}],"role":"symbol","kind":"symbol","fragments":[{"text":