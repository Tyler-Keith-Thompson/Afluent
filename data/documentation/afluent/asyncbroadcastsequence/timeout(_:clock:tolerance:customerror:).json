text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP8DurationQa"},{"text":"? = nil, ","kind":"text"},{"text":"customError","kind":"externalParam"},{"text":": (any ","kind":"text"},{"text":"Error","kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP"},{"text":")? = nil) -> ","kind":"text"},{"text":"AsyncSequences","kind":"typeIdentifier","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO"},{"text":".","kind":"text"},{"text":"Timeout","kind":"typeIdentifier","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Timeout","preciseIdentifier":"s:7Afluent14AsyncSequencesO7TimeoutV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Clock","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"duration","content":[{"inlineContent":[{"text":"The longest the sequence may go without an element.","type":"text"}],"type":"paragraph"}]},{"name":"clock","content":[{"type":"paragraph","inlineContent":[{"text":"The clock that measures the gaps.","type":"text"}]}]},{"name":"tolerance","content":[{"type":"paragraph","inlineContent":[{"text":"The tolerance of the timer’s sleeps. Defaults to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}]},{"name":"customError","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The error to throw when the timer fires. Defaults to"},{"type":"text","text":" "},{"type":"codeVoice","code":"TimeoutError.timedOut(duration:)"},{"type":"text","text":"."}]}]}]},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"A sequence of the same elements that throws if the upstream goes quiet.","type":"text"}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"The timer starts when iteration begins and restarts with every element, so it bounds the","type":"text"},{"text":" ","type":"text"},{"text":"wait for the first element and each gap after it, never the sequence as a whole. Elements","type":"text"},{"text":" ","type":"text"},{"text":"pass through unchanged. When the timer fires, the upstream is cancelled and the sequence","type":"text"},{"text":" ","type":"text"},{"text":"throws, without waiting for the upstream to respond to the cancellation.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The upstream is read ahead of the consumer, and elements it produces while the consumer is"},{"type":"text","text":" "},{"type":"text","text":"busy are buffered, so the timer measures the upstream’s gaps. A duration of zero or less"},{"type":"text","text":" "},{"type":"text","text":"throws before the first element."}]},{"type":"heading","text":"Example","anchor":"Example","level":2},{"syntax":"swift","type":"codeListing","code":["let clock = ContinuousClock()","for try await line in bytes.lines.timeout(.seconds(30), clock: clock) {","    handle(line)","}"]},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"TimeoutError","type":"codeVoice"},{"text":" (or ","type":"text"},{"code":"customError","type":"codeVoice"},{"text":") when ","type":"text"},{"code":"duration","type":"codeVoice"},{"text":" passes between elements, and","type":"text"},{"text":" ","type":"text"},{"text":"any error the upstream throws.","type":"text"}]}],"type":"aside","style":"note","name":"Throws"},{"content":[{"inlineContent":[{"type":"text","text":"On WASI, a sleep on a real clock ("},{"type":"codeVoice","code":"ContinuousClock"},{"type":"text","text":", "},{"type":"codeVoice","code":"SuspendingClock"},{"type":"text","text":") holds the one thread"},{"type":"text","text":" "},{"type":"text","text":"until its deadline, even when other work is ready, and cancelling it doesn’t end it sooner. So the"},{"type":"text","text":" "},{"type":"text","text":"timer can hold the thread before the upstream runs, then count that wait against it and throw even"},{"type":"text","text":" "},{"type":"text","text":"though elements were ready. A test clock is unaffected."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"}]}],"kind":"symbol","sections":[],"abstract":[{"text":"Fails if the sequence goes the given duration without producing an element, measured on","type":"text"},{"text":" ","type":"text"},{"text":"the given clock.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/asyncbroadcastsequence\/timeout(_:clock:tolerance:customerror:)"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncBroadcastSequence\/timeout(_:clock:tolerance:customError:)"},"references":{"doc://Afluent/documentation/Afluent/_Concurrency/AsyncSequence/timeout(_:clock:tolerance:customError:)":{"url":"\/documentation\/afluent\/_concurrency\/asyncsequence\/timeout(_:clock:tolerance:customerror:)","title":"timeout(_:clock:tolerance:customError:)","type":"topic","abstract":[{"text":"Fails if the sequence goes the given duration without producing an element, measured on","type":"text"},{"text":" ","type":"text"},{"text":"the given clock.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timeout","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"ge