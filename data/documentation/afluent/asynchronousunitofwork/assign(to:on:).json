xt","text":"This method allows you to bind the result of the asynchronous operation to a property of an object, updating that property automatically upon completion."},{"type":"text","text":" "},{"type":"text","text":"The object is held weakly to avoid retain cycles, so if the object is deallocated before the asynchronous work completes, the assignment will not occur."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Example","text":"Example"},{"code":["class MyModel: Sendable {","    var value: Int = 0","}","","let model = MyModel()","let unitOfWork: AsynchronousUnitOfWork<Int> = ...","","Task {","    try await unitOfWork.assign(to: \\.value, on: model)","    print(\"Model value updated to \\(model.value)\")","}"],"syntax":"swift","type":"codeListing"},{"style":"note","name":"Throws","content":[{"inlineContent":[{"text":"Rethrows any error thrown by the asynchronous unit of work.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"This method is asynchronous and will complete when the assignment has been made or the operation fails."}],"type":"paragraph"}],"type":"aside"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork\/assign(to:on:)","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"extendedModule":"Afluent","remoteSource":{"fileName":"Assign.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/Workers\/Assign.swift#L36"},"roleHeading":"Instance Method","role":"symbol","title":"assign(to:on:)","externalID":"s:7Afluent22AsynchronousUnitOfWorkPAAE6assign2to2onys24ReferenceWritableKeyPathCyqd__7SuccessQzG_qd__tYaKRld__Cs8SendableRd__lF","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"assign","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Root","kind":"gener