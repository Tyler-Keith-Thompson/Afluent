:[{"text":"This method allows you to bind the result of the asynchronous operation to a property of an object, updating that property automatically upon completion.","type":"text"},{"text":" ","type":"text"},{"text":"The object is held weakly to avoid retain cycles, so if the object is deallocated before the asynchronous work completes, the assignment will not occur.","type":"text"}],"type":"paragraph"},{"text":"Example","anchor":"Example","level":2,"type":"heading"},{"syntax":"swift","code":["class MyModel: Sendable {","    var value: Int = 0","}","","let model = MyModel()","let unitOfWork: AsynchronousUnitOfWork<Int> = ...","","Task {","    try await unitOfWork.assign(to: \\.value, on: model)","    print(\"Model value updated to \\(model.value)\")","}"],"type":"codeListing"},{"style":"note","name":"Throws","content":[{"inlineContent":[{"type":"text","text":"Rethrows any error thrown by the asynchronous unit of work."}],"type":"paragraph"}],"type":"aside"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"This method is asynchronous and will complete when the assignment has been made or the operation fails.","type":"text"}]}],"type":"aside"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork"]]},"abstract":[{"text":"Assigns the output of an asynchronous unit of work to a key path on an object when the work completes successfully.","type":"text"}],"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork\/assign(to:on:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/afluent\/asynchronousunitofwork\/assign(to:on:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"symbolKind":"method","extendedModule":"Afluent","modules":[{"name":"Afluent"}],"title":"assign(to:on:)","role":"symbol","externalID":"s:7Afluent22AsynchronousUnitOfWorkP