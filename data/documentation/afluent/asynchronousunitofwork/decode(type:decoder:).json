":"swift","type":"codeListing","code":["struct User: Decodable, Sendable {","    let id: Int","    let name: String","}","","let jsonDataTask: DeferredTask<Data> = DeferredTask {","    \/\/ Imagine this fetches JSON data asynchronously","    Data(\"\"\"{\"id\": 1, \"name\": \"Alice\"}\"\"\".utf8)","}","","let userTask = jsonDataTask.decode(type: User.self, decoder: JSONDecoder())","","let user = try await userTask.operation()","print(user.name) \/\/ prints \"Alice\""]},{"name":"Note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"The generic constraint "},{"type":"codeVoice","code":"Success == D.Input"},{"type":"text","text":" ensures that the upstream unit of work emits a compatible type for the decoder."}],"type":"paragraph"}],"style":"note"}]}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork"]]},"abstract":[{"text":"Decodes the output from the upstream ","type":"text"},{"code":"AsynchronousUnitOfWork","type":"codeVoice"},{"text":" into a model of type ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" using the given top-level decoder.","type":"text"}],"references":{"doc://Afluent/documentation/Afluent/AsynchronousUnitOfWork/decode(type:decoder:)":{"url":"\/documentation\/afluent\/asynchronousunitofwork\/decode(type:decoder:)","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork\/decode(type:decoder:)","role":"symbol","abstract":[{"type":"text","text":"Decodes the output from the upstream "},{"type":"codeVoice","code":"AsynchronousUnitOfWork"},{"type":"text","text":" into a model of type "},{"type":"codeVoice","code":"T"},{"type":"text","text":" using the given top-level decoder."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"decode"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"te