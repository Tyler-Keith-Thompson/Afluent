a"},{"text":" == ","kind":"text"},{"text":"D","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Input","kind":"typeIdentifier","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/TopLevelDecoder\/Input","preciseIdentifier":"s:7Afluent15TopLevelDecoderP5InputQa"},{"text":"\n","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The type "},{"type":"codeVoice","code":"T"},{"type":"text","text":" to decode into, conforming to the "},{"type":"codeVoice","code":"Decodable"},{"type":"text","text":" protocol."}],"type":"paragraph"}],"name":"type"},{"content":[{"inlineContent":[{"text":"The top-level decoder ","type":"text"},{"type":"codeVoice","code":"D"},{"text":" used for decoding the upstream data.","type":"text"}],"type":"paragraph"}],"name":"decoder"}]},{"kind":"content","content":[{"anchor":"return-value","level":2,"type":"heading","text":"Return Value"},{"inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"AsynchronousUnitOfWork"},{"type":"text","text":" whose output is the decoded "},{"type":"codeVoice","code":"T"},{"type":"text","text":" type object."}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"This operator transforms the upstream’s output by applying the specified decoder to convert the data into a ","type":"text"},{"code":"Decodable","type":"codeVoice"},{"text":" type.","type":"text"},{"text":" ","type":"text"},{"text":"The upstream’s output must be compatible with the input type expected by the provided decoder (e.g., ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"JSONDecoder","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"anchor":"Discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"This is typically used to decode raw data (such as JSON "},{"code":"Data","type":"codeVoice"},{"type":"text","text":") emitted by an upstream asynchronous unit of work into a strongly typed model."},{"type":"text","text":" "},{"type":"text","text":"It simplifies chaining asynchronous operations that involve fetching raw encoded data and decoding it into usable Swift types."}],"type":"paragraph"},{"anchor":"Example","text":"Example","level":2,"type":"heading"},{"syntax":"swift","code":["struct User: Decodable, Sendable {","    let id: Int","    let name: String","}","","let jsonDataTask: DeferredTask<Data> = DeferredTask {","    \/\/ Imagine this fetches JSON data asynchronously","    Data(\"\"\"{\"id\": 1, \"name\": \"Alice\"}\"\"\".utf8)","}","","let userTask = jsonDataTask.decode(type: User.self, decoder: JSONDecoder())","","let user = try await userTask.operation()","print(user.name) \/\/ prints \"Alice\""],"type":"codeListing"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"The generic constraint ","type":"text"},{"code":"Success == D.Input","type":"codeVoice"},{"text":" ensures that the upstream unit of work emits a compatible type for the decoder.","type":"text"}]}],"type":"aside"}]}],"references":{"doc://Afluent/documentation/Afluent/AsynchronousUnitOfWork/Success":{"abstract":[{"text":"The type of data the unit of work will produce if it succeeds.","type":"text"}],"title":"Success","kind":"symbol","fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Success","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}],"url":"\/documentation\/afluent\/asynchronousunitofwork\/success","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork\/Success","role":"symbol","type":"topic","required":true},"doc://Afluent/documentation/Afluent":{"url":"\/documentation\/afluent","identifier":"doc:\/\/Afluent