ck.","type":"text"}]},{"level":2,"anchor":"Discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Delaying work using a custom clock is beneficial when you need precise control over timing behavior,"},{"type":"text","text":" "},{"type":"text","text":"such as testing with test clocks or synchronizing work with specific time sources."},{"type":"text","text":" "},{"type":"text","text":"Use this operator to implement retry backoff, throttling, or scheduled tasks that depend on a particular clock implementation."}]},{"level":2,"anchor":"Example","type":"heading","text":"Example"},{"type":"codeListing","syntax":"swift","code":["let start = Date()","let clock = SuspendingClock()","let delayedTask = DeferredTask {","    \"Delayed with custom clock\"","}.delay(for: .seconds(1), clock: clock, tolerance: .milliseconds(100))","let result = try await delayedTask.execute()","let elapsed = Date().timeIntervalSince(start)","print(\"Result: \\(result) after \\(elapsed) seconds\")"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Availability: macOS 13.0, iOS 16.0, watchOS 9.0, tvOS 16.0, visionOS 1.0 and above.","type":"text"}]}]}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Delays the emission of output from the upstream "},{"code":"AsynchronousUnitOfWork","type":"codeVoice"},{"type":"text","text":" by a specified duration using a given clock."}],"kind":"symbol","references":{"doc://Afluent/documentation/Afluent/AsynchronousUnitOfWork/delay(for:clock:tolerance:)":{"abstract":[{"type":"text","text":"Delays the emission of output from the upstream "},{"type":"codeVoice","code":"AsynchronousUnitOfWork"},{"type":"text","text":" by a specified duration using a given clock."}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork\/delay(for:clock:tolerance:)","kind":"symbol","url":"\/documentation\/afluent\/asynchronousunitofwork\/delay(for:clock:toleranc