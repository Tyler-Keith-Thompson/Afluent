{"variants":[{"paths":["\/documentation\/afluent\/asynchronousunitofwork\/delay(for:clock:tolerance:jitter:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"delay"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"for"},{"kind":"text","text":" "},{"kind":"internalParam","text":"duration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Duration","preciseIdentifier":"s:12_Concurrency5ClockP8DurationQa"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Duration","preciseIdentifier":"s:12_Concurrency5ClockP8DurationQa"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"jitter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"BackoffJitter","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter","preciseIdentifier":"s:7Afluent13BackoffJitterV"},{"kind":"text","text":" = .none) -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"AsynchronousUnitOfWork","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork","preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Success","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork\/Success","preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP7SuccessQa"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Clock","preciseIdentifier":"s:12_Concurrency5ClockP"},{"kind":"text","text":"\n"}]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The duration to delay the output, conforming to the clock’s associated "},{"type":"codeVoice","code":"Duration"},{"type":"text","text":" type."}]}],"name":"duration"},{"content":[{"inlineContent":[{"type":"text","text":"The clock used for timekeeping."}],"type":"paragraph"}],"name":"clock"},{"content":[{"type":"paragraph","inlineContent":[{"text":"An optional tolerance for the delay. Defaults to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}],"name":"tolerance"},{"content":[{"inlineContent":[{"text":"How the delay is randomized. Defaults to ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/none","isActive":true,"type":"reference"},{"text":". Decorrelated","type":"text"},{"text":" ","type":"text"},{"text":"jitter waits at most three times ","type":"text"},{"type":"codeVoice","code":"duration"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"jitter"}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"anchor":"return-value","text":"Return Value","type":"heading"},{"inlineContent":[{"text":"An ","type":"text"},{"code":"AsynchronousUnitOfWork","type":"codeVoice"},{"text":" that emits the upstream output after the specified delay.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"This operator suspends the emission of output for the specified duration according to the provided clock."}],"type":"paragraph"},{"text":"Discussion","level":2,"anchor":"Discussion","type":"heading"},{"inlineContent":[{"text":"Delaying work using a custom clock is beneficial when you need precise control over timing behavior,","type":"text"},{"text":" ","type":"text"},{"text":"such as testing with test clocks or synchronizing work with specific time sources.","type":"text"},{"text":" ","type":"text"},{"text":"Use this operator to implement retry backoff, throttling, or scheduled tasks that depend on a particular clock implementation.","type":"text"}],"type":"paragraph"},{"text":"Example","level":2,"anchor":"Example","type":"heading"},{"syntax":"swift","code":["let start = Date()","let clock = SuspendingClock()","let delayedTask = DeferredTask {","    \"Delayed with custom clock\"","}.delay(for: .seconds(1), clock: clock, tolerance: .milliseconds(100))","let result = try await delayedTask.execute()","let elapsed = Date().timeIntervalSince(start)","print(\"Result: \\(result) after \\(elapsed) seconds\")"],"type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Availability: macOS 13.0, iOS 16.0, watchOS 9.0, tvOS 16.0, visionOS 1.0 and above.","type":"text"}]}]}],"type":"unorderedList"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"On WASI, a sleep on a real clock ("},{"type":"codeVoice","code":"ContinuousClock"},{"type":"text","text":", "},{"type":"codeVoice","code":"SuspendingClock"},{"type":"text","text":") holds the one thread"},{"type":"text","text":" "},{"type":"text","text":"until its deadline, even when other work is ready, and cancelling it doesn’t end it sooner. So the"},{"type":"text","text":" "},{"type":"text","text":"delay always waits out its whole duration, even when cancelled. A test clock is unaffected."}]}],"style":"note","name":"Note","type":"aside"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork\/delay(for:clock:tolerance:jitter:)"},"metadata":{"platforms":[{"name":"iOS","introducedAt":"16.0","deprecate