agraph","inlineContent":[{"text":"Availability: macOS 13.0, iOS 16.0, watchOS 9.0, tvOS 16.0, visionOS 1.0 and above.","type":"text"}]}]}]},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"On WASI, a sleep on a real clock ("},{"type":"codeVoice","code":"ContinuousClock"},{"type":"text","text":", "},{"type":"codeVoice","code":"SuspendingClock"},{"type":"text","text":") holds the one thread"},{"type":"text","text":" "},{"type":"text","text":"until its deadline, even when other work is ready, and cancelling it doesn’t end it sooner. So the"},{"type":"text","text":" "},{"type":"text","text":"delay always waits out its whole duration, even when cancelled. A test clock is unaffected."}]}]}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/afluent\/asynchronousunitofwork\/delay(for:jitter:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Afluent/documentation/Afluent/BackoffJitter/none":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"none"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7Afluent13BackoffJitterV","kind":"typeIdentifier","text":"BackoffJitter"}],"type":"topic","role":"symbol","abstract":[{"text":"Waits exactly the nominal wait.","type":"text"}],"url":"\/documentation\/afluent\/backoffjitter\/none","title":"none","kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/none"},"doc://Afluent/documentation/Afluent/AsynchronousUnitOfWork":{"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork","abstract":[{"type":"text","text":"Represents an asynchronous unit of work."}],"url":"\/documentation\/afluent\/asynchronousunitofwork","title":"AsynchronousUnitOfWork","navigatorTitle":[{"text":"AsynchronousUnitOfWork","kind":"identifier"}],"fragme