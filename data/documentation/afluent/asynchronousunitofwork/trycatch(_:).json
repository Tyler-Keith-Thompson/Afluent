iseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP7SuccessQa","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork\/Success","text":"Success"},{"kind":"text","text":"\n"}],"platforms":["Linux"],"languages":["swift"]}]},{"parameters":[{"name":"handler","content":[{"inlineContent":[{"type":"text","text":"A closure that takes the caught "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" and asynchronously throws or returns an "},{"type":"codeVoice","code":"AsynchronousUnitOfWork"},{"type":"text","text":" to recover with."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"text":"Return Value","type":"heading","level":2,"anchor":"return-value"},{"inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"AsynchronousUnitOfWork"},{"type":"text","text":" that tries to catch and replace any error with the unit of work returned by the handler."}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The handler receives the caught error and can throw. If the handler throws, the error is rethrown."}],"type":"paragraph"},{"inlineContent":[{"text":"This operator is useful when recovery logic itself can throw asynchronously.","type":"text"}],"type":"paragraph"},{"text":"Example","level":2,"anchor":"Example","type":"heading"},{"syntax":"swift","code":["struct FallbackError: Error {}","","let primaryTask = DeferredTask<Int> {","    throw FallbackError()","}","","let fallbackTask = DeferredTask<Int> {","    return 42","}","","let recoveredTask = primaryTask.tryCatch { error in","    print(\"Caught error: \\(error), attempting recovery\")","    \/\/ Recovery could fail, so handler can throw","    if Bool.random() {","        return fallbackTask","    } else {","        throw error","    }","}","","let result = try await recoveredTask.operation().value"],"type":"codeListing"}],"kind":"content"}],"hierarchy":{"paths"