{"variants":[{"paths":["\/documentation\/afluent\/asynchronousunitofworkcache\/cacheuntilcompletionorcancellation"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"A caching strategy that retains a unit of work in the cache until it completes, fails, or is cancelled.","type":"text"}],"metadata":{"role":"symbol","remoteSource":{"fileName":"AUOWCache+CacheUntilCompletionOrCancellation.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/AUOWCacheStrategies\/AUOWCache+CacheUntilCompletionOrCancellation.swift#L44"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CacheUntilCompletionOrCancellation","kind":"identifier"}],"externalID":"s:7Afluent27AsynchronousUnitOfWorkCacheC0F29UntilCompletionOrCancellationV","roleHeading":"Structure","extendedModule":"Afluent","title":"AsynchronousUnitOfWorkCache.CacheUntilCompletionOrCancellation","navigatorTitle":[{"text":"CacheUntilCompletionOrCancellation","kind":"identifier"}],"modules":[{"name":"Afluent"}],"symbolKind":"struct"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWorkCache"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CacheUntilCompletionOrCancellation"}]}]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"This strategy is useful when you want to deduplicate concurrent requests for the same unit of work, ensuring that"},{"type":"text","text":" "},{"type":"text","text":"all consumers receive the same result, and the cached value is automatically cleared after completion or cancellation."}],"type":"paragraph"},{"inlineContent":[{"text":"The cached entry is cleared on:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"successful completion (output received)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"error thrown"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"cancellation"}]}]}]},{"anchor":"Example","text":"Example","type":"heading","level":2},{"code":["let cache = AUOWCache()","","\/\/ A unit of work that produces a String after a delay","@Sendable func unitOfWork() -> some AsynchronousUnitOfWork<String> {","    DeferredTask {","        \/\/ ... expensive computation or network call ...","        return \"result\"","    }","    .shareFromCache(cache, strategy: .cacheUntilCompletionOrCancellation)","}","","\/\/ First execution stores the value in the cache","let task1 = unitOfWork().execute()","\/\/ Second execution (if started before completion) shares the cached value","let task2 = unitOfWork().execute()","","\/\/ When task1 completes, the cache entry is cleared"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"See also: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AUOWCacheStrategy\/cacheUntilCompletionOrCancellation"}],"type":"paragraph"}]}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AUOWCacheStrategy"]}],"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWorkCache\/CacheUntilCompletionOrCancellation","interfaceLanguage":"swift"},"kind":"symbol","sections":[],"topicSections":[{"anchor":"Instance-Methods","title":"Instance Methods","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWorkCache\/CacheUntilCompletionOrCancellation\/handle(unitOfWork:keyedBy:storedIn:)"]},{"anchor":"Default-Implementations","ti