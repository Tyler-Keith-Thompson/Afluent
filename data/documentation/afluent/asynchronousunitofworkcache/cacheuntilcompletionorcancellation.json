{"sections":[],"topicSections":[{"title":"Instance Methods","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWorkCache\/CacheUntilCompletionOrCancellation\/handle(unitOfWork:keyedBy:storedIn:)"],"generated":true,"anchor":"Instance-Methods"},{"title":"Default Implementations","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWorkCache\/CacheUntilCompletionOrCancellation\/AUOWCacheStrategy-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"A caching strategy that retains a unit of work in the cache until it completes, fails, or is cancelled."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CacheUntilCompletionOrCancellation","kind":"identifier"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"This strategy is useful when you want to deduplicate concurrent requests for the same unit of work, ensuring that"},{"type":"text","text":" "},{"type":"text","text":"all consumers receive the same result, and the cached value is automatically cleared after completion or cancellation."}],"type":"paragraph"},{"inlineContent":[{"text":"The cached entry is cleared on:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"successful completion (output received)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"error thrown"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"cancellation"}]}]}]},{"text":"Example","level":2,"type":"heading","anchor":"Example"},{"code":["let cache = AUOWCache()","","\/\/ A unit of work that produces a String after a delay","@Sendable func unitOfWork() -> some AsynchronousUnitOfWork<String> {","    DeferredTask {","        \/\/ ... expensive computation or network call ...","        return \"result\"","    }","    .shareFromCache(cache, strategy: .cacheUntilCompletionOrCancellation)","}","","\/\/ First execution stores the value in the cache","let task1 = unitOfWork().execute()","\/\/ Second execution (if started before completion) shares the cached value","let task2 = unitOfWork().execute()","","\/\/ When task1 completes, the cache entry is cleared"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"See also: ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AUOWCacheStrategy\/cacheUntilCompletionOrCancellation","type":"reference","isActive":true}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWorkCache\/CacheUntilCompletionOrCancellation"},"metadata":{"title":"AsynchronousUnitOfWorkCache.CacheUntilCompletionOrCancellation","role":"symbol","modules":[{"name":"Afluent"}],"extendedModule":"Afluent","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"CacheUntilCompletionOrCancellation"}],"roleHeading":"Structure","remoteSource":{"fileName":"AUOWCache+CacheUntilCompletionOrCancellation.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/AUOWCacheStrategies\/AUOWCache+CacheUntilCompletionOrCancellation.swift#L44"},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"CacheUntilCompletionOrCancellation"}],"externalID":"s:7Afluent27AsynchronousUnitOfWorkCacheC0F29UntilCompletionOrCancellationV"},"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWorkCache"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/asynchronousunitofworkcache\/cacheuntilcomplet