t","text":")? = nil, "},{"kind":"externalParam","text":"receiveOutput"},{"kind":"text","text":": ("},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" ("},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sci7ElementQa","text":"Element"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":")? = nil) -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AnyCancellable","text":"AnyCancellable","preciseIdentifier":"s:7Afluent14AnyCancellableC"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"receiveCompletion","content":[{"inlineContent":[{"text":"An optional async closure invoked when the sequence completes, either normally with ","type":"text"},{"code":".finished","type":"codeVoice"},{"text":" ","type":"text"},{"text":"or with an error ","type":"text"},{"code":".failure","type":"codeVoice"},{"text":". Called exactly once.","type":"text"}],"type":"paragraph"}]},{"name":"receiveOutput","content":[{"type":"paragraph","inlineContent":[{"text":"An optional async throwing closure invoked for each element produced by the sequence.","type":"text"},{"text":" ","type":"text"},{"text":"If this closure throws an error, the sequence is terminated and completion closure is called with ","type":"text"},{"code":".failure","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"kind":"content","content":[{"level":2,"anchor":"return-value","text":"Return Value","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"code":"AnyCancellable","type":"codeVoice"},{"text":" token that can be stored and used to cancel the ongoing subscription.","type":"text"}]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"text":"This method allows you to asynchronously receive each element emitted by the sequence and respond","type":"text"},{"text":" ","type":"text"},{"text":"to completion or failure. The stream runs until all elements are consumed, an error occurs,","type":"text"},{"text":" ","type":"text"},{"text":"or cancellation is triggered via the returned token.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Usage example:","type":"text"}],"type":"paragraph"},{"code":["let publisher: AsyncStream<Int> = AsyncStream { continuation in","    Task {","        for i in 1...5 {","            continuation.yield(i)","            try await Task.sleep(nanoseconds: 500_000_000)","        }","        continuation.finish()","    }","}","","let cancellable = publisher.sink(","    receiveCompletion: { completion in","        switch completion {","        case .finished:","            print(\"Stream completed successfully\")","        case .failure(let error):","            print(\"Stream failed with error: \\(error)\")","        }","    },","    receiveOutput: { value in","        print(\"Received value: \\(value)\")","    }",")","","\/\/ To cancel early:","\/\/ cancellable.cancel()"],"type":"codeListing","syntax":"swift"}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWorkSequence\/sink(receiveCompletion:receiveOutput:)"},"references":{"doc://Afluent/documentation/Afluent":{"kind":"symbol","url":"\/documentation\/afluent","type":"topic","abstract":[],"title":"Afluent","role":"collection","identifier":"doc:\/\/Afluent\/documentation\/Afluent"},"doc://Afluent/documentation/Afluent/AnyCancellable":{"type":"topic","url":"\/documentation\/afluent\/anycancellable","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnyCancellable"}],"abstract":[{"text":"Stores an erased unit of work and provides