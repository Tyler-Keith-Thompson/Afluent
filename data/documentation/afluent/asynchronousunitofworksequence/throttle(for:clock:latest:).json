"type":"text","text":" emits the latest element seen during the interval."}],"type":"paragraph"}]}],"type":"unorderedList"}],"name":"latest"}],"kind":"parameters"},{"content":[{"text":"Return Value","type":"heading","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"An async sequence that emits throttled elements from the upstream sequence.","type":"text"}]}],"kind":"content"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"This operator suppresses elements from the upstream async sequence during each interval, emitting only one element per interval:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"latest"},{"type":"text","text":" is "},{"type":"codeVoice","code":"false"},{"type":"text","text":", it emits the first element received immediately and then ignores subsequent elements until the interval completes."}]}]},{"content":[{"inlineContent":[{"text":"If ","type":"text"},{"code":"latest","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", it emits the first element immediately, then during the interval it tracks element updates, emitting only the most recent one at the interval’s end.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Elements arriving during an interval beyond the emitted one are suppressed, allowing controlled pacing of element emission."}],"type":"paragraph"},{"text":"Example","level":2,"anchor":"Example","type":"heading"},{"inlineContent":[{"type":"text","text":"The following example creates an "},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":" that emits the current date every second,"},{"type":"text","text":" "},{"type":"text","text":"then applies a throttle with a 3-second interval, showing both "},{"type":"codeVoice","code":"latest: false"},{"type":"text","text":" and "},{"type":"codeVoice","code":"latest: true"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Foundation","import _Concurrency","","let stream = AsyncStream<Date> { continuation in","    Task {","        while true {","            continuation.yield(Date())","            try await Task.sleep(nanoseconds: 1_000_000_000) \/\/ 1 second","        }","    }","}","","\/\/ Throttle with latest: false (emit the first element immediately, then suppress others during the interval)","Task {","    print(\"Throttle with latest: false\")","    for await date in stream.throttle(for: .seconds(3), clock: ContinuousClock(), latest: false) {","        print(\"Emitted (first): \\(date)\")","    }","}","","\/\/ Throttle with latest: true (emit the first element immediately, then emit the latest element at interval end)","Task {","    print(\"Throttle with latest: true\")","    for await date in stream.throttle(for: .seconds(3), clock: ContinuousClock(), latest: true) {","        print(\"Emitted (latest): \\(date)\")","    }","}","","\/*","Sample output for latest: false:","Throttle with latest: false","Emitted (first): 2025-07-04 12:00:00 +0000","Emitted (first): 2025-07-04 12:00:03 +0000","Emitted (first): 2025-07-04 12:00:06 +0000","","Sample output for latest: true:","Throttle with latest: true","Emitted (latest): 2025-07-04 12:00:00 +0000","Emitted (latest): 2025-07-04 12:00:02 +0000","Emitted (latest): 2025-07-04 12:00:05 +0000","*\/"]}],"kind":"content"}],"references":{"doc://Afluent/documentation/Afluent":{"type":"topic","title":"Afluent","kind":"symbol","role":"collection","identifier":"doc:\/\/Afluent\/documentation\/Afluent","abstract":[],"url":"\/documentation\/afluent"},"doc://Afluent/documentation/Afluent/AsynchronousUnitOfWorkSequence/throttle(for:clock:latest:)":{"url":"\/documentation\/afluent\/asynchronousunitofworksequence\/throttle(for:clock:latest:)","identifier":"doc:\/\/Aflue