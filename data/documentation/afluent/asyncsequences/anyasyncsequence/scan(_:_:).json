value with each new element from the upstream async sequence using the provided closure.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This is useful for computing running totals, aggregating state, or applying stateful transformations over time.","type":"text"}],"type":"paragraph"},{"anchor":"Example","level":2,"type":"heading","text":"Example"},{"inlineContent":[{"text":"The following example demonstrates accumulating a running sum over an asynchronous sequence of integers:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ An async sequence producing the numbers 1 through 5","let numbers = AsyncStream<Int> { continuation in","    for i in 1...5 {","        continuation.yield(i)","    }","    continuation.finish()","}","","\/\/ Use scan to accumulate a running sum","let runningSum = numbers.scan(0) { partialSum, nextNumber in","    return partialSum + nextNumber","}","","\/\/ Consume the running sums","Task {","    for try await sum in runningSum {","        print(sum) \/\/ Prints: 1, 3, 6, 10, 15","    }","}"]}]}],"references":{"doc://Afluent/documentation/Afluent":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent","title":"Afluent","url":"\/documentation\/afluent","abstract":[],"kind":"symbol","role":"collection","type":"topic"},"doc://Afluent/documentation/Afluent/AsyncSequences/Scan":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Scan","abstract":[],"title":"AsyncSequences.Scan","role":"symbol","kind":"symbol","url":"\/documentation\/afluent\/asyncsequences\/scan","navigatorTitle":[{"kind":"identifier","text":"Scan"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scan"}]},"doc://Afluent/documentation/Afluent/AsyncSequences/AnyAsyncSequence":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AnyAsyncSequence","title":"AsyncSequences.AnyAsyncSequence","navigatorTitle":[{"kind":"identi