ph"},{"level":2,"type":"heading","text":"Example","anchor":"Example"},{"type":"codeListing","code":["let clock = ContinuousClock()","for try await line in bytes.lines.timeout(.seconds(30), clock: clock) {","    handle(line)","}"],"syntax":"swift"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"TimeoutError"},{"type":"text","text":" (or "},{"type":"codeVoice","code":"customError"},{"type":"text","text":") when "},{"type":"codeVoice","code":"duration"},{"type":"text","text":" passes between elements, and"},{"type":"text","text":" "},{"type":"text","text":"any error the upstream throws."}]}],"style":"note","name":"Throws"}]}],"sections":[],"references":{"doc://Afluent/documentation/Afluent/AsyncSequences/Timeout":{"type":"topic","abstract":[{"text":"Used as the implementation detail for the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/timeout(_:clock:tolerance:customError:)"},{"text":" operator.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Timeout"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Timeout"}],"title":"AsyncSequences.Timeout","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Timeout","url":"\/documentation\/afluent\/asyncsequences\/timeout","kind":"symbol"},"doc://Afluent/documentation/Afluent/AsyncSequences/AssertNoFailure":{"role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AssertNoFailure","kind":"identifier"}],"navigatorTitle":[{"text":"AssertNoFailure","kind":"identifier"}],"abstract":[{"type":"text","text":"An async sequence that raises a fatal error if its upstream sequence throws."}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AssertNoFailure","title":"AsyncSequences.Asse