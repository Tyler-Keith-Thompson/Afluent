cated":false,"beta":false,"unavailable":false},{"name":"iPadOS","introducedAt":"16.0","deprecated":false,"beta":false,"unavailable":false},{"name":"Mac Catalyst","introducedAt":"16.0","deprecated":false,"beta":false,"unavailable":false},{"name":"macOS","introducedAt":"13.0","deprecated":false,"beta":false,"unavailable":false},{"name":"tvOS","introducedAt":"16.0","deprecated":false,"beta":false,"unavailable":false},{"name":"visionOS","introducedAt":"1.0","deprecated":false,"beta":false,"unavailable":false},{"name":"watchOS","introducedAt":"9.0","deprecated":false,"beta":false,"unavailable":false}],"title":"timeout(_:customError:)"},"abstract":[{"text":"Fails if the sequence goes the given duration without producing an element, measured on","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"type":"codeVoice","code":"SuspendingClock"},{"text":".","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AssertNoFailure\/timeout(_:customError:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"timeout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"duration"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier","text":"Duration"},{"kind":"text","text":", "},{"kind":"externalParam","text":"customError"},{"kind":"text","text":": (any "},{"preciseIdentifier":"s:s5ErrorP","kind":"typeIdentifier","text":"Error"},{"kind":"text","text":")? = nil) -> "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO","kind":"typeIdentifier","text":"AsyncSequences"},{"kind":"text","text":"."},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Timeout","preciseIdentifier":"s:7Afluent14AsyncSequencesO7TimeoutV","kind":"typeIdentifier","text":"Timeout"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"preciseIdentifier":"s:12_Concurrency15SuspendingClockV","kind":"typeIdentifier","text":"SuspendingClock"},{"kind":"text","text":">"}]}]},{"kind":"parameters","parameters":[{"name":"duration","content":[{"inlineContent":[{"text":"The longest the sequence may go without an element.","type":"text"}],"type":"paragraph"}]},{"name":"customError","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The error to throw when the timer fires. Defaults to"},{"type":"text","text":" "},{"code":"TimeoutError.timedOut(duration:)","type":"codeVoice"},{"type":"text","text":"."}]}]}]},{"kind":"content","content":[{"anchor":"return-value","level":2,"text":"Return Value","type":"heading"},{"inlineContent":[{"text":"A sequence of the same elements that throws if the upstream goes quiet.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The timer starts when iteration begins and restarts with every element, so it bounds the","type":"text"},{"text":" ","type":"text"},{"text":"wait for the first element and each gap after it, never the sequence as a whole. Elements","type":"text"},{"text":" ","type":"text"},{"text":"pass through unchanged. When the timer fires, the upstream is cancelled and the sequence","type":"text"},{"text":" ","type":"text"},{"text":"throws.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The upstream is read ahead of the consumer, and elements it produces while the consumer is","type":"text"},{"text":" ","type":"text"},{"text":"busy are buffered, so the timer measures the upstream’s gaps. A duration of zero or less","type":"text"},{"text":" ","type":"text"},{"text":"throws before the first element.","type":"text"}]},{"text":"Example","type":"heading","level":2,"anchor":"Example"},{"code":["for try await event in serverEvents.timeout(.seconds(30)) {","    handle(event)","}","\/\/ Throws TimeoutError.timedOut if 30 seconds pass without an event"],"type":"codeListing","syntax":"swift"},{"name":"Throws","style":"note","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"TimeoutError","type":"codeVoice"},{"text":" (or ","type":"text"},{"code":"customError","type":"codeVoice"},{"text":") when ","type":"text"},{"code":"duration","type":"codeVoice"},{"text":" passes between elements, and","type":"text"},{"text":" ","type":"text"},{"text":"any error the upstream throws.","type":"text"}],"type":"paragraph"}]},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"On WASI, a sleep on a real clock ("},{"code":"ContinuousClock","type":"codeVoice"},{"type":"text","text":", "},{"code":"SuspendingClock","type":"codeVoice"},{"type":"text","text":") holds the one thread"},{"type":"text","text":" "},{"type":"text","text":"until its deadline, even when other work is ready, and cancelling it doesn’t end it sooner. So the"},{"type":"text","text":" "},{"type":"text","text":"timer can hold the thread before the upstream runs, then count that wait against it and throw even"},{"type":"text","text":" "},{"type":"text","text":"though elements were ready. A test clock is unaffected."}]}]}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AssertNoFailure"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/asyncsequences\/assertnofailure\/timeout(_:customerror:)"]}],"references":{"doc://Afluent/documentation/Afluent/AsyncSequences/AssertNoFailure":{"abstract":[{"type":"text","te