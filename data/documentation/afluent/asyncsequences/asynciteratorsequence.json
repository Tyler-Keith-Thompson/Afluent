{"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncIteratorSequence"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Base"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Base"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"AsyncIteratorProtocol","preciseIdentifier":"s:ScI"}],"platforms":["Linux"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Use it to subscribe to a subject before the code that consumes the subject runs. A ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"drops values sent while nobody is subscribed, and an operator such as ","type":"text"},{"code":"batch(strategy:)","type":"codeVoice"},{"text":" subscribes only when","type":"text"},{"text":" ","type":"text"},{"text":"its consumer’s task starts iterating, so values sent in between are lost. Making the subject’s iterator first","type":"text"},{"text":" ","type":"text"},{"text":"subscribes at once; wrapping it in an ","type":"text"},{"code":"AsyncIteratorSequence","type":"codeVoice"},{"text":" hands that subscription to any operator.","type":"text"}]},{"type":"heading","level":2,"anchor":"Example","text":"Example"},{"type":"codeListing","code":["let events = PassthroughSubject<String>()","\/\/ Subscribes now: every value sent from here on is buffered for the batches below.","let batches = AsyncIteratorSequence(events.makeAsyncIterator())","    .batch(strategy: .count(2))","events.send(\"launch\")","events.send(\"login\")","events.send(completion: .finished)","","let consumer = Task {","    for try await batch in batches {","        print(batch) \/\/ Prints: [\"launch\", \"login\"]","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The subscription belongs to the wrapped iterator. A subject’s iterator subscribes when it is made and buffers","type":"text"},{"text":" ","type":"text"},{"text":"every value sent after that until it is read, without limit. It unsubscribes when the last copy of the","type":"text"},{"text":" ","type":"text"},{"text":"iterator is released, whether or not it was ever iterated, and when a task waiting in its ","type":"text"},{"type":"codeVoice","code":"next()"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"cancelled; values sent after either are not delivered to it. To read the subject again, make a new iterator.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The sequence is single-pass. Each ","type":"text"},{"type":"codeVoice","code":"makeAsyncIterator()"},{"text":" returns a copy of the wrapped iterator, so a","type":"text"},{"text":" ","type":"text"},{"text":"value-type iterator starts over from where it was wrapped, and a reference-type one, such as a subject’s,","type":"text"},{"text":" ","type":"text"},{"text":"shares its elements among every iteration.","type":"text"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences"]]},"metadata":{"modules":[{"name":"Afluent"}],"symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncIteratorSequence","kind":"identifier"}],"remoteSource":{"fileName":"AsyncIteratorSequence.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SequenceOperators\/AsyncIteratorSequence.swift#L40"},"navigatorTitle":[{"text":"AsyncIteratorSequence","kind":"identifier"}],"title":"AsyncSequences.AsyncIteratorSequence","extendedModule":"Afluent","externalID":"s:7Afluent14AsyncSequencesO0B16IteratorSequenceV","roleHeading":"Structure","role":"symbol"},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","abstract":[{"type":"text","text":"A single-pass async sequence over an iterator you already made: the async counterpart of the standard"},{"type":"text","text":" "},{"type":"text","text":"library’s "},{"type":"codeVoice","code":"IteratorSequence"},{"type":"text","text":"."}],"sections":[],"topicSections":[{"generated":true,"title":"Structures","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncIterator"],"anchor":"Structures"},{"generated":true,"title":"Initializers","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/init(_:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/makeAsyncIterator()"],"anchor":"Instance-Methods"},{"generated":true,"title":"Type Aliases","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/Element"],"anchor":"Type-Aliases"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncSequence-Implementations","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncSequence-Implementations"],"anchor":"Default-Implementations"}],"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP","doc:\/\/Afluent\/Sci"],"kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/asyncsequences\/asynciteratorsequence"]}],"references":{"doc://Afluent/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/Afluent\/s16SendableMetatypeP"},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AsyncIteratorSequence"}],"url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence","type":"topic","role":"symbol","abstract":[{"type":"text","text":"A single-pass async sequence over an iterator you already made: the async counterpart of the standard"},{"type":"text","text":" "},{"type":"text","text":"library’s "},{"type":"codeVoice","code":"IteratorSequence"},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncIteratorSequence"}],"title":"AsyncSequences.AsyncIteratorSequence","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence"},"doc://Afluent/s8SendableP":{"identifier":"doc:\/\/Afluent\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://Afluent/documentation/Afluent/AsyncSequences":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncSequences","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/afluent\/asyncsequences","abstract":[{"text":"A namespace for grouping related AsyncSequence operations.","type":"text"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","role":"symbol","navigatorTitle":[{"text":"AsyncSequences","kind":"identifier"}],"title":"AsyncSequences"},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence/init(_:)":{"kind":"symbol","url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence\/init(_:)","type":"topic","role":"symbol","abstract":[{"text":"Creates a sequence over ","type":"text"},{"type":"codeVoice","code":"base"},{"text":".","type":"text"}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"init(_:)","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/init(_:)"},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence/AsyncSequence-Implementations":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncSequence-Implementations","type":"topic","kind":"article","url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence\/asyncsequence-implementations","role":"collectionGroup","title":"AsyncSequence Implementations","abstract":[]},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence/makeAsyncIterator()":{"kind":"symbol","url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence\/makeasynciterator()","type":"topic","role":"symbol","abstract":[],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"makeAsyncIterator"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO","text":"AsyncSequences"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO0B16IteratorSequenceV","text":"AsyncIteratorSequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Base"},{"kind":"text","text":">."},{"kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO0B16IteratorSequenceV0bD0V","text":"AsyncIterator"}],"title":"makeAsyncIterator()","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/makeAsyncIterator()"},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence/AsyncIterator":{"navigatorTitle":[{"kind":"identifier","text":"AsyncIterator"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncIterator","kind":"symbol","url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence\/asynciterator","type":"topic","role":"symbol","title":"AsyncSequences.AsyncIteratorSequence.AsyncIterator","abstract":[],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncIterator"}]},"doc://Afluent/documentation/Afluent":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent","title":"Afluent","role":"collection","abstract":[],"url":"\/documentation\/afluent","kind":"symbol","type":"topic"},"doc://Afluent/documentation/Afluent/PassthroughSubject":{"title":"PassthroughSubject","navigatorTitle":[{"kind":"identifier","text":"PassthroughSubject"}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PassthroughSubject"}],"kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","abstract":[{"type":"text","text":"A subject that broadcasts values to multiple consumers without storing a current value."},{"type":"text","text":" "},{"type":"text","text":"Unlike "},{"code":"CurrentValueSubject","type":"codeVoice"},{"type":"text","text":", "},{"code":"PassthroughSubject","type":"codeVoice"},{"type":"text","text":" does not retain the most recent value."},{"type":"text","text":" "},{"type":"text","text":"This is an "},{"code":"AsyncSequence","type":"codeVoice"},{"type":"text","text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s PassthroughSubject."}],"url":"\/documentation\/afluent\/passthroughsubject"},"doc://Afluent/Sci":{"identifier":"doc:\/\/Afluent\/Sci","title":"_Concurrency.AsyncSequence","type":"unresolvable"},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence/Element":{"kind":"symbol","navigatorTitle":[{"text":"Element","kind":"identifier"}],"url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence\/element","type":"topic","role":"symbol","abstract":[],"fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"identifier"}],"title":"AsyncSequences.AsyncIteratorSequence.Element","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/Element"}}}