{"metadata":{"extendedModule":"Afluent","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncIteratorSequence"}],"title":"AsyncSequences.AsyncIteratorSequence","roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"AsyncIteratorSequence"}],"modules":[{"name":"Afluent"}],"externalID":"s:7Afluent14AsyncSequencesO0B16IteratorSequenceV","symbolKind":"struct","remoteSource":{"fileName":"AsyncIteratorSequence.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SequenceOperators\/AsyncIteratorSequence.swift#L40"}},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP","doc:\/\/Afluent\/Sci"],"type":"conformsTo"}],"variants":[{"paths":["\/documentation\/afluent\/asyncsequences\/asynciteratorsequence"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncIteratorSequence"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Base"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Base"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:ScI","kind":"typeIdentifier","text":"AsyncIteratorProtocol"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Use it to subscribe to a subject before the code that consumes the subject runs. A ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"drops values sent while nobody is subscribed, and an operator such as ","type":"text"},{"code":"batch(strategy:)","type":"codeVoice"},{"text":" subscribes only when","type":"text"},{"text":" ","type":"text"},{"text":"its consumer’s task starts iterating, so values sent in between are lost. Making the subject’s iterator first","type":"text"},{"text":" ","type":"text"},{"text":"subscribes at once; wrapping it in an ","type":"text"},{"code":"AsyncIteratorSequence","type":"codeVoice"},{"text":" hands that subscription to any operator.","type":"text"}]},{"type":"heading","level":2,"text":"Example","anchor":"Example"},{"type":"codeListing","syntax":"swift","code":["let events = PassthroughSubject<String>()","\/\/ Subscribes now: every value sent from here on is buffered for the batches below.","let batches = AsyncIteratorSequence(events.makeAsyncIterator())","    .batch(strategy: .count(2))","events.send(\"launch\")","events.send(\"login\")","events.send(completion: .finished)","","let consumer = Task {","    for try await batch in batches {","        print(batch) \/\/ Prints: [\"launch\", \"login\"]","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The subscription belongs to the wrapped iterator. A subject’s iterator subscribes when it is made and buffers"},{"type":"text","text":" "},{"type":"text","text":"every value sent after that until it is read, without limit. It unsubscribes when the last copy of the"},{"type":"text","text":" "},{"type":"text","text":"iterator is released, whether or not it was ever iterated, and when a task waiting in its "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"cancelled; values sent after either are not delivered to it. To read the subject again, make a new iterator."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sequence is single-pass. Each "},{"type":"codeVoice","code":"makeAsyncIterator()"},{"type":"text","text":" returns a copy of the wrapped iterator, so a"},{"type":"text","text":" "},{"type":"text","text":"value-type iterator starts over from where it was wrapped, and a reference-type one, such as a subject’s,"},{"type":"text","text":" "},{"type":"text","text":"shares its elements among every iteration."}]}]}],"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence"},"abstract":[{"type":"text","text":"A single-pass async sequence over an iterator you already made: the async counterpart of the standard"},{"type":"text","text":" "},{"type":"text","text":"library’s "},{"type":"codeVoice","code":"IteratorSequence"},{"type":"text","text":"."}],"topicSections":[{"title":"Structures","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncIterator"],"anchor":"Structures"},{"title":"Initializers","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/init(_:)"],"anchor":"Initializers"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/makeAsyncIterator()"],"anchor":"Instance-Methods"},{"title":"Type Aliases","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/Element"],"anchor":"Type-Aliases"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncSequence-Implementations","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncSequence-Implementations"],"anchor":"Default-Implementations"}],"references":{"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence/Element":{"abstrac