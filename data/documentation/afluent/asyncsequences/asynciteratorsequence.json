{"sections":[],"kind":"symbol","topicSections":[{"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncIterator"],"generated":true},{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/init(_:)"],"generated":true},{"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/makeAsyncIterator()"],"generated":true},{"title":"Type Aliases","anchor":"Type-Aliases","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/Element"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncSequence-Implementations","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncSequence-Implementations"],"generated":true}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncIteratorSequence","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:ScI","text":"AsyncIteratorProtocol","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use it to subscribe to a subject before the code that consumes the subject runs. A "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","isActive":true},{"type":"text","text":" "},{"type":"text","text":"drops values sent while nobody is subscribed, and an operator such as "},{"type":"codeVoice","code":"batch(strategy:)"},{"type":"text","text":" subscribes only when"},{"type":"text","text":" "},{"type":"text","text":"its consumer’s task starts iterating, so values sent in between are lost. Making the subject’s iterator first"},{"type":"text","text":" "},{"type":"text","text":"subscribes at once; wrapping it in an "},{"type":"codeVoice","code":"AsyncIteratorSequence"},{"type":"text","text":" hands that subscription to any operator."}]},{"type":"heading","level":2,"anchor":"Example","text":"Example"},{"code":["let events = PassthroughSubject<String>()","\/\/ Subscribes now: every value sent from here on is buffered for the batches below.","let batches = AsyncIteratorSequence(events.makeAsyncIterator())","    .batch(strategy: .count(2))","events.send(\"launch\")","events.send(\"login\")","events.send(completion: .finished)","","let consumer = Task {","    for try await batch in batches {","        print(batch) \/\/ Prints: [\"launch\", \"login\"]","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The subscription belongs to the wrapped iterator. A subject’s iterator subscribes when it is made and buffers"},{"type":"text","text":" "},{"type":"text","text":"every value sent after that until it is read, without limit. It unsubscribes when the last copy of the"},{"type":"text","text":" "},{"type":"text","text":"iterator is released, whether or not it was ever iterated, and when a task waiting in its "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"cancelled; values sent after either are not delivered to it. To read the subject again, make a new iterator."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sequence is single-pass. Each "},{"type":"codeVoice","code":"makeAsyncIterator()"},{"type":"text","text":" returns a copy of the wrapped iterator, so a"},{"type":"text","text":" "},{"type":"text","text":"value-type iterator starts over from where it was wrapped, and a reference-type one, such as a subject’s,"},{"type":"text","text":" "},{"type":"text","text":"shares its elements among every iteration."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences"]]},"abstract":[{"type":"text","text":"A single-pass async sequence over an iterator you already made: the async counterpart of the standard"},{"type":"text","text":" "},{"type":"text","text":"library’s "},{"code":"IteratorSequence","type":"codeVoice"},{"type":"text","text":"."}],"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/afluent\/asyncsequences\/asynciteratorsequence"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"symbolKind":"struct","extendedModule":"Afluent","navigatorTitle":[{"text":"AsyncIteratorSequence","kind":"identifier"}],"modules":[{"name":"Afluent"}],"title":"AsyncSequences.AsyncIteratorSequence","role":"symbol","externalID":"s:7Afluent14AsyncSequencesO0B16IteratorSequenceV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncIteratorSequence","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SequenceOperators\/AsyncIteratorSequence.swift#L40","fileName":"AsyncIteratorSequence.swift"},"roleHeading":"Structure"},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP","doc:\/\/Afluent\/Sci"],"type":"conformsTo","kind":"relationships"}],"references":{"doc://Afluent/s16SendableMetatypeP":{"identifier":"doc:\/\/Afluent\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence/Element":{"title":"AsyncSequences.AsyncIteratorSequence.Element","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Element"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Element"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/Element","abstract":[],"kind":"symbol","url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence\/element","type":"topic"},"doc://Afluent/Sci":{"identifier":"doc:\/\/Afluent\/Sci","type":"unresolvable","title":"_Concurrency.AsyncSequence"},"doc://Afluent/documentation/Afluent":{"kind":"symbol","role":"collection","abstract":[],"url":"\/documentation\/afluent","type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent","title":"Afluent"},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence/init(_:)":{"kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/init(_:)","url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence\/init(_:)","role":"symbol","type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"init(_:)","abstract":[{"text":"Creates a sequence over ","type":"text"},{"code":"base","type":"codeVoice"},{"text":".","type":"text"}]},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence":{"kind":"symbol","url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence","title":"AsyncSequences.AsyncIteratorSequence","type":"topic","navigatorTitle":[{"kind":"identifier","text":"AsyncIteratorSequence"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncIteratorSequence"}],"role":"symbol","abstract":[{"text":"A single-pass async sequence over an iterator you already made: the async counterpart of the standard","type":"text"},{"text":" ","type":"text"},{"text":"library’s ","type":"text"},{"code":"IteratorSequence","type":"codeVoice"},{"text":".","type":"text"}]},"doc://Afluent/documentation/Afluent/AsyncSequences":{"kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncSequences","kind":"identifier"}],"navigatorTitle":[{"text":"AsyncSequences","kind":"identifier"}],"type":"topic","url":"\/documentation\/afluent\/asyncsequences","title":"AsyncSequences","abstract":[{"text":"A namespace for grouping related AsyncSequence operations.","type":"text"}]},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence/AsyncSequence-Implementations":{"title":"AsyncSequence Implementations","role":"collectionGroup","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncSequence-Implementations","abstract":[],"kind":"article","url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence\/asyncsequence-implementations","type":"topic"},"doc://Afluent/documentation/Afluent/PassthroughSubject":{"title":"PassthroughSubject","abstract":[{"text":"A subject that broadcasts values to multiple consumers without storing a current value.","type":"text"},{"text":" ","type":"text"},{"text":"Unlike ","type":"text"},{"code":"CurrentValueSubject","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PassthroughSubject","type":"codeVoice"},{"text":" does not retain the most recent value.","type":"text"},{"text":" ","type":"text"},{"text":"This is an ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s PassthroughSubject.","type":"text"}],"url":"\/documentation\/afluent\/passthroughsubject","role":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PassthroughSubject","kind":"identifier"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","kind":"symbol","navigatorTitle":[{"text":"PassthroughSubject","kind":"identifier"}]},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence/makeAsyncIterator()":{"abstract":[],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/makeAsyncIterator()","url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence\/makeasynciterator()","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"makeAsyncIterator"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"AsyncIteratorSequence","preciseIdentifier":"s:7Afluent14AsyncSequencesO0B16IteratorSequenceV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Base"},{"kind":"text","text":">."},{"kind":"typeIdentifier","text":"AsyncIterator","preciseIdentifier":"s:7Afluent14AsyncSequencesO0B16IteratorSequenceV0bD0V"}],"title":"makeAsyncIterator()","kind":"symbol"},"doc://Afluent/s8SendableP":{"identifier":"doc:\/\/Afluent\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence/AsyncIterator":{"kind":"symbol","title":"AsyncSequences.AsyncIteratorSequence.AsyncIterator","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncIterator","url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence\/asynciterator","abstract":[],"role":"symbol","navigatorTitle":[{"text":"AsyncIterator","kind":