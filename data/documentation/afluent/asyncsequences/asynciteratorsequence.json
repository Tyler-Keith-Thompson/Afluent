{"metadata":{"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SequenceOperators\/AsyncIteratorSequence.swift#L40","fileName":"AsyncIteratorSequence.swift"},"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncIteratorSequence"}],"modules":[{"name":"Afluent"}],"title":"AsyncSequences.AsyncIteratorSequence","role":"symbol","externalID":"s:7Afluent14AsyncSequencesO0B16IteratorSequenceV","extendedModule":"Afluent","roleHeading":"Structure","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"AsyncIteratorSequence"}]},"sections":[],"abstract":[{"type":"text","text":"A single-pass async sequence over an iterator you already made: the async counterpart of the standard"},{"type":"text","text":" "},{"type":"text","text":"library’s "},{"type":"codeVoice","code":"IteratorSequence"},{"type":"text","text":"."}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP","doc:\/\/Afluent\/Sci"],"type":"conformsTo","title":"Conforms To"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences"]]},"topicSections":[{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncIterator"],"title":"Structures","anchor":"Structures","generated":true},{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/init(_:)"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/makeAsyncIterator()"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"},{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/Element"],"generated":true,"anchor":"Type-Aliases","title":"Type Aliases"},{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncSequence-Implementations","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncSequence-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncIteratorSequence","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AsyncIteratorProtocol","kind":"typeIdentifier","preciseIdentifier":"s:ScI"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use it to subscribe to a subject before the code that consumes the subject runs. A "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","isActive":true},{"type":"text","text":" "},{"type":"text","text":"drops values sent while nobody is subscribed, and an operator such as "},{"type":"codeVoice","code":"batch(strategy:)"},{"type":"text","text":" subscribes only when"},{"type":"text","text":" "},{"type":"text","text":"its consumer’s task starts iterating, so values sent in between are lost. Making the subject’s iterator first"},{"type":"text","text":" "},{"type":"text","text":"subscribes at once; wrapping it in an "},{"type":"codeVoice","code":"AsyncIteratorSequence"},{"type":"text","text":" hands that subscription to any operator."}]},{"text":"Example","type":"heading","level":2,"anchor":"Example"},{"code":["let events = PassthroughSubject<String>()","\/\/ Subscribes now: every value sent from here on is buffered for the batches below.","let batches = AsyncIteratorSequence(events.makeAsyncIterator())","    .batch(strategy: .count(2))","events.send(\"launch\")","events.send(\"login\")","events.send(completion: .finished)","","let consumer = Task {","    for try await batch in batches {","        print(batch) \/\/ Prints: [\"launch\", \"login\"]","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The subscription belongs to the wrapped iterator. A subject’s iterator subscribes when it is made and buffers"},{"type":"text","text":" "},{"type":"text","text":"every value sent after that until it is read, without limit. It unsubscribes when the last copy of the"},{"type":"text","text":" "},{"type":"text","text":"iterator is released, whether or not it was ever iterated, and when a task waiting in its "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"cancelled; values sent after either are not delivered to it. To read the subject again, make a new iterator."}]},{"type":"paragraph","inlineContent":[{"text":"The sequence is single-pass. Each ","type":"text"},{"code":"makeAsyncIterator()","type":"codeVoice"},{"text":" returns a copy of the wrapped iterator, so a","type":"text"},{"text":" ","type":"text"},{"text":"value-type iterator starts over from where it was wrapped, and a reference-type one, such as a subject’s,","type":"text"},{"text":" ","type":"text"},{"text":"shares its elements among every iteration.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/asyncsequences\/asynciteratorsequence"]}],"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence","interfaceLanguage":"swift"},"references":{"doc://Afluent/s16SendableMetatypeP":{"identifier":"doc:\/\/Afluent\/s16SendableMetatypeP","