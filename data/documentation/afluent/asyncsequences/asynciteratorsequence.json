{"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP","doc:\/\/Afluent\/Sci"],"type":"conformsTo","title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncIteratorSequence","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AsyncIteratorProtocol","preciseIdentifier":"s:ScI","kind":"typeIdentifier"}]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Use it to subscribe to a subject before the code that consumes the subject runs. A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","type":"reference"},{"text":" ","type":"text"},{"text":"drops values sent while nobody is subscribed, and an operator such as ","type":"text"},{"code":"batch(strategy:)","type":"codeVoice"},{"text":" subscribes only when","type":"text"},{"text":" ","type":"text"},{"text":"its consumer’s task starts iterating, so values sent in between are lost. Making the subject’s iterator first","type":"text"},{"text":" ","type":"text"},{"text":"subscribes at once; wrapping it in an ","type":"text"},{"code":"AsyncIteratorSequence","type":"codeVoice"},{"text":" hands that subscription to any operator.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Example","anchor":"Example","type":"heading"},{"syntax":"swift","type":"codeListing","code":["let events = PassthroughSubject<String>()","\/\/ Subscribes now: every value sent from here on is buffered for the batches below.","let batches = AsyncIteratorSequence(events.makeAsyncIterator())","    .batch(strategy: .count(2))","events.send(\"launch\")","events.send(\"login\")","events.send(completion: .finished)","","let consumer = Task {","    for try await batch in batches {","        print(batch) \/\/ Prints: [\"launch\", \"login\"]","    }","}"]},{"inlineContent":[{"type":"text","text":"The subscription belongs to the wrapped iterator. A subject’s iterator subscribes when it is made and buffers"},{"type":"text","text":" "},{"type":"text","text":"every value sent after that until it is read, without limit. It unsubscribes when the last copy of the"},{"type":"text","text":" "},{"type":"text","text":"iterator is released, whether or not it was ever iterated, and when a task waiting in its "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"cancelled; values sent after either are not delivered to it. To read the subject again, make a new iterator."}],"type":"paragraph"},{"inlineContent":[{"text":"The sequence is single-pass. Each ","type":"text"},{"code":"makeAsyncIterator()","type":"codeVoice"},{"text":" returns a copy of the wrapped iterator, so a","type":"text"},{"text":" ","type":"text"},{"text":"value-type iterator starts over from where it was wrapped, and a reference-type one, such as a subject’s,","type":"text"},{"text":" ","type":"text"},{"text":"shares its elements among every iteration.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/afluent\/asyncsequences\/asynciteratorsequence"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"A single-pass async sequence over an iterator you already made: the async counterpart of the standard","type":"text"},{"text":" ","type":"text"},{"text":"library’s ","type":"text"},{"type":"codeVoice","code":"IteratorSequence"},{"text":".","type":"text"}],"kind":"symbol","identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Structures","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncIterator"],"title":"Structures","generated":true},{"anchor":"Initializers","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/init(_:)"],"title":"Initializers","generated":true},{"anchor":"Instance-Methods","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/makeAsyncIterator()"],"title":"Instance Methods","generated":true},{"anchor":"Type-Aliases","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/Element"],"title":"Type Aliases","generated":true},{"anchor":"Default-Implementations","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncSequence-Implementations","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncSequence-Implementations"],"title":"Default Implementations","generated":true}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences"]]},"metadata":{"role":"symbol","symbolKind":"struct","remoteSource":{"fileName":"AsyncIteratorSequence.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SequenceOperators\/AsyncIteratorSequence.swift#L40"},"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncIteratorSequence","kind":"identifier"}],"externalID":"s:7Afluent14AsyncSequencesO0B16IteratorSequenceV","roleHeading":"Structure","title":"AsyncSequences.AsyncIteratorSequence","modules":[{"name":"Afluent"}],"extendedModule":"Afluent","navigatorTitle":[{"text":"AsyncIteratorSequence","kind":"identifier"}]},"references":{"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence/makeAsyncIterator()":{"url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence\/makeasynciterator()","role":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/makeAsyncIterator()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"makeAsyncIterator","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"AsyncIteratorSequence","preciseIdentifier":"s:7Afluent14AsyncSequencesO0B16IteratorSequenceV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"AsyncIterator","preciseIdentifier":"s:7Afluent14AsyncSequencesO0B16IteratorSequenceV0bD0V","kind":"typeIdentifier"}],"title":"makeAsyncIterator()","abstract":[],"kind":"symbol"},"doc://Afluent/Sci":{"identifier":"doc:\/\/Afluent\/Sci","type":"unresolvable","title":"_Concurrency.AsyncSequence"},"doc://Afluent/documentation/Afluent/PassthroughSubject":{"url":"\/documentation\/afluent\/passthroughsubject","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","title":"PassthroughSubject","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PassthroughSubject","kind":"identifier"}],"abstract":[{"text":"A subject that broadcasts values to multiple consumers without storing a current value.","type":"text"},{"text":" ","type":"text"},{"text":"Unlike ","type":"text"},{"code":"CurrentValueSubject","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PassthroughSubject","type":"codeVoice"},{"text":" does not retain the most recent value.","type":"text"},{"text":" ","type":"text"},{"text":"This is an ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s PassthroughSubject.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"PassthroughSubject","kind":"identifier"}],"type":"topic","kind":"symbol"},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence":{"navigatorTitle":[{"text":"AsyncIteratorSequence","kind":"identifier"}],"url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence","title":"AsyncSequences.AsyncIteratorSequence","abstract":[{"type":"text","text":"A single-pass async sequence over an iterator you already made: the async counterpart of the standard"},{"type":"text","text":" "},{"type":"text","text":"library’s "},{"type":"codeVoice","code":"IteratorSequence"},{"type":"text","text":"."}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncIteratorSequence","kind":"identifier"}]},"doc://Afluent/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/Afluent\/s8SendableP"},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence/Element":{"kind":"symbol","role":"symbol","url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence\/element","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/Element","title":"AsyncSequences.AsyncIteratorSequence.Element","type":"topic","abstract":[],"navigatorTitle":[{"kind":"identifier","text":"Element"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Element"}]},"doc://Afluent/documentation/Afluent/AsyncSequences":{"type":"topic","title":"AsyncSequences","kind":"symbol","url":"\/documentation\/afluent\/asyncsequences","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncSequences"}],"abstract":[{"ty