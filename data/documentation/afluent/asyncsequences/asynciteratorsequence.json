{"abstract":[{"text":"A single-pass async sequence over an iterator you already made: the async counterpart of the standard","type":"text"},{"text":" ","type":"text"},{"text":"library’s ","type":"text"},{"type":"codeVoice","code":"IteratorSequence"},{"text":".","type":"text"}],"sections":[],"topicSections":[{"generated":true,"title":"Structures","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncIterator"],"anchor":"Structures"},{"generated":true,"title":"Initializers","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/init(_:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/makeAsyncIterator()"],"anchor":"Instance-Methods"},{"generated":true,"title":"Type Aliases","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/Element"],"anchor":"Type-Aliases"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncSequence-Implementations","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncSequence-Implementations"],"anchor":"Default-Implementations"}],"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences"]]},"metadata":{"roleHeading":"Structure","externalID":"s:7Afluent14AsyncSequencesO0B16IteratorSequenceV","navigatorTitle":[{"text":"AsyncIteratorSequence","kind":"identifier"}],"modules":[{"name":"Afluent"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncIteratorSequence","kind":"identifier"}],"title":"AsyncSequences.AsyncIteratorSequence","extendedModule":"Afluent","symbolKind":"struct","remoteSource":{"fileName":"AsyncIteratorSequence.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SequenceOperators\/AsyncIteratorSequence.swift#L40"},"role":"symbol"},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP","doc:\/\/Afluent\/Sci"],"type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncIteratorSequence","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:ScI","text":"AsyncIteratorProtocol","kind":"typeIdentifier"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Use it to subscribe to a subject before the code that consumes the subject runs. A ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"drops values sent while nobody is subscribed, and an operator such as ","type":"text"},{"type":"codeVoice","code":"batch(strategy:)"},{"text":" subscribes only when","type":"text"},{"text":" ","type":"text"},{"text":"its consumer’s task starts iterating, so values sent in between are lost. Making the subject’s iterator first","type":"text"},{"text":" ","type":"text"},{"text":"subscribes at once; wrapping it in an ","type":"text"},{"type":"codeVoice","code":"AsyncIteratorSequence"},{"text":" hands that subscription to any operator.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Example","anchor":"Example","type":"heading"},{"code":["let events = PassthroughSubject<String>()","\/\/ Subscribes now: every value sent from here on is buffered for the batches below.","let batches = AsyncIteratorSequence(events.makeAsyncIterator())","    .batch(strategy: .count(2))","events.send(\"launch\")","events.send(\"login\")","events.send(completion: .finished)","","let consumer = Task {","    for try await batch in batches {","        print(batch) \/\/ Prints: [\"launch\", \"login\"]","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The subscription belongs to the wrapped iterator. A subject’s iterator subscribes when it is made and buffers","type":"text"},{"text":" ","type":"text"},{"text":"every value sent after that until it is read, without limit. It unsubscribes when the last copy of the","type":"text"},{"text":" ","type":"text"},{"text":"iterator is released, whether or not it was ever iterated, and when a task waiting in its ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"cancelled; values sent after either are not delivered to it. To read the subject again, make a new iterator.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The sequence is single-pass. Each ","type":"text"},{"code":"makeAsyncIterator()","type":"codeVoice"},{"text":" returns a copy of the wrapped iterator, so a","type":"text"},{"text":" ","type":"text"},{"text":"value-type iterator starts over from where it was wrapped, and a reference-type one, such as a subject’s,","type":"text"},{"text":" ","type":"text"},{"text":"shares its elements among every iteration.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/afluent\/asyncsequences\/asynciteratorsequence"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Afluent/Sci":{"type":"unresolvable","identifier":"doc:\/\/Afluent\/Sci","title":"_Concurrency.AsyncSequence"},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AsyncIteratorSequence"}],"type":"topic","url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence","title":"AsyncSequences.AsyncIteratorSequence","role":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence","abstract":[{"text":"A single-pass async sequence over an iterator you already made: the async counterpart of the standard","type":"text"},{"text":" ","type":"text"},{"text":"library’s ","type":"text"},{"code":"IteratorSequence","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncIteratorSequence"}]},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence/AsyncSequence-Implementations":{"abstract":[],"title":"AsyncSequence Implementations","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncSequence-Implementations","type":"topic","role":"collectionGroup","url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence\/asyncsequence-implementations","kind":"article"},"doc://Afluent/documentation/Afluent/AsyncSequences":{"navigatorTitle":[{"kind":"identifier","text":"AsyncSequences"}],"abstract":[{"type":"text","text":"A namespace for grouping related AsyncSequence operations."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncSequences"}],"type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","title":"AsyncSequences","url":"\/documentation\/afluent\/asyncsequences"},"doc://Afluent/documentation/Afluent":{"title":"Afluent","kind":"symbol","type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent","url":"\/documentation\/afluent","role":"collection","abstract":[]},"doc://Afluent/documentation/Afluent/PassthroughSubject":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PassthroughSubject"}],"abstract":[{"type":"text","text":"A subject that broadcasts values to multiple consumers without storing a current value."},{"type":"text","text":" "},{"type":"text","text":"Unlike "},{"type":"codeVoice","code":"CurrentValueSubject"},{"type":"text","text":", "},{"type":"codeVoice","code":"PassthroughSubject"},{"type":"text","text":" does not retain the most recent value."},{"type":"text","text":" "},{"type":"text","text":"This is an "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s PassthroughSubject."}],"url":"\/documentation\/afluent\/passthroughsubject","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"PassthroughSubject"}],"title":"PassthroughSubject","role":"symbol","type":"topic"},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence/Element":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/Element","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"identifier"}],"abstract":[],"url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence\/element","kind":"symbol","navigatorTitle":[{"text":"Element","kind":"identifier"}],"title":"AsyncSequences.AsyncIteratorSequence.Element","role":"symbol","type":"topic"},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence/init(_:)":{"type":"topic","url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence\/init(_:)","abstract":[{"type":"text","text":"Creates a sequence over "},{"type":"codeVoice","code":"base"},{"type":"text","text":"."}],"title":"init(_:)","kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/init(_:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol"},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence/AsyncIterator":{"abstract":[],"kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncIterator","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncIterator","url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence\/asynciterator","title":"AsyncSequences.AsyncIteratorSequence.AsyncIterator","navigatorTitle":[{"text":"AsyncIterator","kind":"identifier"}]},"doc://Afluent/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/Afluent\/s8SendableP","title":"Swift.Sendable"},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence/makeAsyncIterator()":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/makeAsyncIterator()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"makeAsyncIterator","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"AsyncIteratorSequence","preciseIdentifier":"s:7Afluent14AsyncSequencesO0B16IteratorSequenceV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"text":"AsyncIterator","preciseIdentifier":"s:7Afluent14AsyncSequencesO0B16IteratorSequenceV0bD0V","kind":"typeIdentifier"}],"title":"makeAsyncIterator()","url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence\/makeasynciterator()","abstract":[],"type":"topic","role":"symb