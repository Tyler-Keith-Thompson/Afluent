{"sections":[],"topicSections":[{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncIterator"],"generated":true,"anchor":"Structures","title":"Structures"},{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/init(_:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/makeAsyncIterator()"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"},{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/Element"],"generated":true,"anchor":"Type-Aliases","title":"Type Aliases"},{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncSequence-Implementations","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncSequence-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP","doc:\/\/Afluent\/Sci"],"title":"Conforms To"}],"abstract":[{"text":"A single-pass async sequence over an iterator you already made: the async counterpart of the standard","type":"text"},{"text":" ","type":"text"},{"text":"library’s ","type":"text"},{"code":"IteratorSequence","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncIteratorSequence","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Base","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AsyncIteratorProtocol","kind":"typeIdentifier","preciseIdentifier":"s:ScI"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use it to subscribe to a subject before the code that consumes the subject runs. A "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","isActive":true},{"type":"text","text":" "},{"type":"text","text":"drops values sent while nobody is subscribed, and an operator such as "},{"type":"codeVoice","code":"batch(strategy:)"},{"type":"text","text":" subscribes only when"},{"type":"text","text":" "},{"type":"text","text":"its consumer’s task starts iterating, so values sent in between are lost. Making the subject’s iterator first"},{"type":"text","text":" "},{"type":"text","text":"subscribes at once; wrapping it in an "},{"type":"codeVoice","code":"AsyncIteratorSequence"},{"type":"text","text":" hands that subscription to any operator."}]},{"type":"heading","level":2,"text":"Example","anchor":"Example"},{"type":"codeListing","syntax":"swift","code":["let events = PassthroughSubject<String>()","\/\/ Subscribes now: every value sent from here on is buffered for the batches below.","let batches = AsyncIteratorSequence(events.makeAsyncIterator())","    .batch(strategy: .count(2))","events.send(\"launch\")","events.send(\"login\")","events.send(completion: .finished)","","let consumer = Task {","    for try await batch in batches {","        print(batch) \/\/ Prints: [\"launch\", \"login\"]","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The subscription belongs to the wrapped iterator. A subject’s iterator subscribes when it is made and buffers"},{"type":"text","text":" "},{"type":"text","text":"every value sent after that until it is read, without limit. It unsubscribes when the last copy of the"},{"type":"text","text":" "},{"type":"text","text":"iterator is released, whether or not it was ever iterated, and when a task waiting in its "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"cancelled; values sent after either are not delivered to it. To read the subject again, make a new iterator."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sequence is single-pass. Each "},{"type":"codeVoice","code":"makeAsyncIterator()"},{"type":"text","text":" returns a copy of the wrapped iterator, so a"},{"type":"text","text":" "},{"type":"text","text":"value-type iterator starts over from where it was wrapped, and a reference-type one, such as a subject’s,"},{"type":"text","text":" "},{"type":"text","text":"shares its elements among every iteration."}]}]}],"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence","interfaceLanguage":"swift"},"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncIteratorSequence"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SequenceOperators\/AsyncIteratorSequence.swift#L40","fileName":"AsyncIteratorSequence.swift"},"modules":[{"name":"Afluent"}],"extendedModule":"Afluent","title":"AsyncSequences.AsyncIteratorSequence","symbolKind":"struct","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AsyncIteratorSequence"}],"externalID":"s:7Afluent14AsyncSequencesO0B16IteratorSequenceV","roleHeading":"Structure"},"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences"]]},"variants":[{"paths":["\/documentation\/afluent\/asyncsequences\/asynciteratorsequence"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Afluent/documentation/Afluent":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent","abstract":[],"role":"collection","type":"topic","url":"\/documentation\/afluent","title":"Afluent","kind":"symbol"},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence":{"navigatorTitle":[{"text":"AsyncIteratorSequence","kind":"identifier"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence","title":"AsyncSequences.AsyncIteratorSequence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncIteratorSequence","kind":"identifier"}],"type":"topic","url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence","kind":"symbol","abstract":[{"text":"A single-pass async sequence over an iterator you already made: the async counterpart of the standard","type":"text"},{"text":" ","type":"text"},{"text":"library’s ","type":"text"},{"code":"IteratorSequence","type":"codeVoice"},{"text":".","type":"text"}],"role":"symbol"},"doc://Afluent/Sci":{"type":"unresolvable","title":"_Concurrency.AsyncSequence","identifier":"doc:\/\/Afluent\/Sci"},"doc://Afluent/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/Afluent\/s8SendableP"},"doc://Afluent/documentation/Afluent/PassthroughSubject":{"title":"PassthroughSubject","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","type":"topic","role":"symbol","url":"\/documentation\/afluent\/passthroughsubject","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PassthroughSubject","kind":"identifier"}],"abstract":[{"text":"A subject that broadcasts values to multiple consumers without storing a current value.","type":"text"},{"text":" ","type":"text"},{"text":"Unlike ","type":"text"},{"code":"CurrentValueSubject","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PassthroughSubject","type":"codeVoice"},{"text":" does not retain the most recent value.","type":"text"},{"text":" ","type":"text"},{"text":"This is an ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s PassthroughSubject.","type":"text"}],"navigatorTitle":[{"text":"PassthroughSubject","kind":"identifier"}]},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence/AsyncIterator":{"kind":"symbol","abstract":[],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncIterator","kind":"identifier"}],"title":"AsyncSequences.AsyncIteratorSequence.AsyncIterator","type":"topic","role":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncIterator","url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence\/asynciterator","navigatorTitle":[{"text":"AsyncIterator","kind":"identifier"}]},"doc://Afluent/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/Afluent\/s16SendableMetatypeP"},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence/init(_:)":{"kind":"symbol","abstract":[{"type":"text","text":"Creates a sequence over "},{"code":"base","type":"codeVoice"},{"type":"text","text":"."}],"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":")","kind":"text"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/init(_:)","url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence\/init(_:)","role":"symbol","title":"init(_:)","type":"topic"},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence/makeAsyncIterator()":{"kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/makeAsyncIterator()","title":"makeAsyncIterator()","abstract":[],"url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence\/makeasynciterator()","role":"symbol","fragments":[{"kind":"keyword"