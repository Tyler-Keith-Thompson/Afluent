/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncIterator"},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence/AsyncSequence-Implementations":{"url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence\/asyncsequence-implementations","kind":"article","abstract":[],"type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncSequence-Implementations","role":"collectionGroup","title":"AsyncSequence Implementations"},"doc://Afluent/documentation/Afluent":{"title":"Afluent","type":"topic","abstract":[],"identifier":"doc:\/\/Afluent\/documentation\/Afluent","role":"collection","kind":"symbol","url":"\/documentation\/afluent"},"doc://Afluent/documentation/Afluent/AsyncSequences":{"navigatorTitle":[{"text":"AsyncSequences","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncSequences","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A namespace for grouping related AsyncSequence operations.","type":"text"}],"url":"\/documentation\/afluent\/asyncsequences","title":"AsyncSequences","type":"topic","role":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences"},"doc://Afluent/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/Afluent\/s8SendableP"},"doc://Afluent/documentation/Afluent/PassthroughSubject":{"type":"topic","title":"PassthroughSubject","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PassthroughSubject"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","navigatorTitle":[{"kind":"identifier","text":"PassthroughSubject"}],"abstract":[{"type":"text","text":"A subject that broadcasts values to multiple consumers without storing a current value."},{"type":"text","text":" "},{"type":"text","text":"Unlike "},{"type":"codeVoice","code":"CurrentValueSubject"},{"type":"text","text":", "},{"type":"codeVoice","code":"PassthroughSubject"},{"type":"text","text":" does not retain the most recent value."},{"type":"text","text":" "},{"type":"text","text":"This is an "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s PassthroughSubject."}],"kind":"symbol","url":"\/documentation\/afluent\/passthroughsubject","role":"symbol"},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence/init(_:)":{"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence\/init(_:)","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence\/init(_:)","kind":"symbol","title":"init(_:)","abstract":[{"type":"text","text":"Creates a sequence over "},{"type":"codeVoice","code":"base"},{"type":"text","text":"."}],"role":"symbol"},"doc://Afluent/Sci":{"type":"unresolvable","identifier":"doc:\/\/Afluent\/Sci","title":"_Concurrency.AsyncSequence"},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/AsyncIteratorSequence","navigatorTitle":[{"text":"AsyncIteratorSequence","kind":"identifier"}],"title":"AsyncSequences.AsyncIteratorSequence","role":"symbol","abstract":[{"type":"text","text":"A single-pass async sequence over an iterator you already made: the async counterpart of the standard"},{"type":"text","text":" "},{"type":"text","text":"library’s "},{"type":"codeVoice","code":"IteratorSequence"},{"type":"text","text":"."}],"type":"topic","kind":"symbol","url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncIteratorSequence","kind":"identifier