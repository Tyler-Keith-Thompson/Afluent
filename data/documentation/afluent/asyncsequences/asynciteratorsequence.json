fluent\/AsyncSequences\/AsyncIteratorSequence\/AsyncIterator","abstract":[],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AsyncIterator"}],"title":"AsyncSequences.AsyncIteratorSequence.AsyncIterator","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncIterator"}]},"doc://Afluent/documentation/Afluent/PassthroughSubject":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PassthroughSubject","kind":"identifier"}],"url":"\/documentation\/afluent\/passthroughsubject","title":"PassthroughSubject","navigatorTitle":[{"text":"PassthroughSubject","kind":"identifier"}],"abstract":[{"text":"A subject that broadcasts values to multiple consumers without storing a current value.","type":"text"},{"text":" ","type":"text"},{"text":"Unlike ","type":"text"},{"code":"CurrentValueSubject","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PassthroughSubject","type":"codeVoice"},{"text":" does not retain the most recent value.","type":"text"},{"text":" ","type":"text"},{"text":"This is an ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s PassthroughSubject.","type":"text"}],"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject"},"doc://Afluent/s8SendableP":{"identifier":"doc:\/\/Afluent\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://Afluent/documentation/Afluent/AsyncSequences/AsyncIteratorSequence/init(_:)":{"abstract":[{"text":"Creates a sequence over ","type":"text"},{"code":"base","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","title":"init(_:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Base","kind":"typeIdentifier"},{"text":")","kind":"text"}],"url":"\/documentation\/afluent\/asyncsequences\/asynciteratorsequ