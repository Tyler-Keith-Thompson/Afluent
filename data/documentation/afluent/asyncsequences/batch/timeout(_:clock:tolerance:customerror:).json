rd","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"timeout"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"duration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":"."},{"preciseIdentifier":"s:12_Concurrency5ClockP8DurationQa","kind":"typeIdentifier","text":"Duration"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":"."},{"preciseIdentifier":"s:12_Concurrency5ClockP8DurationQa","kind":"typeIdentifier","text":"Duration"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"customError"},{"kind":"text","text":": (any "},{"preciseIdentifier":"s:s5ErrorP","kind":"typeIdentifier","text":"Error"},{"kind":"text","text":")? = nil) -> "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO","kind":"typeIdentifier","text":"AsyncSequences"},{"kind":"text","text":"."},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Timeout","preciseIdentifier":"s:7Afluent14AsyncSequencesO7TimeoutV","kind":"typeIdentifier","text":"Timeout"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:12_Concurrency5ClockP","kind":"typeIdentifier","text":"Clock"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The longest the sequence may go without an element."}]}],"name":"duration"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The clock that measures the gaps."}]}],"name":"clock"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The tolerance of the timer’s sleeps. Defaults to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}],"name":"tolerance"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The error to throw when the timer fires. Defaults to"},{"type":"text","text":" "},{"type":"codeVoice","code":"TimeoutError.timedOut(duration:)"},{"type":"text","text":"."}]}],"name":"customError"}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"A sequence of the same elements that throws if the upstream goes quiet.","type":"text"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The timer starts when iteration begins and restarts with every element, so it bounds the"},{"type":"text","text":" "},{"type":"text","text":"wait for the first element and each gap after it, never the sequence as a whole. Elements"},{"type":"text","text":" "},{"type":"text","text":"pass through unchanged. When the timer fires, the upstream is cancelled and the sequence"},{"type":"text","text":" "},{"type":"text","text":"throws, without waiting for the upstream to respond to the cancellation."}]},{"type":"paragraph","inlineContent":[{"text":"The upstream is read ahead of the consumer, and elements it produces while the consumer is","type":"text"},{"text":" ","type":"text"},{"text":"busy are buffered, so the timer measures the upstream’s gaps. A duration of zero or less","type":"text"},{"text":" ","type":"text"},{"text":"throws before the first element.","type":"text"}]},{"type":"heading","anchor":"Example","level":2,"text":"Example"},{"syntax":"swift","type":"codeListing","code":["let clock = ContinuousClock()","for try await line in bytes.lines.timeout(.seconds(30), clock: clock) {","    handle(line)","}"]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"TimeoutError"},{"type":"text","text":" (or "},{"type":"codeVoice","code":"customError"},{"type":"text","text":") when "},{"type":"codeVoice","code":"duration"},{"type":"text","text":" passes between elements, and"},{"type":"text","text":" "},{"type":"text","text":"any error the upstream throws."}]}],"type":"aside","name":"Throws","style":"note"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"On WASI, a sleep on a real clock ("},{"type":"codeVoice","code":"ContinuousClock"},{"type":"text","text":", "},{"type":"codeVoice","code":"SuspendingClock"},{"type":"text","text":") holds the one thread"},{"type":"text","text":" "},{"type":"text","text":"until its deadline, even when other work is ready, and cancelling it doesn’t end it sooner. So the"},{"type":"text","text":" "},{"type":"text","text":"timer can hold the thread before the upstream runs, then count that wait against it and throw even"},{"type":"text","text":" "},{"type":"text","text":"though elements were ready. A test clock is unaffected."}]}],"type":"aside","name":"Note","style":"note"}]}],"references":{"doc://Afluent/documentation/Afluent":{"kind":"symbol","role":"collection","abstract":[],"url":"\/documentation\/afluent","type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent","title":"Afluent"},"doc://Afluent/documentation/Afluent/_Concurrency/AsyncSequence/batch(strategy:)":{"title":"batch(strategy:)","abstract":[{"text":"Gathers elements into arrays and emits each array when the strategy says to flush.","type":"text"}],"url":"\/documentation\/afluent\/_concurrency\/asyncsequence\/batch(strategy:)","role":"symbol","type":"topic","fragments":[{"kind":"k