[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" that emits the same elements as the upstream but retries on failure using the given strategy,"},{"type":"text","text":" "},{"type":"text","text":"performing the transformation before each retry."}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The provided transformation closure is executed "},{"inlineContent":[{"type":"text","text":"before"}],"type":"emphasis"},{"type":"text","text":" each retry, allowing for side effects such as refreshing tokens or resetting state."},{"type":"text","text":" "},{"type":"text","text":"The closure’s returned "},{"code":"AsyncSequence","type":"codeVoice"},{"type":"text","text":" is always fully consumed before the retry occurs, but its elements are ignored."},{"type":"text","text":" "},{"type":"text","text":"The element type of the returned sequence does not need to match the upstream’s element type."}]},{"type":"paragraph","inlineContent":[{"text":"This is useful for performing asynchronous side effects like credential refresh before retrying the main sequence.","type":"text"}]},{"level":2,"anchor":"Example-Refreshing-an-access-token-on-a-401-HTTP-error-before-retrying-the-main-request","type":"heading","text":"Example: Refreshing an access token on a 401 HTTP error before retrying the main request"},{"code":["let mainRequest = URLSession.shared.dataTaskAsyncSequence(for: URLRequest(url: URL(string: \"https:\/\/api.example.com\/data\")!))","","let retriedSequence = mainRequest.retry(.byCount(3)) { error in","    \/\/ If error is 401 Unauthorized, refresh token before retrying","    DeferredTask {","        if let urlError = error as? URLError, urlError.code == .userAuthenticationRequired {","            try await refreshAccessToken()","        }","    }","    .toAsyncSequence() \/\/ This sequence is fully consumed before retrying, ignoring its elements","}"],"type":"codeListing","syntax":"swift"}]}],"variants":[{"paths":["\/documentation\/afluent\/asyncsequences\/catch\/retry(_:_:)-4qvns"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","abstract":[{"text":"Retries the upstream ","type":"text"},{"type":"codeVoice","code":"AsyncSequence"},{"text":" using the provided retry strategy.","type":"text"}],"references":{"doc://Afluent/documentation/Afluent/AsyncSequences":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncSequences","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/afluent\/asyncsequences","abstract":[{"text":"A namespace for grouping related AsyncSequence operations.","type":"text"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","role":"symbol","navigatorTitle":[{"text":"AsyncSequences","kind":"identifier"}],"title":"AsyncSequences"},"doc://Afluent/documentation/Afluent/AsyncSequences/Catch":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Catch","url":"\/documentation\/afluent\/asyncsequences\/catch","abstract":[{"type":"text","text":"Used as the implementation detail for the catch\/tryCatch sequence operators."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Catch"}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Catch"}],"title":"AsyncSequences.Catch"},"doc://Afluent/documentation/Afluent/AsyncSequences/Catch/retry(_:_:)-4qvns":{"abstract":[{"type":"text","text":"Retries the upstream "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" using the provided retry strategy."}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Catch\/retry(_:_:)-4qvns","url":"\/documentation\/afluent\/asyncsequences\/ca