ple"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example demonstrates accumulating a running sum over an asynchronous sequence of integers:"}]},{"code":["\/\/ An async sequence producing the numbers 1 through 5","let numbers = AsyncStream<Int> { continuation in","    for i in 1...5 {","        continuation.yield(i)","    }","    continuation.finish()","}","","\/\/ Use scan to accumulate a running sum","let runningSum = numbers.scan(0) { partialSum, nextNumber in","    return partialSum + nextNumber","}","","\/\/ Consume the running sums","Task {","    for try await sum in runningSum {","        print(sum) \/\/ Prints: 1, 3, 6, 10, 15","    }","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Decode\/scan(_:_:)","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"text":"Accumulates state over the elements of an asynchronous sequence, emitting each intermediate accumulated value.","type":"text"}],"references":{"doc://Afluent/documentation/Afluent/AsyncSequences/Decode":{"navigatorTitle":[{"text":"Decode","kind":"identifier"}],"type":"topic","kind":"symbol","title":"AsyncSequences.Decode","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Decode","kind":"identifier"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Decode","role":"symbol","url":"\/documentation\/afluent\/asyncsequences\/decode","abstract":[{"text":"Used as the implementation detail for the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/decode(type:decoder:)","type":"reference"},{"text":" operator.","type":"text"}]},"doc://Afluent/documentation/Afluent/AsyncSequences/Decode/scan(_:_:)":{"kind":"symbol","url":"\/documentation\/afluent\/asyncsequences\/decode\/scan(_:_:)","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequence