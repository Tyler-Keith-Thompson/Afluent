haredSequence {","        print(\"First consumer received \\(value)\")","    }","    \/\/ prints the values the shared sequence reads after this consumer subscribed","}","","async let secondConsumer = Task {","    for await value in sharedSequence {","        print(\"Second consumer received \\(value)\")","    }","    \/\/ prints the values the shared sequence reads after this consumer subscribed","}","","\/\/ A consumer that subscribes after the shared sequence has handed out values misses them.","await firstConsumer.value","await secondConsumer.value"]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Decode\/share()"},"kind":"symbol","references":{"doc://Afluent/documentation/Afluent/AsyncBroadcastSequence":{"type":"topic","title":"AsyncBroadcastSequence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncBroadcastSequence","kind":"identifier"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncBroadcastSequence","kind":"symbol","url":"\/documentation\/afluent\/asyncbroadcastsequence","abstract":[{"type":"text","text":"An async sequence that multicasts elements from an upstream sequence to multiple concurrent consumers."}],"role":"symbol","navigatorTitle":[{"text":"AsyncBroadcastSequence","kind":"identifier"}]},"doc://Afluent/documentation/Afluent/AsyncSequences/Decode":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Decode","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Decode"}],"type":"topic","title":"AsyncSequences.Decode","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Decode"}],"url":"\/documentation\/afluent\/asyncsequences\/decode","abstract":[{"type":"text","text":"Used as the implementation detail for the "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/decode(type:decoder:)","isA