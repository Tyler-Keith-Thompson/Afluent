":"heading","text":"Example"},{"syntax":"swift","code":["let clock = ContinuousClock()","for try await line in bytes.lines.timeout(.seconds(30), clock: clock) {","    handle(line)","}"],"type":"codeListing"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"TimeoutError"},{"type":"text","text":" (or "},{"type":"codeVoice","code":"customError"},{"type":"text","text":") when "},{"type":"codeVoice","code":"duration"},{"type":"text","text":" passes between elements, and"},{"type":"text","text":" "},{"type":"text","text":"any error the upstream throws."}]}],"type":"aside","name":"Throws"}],"kind":"content"}],"references":{"doc://Afluent/documentation/Afluent/AsyncSequences/Decode/timeout(_:clock:tolerance:customError:)":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Decode\/timeout(_:clock:tolerance:customError:)","abstract":[{"type":"text","text":"Fails if the sequence goes the given duration without producing an element, measured on"},{"type":"text","text":" "},{"type":"text","text":"the given clock."}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timeout","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP8DurationQa"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP8DurationQa"},{"text":"?, ","kind":"text"},{"text":"customError","kind":"externalParam"},{"text":": (any ","kind":"text"