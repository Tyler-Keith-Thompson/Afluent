type":"paragraph"},{"inlineContent":[{"text":"This is useful for computing running totals, aggregating state, or applying stateful transformations over time.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Example","anchor":"Example"},{"inlineContent":[{"type":"text","text":"The following example demonstrates accumulating a running sum over an asynchronous sequence of integers:"}],"type":"paragraph"},{"code":["\/\/ An async sequence producing the numbers 1 through 5","let numbers = AsyncStream<Int> { continuation in","    for i in 1...5 {","        continuation.yield(i)","    }","    continuation.finish()","}","","\/\/ Use scan to accumulate a running sum","let runningSum = numbers.scan(0) { partialSum, nextNumber in","    return partialSum + nextNumber","}","","\/\/ Consume the running sums","Task {","    for try await sum in runningSum {","        print(sum) \/\/ Prints: 1, 3, 6, 10, 15","    }","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://Afluent/documentation/Afluent/AsyncSequences/Delay":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Delay","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Delay","kind":"identifier"}],"abstract":[{"type":"text","text":"Used as the implementation detail for the "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/delay(for:tolerance:)","isActive":true},{"type":"text","text":" operator."}],"url":"\/documentation\/afluent\/asyncsequences\/delay","navigatorTitle":[{"text":"Delay","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic","title":"AsyncSequences.Delay"},"doc://Afluent/documentation/Afluent/AsyncSequences/Scan":{"abstract":[],"title":"AsyncSequences.Scan","type":"topic","navigatorTitle":[{"text":"Scan","kind":"identifier"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSe