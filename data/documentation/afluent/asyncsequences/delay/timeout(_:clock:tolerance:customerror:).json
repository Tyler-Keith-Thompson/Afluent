,"    handle(line)","}"]},{"type":"aside","name":"Throws","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"TimeoutError","type":"codeVoice"},{"type":"text","text":" (or "},{"code":"customError","type":"codeVoice"},{"type":"text","text":") when "},{"code":"duration","type":"codeVoice"},{"type":"text","text":" passes between elements, and"},{"type":"text","text":" "},{"type":"text","text":"any error the upstream throws."}]}]}]}],"abstract":[{"type":"text","text":"Fails if the sequence goes the given duration without producing an element, measured on"},{"type":"text","text":" "},{"type":"text","text":"the given clock."}],"references":{"doc://Afluent/documentation/Afluent/AsyncSequences/Timeout":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Timeout"}],"kind":"symbol","title":"AsyncSequences.Timeout","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Timeout","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Timeout"}],"type":"topic","abstract":[{"type":"text","text":"Used as the implementation detail for the "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/timeout(_:clock:tolerance:customError:)","isActive":true},{"type":"text","text":" operator."}],"url":"\/documentation\/afluent\/asyncsequences\/timeout"},"doc://Afluent/documentation/Afluent/AsyncSequences/Delay":{"role":"symbol","abstract":[{"type":"text","text":"Used as the implementation detail for the "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/delay(for:tolerance:)","type":"reference","isActive":true},{"type":"text","text":" operator."}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Delay","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Delay"}],"title":"AsyncSeque