":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Strategy","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:7Afluent13BatchStrategyP","text":"BatchStrategy","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sci7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"text":"Strategy","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:7Afluent13BatchStrategyP7ElementQa","text":"Element","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/Element","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"strategy","content":[{"type":"paragraph","inlineContent":[{"text":"When to emit the gathered elements; its ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" is this","type":"text"},{"text":" ","type":"text"},{"text":"sequence’s, inferred from the call.","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"A sequence of the upstream’s elements, in order, in arrays of one or more."}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The strategy decides when the pending elements are flushed: every so many elements"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/count(_:)","isActive":true,"type":"reference"},{"type":"text","text":"), every interval"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/time(interval:clock:tolerance:)","isActive":true,"type":"reference"},{"type":"text","text":"), on a signal or a unit of work"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","isActive":true,"type":"reference"},{"type":"text","text":"), whenever any of several does"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/either(_:_:)","isActive":true,"type":"reference"},{"type":"text","text":"), or by a rule of your own ("},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","isActive":true,"type":"reference"},{"type":"text","text":"). After every"},{"type":"text","text":" "},{"type":"text","text":"flush, each strategy starts over. A flush with nothing pending emits nothing; the"},{"type":"text","text":" "},{"type":"text","text":"sequence never emits an empty array."}]},{"type":"paragraph","inlineContent":[{"text":"When the upstream finishes, the pending elements, if any, are emitted as a last array and","type":"text"},{"text":" ","type":"text"},{"text":"the sequence finishes. When the upstream throws, the pending elements are dropped and the","type":"text"},{"text":" ","type":"text"},{"text":"sequence throws the same error. A signal that finishes stops firing while the batches go","type":"text"},{"text":" ","type":"text"},{"text":"on; a signal that throws ends the sequence with its error.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The upstream and the strategy run in tasks of their own, started when iteration begins,"},{"type":"text","text":" "},{"type":"text","text":"so the upstream is read ahead of the consumer, and arrays the consumer hasn’t taken yet"},{"type":"text","text":" "},{"type":"text","text":"are buffered. Cancelling the consumer, or dropping its iterator, cancels both. An"},{"type":"text","text":" "},{"type":"text","text":"upstream or signal that ignores cancellation keeps the internal task alive until its"},{"type":"text","text":" "},{"type":"text","text":"pending "},{"code":"next()","type":"codeVoice"},{"type":"text","text":" returns, and is not read again after that; the batched sequence itself"},{"type":"text","text":" "},{"type":"text","text":"ends at once."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Batching needs iOS 16, Mac Catalyst 16, macOS 13, tvOS 16, watchOS 9 or visionOS 1."}]},{"level":2,"type":"heading","text":"Example","anchor":"Example"},{"syntax":"swift","type":"codeListing","code":["for try await batch in [1, 2, 3, 4].async.batch(strategy: .either(.count(3), .time(interval: .seconds(1), clock: ContinuousClock()))) {","    print(batch) \/\/ Prints [1, 2, 3], then [4]","}"]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Any error the upstream or the strategy throws.","type":"text"}]}],"name":"Throws","style":"note"}]}],"kind":"symbol","references":{"doc://Afluent/documentation/Afluent/AsyncSequences/Dematerialize/batch(strategy:)":{"abstract":[{"type":"text","text":"Gathers elements into arrays and emits each array when the strategy says to flush."}],"title":"batch(strategy:)","kind":"symbol","url":"\/documentation\/afluent\/asyncsequences\/dematerialize\/batch(strategy:)","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batch","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Strategy","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"strategy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Strategy","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO","text":"AsyncSequences","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO5BatchV","text":"Batch","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"t