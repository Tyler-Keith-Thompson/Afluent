invoked when the sequence completes, either normally with ","type":"text"},{"code":".finished","type":"codeVoice"},{"text":" ","type":"text"},{"text":"or with an error ","type":"text"},{"code":".failure","type":"codeVoice"},{"text":". Called exactly once.","type":"text"}],"type":"paragraph"}],"name":"receiveCompletion"},{"content":[{"inlineContent":[{"type":"text","text":"An optional async throwing closure invoked for each element produced by the sequence."},{"type":"text","text":" "},{"type":"text","text":"If this closure throws an error, the sequence is terminated and completion closure is called with "},{"type":"codeVoice","code":".failure"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"receiveOutput"}]},{"kind":"content","content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"AnyCancellable"},{"type":"text","text":" token that can be stored and used to cancel the ongoing subscription."}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"This method allows you to asynchronously receive each element emitted by the sequence and respond","type":"text"},{"text":" ","type":"text"},{"text":"to completion or failure. The stream runs until all elements are consumed, an error occurs,","type":"text"},{"text":" ","type":"text"},{"text":"or cancellation is triggered via the returned token.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Usage example:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let publisher: AsyncStream<Int> = AsyncStream { continuation in","    Task {","        for i in 1...5 {","            continuation.yield(i)","            try await Task.sleep(nanoseconds: 500_000_000)","        }","        continuation.finish()","    }","}","","let cancellable = publisher.sink(","    receiveCompletion: { completion in","        switch completion {","        case .finished:","            print(\"Stream completed successfully\")","        case .failure(let error):","            print(\"Stream failed with error: \\(error)\")","        }","    },","    receiveOutput: { value in","        print(\"Received value: \\(value)\")","    }",")","","\/\/ To cancel early:","\/\/ cancellable.cancel()"]}]}],"variants":[{"paths":["\/documentation\/afluent\/asyncsequences\/dematerialize\/sink(receivecompletion:receiveoutput:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Dematerialize\/sink(receiveCompletion:receiveOutput:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Dematerialize"]]},"metadata":{"symbolKind":"method","remoteSource":{"fileName":"AnyCancellable.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/Subscription\/AnyCancellable.swift#L161"},"extendedModule":"_Concurrency","modules":[{"relatedModules":["_Concurrency"],"name":"Afluent"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sink"},{"kind":"text","text":"("},{"kind":"externalParam","text":"receiveCompletion"},{"text":": ((","kind":"text"},{"text":"AsyncSequences","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO"},{"text":".","kind":"text"},{"text":"Completion","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO10CompletionO"},{"text":"<any ","kind":"text"},{"text":"Error","kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP"},{"text":">) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Void","kind":"typeIdentifier","preciseIdentifier":"s:s4Voida"},{"text":")?, ","kind":"text"},{"text":"