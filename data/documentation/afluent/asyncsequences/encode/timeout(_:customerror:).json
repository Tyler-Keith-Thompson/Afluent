{"metadata":{"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":"."}]},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timeout","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:s8DurationV","text":"Duration","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"customError","kind":"externalParam"},{"text":": (any ","kind":"text"},{"preciseIdentifier":"s:s5ErrorP","text":"Error","kind":"typeIdentifier"},{"text":")?) -> ","kind":"text"},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO","text":"AsyncSequences","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO7TimeoutV","text":"Timeout","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:12_Concurrency15SuspendingClockV","text":"SuspendingClock","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","modules":[{"name":"Afluent","relatedModules":["_Concurrency"]}],"externalID":"s:Sci7Afluents8SendableRzsAB7ElementRpzrlE7timeout_11customErrorAA14AsyncSequencesO7TimeoutVy_x12_Concurrency15SuspendingClockVGs8DurationV_s0F0_pSgtF::SYNTHESIZED::s:7Afluent14AsyncSequencesO6EncodeV","extendedModule":"_Concurrency","symbolKind":"method","title":"timeout(_:customError:)","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SequenceOperators\/TimeoutSequence.swift#L176","fileName":"TimeoutSequence.swift"},"platforms":[{"name":"iOS","unavailable":false,"introducedAt":"16.0","deprecated":false,"beta":false},{"name":"iPadOS","unavailable":false,"introducedAt":"16.0","deprecated":false,"beta":false},{"name":"Mac Catalyst","unavailable":false,"introducedAt":"16.0","deprecated":false,"beta":false},{"name":"macOS","unavailable":false,"introducedAt":"13.0","deprecated":false,"beta":false},{"name":"tvOS","unavailable":false,"introducedAt":"16.0","deprecated":false,"beta":false},{"name":"visionOS","unavailable":false,"introducedAt":"1.0","deprecated":false,"beta":false},{"name":"watchOS","unavailable":false,"introducedAt":"9.0","deprecated":false,"beta":false}],"roleHeading":"Instance Method"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"timeout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"duration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV","text":"Duration"},{"kind":"text","text":", "},{"kind":"externalParam","text":"customError"},{"kind":"text","text":": (any "},{"kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP","text":"Error"},{"kind":"text","text":")? = nil) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","text":"AsyncSequences"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO7TimeoutV","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Timeout","text":"Timeout"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency15SuspendingClockV","text":"SuspendingClock"},{"kind":"text","text":">"}]}],"kind":"declarations"},{"parameters":[{"name":"duration","content":[{"inlineContent":[{"type":"text","text":"The longest the sequence may go without an element."}],"type":"paragraph"}]},{"name":"customError","content":[{"type":"paragraph","inlineContent":[{"text":"The error to throw when the timer fires. Defaults to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"TimeoutError.timedOut(duration:)"},{"text":".","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"inlineContent":[{"text":"A sequence of the same elements that throws if the upstream goes quiet.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"The timer starts when iteration begins and restarts with every element, so it bounds the","type":"text"},{"text":" ","type":"text"},{"text":"wait for the first element and each gap after it, never the sequence as a whole. Elements","type":"text"},{"text":" ","type":"text"},{"text":"pass through unchanged. When the timer fires, the upstream is cancelled and the sequence","type":"text"},{"text":" ","type":"text"},{"text":"throws.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The upstream is read ahead of the consumer, and elements it produces while the consumer is"},{"type":"text","text":" "},{"type":"text","text":"busy are buffered, so the timer measures the upstream’s gaps. A duration of zero or less"},{"type":"text","text":" "},{"type":"text","text":"throws before the first element."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Example","anchor":"Example"},{"type":"codeListing","code":["for try await event in serverEvents.timeout(.seconds(30)) {","    handle(event)","}","\/\/ Throws TimeoutError.timedOut if 30 seconds pass without an event"],"syntax":"swift"},{"style":"note","type":"aside","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"TimeoutError"},{"type":"text","text":" (or "},{"type":"codeVoice","code":"customError"},{"type":"text","text":") when "},{"type":"codeVoice","code":"duration"},{"type":"text","text":" passes between elements, and"},{"type":"text","text":" "},{"type":"text","text":"any error the upstream throws."}]}]},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"On WASI, a sleep on a real clock (","type":"text"},{"code":"ContinuousClock","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SuspendingClock","type":"codeVoice"},{"text":") holds the one thread","type":"text"},{"text":" ","type":"text"},{"text":"until its deadline, even when other work is ready, and cancelling it doesn’t end it sooner. So the","type":"text"},{"text":" ","type":"text"},{"text":"timer can hold the thread before the upstream runs, then count that wait against it and throw even","type":"text"},{"text":" ","type":"text"},{"text":"though elements were ready. A test clock is unaffected.","type":"text"}]}]}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Encode"]]},"abstract":[{"type":"text","text":"Fails if the sequence goes the given duration without producing an element, measured on"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"SuspendingClock"},{"type":"text","text":"."}],"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Encode\/timeout(_:customError:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/afluent\/asyncsequences\/encode\/timeout(_:customerror:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Afluent/documentation/Afluent/_Concurrency/AsyncSequence/timeout(_:clock:tolerance:customError:)":{"fragments":[{"kind":"keyword",