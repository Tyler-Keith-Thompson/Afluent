","    }","}","","enum NetworkError: Error {","    case timeout","    case unknown","}","","let counter = CallCounter()","","let sequence = DeferredTask {","    let attempt = await counter.increment()","    if attempt < 2 {","        throw NetworkError.timeout","    }","    return 55","}",".toAsyncSequence()",".retry(3, on: NetworkError.self)","","for try await value in sequence {","    print(value) \/\/ prints 55 after retry on NetworkError.timeout","}"],"type":"codeListing","syntax":"swift"},{"content":[{"inlineContent":[{"text":"Not every ","type":"text"},{"type":"codeVoice","code":"AsyncSequence"},{"text":" can be retried, for this to work the sequence has to implement an iterator that doesn’t preserve state across various creations.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"important","name":"Important"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"AsyncStream","type":"codeVoice"},{"type":"text","text":" and "},{"code":"AsyncThrowingStream","type":"codeVoice"},{"type":"text","text":" are notable sequences which cannot be retried on their own."}]}],"type":"aside","style":"note","name":"Note"}]}],"sections":[],"variants":[{"paths":["\/documentation\/afluent\/asyncsequences\/flatmap\/retry(_:on:)-7unq1"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Afluent/documentation/Afluent/AsyncSequences/RetryOnCast":{"navigatorTitle":[{"kind":"identifier","text":"RetryOnCast"}],"role":"symbol","type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/RetryOnCast","kind":"symbol","abstract":[],"title":"AsyncSequences.RetryOnCast","url":"\/documentation\/afluent\/asyncsequences\/retryoncast","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"RetryOnCast"}]},"doc://Afluent/documentation/Afluent/AsyncSequences":{"role":"symbol","abstract":[{"text":"A namespace for grouping related AsyncSequence operations.","type":"text"}],