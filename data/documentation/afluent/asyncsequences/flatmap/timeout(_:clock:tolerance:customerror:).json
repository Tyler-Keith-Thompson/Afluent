,"kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Duration","preciseIdentifier":"s:12_Concurrency5ClockP8DurationQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Duration","preciseIdentifier":"s:12_Concurrency5ClockP8DurationQa"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"customError"},{"kind":"text","text":": (any "},{"kind":"typeIdentifier","text":"Error","preciseIdentifier":"s:s5ErrorP"},{"kind":"text","text":")? = nil) -> "},{"kind":"typeIdentifier","text":"AsyncSequences","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Timeout","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Timeout","preciseIdentifier":"s:7Afluent14AsyncSequencesO7TimeoutV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Clock","preciseIdentifier":"s:12_Concurrency5ClockP"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"duration","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The longest the sequence may go without an element."}]}]},{"name":"clock","content":[{"inlineContent":[{"text":"The clock that measures the gaps.","type":"text"}],"type":"paragraph"}]},{"name":"tolerance","content":[{"inlineContent":[{"text":"The tolerance of the timer’s sleeps. Defaults to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}],"type":"paragraph"}]},{"name":"customError","content":[{"type":"paragraph","inlineContent":[{"text":"The error to throw when the timer fires. Defaults to","type":"text"},{"text":" ","type":"text"},{"code":"TimeoutError.timedOut(duration:)","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A sequence of the same elements that throws if the upstream goes quiet."}]}],"kind":"content"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The timer starts when iteration begins and restarts with every element, so it bounds the","type":"text"},{"text":" ","type":"text"},{"text":"wait for the first element and each gap after it, never the sequence as a whole. Elements","type":"text"},{"text":" ","type":"text"},{"text":"pass through unchanged. When the timer fires, the upstream is cancelled and the sequence","type":"text"},{"text":" ","type":"text"},{"text":"throws, without waiting for the upstream to respond to the cancellation.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The upstream is read ahead of the consumer, and elements it produces while the consumer is","type":"text"},{"text":" ","type":"text"},{"text":"busy are buffered, so the timer measures the upstream’s gaps. A duration of zero or less","type":"text"},{"text":" ","type":"text"},{"text":"throws before the first element.","type":"text"}]},{"type":"heading","level":2,"text":"Example","anchor":"Example"},{"type":"codeListing","syntax":"swift","code":["let clock = ContinuousClock()","for try await line in bytes.lines.timeout(.seconds(30), clock: clock) {","    handle(line)","}"]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"TimeoutError"},{"type":"text","text":" (or "},{"type":"codeVoice","code":"customError"},{"type":"text","text":") when "},{"type":"codeVoice","code":"duration"},{"type":"text","text":" passes between elements, and"},{"type":"text","text":" "},{"type":"text","text":"any error the upstream throws."}]}],"type":"aside","name":"Throws","style":"note"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"On WASI, a sleep on a real clock ("},{"type":"codeVoice","code":"ContinuousClock"},{"type":"text","text":", "},{"type":"codeVoice","code":"SuspendingClock"},{"type":"text","text":") holds the one thread"},{"type":"text","text":" "},{"type":"text","text":"until its deadline, even when other work is ready, and cancelling it doesn’t end it sooner. So the"},{"type":"text","text":" "},{"type":"text","text":"timer can hold the thread before the upstream runs, then count that wait against it and throw even"},{"type":"text","text":" "},{"type":"text","text":"though elements were ready. A test clock is unaffected."}]}],"type":"aside","name":"Note","style":"note"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/asyncsequences\/flatmap\/timeout(_:clock:tolerance:customerror:)"]}],"abstract":[{"type":"text","text":"Fails if the sequence goes the given duration without producing an element, measured on"},{"type":"text","text":" "},{"type":"text","text":"the given clock."}],"references":{"doc://Afluent/documentation/Afluent/_Concurrency/AsyncSequence/flatMap(maxSubscriptions:_:)":{"type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/flatMap(maxSubscriptions:_:)","abstract":[{"text":"Merges the results of mapping each element to an ","type":"text"},{"type":"codeVoice","code":"AsyncSequence"},{"text":", with control over subscription demand.","type":"text"}],"title":"flatMap(maxSubscriptions:_:)","url":"\/documentation\/afluent\/_concurrency\/asyncsequence\/flatmap(maxsubscriptions:_:)","role":"symbol"