ew element from the upstream async sequence using the provided closure."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is useful for computing running totals, aggregating state, or applying stateful transformations over time."}]},{"type":"heading","level":2,"text":"Example","anchor":"Example"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The following example demonstrates accumulating a running sum over an asynchronous sequence of integers:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ An async sequence producing the numbers 1 through 5","let numbers = AsyncStream<Int> { continuation in","    for i in 1...5 {","        continuation.yield(i)","    }","    continuation.finish()","}","","\/\/ Use scan to accumulate a running sum","let runningSum = numbers.scan(0) { partialSum, nextNumber in","    return partialSum + nextNumber","}","","\/\/ Consume the running sums","Task {","    for try await sum in runningSum {","        print(sum) \/\/ Prints: 1, 3, 6, 10, 15","    }","}"]}]}],"kind":"symbol","references":{"doc://Afluent/documentation/Afluent/AsyncSequences/GroupBy":{"type":"topic","kind":"symbol","url":"\/documentation\/afluent\/asyncsequences\/groupby","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"GroupBy","kind":"identifier"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/GroupBy","abstract":[{"type":"text","text":"Used as the implementation detail for the "},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/groupBy(keySelector:)","type":"reference"},{"type":"text","text":" operator."}],"navigatorTitle":[{"text":"GroupBy","kind":"identifier"}],"title":"AsyncSequences.GroupBy","role":"symbol"},"doc://Afluent/documentation/Afluent/AsyncSequences/GroupBy/scan(_:_:)":{"role":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/GroupBy\/scan(_:_:)","kind":"symbol","type":"topic","ab