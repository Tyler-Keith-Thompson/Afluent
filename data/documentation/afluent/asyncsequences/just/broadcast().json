","role":"symbol","title":"AsyncSequences.Just","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Just"}],"navigatorTitle":[{"kind":"identifier","text":"Just"}],"url":"\/documentation\/afluent\/asyncsequences\/just"},"doc://Afluent/documentation/Afluent":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent","type":"topic","url":"\/documentation\/afluent","abstract":[],"title":"Afluent","kind":"symbol","role":"collection"}}}