"Linux"]}]},{"parameters":[{"name":"receiveCompletion","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional async closure invoked when the sequence completes, either normally with "},{"type":"codeVoice","code":".finished"},{"type":"text","text":" "},{"type":"text","text":"or with an error "},{"type":"codeVoice","code":".failure"},{"type":"text","text":". Called exactly once."}]}]},{"name":"receiveOutput","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An optional async throwing closure invoked for each element produced by the sequence."},{"type":"text","text":" "},{"type":"text","text":"If this closure throws an error, the sequence is terminated and completion closure is called with "},{"type":"codeVoice","code":".failure"},{"type":"text","text":"."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"return-value","text":"Return Value","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"AnyCancellable"},{"type":"text","text":" token that can be stored and used to cancel the ongoing subscription."}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"This method allows you to asynchronously receive each element emitted by the sequence and respond","type":"text"},{"text":" ","type":"text"},{"text":"to completion or failure. The stream runs until all elements are consumed, an error occurs,","type":"text"},{"text":" ","type":"text"},{"text":"or cancellation is triggered via the returned token.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Usage example:"}]},{"syntax":"swift","type":"codeListing","code":["let publisher: AsyncStream<Int> = AsyncStream { continuation in","    Task {","        for i in 1...5 {","            continuation.yield(i)","            try await Task.sleep(nanoseconds: 500_000_000)","        }","        continuation.finish()","    }","}","","let cancellable = publisher.sink(","    receiveCompletion: { completion in","        switch completion {","        case .finished:","            print(\"Stream completed successfully\")","        case .failure(let error):","            print(\"Stream failed with error: \\(error)\")","        }","    },","    receiveOutput: { value in","        print(\"Received value: \\(value)\")","    }",")","","\/\/ To cancel early:","\/\/ cancellable.cancel()"]}]}],"abstract":[{"type":"text","text":"Starts processing the elements of this async sequence, handling output and completion events,"},{"type":"text","text":" "},{"type":"text","text":"and returns an "},{"type":"codeVoice","code":"AnyCancellable"},{"type":"text","text":" token that can be used to cancel the subscription."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/asyncsequences\/just\/sink(receivecompletion:receiveoutput:)"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Just\/sink(receiveCompletion:receiveOutput:)","interfaceLanguage":"swift"},"metadata":{"externalID":"s:Sci7Afluents8SendableRzrlE4sink17receiveCompletion0D6OutputAA14AnyCancellableCyAA14AsyncSequencesO0E0Oy_s5Error_pGYaYbcSg_y7ElementQzYaYbKcSgtF::SYNTHESIZED::s:7Afluent14AsyncSequencesO4JustV","remoteSource":{"fileName":"AnyCancellable.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/Subscription\/AnyCancellable.swift#L161"},"modules":[{"relatedModules":["_Concurrency"],"name":"Afluent"}],"role":"symbol","roleHeading":"Instance Method","extendedModule":"_Concurrency","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sink","kind":"identifier"},{"text":"(","kind":"text"},{"text":"receiveCompletion","kind":"externalParam"},{"text":": ((","kind":"