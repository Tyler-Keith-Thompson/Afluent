text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timeout","kind":"identifier"},{"text":"<","kind":"text"},{"text":"C","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"duration","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP8DurationQa"},{"text":", ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"tolerance","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP8DurationQa"},{"text":"? = nil, ","kind":"text"},{"text":"customError","kind":"externalParam"},{"text":": (any ","kind":"text"},{"text":"Error","kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP"},{"text":")? = nil) -> ","kind":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","text":"AsyncSequences","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO"},{"text":".","kind":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Timeout","text":"Timeout","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO7TimeoutV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Clock","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"duration","content":[{"inlineContent":[{"text":"The longest the sequence may go without an element.","type":"text"}],"type":"paragraph"}]},{"name":"clock","content":[{"type":"paragraph","inlineContent":[{"text":"The clock that measures the gaps.","type":"text"}]}]},{"name":"tolerance","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The tolerance of the timer’s sleeps. Defaults to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]}]},{"name":"customError","content":[{"inlineContent":[{"type":"text","text":"The error to throw when the timer fires. Defaults to"},{"type":"text","text":" "},{"type":"codeVoice","code":"TimeoutError.timedOut(duration:)"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A sequence of the same elements that throws if the upstream goes quiet."}]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"The timer starts when iteration begins and restarts with every element, so it bounds the"},{"type":"text","text":" "},{"type":"text","text":"wait for the first element and each gap after it, never the sequence as a whole. Elements"},{"type":"text","text":" "},{"type":"text","text":"pass through unchanged. When the timer fires, the upstream is cancelled and the sequence"},{"type":"text","text":" "},{"type":"text","text":"throws, without waiting for the upstream to respond to the cancellation."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The upstream is read ahead of the consumer, and elements it produces while the consumer is"},{"type":"text","text":" "},{"type":"text","text":"busy are buffered, so the timer measures the upstream’s gaps. A duration of zero or less"},{"type":"text","text":" "},{"type":"text","text":"throws before the first element."}],"type":"paragraph"},{"anchor":"Example","level":2,"type":"heading","text":"Example"},{"code":["let clock = ContinuousClock()","for try await line in bytes.lines.timeout(.seconds(30), clock: clock) {","    handle(line)","}"],"syntax":"swift","type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"TimeoutError"},{"text":" (or ","type":"text"},{"type":"codeVoice","code":"customError"},{"text":") when ","type":"text"},{"type":"codeVoice","code":"duration"},{"text":" passes between elements, and","type":"text"},{"text":" ","type":"text"},{"text":"any error the upstream throws.","type":"text"}]}],"style":"note","type":"aside","name":"Throws"},{"content":[{"type":"paragraph","inlineContent":[{"text":"On WASI, a sleep on a real clock (","type":"text"},{"type":"codeVoice","code":"ContinuousClock"},{"text":", ","type":"text"},{"type":"codeVoice","code":"SuspendingClock"},{"text":") holds the one thread","type":"text"},{"text":" ","type":"text"},{"text":"until its deadline, even when other work is ready, and cancelling it doesn’t end it sooner. So the","type":"text"},{"text":" ","type":"text"},{"text":"timer can hold the thread before the upstream runs, then count that wait against it and throw even","type":"text"},{"text":" ","type":"text"},{"text":"though elements were ready. A test clock is unaffected.","type":"text"}]}],"style":"note","type":"aside","name":"Note"}]}],"references":{"doc://Afluent/documentation/Afluent/_Concurrency/AsyncSequence/timeout(_:clock:tolerance:customError:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"timeout"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Duration","preciseIdentifier":"s:12_Concurrency5ClockP8DurationQa"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clock"},{"kind":"text","tex