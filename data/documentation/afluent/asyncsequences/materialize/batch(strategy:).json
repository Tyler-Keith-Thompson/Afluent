{"sections":[],"abstract":[{"text":"Gathers elements into arrays and emits each array when the strategy says to flush.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"platforms":[{"deprecated":false,"name":"iOS","introducedAt":"16.0","beta":false,"unavailable":false},{"deprecated":false,"name":"iPadOS","introducedAt":"16.0","beta":false,"unavailable":false},{"deprecated":false,"name":"Mac Catalyst","introducedAt":"16.0","beta":false,"unavailable":false},{"deprecated":false,"name":"macOS","introducedAt":"13.0","beta":false,"unavailable":false},{"deprecated":false,"name":"tvOS","introducedAt":"16.0","beta":false,"unavailable":false},{"deprecated":false,"name":"visionOS","introducedAt":"1.0","beta":false,"unavailable":false},{"deprecated":false,"name":"watchOS","introducedAt":"9.0","beta":false,"unavailable":false}],"role":"symbol","title":"batch(strategy:)","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SequenceOperators\/BatchSequence.swift#L221","fileName":"BatchSequence.swift"},"conformance":{"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Element"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":".","type":"text"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"externalID":"s:Sci7Afluents8SendableRzsAB7ElementRpzrlE5batch8strategyAA14AsyncSequencesO5BatchVy_xqd__Gqd___tAA0H8StrategyRd__ACQyd__ADRSlF::SYNTHESIZED::s:7Afluent14AsyncSequencesO11MaterializeV","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"batch"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Strategy"},{"kind":"text","text":">("},{"kind":"externalParam","text":"strategy"},{"kind":"text","text"