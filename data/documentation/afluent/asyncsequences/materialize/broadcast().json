espace for grouping related AsyncSequence operations."}],"navigatorTitle":[{"kind":"identifier","text":"AsyncSequences"}]},"doc://Afluent/documentation/Afluent/_Concurrency/AsyncSequence/materialize()":{"url":"\/documentation\/afluent\/_concurrency\/asyncsequence\/materialize()","role":"symbol","type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/materialize()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"materialize","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Materialize","preciseIdentifier":"s:7Afluent14AsyncSequencesO11MaterializeV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"materialize()","abstract":[{"type":"text","text":"Transforms all elements, errors, and completion of the sequence into "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" values."}],"kind":"symbol"},"doc://Afluent/documentation/Afluent/AsyncSequences/Materialize/broadcast()":{"role":"symbol","url":"\/documentation\/afluent\/asyncsequences\/materialize\/broadcast()","abstract":[{"type":"text","text":"Returns a sequence that multicasts elements to multiple concurrent consumers."}],"kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Materialize\/broadcast()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"broadcast"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"s:7Afluent22AsyncBroadcastSequenceV","kind":"typeIdentifier","text":"AsyncBroadcastSequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":">"}],"title":"broadcast()","type":"topic","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code"