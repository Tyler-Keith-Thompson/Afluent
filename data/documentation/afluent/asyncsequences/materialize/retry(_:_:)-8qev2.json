t"},{"code":"AsyncSequence","type":"codeVoice"},{"text":" to be fully consumed for side effects before retrying.","type":"text"}]}],"name":"transform"}],"kind":"parameters"},{"content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":" that emits the same elements as the upstream but retries on failure using the given strategy,","type":"text"},{"text":" ","type":"text"},{"text":"performing the transformation before each retry.","type":"text"}]}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The provided transformation closure is executed ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"text":" each retry, allowing for side effects such as refreshing tokens or resetting state.","type":"text"},{"text":" ","type":"text"},{"text":"The closure’s returned ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":" is always fully consumed before the retry occurs, but its elements are ignored.","type":"text"},{"text":" ","type":"text"},{"text":"The element type of the returned sequence does not need to match the upstream’s element type.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is useful for performing asynchronous side effects like credential refresh before retrying the main sequence."}]},{"anchor":"Example-Refreshing-an-access-token-on-a-401-HTTP-error-before-retrying-the-main-request","level":2,"type":"heading","text":"Example: Refreshing an access token on a 401 HTTP error before retrying the main request"},{"code":["let mainRequest = URLSession.shared.dataTaskAsyncSequence(for: URLRequest(url: URL(string: \"https:\/\/api.example.com\/data\")!))","","let retriedSequence = mainRequest.retry(.byCount(3)) { error in","    \/\/ If error is 401 Unauthorized, refresh token before retrying","    DeferredTask {","        if let urlError = error as? URLError, urlError.code == .userAuthenticationRequired {","            try await refreshAccessToken()","        }","    }","    .toAsyncSequence() \/\/ This sequence is fully consumed before retrying, ignoring its elements","}"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Materialize\/retry(_:_:)-8qev2","interfaceLanguage":"swift"},"references":{"doc://Afluent/documentation/Afluent/AsyncSequences/Materialize":{"kind":"symbol","abstract":[{"type":"text","text":"Used as the implementation detail for the "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/materialize()","isActive":true,"type":"reference"},{"type":"text","text":" operator."}],"url":"\/documentation\/afluent\/asyncsequences\/materialize","type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Materialize","role":"symbol","title":"AsyncSequences.Materialize","navigatorTitle":[{"kind":"identifier","text":"Materialize"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Materialize"}]},"doc://Afluent/documentation/Afluent/AsyncSequences/RetryAfterFlatMapping":{"title":"AsyncSequences.RetryAfterFlatMapping","type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/RetryAfterFlatMapping","abstract":[],"kind":"symbol","role":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RetryAfterFlatMapping","kind":"identifier"}],"url":"\/documentation\/afluent\/asyncsequences\/retryafterflatmapping","navigatorTitle":[{"text":"RetryAfterFlatMapping","kind":"identifier"}]},"doc://Afluent/documentation/Afluent/AsyncSequences":{"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":