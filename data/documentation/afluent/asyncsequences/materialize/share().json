nuation.finish()","}","","let sharedSequence = upstream.share()","","async let firstConsumer = Task {","    for await value in sharedSequence {","        print(\"First consumer received \\(value)\")","    }","    \/\/ prints the values the shared sequence reads after this consumer subscribed","}","","async let secondConsumer = Task {","    for await value in sharedSequence {","        print(\"Second consumer received \\(value)\")","    }","    \/\/ prints the values the shared sequence reads after this consumer subscribed","}","","\/\/ A consumer that subscribes after the shared sequence has handed out values misses them.","await firstConsumer.value","await secondConsumer.value"],"syntax":"swift"}]}],"kind":"symbol","references":{"doc://Afluent/documentation/Afluent/AsyncSequences/Materialize":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Materialize","kind":"symbol","title":"AsyncSequences.Materialize","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Materialize"}],"url":"\/documentation\/afluent\/asyncsequences\/materialize","navigatorTitle":[{"kind":"identifier","text":"Materialize"}],"type":"topic","role":"symbol","abstract":[{"text":"Used as the implementation detail for the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/materialize()"},{"text":" operator.","type":"text"}]},"doc://Afluent/documentation/Afluent/AsyncSequences":{"kind":"symbol","title":"AsyncSequences","url":"\/documentation\/afluent\/asyncsequences","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncSequences"}],"navigatorTitle":[{"kind":"identifier","text":"AsyncSequences"}],"type":"topic","abstract":[{"type":"text","text":"A namespace for grouping related AsyncSequence operations."}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","role":"symbol"},