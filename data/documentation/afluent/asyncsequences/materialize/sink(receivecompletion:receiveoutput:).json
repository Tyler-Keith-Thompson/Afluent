n","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"This method allows you to asynchronously receive each element emitted by the sequence and respond"},{"type":"text","text":" "},{"type":"text","text":"to completion or failure. The stream runs until all elements are consumed, an error occurs,"},{"type":"text","text":" "},{"type":"text","text":"or cancellation is triggered via the returned token."}],"type":"paragraph"},{"inlineContent":[{"text":"Usage example:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let publisher: AsyncStream<Int> = AsyncStream { continuation in","    Task {","        for i in 1...5 {","            continuation.yield(i)","            try await Task.sleep(nanoseconds: 500_000_000)","        }","        continuation.finish()","    }","}","","let cancellable = publisher.sink(","    receiveCompletion: { completion in","        switch completion {","        case .finished:","            print(\"Stream completed successfully\")","        case .failure(let error):","            print(\"Stream failed with error: \\(error)\")","        }","    },","    receiveOutput: { value in","        print(\"Received value: \\(value)\")","    }",")","","\/\/ To cancel early:","\/\/ cancellable.cancel()"]}]}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Materialize"]]},"references":{"doc://Afluent/documentation/Afluent":{"title":"Afluent","url":"\/documentation\/afluent","abstract":[],"kind":"symbol","role":"collection","identifier":"doc:\/\/Afluent\/documentation\/Afluent","type":"topic"},"doc://Afluent/documentation/Afluent/_Concurrency/AsyncSequence/materialize()":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/materialize()","kind":"symbol","title":"materialize()","fragments":[{"text":"func","kind":"keyword"},{"text