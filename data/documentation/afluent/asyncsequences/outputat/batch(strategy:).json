is this"},{"type":"text","text":" "},{"type":"text","text":"sequence’s, inferred from the call."}]}]}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"text":"A sequence of the upstream’s elements, in order, in arrays of one or more.","type":"text"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"The strategy decides when the pending elements are flushed: every so many elements","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/count(_:)"},{"text":"), every interval","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/time(interval:clock:tolerance:)"},{"text":"), on a signal or a unit of work","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy"},{"text":"), whenever any of several does","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/either(_:_:)"},{"text":"), or by a rule of your own (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy"},{"text":"). After every","type":"text"},{"text":" ","type":"text"},{"text":"flush, each strategy starts over. A flush with nothing pending emits nothing; the","type":"text"},{"text":" ","type":"text"},{"text":"sequence never emits an empty array.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When the upstream finishes, the pending elements, if any, are emitted as a last array and"},{"type":"text","text":" "},{"type":"text","text":"the sequence finishes. When the upstream throws, the pending elements are dropped and the"},{"type":"text","text":" "},{"type":"text","text":"sequence throws the same error. A signal that finishes stops firing while the batches go"},{"type":"text","text":" "},{"type":"text","text":"on; a signal that throws ends the sequence with its error."}],"type":"paragraph"},{"inlineContent":[{"text":"The upstream and the strategy run in tasks of their own, started when iteration begins,","type":"text"},{"text":" ","type":"text"},{"text":"so the upstream is read ahead of the consumer, and arrays the consumer hasn’t taken yet","type":"text"},{"text":" ","type":"text"},{"text":"are buffered. Cancelling the consumer, or dropping its iterator, cancels both. An","type":"text"},{"text":" ","type":"text"},{"text":"upstream or signal that ignores cancellation keeps the internal task alive until its","type":"text"},{"text":" ","type":"text"},{"text":"pending ","type":"text"},{"type":"codeVoice","code":"next()"},{"text":" returns, and is not read again after that; the batched sequence itself","type":"text"},{"text":" ","type":"text"},{"text":"ends at once.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Batching needs iOS 16, Mac Catalyst 16, macOS 13, tvOS 16, watchOS 9 or visionOS 1.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Example","anchor":"Example"},{"code":["for try await batch in [1, 2, 3, 4].async.batch(strategy: .either(.count(3), .time(interval: .seconds(1), clock: ContinuousClock()))) {","    print(batch) \/\/ Prints [1, 2, 3], then [4]","}"],"type":"codeListing","syntax":"swift"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any error the upstream or the strategy throws."}]}],"type":"aside","name":"Throws"}]}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/OutputAt"]]},"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/OutputAt\/batch(strategy:)","interfaceLanguage":"swift"},"metadata":{"externalID":"s:Sci7Afluents8SendableRzsAB7ElementRpzrlE5batch8strategyAA14AsyncSequencesO5BatchVy_xqd__Gqd___tAA0H8StrategyRd__ACQyd__ADRSlF::SYNTHESIZED::s:7Afluent14AsyncSequencesO8OutputAtV","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Self","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":".","type":"text"}]},"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SequenceOperators\/BatchSequence.swift#L221","fileName":"BatchSequence.swift"},"platforms":[{"name":"iOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"16.0"},{"name":"iPadOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"16.0"},{"name":"Mac Catalyst","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"16.0"},{"name":"macOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"13.0"},{"name":"tvOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"16.0"},{"name":"visionOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"1.0"},{"name":"watchOS","unavailable":false,"beta":false,"deprecated":false,"introducedAt":"9.0"}],"role":"symbol","modules":[{"name":"Afluent","relatedModules":["_Concurrency"]}],"symbolKind":"method","extendedModule":"_Concurrency","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"batch"},{"kind":"text","text":"<"},{"kind":"genericP