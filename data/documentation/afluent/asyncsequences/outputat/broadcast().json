ncSequences/OutputAt":{"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OutputAt"}],"url":"\/documentation\/afluent\/asyncsequences\/outputat","abstract":[],"navigatorTitle":[{"kind":"identifier","text":"OutputAt"}],"type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/OutputAt","role":"symbol","title":"AsyncSequences.OutputAt"}}}