onforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":"."}]},"kind":"symbol","type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/OutputAt\/broadcast()","title":"broadcast()","role":"symbol","url":"\/documentation\/afluent\/asyncsequences\/outputat\/broadcast()","abstract":[{"type":"text","text":"Returns a sequence that multicasts elements to multiple concurrent consumers."}]}}}