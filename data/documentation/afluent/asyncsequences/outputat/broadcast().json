ncSequences/OutputAt":{"type":"topic","url":"\/documentation\/afluent\/asyncsequences\/outputat","role":"symbol","abstract":[],"title":"AsyncSequences.OutputAt","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"OutputAt","kind":"identifier"}],"navigatorTitle":[{"text":"OutputAt","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/OutputAt"}}}