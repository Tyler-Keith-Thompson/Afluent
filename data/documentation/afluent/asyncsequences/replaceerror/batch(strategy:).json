{"metadata":{"roleHeading":"Instance Method","platforms":[{"deprecated":false,"unavailable":false,"beta":false,"name":"iOS","introducedAt":"16.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"iPadOS","introducedAt":"16.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"Mac Catalyst","introducedAt":"16.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"macOS","introducedAt":"13.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"tvOS","introducedAt":"16.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"visionOS","introducedAt":"1.0"},{"deprecated":false,"unavailable":false,"beta":false,"name":"watchOS","introducedAt":"9.0"}],"externalID":"s:Sci7Afluents8SendableRzsAB7ElementRpzrlE5batch8strategyAA14AsyncSequencesO5BatchVy_xqd__Gqd___tAA0H8StrategyRd__ACQyd__ADRSlF::SYNTHESIZED::s:7Afluent14AsyncSequencesO12ReplaceErrorV","role":"symbol","symbolKind":"method","title":"batch(strategy:)","modules":[{"name":"Afluent","relatedModules":["_Concurrency"]}],"extendedModule":"_Concurrency","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batch","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Strategy","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"strategy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Strategy","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO","text":"AsyncSequences","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO5BatchV","text":"Batch","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Strategy","kind":"typeIdentifier"},{"text":">","kind":"text"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SequenceOperators\/BatchSequence.swift#L221","fileName":"BatchSequence.swift"},