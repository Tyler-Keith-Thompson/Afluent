ing","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"This method allows you to asynchronously receive each element emitted by the sequence and respond","type":"text"},{"text":" ","type":"text"},{"text":"to completion or failure. The stream runs until all elements are consumed, an error occurs,","type":"text"},{"text":" ","type":"text"},{"text":"or cancellation is triggered via the returned token.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Usage example:","type":"text"}]},{"syntax":"swift","code":["let publisher: AsyncStream<Int> = AsyncStream { continuation in","    Task {","        for i in 1...5 {","            continuation.yield(i)","            try await Task.sleep(nanoseconds: 500_000_000)","        }","        continuation.finish()","    }","}","","let cancellable = publisher.sink(","    receiveCompletion: { completion in","        switch completion {","        case .finished:","            print(\"Stream completed successfully\")","        case .failure(let error):","            print(\"Stream failed with error: \\(error)\")","        }","    },","    receiveOutput: { value in","        print(\"Received value: \\(value)\")","    }",")","","\/\/ To cancel early:","\/\/ cancellable.cancel()"],"type":"codeListing"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/ReplaceError\/sink(receiveCompletion:receiveOutput:)"},"references":{"doc://Afluent/documentation/Afluent/_Concurrency/AsyncSequence/replaceError(with:)":{"role":"symbol","type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/replaceError(with:)","kind":"symbol","abstract":[{"type":"text","text":"Replaces any error from the sequence with the provided value."}],"title":"replaceError(with:)","url":"\/documentation\/afluent\/_concurrency\/asyncsequence\/replaceerror(with:)","fragments":[{"kind":"keywo