xt":", ","kind":"text"},{"text":"Strategy","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Strategy","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","preciseIdentifier":"s:7Afluent13BatchStrategyP","text":"BatchStrategy","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:Sci7ElementQa","text":"Element","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"text":"Strategy","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/Element","preciseIdentifier":"s:7Afluent13BatchStrategyP7ElementQa","text":"Element","kind":"typeIdentifier"}],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"strategy","content":[{"inlineContent":[{"text":"When to emit the gathered elements; its ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" is this","type":"text"},{"text":" ","type":"text"},{"text":"sequence’s, inferred from the call.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"return-value","text":"Return Value"},{"inlineContent":[{"type":"text","text":"A sequence of the upstream’s elements, in order, in arrays of one or more."}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"The strategy decides when the pending elements are flushed: every so many elements","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/count(_:)","isActive":true,"type":"reference"},{"text":"), every interval","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/time(interval:clock:tolerance:)","isActive":true,"type":"reference"},{"text":"), on a signal or a unit of work","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","isActive":true,"type":"reference"},{"text":"), whenever any of several does","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/either(_:_:)","isActive":true,"type":"reference"},{"text":"), or by a rule of your own (","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","isActive":true,"type":"reference"},{"text":"). After every","type":"text"},{"text":" ","type":"text"},{"text":"flush, each strategy starts over. A flush with nothing pending emits nothing; the","type":"text"},{"text":" ","type":"text"},{"text":"sequence never emits an empty array.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When the upstream finishes, the pending elements, if any, are emitted as a last array and"},{"type":"text","text":" "},{"type":"text","text":"the sequence finishes. When the upstream throws, the pending elements are dropped and the"},{"type":"text","text":" "},{"type":"text","text":"sequence throws the same error. A signal that finishes stops firing while the batches go"},{"type":"text","text":" "},{"type":"text","text":"on; a signal that throws ends the sequence with its error."}],"type":"paragraph"},{"inlineContent":[{"text":"The upstream and the strategy run in tasks of their own, started when iteration begins,","type":"text"},{"text":" ","type":"text"},{"text":"so the upstream is read ahead of the consumer, and arrays the consumer hasn’t taken yet","type":"text"},{"text":" ","type":"text"},{"text":"are buffered. Cancelling the consumer, or dropping its iterator, cancels both. An","type":"text"},{"text":" ","type":"text"},{"text":"upstream or signal that ignores cancellation keeps the internal task alive until its","type":"text"},{"text":" ","type":"text"},{"text":"pending ","type":"text"},{"type":"codeVoice","code":"next()"},{"text":" returns, and is not read again after that; the batched sequence itself","type":"text"},{"text":" ","type":"text"},{"text":"ends at once.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Batching needs iOS 16, Mac Catalyst 16, macOS 13, tvOS 16, watchOS 9 or visionOS 1.","type":"text"}],"type":"paragraph"},{"anchor":"Example","type":"heading","level":2,"text":"Example"},{"syntax":"swift","code":["for try await batch in [1, 2, 3, 4].async.batch(strategy: .either(.count(3), .time(interval: .seconds(1), clock: ContinuousClock()))) {","    print(batch) \/\/ Prints [1, 2, 3], then [4]","}"],"type":"codeListing"},{"name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any error the upstream or the strategy throws."}]}],"type":"aside","style":"note"}]}],"references":{"doc://Afluent/documentation/Afluent/SignalBatchStrategy":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SignalBatchStrategy"}],"url":"\/documentation\/afluent\/signalbatchstrategy","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","abstract":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","type":"reference"},{"text":" that flushes each time a sequence produces an element.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"SignalBatchStrategy"}],"type":"topic","role":"symbol","title":"SignalBatchStrategy","kind":"symbol"},"doc://Afluent/documentation/Afluent/AsyncSequences/Batch":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Batch","type":"topic","navigatorTitle":[{"text":"Batch","kind":"identifier"}],"role":"symbol","title":"AsyncSequences.Batch","url":"\/documentation\/afluent\/asyn