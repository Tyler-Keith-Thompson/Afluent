"text":"Example","type":"heading","anchor":"Example","level":2},{"code":["let clock = ContinuousClock()","for try await line in bytes.lines.timeout(.seconds(30), clock: clock) {","    handle(line)","}"],"type":"codeListing","syntax":"swift"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"TimeoutError","type":"codeVoice"},{"type":"text","text":" (or "},{"code":"customError","type":"codeVoice"},{"type":"text","text":") when "},{"code":"duration","type":"codeVoice"},{"type":"text","text":" passes between elements, and"},{"type":"text","text":" "},{"type":"text","text":"any error the upstream throws."}]}],"type":"aside","style":"note","name":"Throws"}]}],"references":{"doc://Afluent/documentation/Afluent/_Concurrency/AsyncSequence/replaceNil(with:)":{"kind":"symbol","url":"\/documentation\/afluent\/_concurrency\/asyncsequence\/replacenil(with:)","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/replaceNil(with:)","title":"replaceNil(with:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"replaceNil","kind":"identifier"},{"text":"<","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"with","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"AsyncSequences","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO"},{"text":".","kind":"text"},{"text":"ReplaceNil","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO10ReplaceNilV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"type":"text","text":"Replaces any "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" values from the sequence with the provided non-nil value."}],"role":"symbol"},"doc://Afluent/documentation/Afluent