cBroadcastSequence","kind":"identifier"}],"url":"\/documentation\/afluent\/asyncbroadcastsequence","title":"AsyncBroadcastSequence","abstract":[{"text":"An async sequence that multicasts elements from an upstream sequence to multiple concurrent consumers.","type":"text"}],"type":"topic","kind":"symbol","navigatorTitle":[{"text":"AsyncBroadcastSequence","kind":"identifier"}],"role":"symbol"}}}