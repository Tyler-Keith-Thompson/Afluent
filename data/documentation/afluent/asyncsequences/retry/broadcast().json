"text","text":" "},{"kind":"identifier","text":"AsyncBroadcastSequence"}],"title":"AsyncBroadcastSequence","abstract":[{"type":"text","text":"An async sequence that multicasts elements from an upstream sequence to multiple concurrent consumers."}],"url":"\/documentation\/afluent\/asyncbroadcastsequence","type":"topic","navigatorTitle":[{"kind":"identifier","text":"AsyncBroadcastSequence"}]}}}