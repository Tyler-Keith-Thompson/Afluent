xt":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The provided transformation closure is executed "},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" each retry, allowing for side effects such as refreshing tokens or resetting state."},{"type":"text","text":" "},{"type":"text","text":"The closure’s returned "},{"code":"AsyncSequence","type":"codeVoice"},{"type":"text","text":" is always fully consumed before the retry occurs, but its elements are ignored."},{"type":"text","text":" "},{"type":"text","text":"The element type of the returned sequence does not need to match the upstream’s element type."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This is useful for performing asynchronous side effects like credential refresh before retrying the main sequence."}],"type":"paragraph"},{"anchor":"Example-Refreshing-an-access-token-on-a-401-HTTP-error-before-retrying-the-main-request","text":"Example: Refreshing an access token on a 401 HTTP error before retrying the main request","level":2,"type":"heading"},{"syntax":"swift","code":["let mainRequest = URLSession.shared.dataTaskAsyncSequence(for: URLRequest(url: URL(string: \"https:\/\/api.example.com\/data\")!))","","let retriedSequence = mainRequest.retry(.byCount(3)) { error in","    \/\/ If error is 401 Unauthorized, refresh token before retrying","    DeferredTask {","        if let urlError = error as? URLError, urlError.code == .userAuthenticationRequired {","            try await refreshAccessToken()","        }","    }","    .toAsyncSequence() \/\/ This sequence is fully consumed before retrying, ignoring its elements","}"],"type":"codeListing"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Retry"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url