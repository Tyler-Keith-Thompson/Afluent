{"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"timeout"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"duration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Duration","preciseIdentifier":"s:s8DurationV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"customError"},{"kind":"text","text":": (any "},{"kind":"typeIdentifier","text":"Error","preciseIdentifier":"s:s5ErrorP"},{"kind":"text","text":")? = nil) -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","text":"AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Timeout","text":"Timeout","preciseIdentifier":"s:7Afluent14AsyncSequencesO7TimeoutV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"SuspendingClock","preciseIdentifier":"s:12_Concurrency15SuspendingClockV"},{"kind":"text","text":">"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The longest the sequence may go without an element."}],"type":"paragraph"}],"name":"duration"},{"content":[{"inlineContent":[{"type":"text","text":"The error to throw when the timer fires. Defaults to"},{"type":"text","text":" "},{"type":"codeVoice","code":"TimeoutError.timedOut(duration:)"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"customError"}],"kind":"parameters"},{"content":[{"text":"Return Value","anchor":"return-value","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A sequence of the same elements that throws if the upstream goes quiet."}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The timer starts when iteration begins and restarts with every element, so it bounds the"},{"type":"text","text":" "},{"type":"text","text":"wait for the first element and each gap after it, never the sequence as a whole. Elements"},{"type":"text","text":" "},{"type":"text","text":"pass through unchanged. When the timer fires, the upstream is cancelled and the sequence"},{"type":"text","text":" "},{"type":"text","text":"throws."}]},{"type":"paragraph","inlineContent":[{"text":"The upstream is read ahead of the consumer, and elements it produces while the consumer is","type":"text"},{"text":" ","type":"text"},{"text":"busy are buffered, so the timer measures the upstream’s gaps. A duration of zero or less","type":"text"},{"text":" ","type":"text"},{"text":"throws before the first element.","type":"text"}]},{"anchor":"Example","level":2,"type":"heading","text":"Example"},{"code":["for try await event in serverEvents.timeout(.seconds(30)) {","    handle(event)","}","\/\/ Throws TimeoutError.timedOut if 30 seconds pass without an event"],"type":"codeListing","syntax":"swift"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"code":"TimeoutError","type":"codeVoice"},{"text":" (or ","type":"text"},{"code":"customError","type":"codeVoice"},{"text":") when ","type":"text"},{"code":"duration","type":"codeVoice"},{"text":" passes between elements, and","type":"text"},{"text":" ","type":"text"},{"text":"any error the upstream throws.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Throws"},{"content":[{"inlineContent":[{"text":"On WASI, a sleep on a real clock (","type":"text"},{"type":"codeVoice","code":"ContinuousClock"},{"text":", ","type":"text"},{"type":"codeVoice","code":"SuspendingClock"},{"text":") holds the one thread","type":"text"},{"text":" ","type":"text"},{"text":"until its deadline, even when other work is ready, and cancelling it doesn’t end it sooner. So the","type":"text"},{"text":" ","type":"text"},{"text":"timer can hold the thread before the upstream runs, then count that wait against it and throw even","type":"text"},{"text":" ","type":"text"},{"text":"though elements were ready. A test clock is unaffected.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"}],"kind":"content"}],"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/RetryAfterFlatMapping\/timeout(_:customError:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/RetryAfterFlatMapping"]]},"metadata":{"modules":[{"name":"Afluent","relatedModules":["_Concurrency"]}],"symbolKind":"method","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"timeout"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Duration","preciseIdentifier":"s:s8DurationV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"customError"},{"kind":"text","text":": (any "},{"kind":"typeIdentifier","text":"Error","preciseIdentifier":"s:s5ErrorP"},{"kind":"text","text":")?) -> "},{"kind":"typeIdentifier","text":"AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Timeout","preciseIdentifier":"s:7Afluent14AsyncSequencesO7TimeoutV"},{"kin