,"code":"AsyncSequence"},{"text":" to be fully consumed for side effects before retrying.","type":"text"}]}],"name":"transform"}]},{"kind":"content","content":[{"anchor":"return-value","type":"heading","text":"Return Value","level":2},{"inlineContent":[{"text":"An ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":" that emits the same elements as the upstream but retries on failure using the given strategy,","type":"text"},{"text":" ","type":"text"},{"text":"performing the transformation before each retry.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"inlineContent":[{"text":"The provided transformation closure is executed ","type":"text"},{"inlineContent":[{"type":"text","text":"before"}],"type":"emphasis"},{"text":" each retry, allowing for side effects such as refreshing tokens or resetting state.","type":"text"},{"text":" ","type":"text"},{"text":"The closure’s returned ","type":"text"},{"type":"codeVoice","code":"AsyncSequence"},{"text":" is always fully consumed before the retry occurs, but its elements are ignored.","type":"text"},{"text":" ","type":"text"},{"text":"The element type of the returned sequence does not need to match the upstream’s element type.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This is useful for performing asynchronous side effects like credential refresh before retrying the main sequence."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Example-Refreshing-an-access-token-on-a-401-HTTP-error-before-retrying-the-main-request","text":"Example: Refreshing an access token on a 401 HTTP error before retrying the main request"},{"syntax":"swift","type":"codeListing","code":["let mainRequest = URLSession.shared.dataTaskAsyncSequence(for: URLRequest(url: URL(string: \"https:\/\/api.example.com\/data\")!))","","let retriedSequence = mainRequest.retry(.byCount(3)) { error in","    \/\/ I