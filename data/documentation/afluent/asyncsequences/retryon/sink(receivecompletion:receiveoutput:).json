fier"}],"externalID":"s:Sci7Afluents8SendableRzrlE4sink17receiveCompletion0D6OutputAA14AnyCancellableCyAA14AsyncSequencesO0E0Oy_s5Error_pGYaYbcSg_y7ElementQzYaYbKcSgtF::SYNTHESIZED::s:7Afluent14AsyncSequencesO7RetryOnC","extendedModule":"_Concurrency","roleHeading":"Instance Method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/Subscription\/AnyCancellable.swift#L161","fileName":"AnyCancellable.swift"}},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Starts processing the elements of this async sequence, handling output and completion events,"},{"type":"text","text":" "},{"type":"text","text":"and returns an "},{"type":"codeVoice","code":"AnyCancellable"},{"type":"text","text":" token that can be used to cancel the subscription."}],"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/RetryOn\/sink(receiveCompletion:receiveOutput:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sink","kind":"identifier"},{"text":"(","kind":"text"},{"text":"receiveCompletion","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"@Sendable","kind":"attribute"},{"text":" (","kind":"text"},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO","text":"AsyncSequences","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO10CompletionO","text":"Completion","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Completion","kind":"typeIdentifier"},{"text":"<any ","kind":"text"},{"preciseIdentifier":"s:s5ErrorP","text":"Error","kind":"typeIdentifier"},{"text":">) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"}