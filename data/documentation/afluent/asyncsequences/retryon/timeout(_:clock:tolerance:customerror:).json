"text","text":"The error to throw when the timer fires. Defaults to"},{"type":"text","text":" "},{"code":"TimeoutError.timedOut(duration:)","type":"codeVoice"},{"type":"text","text":"."}]}]}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"text":"A sequence of the same elements that throws if the upstream goes quiet.","type":"text"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The timer starts when iteration begins and restarts with every element, so it bounds the"},{"type":"text","text":" "},{"type":"text","text":"wait for the first element and each gap after it, never the sequence as a whole. Elements"},{"type":"text","text":" "},{"type":"text","text":"pass through unchanged. When the timer fires, the upstream is cancelled and the sequence"},{"type":"text","text":" "},{"type":"text","text":"throws, without waiting for the upstream to respond to the cancellation."}]},{"type":"paragraph","inlineContent":[{"text":"The upstream is read ahead of the consumer, and elements it produces while the consumer is","type":"text"},{"text":" ","type":"text"},{"text":"busy are buffered, so the timer measures the upstream’s gaps. A duration of zero or less","type":"text"},{"text":" ","type":"text"},{"text":"throws before the first element.","type":"text"}]},{"type":"heading","level":2,"text":"Example","anchor":"Example"},{"code":["let clock = ContinuousClock()","for try await line in bytes.lines.timeout(.seconds(30), clock: clock) {","    handle(line)","}"],"type":"codeListing","syntax":"swift"},{"style":"note","type":"aside","name":"Throws","content":[{"inlineContent":[{"type":"text","text":""},{"code":"TimeoutError","type":"codeVoice"},{"type":"text","text":" (or "},{"code":"customError","type":"codeVoice"},{"type":"text","text":") when "},{"code":"duration","type":"co