keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncBroadcastSequence"}],"abstract":[{"text":"An async sequence that multicasts elements from an upstream sequence to multiple concurrent consumers.","type":"text"}],"url":"\/documentation\/afluent\/asyncbroadcastsequence"}}}