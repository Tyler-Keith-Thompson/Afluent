stSequence","kind":"identifier"}],"type":"topic","role":"symbol"},"doc://Afluent/documentation/Afluent/AsyncSequences/RetryOnAfterFlatMapping":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/RetryOnAfterFlatMapping","title":"AsyncSequences.RetryOnAfterFlatMapping","abstract":[],"role":"symbol","url":"\/documentation\/afluent\/asyncsequences\/retryonafterflatmapping","type":"topic","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RetryOnAfterFlatMapping","kind":"identifier"}],"navigatorTitle":[{"text":"RetryOnAfterFlatMapping","kind":"identifier"}],"kind":"symbol"}}}