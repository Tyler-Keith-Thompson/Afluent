ent":[{"type":"text","text":"The retry strategy to use."}]}]},{"name":"transform","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An async closure that takes the error from the upstream and returns a new "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" to be fully consumed for side effects before retrying."}]}]}]},{"content":[{"anchor":"return-value","type":"heading","text":"Return Value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" that emits the same elements as the upstream but retries on failure using the given strategy,"},{"type":"text","text":" "},{"type":"text","text":"performing the transformation before each retry."}]}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The provided transformation closure is executed "},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" each retry, allowing for side effects such as refreshing tokens or resetting state."},{"type":"text","text":" "},{"type":"text","text":"The closure’s returned "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" is always fully consumed before the retry occurs, but its elements are ignored."},{"type":"text","text":" "},{"type":"text","text":"The element type of the returned sequence does not need to match the upstream’s element type."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is useful for performing asynchronous side effects like credential refresh before retrying the main sequence."}]},{"type":"heading","text":"Example: Refreshing an access token on a 401 HTTP error before retrying the main request","level":2,"anchor":"Example-Refreshing-an-access-token-on-a-401-HTTP-error-before-retrying-the-main-request"},{"type":"codeListing","syntax":"swift","code":[