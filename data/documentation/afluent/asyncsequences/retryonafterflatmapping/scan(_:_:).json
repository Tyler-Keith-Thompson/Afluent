},{"text":" ","type":"text"},{"text":"accumulated value with each new element from the upstream async sequence using the provided closure.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is useful for computing running totals, aggregating state, or applying stateful transformations over time."}]},{"type":"heading","anchor":"Example","level":2,"text":"Example"},{"type":"paragraph","inlineContent":[{"text":"The following example demonstrates accumulating a running sum over an asynchronous sequence of integers:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ An async sequence producing the numbers 1 through 5","let numbers = AsyncStream<Int> { continuation in","    for i in 1...5 {","        continuation.yield(i)","    }","    continuation.finish()","}","","\/\/ Use scan to accumulate a running sum","let runningSum = numbers.scan(0) { partialSum, nextNumber in","    return partialSum + nextNumber","}","","\/\/ Consume the running sums","Task {","    for try await sum in runningSum {","        print(sum) \/\/ Prints: 1, 3, 6, 10, 15","    }","}"]}]}],"references":{"doc://Afluent/documentation/Afluent/AsyncSequences/Scan":{"kind":"symbol","url":"\/documentation\/afluent\/asyncsequences\/scan","title":"AsyncSequences.Scan","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Scan","type":"topic","role":"symbol","abstract":[],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scan","kind":"identifier"}],"navigatorTitle":[{"text":"Scan","kind":"identifier"}]},"doc://Afluent/documentation/Afluent/AsyncSequences/RetryOnAfterFlatMapping":{"abstract":[],"type":"topic","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"RetryOnAfterFlatMapping"}],"title":"AsyncSequences.RetryOnAfterFlatMapping","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/RetryOnAfterFlatMapping","role":"symbol","navigatorTitle":