{"abstract":[{"type":"text","text":"Gathers elements into arrays and emits each array when the strategy says to flush."}],"variants":[{"paths":["\/documentation\/afluent\/asyncsequences\/retryoncast\/batch(strategy:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/RetryOnCast"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"batch"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Strategy"},{"kind":"text","text":">("},{"kind":"externalParam","text":"strategy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","text":"AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Batch","text":"Batch","preciseIdentifier":"s:7Afluent14AsyncSequencesO5BatchV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","text":"BatchStrategy","preciseIdentifier":"s:7Afluent13BatchStrategyP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:Sci7ElementQa"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/Element","text":"Element","preciseIdentifier":"s:7Afluent13BatchStrategyP7ElementQa"}],"languages":["swift"],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"strategy","content":[{"inlineContent":[{"text":"When to emit the gathered elements; its ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" is this","type":"text"},{"text":" ","type":"text"},{"text":"sequence’s, inferred from the call.","type":"text"}],"type":"paragraph"}]}]},{"content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"text","text":"A sequence of the upstream’s elements, in order, in arrays of one or more."}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"The strategy decides when the pending elements are flushed: every so many elements","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/count(_:)"},{"text":"), every interval","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/time(interval:clock:tolerance:)"},{"text":"), on a signal or a unit of work","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy"},{"text":"), whenever any of several does","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/either(_:_:)"},{"text":"), or by a rule of your own (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy"},{"text":"). After every","type":"text"},{"text":" ","type":"text"},{"text":"flush, each strategy starts over. A flush with nothing pending emits nothing; the","type":"text"},{"text":" ","type":"text"},{"text":"sequence never emits an empty array.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When the upstream finishes, the pending elements, if any, are emitted as a last array and","type":"text"},{"text":" ","type":"text"},{"text":"the sequence finishes. When the upstream throws, the pending elements are dropped and the","type":"text"},{"text":" ","type":"text"},{"text":"sequence throws the same error. A signal that finishes stops firing while the batches go","type":"text"},{"text":" ","type":"text"},{"text":"on; a signal that throws ends the sequence with its error.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The upstream and the strategy run in tasks of their own, started when iteration begins,","type":"text"},{"text":" ","type":"text"},{"text":"so the upstream is read ahead of the consumer, and arrays the consumer hasn’t taken yet","type":"text"},{"text":" ","type":"text"},{"text":"are buffered. Cancelling the consumer, or dropping its iterator, cancels both. An","type":"text"},{"text":" ","type":"text"},{"text":"upstream or signal that ignores cancellation keeps the internal task alive until its","type":"text"},{"text":" ","type":"text"},{"text":"pending ","type":"text"},{"type":"codeVoice","code":"next()"},{"text":" returns, and is not read again after that; the batched sequence itself","type":"text"},{"text":" ","type":"text"},{"text":"ends at once.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Batching needs iOS 16, Mac Catalyst 16, macOS 13, tvOS 16, watchOS 9 or visionOS 1."}],"type":"paragraph"},{"anchor":"Example","level":2,"text":"Example","type":"heading"},{"code":["for try await batch in [1, 2, 3, 4].async.batch(strategy: .either(.count(3), .time(interval: .seconds(1), clock: ContinuousClock()))) {","    print(batch) \/\/ Prints [1, 2, 3], then [4]","}"],"syntax":"swift","type":"codeListing"},{"name":"Throws","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Any error the upstream or the strategy throws.","type":"text"}]}]}],"kind":"content"}],"sections":[],"metadata":{"modules":[{"name":"Afluent","relatedModules":["_Concurrency"]}],"roleHeading":"Instance Method","symbolKind":"method","platforms":[{"name":"iOS","introducedAt":"16.0","unavailable":false,"beta":false,"deprecated":false},{"name":"iPadOS","introducedAt":"16.0","unavailable":false,"beta":false,"deprecated":false},{"name":"Mac Catalyst","introducedAt":"16.0","unavailable":false,"beta":false,"deprecated":false},{"name":"macOS","introducedAt":"13.0","unavailable":false,"beta":false,"deprecated":false},{"name":"tvOS","introducedAt":"16.0","unavailable":false,"beta":false,"deprecated":false},{"name":"visionOS","introducedAt":"1.0","unavailable":false,"beta":false,"deprecated":false},{"name":"watchOS","introducedAt":"9.0","unavailable":false,"beta":false,"deprecated":false}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"batch"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Strategy"},{"kind":"text","text":">("},{"kind":"externalParam","text":"strategy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO","text":"AsyncSequences"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO5BatchV","text":"Batch"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":">"}],"extendedModule":"_Concurrency","titl