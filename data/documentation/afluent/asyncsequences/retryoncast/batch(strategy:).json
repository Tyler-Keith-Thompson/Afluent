{"abstract":[{"type":"text","text":"Gathers elements into arrays and emits each array when the strategy says to flush."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/asyncsequences\/retryoncast\/batch(strategy:)"]}],"metadata":{"extendedModule":"_Concurrency","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batch","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Strategy","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"strategy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Strategy","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO","text":"AsyncSequences","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO5BatchV","text":"Batch","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Strategy","kind":"typeIdentifier"},{"text":">","kind":"text"}],"remoteSource":{"fileName":"BatchSequence.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SequenceOperators\/BatchSequence.swift#L221"},"platforms":[{"unavailable":false,"beta":false,"introducedAt":"16.0","deprecated":false,"name":"iOS"},{"unavailable":false,"beta":false,"introducedAt":"16.0","deprecated":false,"name":"iPadOS"},{"unavailable":false,"beta":false,"introducedAt":"16.0","deprecated":false,"name":"Mac Catalyst"},{"unavailable":false,"beta":false,"introducedAt":"13.0","deprecated":false,"name":"macOS"},{"unavailable":false,"beta":false,"introducedAt":"16.0","deprecated":false,"name":"tvOS"},{"unavailable":false,"beta":false,"introducedAt":"1.0","deprecated":false,"name":"visionOS"},{"unavailable":false,"beta":false,"introducedAt":"9.0","deprecated":false,"name":"watchOS"}],"conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"Self","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":".","type":"text"}]},"title":"batch(strategy:)","modules":[{"relatedModules":["_Concurrency"],"name":"Afluent"}],"role":"symbol","externalID":"s:Sci7Afluents8SendableRzsAB7ElementRpzrlE5batch8strategyAA14AsyncSequencesO5BatchVy_xqd__Gqd___tAA0H8StrategyRd__ACQyd__ADRSlF::SYNTHESIZED::s:7Afluent14AsyncSequencesO11RetryOnCastC","roleHeading":"Instance Method","symbolKind":"method"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/RetryOnCast\/batch(strategy:)"},"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"batch"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Strategy"},{"kind":"text","text":">("},{"kind":"externalParam","text":"strategy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO","text":"AsyncSequences"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Batch","preciseIdentifier":"s:7Afluent14AsyncSequencesO5BatchV","text":"Batch"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","preciseIdentifier":"s:7Afluent13BatchStrategyP","text":"BatchStrategy"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sci7ElementQa","text":"Element"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/Element","preciseIdentifier":"s:7Afluent13BatchStrategyP7ElementQa","text":"Element"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"When to emit the gathered elements; its ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" is this","type":"text"},{"text":" ","type":"text"},{"text":"sequence’s, inferred from the call.","type":"text"}]}],"name":"strategy"}]},{"kind":"content","content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"inlineContent":[{"text":"A sequence of the upstream’s elements, in order, in arrays of one or more.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"inlineContent":[{"text":"The strategy decides when the pending elements are flushed: every so many elements","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/count(_:)","isActive":true,"type":"reference"},{"text":"), every interval","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/time(interval:clock:tolerance:)","isActive":true,"type":"reference"},{"text":"), on a signal or a unit of work","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","isActive":true,"type":"reference"},{"text":"), whenever any of several does","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/either(_:_:)","isActive":true,"type":"reference"},{"text":"), or by a rule of your own (","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","isActive":true,"type":"reference"},{"text":"). After every","type":"text"},{"text":" ","type":"text"},{"text":"flush, each strategy starts over. A flush with nothing pending emits nothing; the","type":"text"},{"text":" ","type":"text"},{"text":"sequence never emits an empty array.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When the upstream finishes, the pending elements, if any, are emitted as a last array and","type":"text"},{"text":" ","type":"text"},{"text":"the sequence finishes. When the upstream throws, the pending elements are dropped and the","type":"text"},{"text":" ","type":"text"},{"text":"sequence throws the same error. A signal that finishes stops firing while the batches go","type":"text"},{"text":" ","type":"text"},{"text":"on; a signal that throws ends the sequence with its error.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The upstream and the strategy run in tasks of their own, started when iteration begins,"},{"type":"text","text":" "},{"type":"text","text":"so the upstream is read ahead of the consumer, and arrays the consumer hasn’t taken yet"},{"type":"text","text":" "},{"type":"text","text":"are buffered. Cancelling the consumer, or dropping its iterator, cancels both. An"},{"type":"text","text":" "},{"type":"text","text":"upstream or signal that ignores cancellation keeps the internal task alive until its"},{"type":"text","text":" "},{"type":"text","text":"pending "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" returns, and is not read again after that; the batched sequence itself"},{"type":"text","text":" "},{"type":"text","text":"ends at once."}],"type":"paragraph"},{"inlineContent":[{"text":"Batching needs iOS 16, Mac Catalyst 16, macOS 13, tvOS 16, watchOS 9 or visionOS 1.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Example","level":2,"anchor":"Example"},{"syntax":"swift","type":"codeListing","code":["for try await batch in [1, 2, 3, 4].async.batch(strategy: .either(.count(3), .time(interval: .seconds(1), clock: ContinuousClock()))) {","    print(batch) \/\/ Prints [1, 2, 3], then [4]","}"]},{"type":"aside","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any error the upstream or the strategy throws."}]}],"style":"note"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/RetryOnCast"]]},"references":{"doc://Afluent/documentation/Afluent/AsyncSequences/RetryOnCast/batch(strategy:)":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/RetryOnCast\/batch(strategy:)","title":"batch(strategy:)","kind":"symbol","url":"\/documentation\/afluent\/asyncsequences\/retryoncast\/batch(strategy:)","type":"topic","abstract":[{"type":"text","text":"Gathers elements into arrays and emits each array when the strategy says to flush."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batch","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Strategy","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"strategy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Strategy","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"AsyncSequences","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO"},{"text":".","kind":"text"},{"text":"Batch","kind":"typeIdentifier