 to multiple concurrent consumers.","type":"text"}],"url":"\/documentation\/afluent\/asyncsequences\/retryoncast\/broadcast()","title":"broadcast()","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/RetryOnCast\/broadcast()","type":"topic"},"doc://Afluent/documentation/Afluent":{"role":"collection","url":"\/documentation\/afluent","title":"Afluent","identifier":"doc:\/\/Afluent\/documentation\/Afluent","abstract":[],"kind":"symbol","type":"topic"}}}