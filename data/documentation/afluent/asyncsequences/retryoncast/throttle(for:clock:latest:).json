":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock"}],"platforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"name":"interval","content":[{"inlineContent":[{"type":"text","text":"The length of time to wait between emissions."}],"type":"paragraph"}]},{"name":"clock","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The clock used to measure time intervals and perform sleeps."}]}]},{"name":"latest","content":[{"inlineContent":[{"text":"A Boolean flag determining which element to emit during each interval:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"false"},{"type":"text","text":" emits the first element seen in the interval."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"true"},{"type":"text","text":" emits the latest element seen during the interval."}]}]}],"type":"unorderedList"}]}],"kind":"parameters"},{"content":[{"anchor":"return-value","type":"heading","level":2,"text":"Return Value"},{"inlineContent":[{"type":"text","text":"An async sequence that emits throttled elements from the upstream sequence."}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"This operator suppresses elements from the upstream async sequence during each interval, emitting only one element per interval:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"If "},{"code":"latest","type":"codeVoice"},{"type":"text","text":" is "},{"code":"false","type":"codeVoice"},{"type":"text","text":", it emits the first element received immediately and then ignores subsequent elements until the interval completes."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"latest"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":", it emits the first element immediately, then during the interval it tracks element updates, emitting only the most recent one at the interval’s end."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Elements arriving during an interval beyond the emitted one are suppressed, allowing controlled pacing of element emission."}],"type":"paragraph"},{"level":2,"text":"Example","type":"heading","anchor":"Example"},{"inlineContent":[{"text":"The following example creates an ","type":"text"},{"type":"codeVoice","code":"AsyncStream"},{"text":" that emits the current date every second,","type":"text"},{"text":" ","type":"text"},{"text":"then applies a throttle with a 3-second interval, showing both ","type":"text"},{"type":"codeVoice","code":"latest: false"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"latest: true"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Foundation","import _Concurrency","","let stream = AsyncStream<Date> { continuation in","    Task {","        while true {","            continuation.yield(Date())","            try await Task.sleep(nanoseconds: 1_000_000_000) \/\/ 1 second","        }","    }","}","","\/\/ Throttle with latest: false (emit the first element immediately, then suppress others during the interval)","Task {","    print(\"Throttle with latest: false\")","    for await date in stream.throttle(for: .seconds(3), clock: ContinuousClock(), latest: false) {","        print(\"Emitted (first): \\(date)\")","    }","}","","\/\/ Throttle with latest: true (emit the first element immediately, then emit the latest element at interval end)","Task {","    print(\"Throttle with latest: true\")","    for await date in stream.throttle(for: .seconds(3), clock: ContinuousClock(), latest: true) {","        print(\"Emitted (latest): \\(date)\")","    }","}","","\/*","Sample output for latest: false:","Throttle with la