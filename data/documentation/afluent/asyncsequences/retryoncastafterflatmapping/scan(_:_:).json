:"s:7Afluent14AsyncSequencesO4ScanV","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Scan","text":"Scan"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:Sci7ElementQa","text":"Element"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"}]}]},{"parameters":[{"name":"initialResult","content":[{"inlineContent":[{"text":"The initial accumulated value to start with.","type":"text"}],"type":"paragraph"}]},{"name":"nextPartialResult","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that takes the current accumulated value and the next element from the upstream sequence,"},{"type":"text","text":" "},{"type":"text","text":"and returns a new accumulated value asynchronously."}]}]}],"kind":"parameters"},{"content":[{"text":"Return Value","type":"heading","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"An asynchronous sequence that produces each intermediate accumulated result."}]}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"This operator works similarly to Combine’s "},{"type":"codeVoice","code":"scan"},{"type":"text","text":" operator. It produces a sequence of values by repeatedly combining a running"},{"type":"text","text":" "},{"type":"text","text":"accumulated value with each new element from the upstream async sequence using the provided closure."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This is useful for computing running totals, aggregating state, or applying stateful transformations over time."}],"type":"paragraph"},{"level":2,"text":"Example","anchor":"Example","type":"heading"},{"inlineContent":[{"type":"text","text":"The following example demonstrates accumulating a running sum over an asynchronous sequence of integers:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ An async sequence producing the numbers 1 through 5","let numbers = AsyncStream<Int> { continuation in","    for i in 1...5 {","        continuation.yield(i)","    }","    continuation.finish()","}","","\/\/ Use scan to accumulate a running sum","let runningSum = numbers.scan(0) { partialSum, nextNumber in","    return partialSum + nextNumber","}","","\/\/ Consume the running sums","Task {","    for try await sum in runningSum {","        print(sum) \/\/ Prints: 1, 3, 6, 10, 15","    }","}"],"type":"codeListing"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/asyncsequences\/retryoncastafterflatmapping\/scan(_:_:)"]}],"references":{"doc://Afluent/documentation/Afluent/AsyncSequences/Scan":{"kind":"symbol","abstract":[],"type":"topic","role":"symbol","title":"AsyncSequences.Scan","navigatorTitle":[{"text":"Scan","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Scan","kind":"identifier"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Scan","url":"\/documentation\/afluent\/asyncsequences\/scan"},"doc://Afluent/documentation/Afluent/AsyncSequences/RetryOnCastAfterFlatMapping":{"abstract":[],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/RetryOnCastAfterFlatMapping","title":"AsyncSequences.RetryOnCastAfterFlatMapping","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"RetryOnCastAfterFlatMapping"}],"url":"\/documen