 }","    \/\/ prints the values the shared sequence reads after this consumer subscribed","}","","async let secondConsumer = Task {","    for await value in sharedSequence {","        print(\"Second consumer received \\(value)\")","    }","    \/\/ prints the values the shared sequence reads after this consumer subscribed","}","","\/\/ A consumer that subscribes after the shared sequence has handed out values misses them.","await firstConsumer.value","await secondConsumer.value"],"syntax":"swift","type":"codeListing"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/asyncsequences\/retryoncastafterflatmapping\/share()"]}],"abstract":[{"text":"Returns a sequence that multicasts elements to multiple concurrent consumers.","type":"text"}],"references":{"doc://Afluent/documentation/Afluent/AsyncSequences/RetryOnCastAfterFlatMapping":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/RetryOnCastAfterFlatMapping","url":"\/documentation\/afluent\/asyncsequences\/retryoncastafterflatmapping","abstract":[],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"RetryOnCastAfterFlatMapping"}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"RetryOnCastAfterFlatMapping"}],"title":"AsyncSequences.RetryOnCastAfterFlatMapping"},"doc://Afluent/documentation/Afluent":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent","title":"Afluent","role":"collection","abstract":[],"url":"\/documentation\/afluent","kind":"symbol","type":"topic"},"doc://Afluent/documentation/Afluent/AsyncBroadcastSequence":{"navigatorTitle":[{"text":"AsyncBroadcastSequence","kind":"identifier"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncBroadcastSequence","kind":"symbol","type":"topic","url":"\/documentation\/afluent\/asyncbroadcastsequence","role":"symbol","title":"AsyncBroadcastSequence","abstract":[{"type":"text","text":"An async seq