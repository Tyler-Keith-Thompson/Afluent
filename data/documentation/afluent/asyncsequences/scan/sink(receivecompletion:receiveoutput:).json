y with ","type":"text"},{"code":".finished","type":"codeVoice"},{"text":" ","type":"text"},{"text":"or with an error ","type":"text"},{"code":".failure","type":"codeVoice"},{"text":". Called exactly once.","type":"text"}],"type":"paragraph"}]},{"name":"receiveOutput","content":[{"inlineContent":[{"text":"An optional async throwing closure invoked for each element produced by the sequence.","type":"text"},{"text":" ","type":"text"},{"text":"If this closure throws an error, the sequence is terminated and completion closure is called with ","type":"text"},{"type":"codeVoice","code":".failure"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"anchor":"return-value","text":"Return Value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"An "},{"code":"AnyCancellable","type":"codeVoice"},{"type":"text","text":" token that can be stored and used to cancel the ongoing subscription."}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"This method allows you to asynchronously receive each element emitted by the sequence and respond"},{"type":"text","text":" "},{"type":"text","text":"to completion or failure. The stream runs until all elements are consumed, an error occurs,"},{"type":"text","text":" "},{"type":"text","text":"or cancellation is triggered via the returned token."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Usage example:"}],"type":"paragraph"},{"syntax":"swift","code":["let publisher: AsyncStream<Int> = AsyncStream { continuation in","    Task {","        for i in 1...5 {","            continuation.yield(i)","            try await Task.sleep(nanoseconds: 500_000_000)","        }","        continuation.finish()","    }","}","","let cancellable = publisher.sink(","    receiveCompletion: { completion in","        switch completion {","        case .finished:","            print(\"Str