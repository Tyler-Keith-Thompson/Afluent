:"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let publisher: AsyncStream<Int> = AsyncStream { continuation in","    Task {","        for i in 1...5 {","            continuation.yield(i)","            try await Task.sleep(nanoseconds: 500_000_000)","        }","        continuation.finish()","    }","}","","let cancellable = publisher.sink(","    receiveCompletion: { completion in","        switch completion {","        case .finished:","            print(\"Stream completed successfully\")","        case .failure(let error):","            print(\"Stream failed with error: \\(error)\")","        }","    },","    receiveOutput: { value in","        print(\"Received value: \\(value)\")","    }",")","","\/\/ To cancel early:","\/\/ cancellable.cancel()"]}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Scan"]]},"variants":[{"paths":["\/documentation\/afluent\/asyncsequences\/scan\/sink(receivecompletion:receiveoutput:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"role":"symbol","roleHeading":"Instance Method","title":"sink(receiveCompletion:receiveOutput:)","symbolKind":"method","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"type":"codeVoice","code":"Self"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":".","type":"text"}]},"modules":[{"name":"Afluent","relatedModules":["_Concurrency"]}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"sink","kind":"identifier"},{"text":"(","kind":"text"},{"text":"receiveCompletion","kind":"externalParam"},{"text":": ((","kind":"text"},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO","text":"AsyncSequenc