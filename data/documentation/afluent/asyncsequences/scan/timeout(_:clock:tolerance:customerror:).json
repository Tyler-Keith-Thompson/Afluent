ces while the consumer is"},{"type":"text","text":" "},{"type":"text","text":"busy are buffered, so the timer measures the upstream’s gaps. A duration of zero or less"},{"type":"text","text":" "},{"type":"text","text":"throws before the first element."}],"type":"paragraph"},{"text":"Example","type":"heading","anchor":"Example","level":2},{"type":"codeListing","syntax":"swift","code":["let clock = ContinuousClock()","for try await line in bytes.lines.timeout(.seconds(30), clock: clock) {","    handle(line)","}"]},{"name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"TimeoutError","type":"codeVoice"},{"type":"text","text":" (or "},{"code":"customError","type":"codeVoice"},{"type":"text","text":") when "},{"code":"duration","type":"codeVoice"},{"type":"text","text":" passes between elements, and"},{"type":"text","text":" "},{"type":"text","text":"any error the upstream throws."}]}],"type":"aside","style":"note"}]}],"metadata":{"remoteSource":{"fileName":"TimeoutSequence.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SequenceOperators\/TimeoutSequence.swift#L207"},"roleHeading":"Instance Method","title":"timeout(_:clock:tolerance:customError:)","symbolKind":"method","platforms":[{"deprecated":false,"beta":false,"introducedAt":"16.0","unavailable":false,"name":"iOS"},{"deprecated":false,"beta":false,"introducedAt":"16.0","unavailable":false,"name":"iPadOS"},{"deprecated":false,"beta":false,"introducedAt":"16.0","unavailable":false,"name":"Mac Catalyst"},{"deprecated":false,"beta":false,"introducedAt":"13.0","unavailable":false,"name":"macOS"},{"deprecated":false,"beta":false,"introducedAt":"16.0","unavailable":false,"name":"tvOS"},{"deprecated":false,"beta":false,"introducedAt":"1.0","unavailable":false,"name":"visionOS"},{"deprecated":false,"beta":false,"introducedAt":"9.0","unavailable":false,"name":"watchOS"}],"conformance":{"constraints":[{"type":"codeVoice","code":"Self"}