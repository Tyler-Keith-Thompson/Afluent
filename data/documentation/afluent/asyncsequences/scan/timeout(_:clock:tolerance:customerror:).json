:"heading","level":2},{"code":["let clock = ContinuousClock()","for try await line in bytes.lines.timeout(.seconds(30), clock: clock) {","    handle(line)","}"],"syntax":"swift","type":"codeListing"},{"name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"TimeoutError"},{"type":"text","text":" (or "},{"type":"codeVoice","code":"customError"},{"type":"text","text":") when "},{"type":"codeVoice","code":"duration"},{"type":"text","text":" passes between elements, and"},{"type":"text","text":" "},{"type":"text","text":"any error the upstream throws."}]}],"type":"aside","style":"note"}],"kind":"content"}],"references":{"doc://Afluent/documentation/Afluent/AsyncSequences/Timeout":{"type":"topic","abstract":[{"type":"text","text":"Used as the implementation detail for the "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/timeout(_:clock:tolerance:customError:)","isActive":true},{"type":"text","text":" operator."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Timeout","kind":"identifier"}],"title":"AsyncSequences.Timeout","url":"\/documentation\/afluent\/asyncsequences\/timeout","navigatorTitle":[{"text":"Timeout","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Timeout","kind":"symbol"},"doc://Afluent/documentation/Afluent/AsyncSequences/Scan/timeout(_:clock:tolerance:customError:)":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Scan\/timeout(_:clock:tolerance:customError:)","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Fails if the sequence goes the given duration without producing an element, measured on"},{"type":"text","text":" "},{"type":"text","text":"the given clock."}],"title":"timeout(_:clock:tolerance:customError:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identi