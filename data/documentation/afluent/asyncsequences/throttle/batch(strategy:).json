n\/Sources\/Afluent\/SequenceOperators\/BatchSequence.swift#L221","fileName":"BatchSequence.swift"},"extendedModule":"_Concurrency","externalID":"s:Sci7Afluents8SendableRzsAB7ElementRpzrlE5batch8strategyAA14AsyncSequencesO5BatchVy_xqd__Gqd___tAA0H8StrategyRd__ACQyd__ADRSlF::SYNTHESIZED::s:7Afluent14AsyncSequencesO8ThrottleV","title":"batch(strategy:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"batch"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Strategy"},{"kind":"text","text":">("},{"kind":"externalParam","text":"strategy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO","text":"AsyncSequences"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO5BatchV","text":"Batch"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":">"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"batch"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Strategy"},{"kind":"text","text":">("},{"kind":"externalParam","text":"strategy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"AsyncSequences","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Batch","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Batch","preciseIdentifier":"s:7Afluent14AsyncSequencesO5BatchV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"BatchStrategy","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","preciseIdentifier":"s:7Afluent13BatchStrategyP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:Sci7ElementQa"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/Element","preciseIdentifier":"s:7Afluent13BatchStrategyP7ElementQa"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"strategy","content":[{"inlineContent":[{"type":"text","text":"When to emit the gathered elements; its "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" is this"},{"type":"text","text":" "},{"type":"text","text":"sequence’s, inferred from the call."}],"type":"paragraph"}]}]},{"content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A sequence of the upstream’s elements, in order, in arrays of one or more."}]}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"The strategy decides when the pending elements are flushed: every so many elements"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/count(_:)","type":"reference","isActive":true},{"type":"text","text":"), every interval"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/time(interval:clock:tolerance:)","type":"reference","isActive":true},{"type":"text","text":"), on a signal or a unit of work"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","type":"reference","isActive":true},{"type":"text","text":"), whenever any of several does"},{"type":"text","text":" "},{"type":"text","text":"("},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/either(_:_:)","type":"reference","isActive":true},{"type":"text","text":"), or by a rule of your own ("},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","type":"reference","isActive":true},{"type":"text","text":"). After every"},{"type":"text","text":" "},{"type":"text","text":"flush, each strategy starts over. A flush with nothing pending emits nothing; the"},{"type":"text","text":" "},{"type":"text","text":"sequence never emits an empty array."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When the upstream finishes, the pending elements, if any, are emitted as a last array and"},{"type":"text","text":" "},{"type":"text","text":"the sequence finishes. When the upstream throws, the pending elements are dropped and the"},{"type":"text","text":" "},{"type":"text","text":"sequence throws the same error. A signal that finishes stops firing while the batches go"},{"type":"text","text":" "},{"type":"text","text":"on; a signal that throws ends the sequence with its error."}],"type":"paragraph"},{"inlineContent":[{"text":"The upstream and the strategy run in tasks of their own, started when iteration begins,","type":"text"},{"text":" ","type":"text"},{"text":"so the upstream is read ahead of the consumer, and arrays the consumer hasn’t taken yet","type":"text"},{"text":" ","type":"text"},{"text":"are buffered. Cancelling the consumer, or dropping its iterator, cancels both. An","type":"text"},{"text":" ","type":"text"},{"text":"upstream or signal that ignores cancellation keeps the internal task alive until its","type":"text"},{"text":" ","type":"text"},{"text":"pending ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":" returns, and is not read again after that; the batched sequence itself","type":"text"},{"text":" ","type":"text"},{"text":"ends at once.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Batching needs iOS 16, Mac Catalyst 16, macOS 13, tvOS 16, watchOS 9 or visionOS 1.","type":"text"}],"type":"paragraph"},{"anchor":"Example","level":2,"type":"heading","text":"Example"},{"syntax":"swift","type":"codeListing","code":["for try await batch in [1, 2, 3, 4].async.batch(strategy: .either(.count(3), .time(interval: .seconds(1), clock: ContinuousClock()))) {","    print(batch) \/\/ Prints [1, 2, 3], then [4]","}"]},{"style":"note","name":"Throws","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Any error the upstream or the strategy throws.","type":"text"}]}]}],"kind":"content"}],"references":{"doc://Afluent/documentation/Afluent":{"type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent","role":"collection","title":"Afluent","url":"\/documentation\/afluent","abstract":[],"kind":"symbol"},"doc://Afluent/documentation/Afluent/AsyncSequences/Throttle":{"navigatorTitle":[{"text":"Throttle","kind":"identifier"}],"kind":"symbol","title":"AsyncSequences.Throttle","abstract":[],"url":"\/documentation\/afluent\/asyncsequences\/throttle","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Throttle","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Throttle"},"doc://Afluent/documentation/Afluent/_Concurrency/AsyncSequence/batch(strategy:)":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/batch(strategy:)","type":"topic","role":"symbol","title":"batch(strategy:)","url":"\/documentation\/afluent\/_concurrency\/asyncsequence\/batch