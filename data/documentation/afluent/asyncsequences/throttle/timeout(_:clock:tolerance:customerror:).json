kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"timeout"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"duration"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP8DurationQa","text":"Duration"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP8DurationQa","text":"Duration"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"customError"},{"kind":"text","text":": (any "},{"kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP","text":"Error"},{"kind":"text","text":")? = nil) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO","text":"AsyncSequences","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO7TimeoutV","text":"Timeout","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Timeout"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP","text":"Clock"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The longest the sequence may go without an element."}],"type":"paragraph"}],"name":"duration"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The clock that measures the gaps.","type":"text"}]}],"name":"clock"},{"content":[{"inlineContent":[{"text":"The tolerance of the timer’s sleeps. Defaults to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"tolerance"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The error to throw when the timer fires. Defaults to"},{"type":"text","text":" "},{"type":"codeVoice","code":"TimeoutError.timedOut(duration:)"},{"type":"text","text":"."}]}],"name":"customError"}]},{"kind":"content","content":[{"text":"Return Value","type":"heading","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A sequence of the same elements that throws if the upstream goes quiet."}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The timer starts when iteration begins and restarts with every element, so it bounds the","type":"text"},{"text":" ","type":"text"},{"text":"wait for the first element and each gap after it, never the sequence as a whole. Elements","type":"text"},{"text":" ","type":"text"},{"text":"pass through unchanged. When the timer fires, the upstream is cancelled and the sequence","type":"text"},{"text":" ","type":"text"},{"text":"throws, without waiting for the upstream to respond to the cancellation.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The upstream is read ahead of the consumer, and elements it produces while the consumer is"},{"type":"text","text":" "},{"type":"text","text":"busy are buffered, so the timer measures the upstream’s gaps. A duration of zero or less"},{"type":"text","text":" "},{"type":"text","text":"throws before the first element."}]},{"type":"heading","level":2,"anchor":"Example","text":"Example"},{"code":["let clock = ContinuousClock()","for try await line in bytes.lines.timeout(.seconds(30), clock: clock) {","    handle(line)","}"],"type":"codeListing","syntax":"swift"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"TimeoutError"},{"type":"text","text":" (or "},{"type":"codeVoice","code":"customError"},{"type":"text","text":") when "},{"type":"codeVoice","code":"duration"},{"type":"text","text":" passes between elements, and"},{"type":"text","text":" "},{"type":"text","text":"any error the upstream throws."}]}],"name":"Throws","style":"note"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"On WASI, a sleep on a real clock ("},{"type":"codeVoice","code":"ContinuousClock"},{"type":"text","text":", "},{"type":"codeVoice","code":"SuspendingClock"},{"type":"text","text":") holds the one thread"},{"type":"text","text":" "},{"type":"text","text":"until its deadline, even when other work is ready, and cancelling it doesn’t end it sooner. So the"},{"type":"text","text":" "},{"type":"text","text":"timer can hold the thread before the upstream runs, then count that wait against it and throw even"},{"type":"text","text":" "},{"type":"text","text":"though elements were ready. A test clock is unaffected."}]}],"name":"Note","style":"note"}]}],"references":{"doc://Afluent/documentation/Afluent/AsyncSequences":{"kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncSequences","kind":"identifier"}],"navigatorTitle":[{"text":"AsyncSequences","kind":"identifier"}],"type":"topic","url":"\/documentation\/afluent\/asyncsequences","title":"AsyncSequences","abstract":[{"text":"A namespace for grouping related AsyncSequence operations.","type":"text"}]},"doc://Afluent/documentation/Afluen