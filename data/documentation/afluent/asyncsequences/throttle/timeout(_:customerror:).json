","text":"Example","anchor":"Example","level":2},{"type":"codeListing","syntax":"swift","code":["for try await event in serverEvents.timeout(.seconds(30)) {","    handle(event)","}","\/\/ Throws TimeoutError.timedOut if 30 seconds pass without an event"]},{"type":"aside","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"TimeoutError"},{"type":"text","text":" (or "},{"type":"codeVoice","code":"customError"},{"type":"text","text":") when "},{"type":"codeVoice","code":"duration"},{"type":"text","text":" passes between elements, and"},{"type":"text","text":" "},{"type":"text","text":"any error the upstream throws."}]}],"style":"note"}]}],"variants":[{"paths":["\/documentation\/afluent\/asyncsequences\/throttle\/timeout(_:customerror:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"type":"text","text":"Fails if the sequence goes the given duration without producing an element, measured on"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"SuspendingClock"},{"type":"text","text":"."}],"references":{"doc://Afluent/documentation/Afluent/AsyncSequences/Throttle":{"type":"topic","abstract":[],"navigatorTitle":[{"kind":"identifier","text":"Throttle"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Throttle"}],"kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Throttle","title":"AsyncSequences.Throttle","role":"symbol","url":"\/documentation\/afluent\/asyncsequences\/throttle"},"doc://Afluent/documentation/Afluent/AsyncSequences/Timeout":{"type":"topic","abstract":[{"text":"Used as the implementation detail for the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/timeout(_:clock:tolerance:customError:)"},{"text":" operator.","type":"text"}],"role":"symbol","navigatorTitle":[