ind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO","text":"AsyncSequences"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO5BatchV","text":"Batch"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":">"}],"extendedModule":"_Concurrency","role":"symbol"},"abstract":[{"type":"text","text":"Gathers elements into arrays and emits each array when the strategy says to flush."}],"sections":[],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/asyncsequences\/timeout\/batch(strategy:)"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Timeout"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Timeout\/batch(strategy:)"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batch","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Strategy","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"strategy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Strategy","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","text":"AsyncSequences","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO"},{"text":".","kind":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Batch","text":"Batch","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO5BatchV"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Strategy","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Strategy","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","text":"BatchStrategy","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent13BatchStrategyP"},{"text":", ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:Sci7ElementQa"},{"text":" == ","kind":"text"},{"text":"Strategy","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/Element","text":"Element","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent13BatchStrategyP7ElementQa"}]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"text":"When to emit the gathered elements; its ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" is this","type":"text"},{"text":" ","type":"text"},{"text":"sequence’s, inferred from the call.","type":"text"}],"type":"paragraph"}],"name":"strategy"}],"kind":"parameters"},{"content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A sequence of the upstream’s elements, in order, in arrays of one or more."}]}],"kind":"content"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The strategy decides when the pending elements are flushed: every so many elements","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/count(_:)"},{"text":"), every interval","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/time(interval:clock:tolerance:)"},{"text":"), on a signal or a unit of work","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy"},{"text":"), whenever any of several does","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/either(_:_:)"},{"text":"), or by a rule of your own (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy"},{"text":"). After every","type":"text"},{"text":" ","type":"text"},{"text":"flush, each strategy starts over. A flush with nothing pending emits nothing; the","type":"text"},{"text":" ","type":"text"},{"text":"sequence never emits an empty array.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the upstream finishes, the pending elements, if any, are emitted as a last array and"},{"type":"text","text":" "},{"type":"text","text":"the sequence finishes. When the upstream throws, the pending elements are dropped and the"},{"type":"text","text":" "},{"type":"text","text":"sequence throws the same error. A signal that finishes stops firing while the batches go"},{"type":"text","text":" "},{"type":"text","text":"on; a signal that throws ends the sequence with its error."}]},{"type":"paragraph","inlineContent":[{"text":"The upstream and the strategy run in tasks of their own, started when iteration begins,","type":"text"},{"text":" ","type":"text"},{"text":"so the upstream is read ahead of the consumer, and arrays the consumer hasn’t taken yet","type":"text"},{"text":" ","type":"text"},{"text":"are buffered. Cancelling the consumer, or dropping its iterator, cancels both. An","type":"text"},{"text":" ","type":"text"},{"text":"upstream or signal that ignores cancellation keeps the internal task alive until its","type":"text"},{"text":" ","type":"text"},{"text":"pending ","type":"text"},{"code":"next()","type":"codeVoice"},{"text":" returns, and is not read again after that; the batched sequence itself","type":"text"},{"text":" ","type":"text"},{"text":"ends at once.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Batching needs iOS 16, Mac Catalyst 16, macOS 13, tvOS 16, watchOS 9 or visionOS 1.","type":"text"}]},{"type":"heading","level":2,"anchor":"Example","text":"Example"},{"syntax":"swift","type":"codeListing","code":["for try await batch in [1, 2, 3, 4].async.batch(strategy: .either(.count(3), .time(interval: .seconds(1), clock: ContinuousClock()))) {","    print(batch) \/\/ Prints [1, 2, 3], then [4]","}"]},{"type":"aside","content":[{"inlineContent":[{"text":"Any error the upstream or the strategy throws.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Throws"}],"kind":"content"}],"references":{"doc://Afluent/documentation/Afluent/AsyncSequences/Timeout":{"url":"\/documentation\/afluent\/asyncsequences\/timeout","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Timeout","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Timeout","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"Timeout","kind":"identifier"}],"title":"AsyncSequences.Timeout","abstract":[{"type":"text","text":"Used as the implementation detail for the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/timeout(_:clock:tolerance:customError:)"},{"type":"text","text":" operator."}],"type":"topic"},"doc://Afluent/documentation/Afluent/BatchStrategy/time(interval:clock:tolerance:)":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"time","kind":"identifier"},{"text":"<