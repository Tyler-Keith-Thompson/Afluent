":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"platforms":[{"introducedAt":"16.0","name":"iOS","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"16.0","name":"iPadOS","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"16.0","name":"Mac Catalyst","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"13.0","name":"macOS","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"16.0","name":"tvOS","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"1.0","name":"visionOS","unavailable":false,"beta":false,"deprecated":false},{"introducedAt":"9.0","name":"watchOS","unavailable":false,"beta":false,"deprecated":false}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batch","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Strategy","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"strategy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Strategy","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","text":"AsyncSequences","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO5BatchV","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Batch","text":"Batch","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Strategy","kind":"typeIdentifier"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:7Afluent13BatchStrategyP","kind":"typeIdentifier","text":"BatchStrategy","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"preciseIdentifier":"s:Sci7ElementQa","kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":"."},{"preciseIdentifier":"s:7Afluent13BatchStrategyP7ElementQa","kind":"typeIdentifier","text":"Element","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/Element"}],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"strategy","content":[{"inlineContent":[{"text":"When to emit the gathered elements; its ","type":"text"},{"type":"codeVoice","code":"Element"},{"text":" is this","type":"text"},{"text":" ","type":"text"},{"text":"sequence’s, inferred from the call.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"level":2,"anchor":"return-value","text":"Return Value","type":"heading"},{"inlineContent":[{"type":"text","text":"A sequence of the upstream’s elements, in order, in arrays of one or more."}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"The strategy decides when the pending elements are flushed: every so many elements","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/count(_:)","type":"reference"},{"text":"), every interval","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/time(interval:clock:tolerance:)","type":"reference"},{"text":"), on a signal or a unit of work","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","type":"reference"},{"text":"), whenever any of several does","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/either(_:_:)","type":"reference"},{"text":"), or by a rule of your own (","type":"text"},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","type":"reference"},{"text":"). After every","type":"text"},{"text":" ","type":"text"},{"text":"flush, each strategy starts over. A flush with nothing pending emits nothing; the","type":"text"},{"text":" ","type":"text"},{"text":"sequence never emits an empty array.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When the upstream finishes, the pending elements, if any, are emitted as a last array and","type":"text"},{"text":" ","type":"text"},{"text":"the sequence finishes. When the upstream throws, the pending elements are dropped and the","type":"text"},{"text":" ","type":"text"},{"text":"sequence throws the same error. A signal that finishes stops firing while the batches go","type":"text"},{"text":" ","type":"text"},{"text":"on; a signal that throws ends the sequence with its error.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The upstream and the strategy run in tasks of their own, started when iteration begins,"},{"type":"text","text":" "},{"type":"text","text":"so the upstream is read ahead of the consumer, and arrays the consumer hasn’t taken yet"},{"type":"text","text":" "},{"type":"text","text":"are buffered. Cancelling the consumer, or dropping its iterator, cancels both. An"},{"type":"text","text":" "},{"type":"text","text":"upstream or signal that ignores cancellation keeps the internal task alive until its"},{"type":"text","text":" "},{"type":"text","text":"pending "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" returns, and is not read again after that; the batched sequence itself"},{"type":"text","text":" "},{"type":"text","text":"ends at once."}],"type":"paragraph"},{"inlineContent":[{"text":"Batching needs iOS 16, Mac Catalyst 16, macOS 13, tvOS 16, watchOS 9 or visionOS 1.","type":"text"}],"type":"paragraph"},{"anchor":"Example","level":2,"text":"Example","type":"heading"},{"syntax":"swift","code":["for try await batch in [1, 2, 3, 4].async.batch(strategy: .either(.count(3), .time(interval: .seconds(1), clock: ContinuousClock()))) {","    print(batch) \/\/ Prints [1, 2, 3], then [4]","}"],"type":"codeListing"},{"name":"Throws","content":[{"inlineContent":[{"text":"Any error the upstream or the strategy throws.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside"}]}],"variants":[{"paths":["\/documentation\/afluent\/asyncsequences\/timeout\/batch(strategy:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Gathers elements into arrays and emits each array when the strategy says to flush.","type":"text"}],"references":{"doc://Afluent/documentation/Afluent/BatchStrategy/time(interval:clock:tolerance:)":{"title":"time(interval:clock:tolerance:)","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"time"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Batched"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"externalParam","text":"interval"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":"."},{"preciseIdentifier":"s:12_Concurrency5ClockP8DurationQa","kind":"typeIdentifier","text":"Duration"},{"kind":"text","text":", "},{"kind":"externalParam","text":"clock"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":", "},{"kind":"externalParam","text":"tolerance"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":"."},{"preciseIdentifier":"s:12_Concurrency5ClockP8DurationQa","kind":"typeIdentifier","text":"Duration"},{"kind":"text","text":"?) -> "},{"preciseIdentifier":"s:7Afluent17TimeBatchStrategyV","kind":"typeIdentifier","text":"TimeBatchStrategy"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Batched"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">"}],"kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/time(interval:clock:tolerance:)","url":"\/documentation\/afluent\/batchstrategy\/time(interval:clock:tolerance:)","abstract":[{"type":"text","text":"Flushes each time the interval passes on the given clock."}]},"doc://Afluent/documentation/Afluent/BatchStrategy/count(_:)":{"title":"count(_:)","type":"topic","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"count","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Batched","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"CountBatchStrategy","preciseIdentifier":"s:7Afluent18CountBatchStrategyV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Batched","kind":"typeIdentifier"},{"text":">","kind":"text"}],"kind":"symbol","abstract":[{"type":"text","text":"Flushes whenever the given number of elements is pending."}],"url":"\/documentation\/afluent\/batchstrategy\/count(_:)","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/count(_:)"},"doc://Afluent/documentation/Afluent/_Concurrency/AsyncSequence/timeout(_:clock:tolerance:customError:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"timeout"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"C"},{"kind":"text","text":">("},{"kind":"typeIden