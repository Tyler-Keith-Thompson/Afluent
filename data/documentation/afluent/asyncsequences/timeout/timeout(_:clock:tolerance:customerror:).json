pe":"heading","anchor":"Example"},{"syntax":"swift","type":"codeListing","code":["let clock = ContinuousClock()","for try await line in bytes.lines.timeout(.seconds(30), clock: clock) {","    handle(line)","}"]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"TimeoutError"},{"type":"text","text":" (or "},{"type":"codeVoice","code":"customError"},{"type":"text","text":") when "},{"type":"codeVoice","code":"duration"},{"type":"text","text":" passes between elements, and"},{"type":"text","text":" "},{"type":"text","text":"any error the upstream throws."}]}],"style":"note","name":"Throws","type":"aside"}],"kind":"content"}],"references":{"doc://Afluent/documentation/Afluent/AsyncSequences/Timeout":{"role":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Timeout","navigatorTitle":[{"kind":"identifier","text":"Timeout"}],"title":"AsyncSequences.Timeout","type":"topic","abstract":[{"type":"text","text":"Used as the implementation detail for the "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/timeout(_:clock:tolerance:customError:)","isActive":true},{"type":"text","text":" operator."}],"kind":"symbol","url":"\/documentation\/afluent\/asyncsequences\/timeout","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Timeout"}]},"doc://Afluent/documentation/Afluent":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent","type":"topic","url":"\/documentation\/afluent","abstract":[],"title":"Afluent","kind":"symbol","role":"collection"},"doc://Afluent/documentation/Afluent/AsyncSequences/Timeout/timeout(_:clock:tolerance:customError:)":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Timeout\/timeout(_:clock:tolerance:customError:)","title":"timeout(_:clock:tolerance:customError:)","url":"\/documentation\/afluent\/asyncsequences\/timeout\/timeout(_:clock:tolerance:cu