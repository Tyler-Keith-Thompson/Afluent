t14AsyncSequencesO","text":"AsyncSequences","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO7TimeoutV","text":"Timeout","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:12_Concurrency15SuspendingClockV","text":"SuspendingClock","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":[{"unavailable":false,"introducedAt":"16.0","name":"iOS","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"16.0","name":"iPadOS","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"16.0","name":"Mac Catalyst","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"13.0","name":"macOS","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"16.0","name":"tvOS","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"1.0","name":"visionOS","deprecated":false,"beta":false},{"unavailable":false,"introducedAt":"9.0","name":"watchOS","deprecated":false,"beta":false}],"modules":[{"relatedModules":["_Concurrency"],"name":"Afluent"}],"roleHeading":"Instance Method","role":"symbol","title":"timeout(_:customError:)","remoteSource":{"fileName":"TimeoutSequence.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SequenceOperators\/TimeoutSequence.swift#L176"}},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"timeout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"duration","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s8DurationV","text":"Duration","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"customError","kind":"externalParam"},{"text":": (any ","kind":"text"},{"preciseIdentifier":"s:s5ErrorP","text":"Error","kind":"typeIdentifier"},{"text":")? = nil) -> ","kind":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO","text":"AsyncSequences","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Timeout","preciseIdentifier":"s:7Afluent14AsyncSequencesO7TimeoutV","text":"Timeout","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:12_Concurrency15SuspendingClockV","text":"SuspendingClock","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"duration","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The longest the sequence may go without an element."}]}]},{"name":"customError","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The error to throw when the timer fires. Defaults to"},{"type":"text","text":" "},{"type":"codeVoice","code":"TimeoutError.timedOut(duration:)"},{"type":"text","text":"."}]}]}]},{"kind":"content","content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"A sequence of the same elements that throws if the upstream goes quiet."}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The timer starts when iteration begins and restarts with every element, so it bounds the"},{"type":"text","text":" "},{"type":"text","text":"wait for the first element and each gap after it, never the sequence as a whole. Elements"},{"type":"text","text":" "},{"type":"text","text":"pass through unchanged. When the timer fires, the upstream is cancelled and the sequence"},{"type":"text","text":" "},{"type":"text","text":"throws."}],"type":"paragraph"},{"inlineContent":[{"text":"The upstream is read ahead of the consumer, and elements it produces while the consumer is","type":"text"},{"text":" ","type":"text"},{"text":"busy are buffered, so the timer measures the upstream’s gaps. A duration of zero or less","type":"text"},{"text":" ","type":"text"},{"text":"throws before the first element.","type":"text"}],"type":"paragraph"},{"text":"Example","anchor":"Example","level":2,"type":"heading"},{"syntax":"swift","code":["for try await event in serverEvents.timeout(.seconds(30)) {","    handle(event)","}","\/\/ Throws TimeoutError.timedOut if 30 seconds pass without an event"],"type":"codeListing"},{"name":"Throws","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"TimeoutError","type":"codeVoice"},{"text":" (or ","type":"text"},{"code":"customError","type":"codeVoice"},{"text":") when ","type":"text"},{"code":"duration","type":"codeVoice"},{"text":" passes between elements, and","type":"text"},{"text":" ","type":"text"},{"text":"any error the upstream throws.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"On WASI, a sleep on a real clock (","type":"text"},{"code":"ContinuousClock","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SuspendingClock","type":"codeVoice"},{"text":") holds the one thread","type":"text"},{"text":" ","type":"text"},{"text":"until its deadline, even when other work is ready, and cancelling it doesn’t end it sooner. So the","type":"text"},{"text":" ","type":"text"},{"text":"timer can hold the thread before the upstream runs, then count that wait against it and throw even","type":"text"},{"text":" ","type":"text"},{"text":"though elements were ready. A test clock is unaffected.","type":"text"}]}],"style":"note","type":"aside"}]}],"references":{"doc://Afluent/documentation/Afluent/_Concurrency/AsyncSequence/timeout(_:clock:tolerance:customError:)":{"kind":"symbol","fragments"