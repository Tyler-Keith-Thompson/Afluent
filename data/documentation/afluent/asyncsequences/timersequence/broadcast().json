://Afluent/documentation/Afluent/AsyncSequences/TimerSequence":{"title":"AsyncSequences.TimerSequence","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/TimerSequence","url":"\/documentation\/afluent\/asyncsequences\/timersequence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TimerSequence","kind":"identifier"}],"type":"topic","abstract":[{"text":"A timer-based asynchronous sequence that emits the current instant of a specified clock","type":"text"},{"text":" ","type":"text"},{"text":"at a regular interval.","type":"text"}],"navigatorTitle":[{"text":"TimerSequence","kind":"identifier"}],"kind":"symbol","role":"symbol"}}}