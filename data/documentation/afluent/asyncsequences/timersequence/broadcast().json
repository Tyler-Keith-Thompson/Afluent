ndable"},{"type":"text","text":"."}]},"url":"\/documentation\/afluent\/asyncsequences\/timersequence\/broadcast()","title":"broadcast()","role":"symbol"},"doc://Afluent/documentation/Afluent":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent","title":"Afluent","type":"topic","kind":"symbol","role":"collection","abstract":[],"url":"\/documentation\/afluent"}}}