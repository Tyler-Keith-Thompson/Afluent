://Afluent/documentation/Afluent/AsyncSequences/TimerSequence":{"title":"AsyncSequences.TimerSequence","kind":"symbol","url":"\/documentation\/afluent\/asyncsequences\/timersequence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TimerSequence","kind":"identifier"}],"role":"symbol","abstract":[{"text":"A timer-based asynchronous sequence that emits the current instant of a specified clock","type":"text"},{"text":" ","type":"text"},{"text":"at a regular interval.","type":"text"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/TimerSequence","type":"topic","navigatorTitle":[{"text":"TimerSequence","kind":"identifier"}]}}}