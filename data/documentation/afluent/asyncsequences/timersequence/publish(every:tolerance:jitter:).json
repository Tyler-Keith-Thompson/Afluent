lockV","text":"ContinuousClock"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency15ContinuousClockV8Durationa","text":"Duration"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"jitter"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter","preciseIdentifier":"s:7Afluent13BackoffJitterV","text":"BackoffJitter"},{"kind":"text","text":" = .none) -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO","text":"AsyncSequences"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/TimerSequence","preciseIdentifier":"s:7Afluent14AsyncSequencesO13TimerSequenceV","text":"TimerSequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"C"},{"kind":"text","text":">"}]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The time interval between emitted instants."}],"type":"paragraph"}],"name":"interval"},{"content":[{"type":"paragraph","inlineContent":[{"text":"An optional tolerance for scheduling, allowing slight variance in timing.","type":"text"}]}],"name":"tolerance"},{"content":[{"inlineContent":[{"type":"text","text":"Where each tick falls inside its period. Defaults to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/none"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"ticks at the end of each period. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/full(using:)"},{"type":"text","text":" ticks anywhere in it,"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/equal(using:)"},{"type":"text","text":" in its second h