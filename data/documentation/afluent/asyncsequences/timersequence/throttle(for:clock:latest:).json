, ","kind":"text"},{"text":"clock","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"latest","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO","text":"AsyncSequences","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO8ThrottleV","text":"Throttle","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"C","kind":"typeIdentifier"},{"text":">","kind":"text"}],"type":"topic","url":"\/documentation\/afluent\/asyncsequences\/timersequence\/throttle(for:clock:latest:)","kind":"symbol","abstract":[{"type":"text","text":"Allows only one element to pass through during each specified interval, emitting either the first or the latest element seen in that period."}]},"doc://Afluent/documentation/Afluent":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent","title":"Afluent","role":"collection","abstract":[],"url":"\/documentation\/afluent","kind":"symbol","type":"topic"},"doc://Afluent/documentation/Afluent/AsyncSequences/Throttle":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Throttle","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/afluent\/asyncsequences\/throttle","abstract":[],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Throttle","role":"symbol","navigatorTitle":[{"text":"Throttle","kind":"identifier"}],"title":"AsyncSequences.Throttle"}}}