t":"Error","preciseIdentifier":"s:s5ErrorP","kind":"typeIdentifier"},{"text":")? = nil) -> ","kind":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","text":"AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Timeout","text":"Timeout","preciseIdentifier":"s:7Afluent14AsyncSequencesO7TimeoutV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"SuspendingClock","preciseIdentifier":"s:12_Concurrency15SuspendingClockV","kind":"typeIdentifier"},{"text":">","kind":"text"}],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The longest the sequence may go without an element.","type":"text"}]}],"name":"duration"},{"content":[{"inlineContent":[{"text":"The error to throw when the timer fires. Defaults to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"TimeoutError.timedOut(duration:)"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"customError"}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A sequence of the same elements that throws if the upstream goes quiet."}]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The timer starts when iteration begins and restarts with every element, so it bounds the","type":"text"},{"text":" ","type":"text"},{"text":"wait for the first element and each gap after it, never the sequence as a whole. Elements","type":"text"},{"text":" ","type":"text"},{"text":"pass through unchanged. When the timer fires, the upstream is cancelled and the sequence","type":"text"},{"text":" ","type":"text"},{"text":"throws.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The upstream is read ahead of the consumer, and elements it produces while the consumer is"},{"type":"text","text":" "},{"type":"text","text":"busy are buffered, so the timer measures the upstream’s gaps. A duration of zero or less"},{"type":"text","text":" "},{"type":"text","text":"throws before the first element."}]},{"anchor":"Example","level":2,"type":"heading","text":"Example"},{"syntax":"swift","type":"codeListing","code":["for try await event in serverEvents.timeout(.seconds(30)) {","    handle(event)","}","\/\/ Throws TimeoutError.timedOut if 30 seconds pass without an event"]},{"content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"TimeoutError"},{"text":" (or ","type":"text"},{"type":"codeVoice","code":"customError"},{"text":") when ","type":"text"},{"type":"codeVoice","code":"duration"},{"text":" passes between elements, and","type":"text"},{"text":" ","type":"text"},{"text":"any error the upstream throws.","type":"text"}],"type":"paragraph"}],"name":"Throws","style":"note","type":"aside"},{"content":[{"type":"paragraph","inlineContent":[{"text":"On WASI, a sleep on a real clock (","type":"text"},{"type":"codeVoice","code":"ContinuousClock"},{"text":", ","type":"text"},{"type":"codeVoice","code":"SuspendingClock"},{"text":") holds the one thread","type":"text"},{"text":" ","type":"text"},{"text":"until its deadline, even when other work is ready, and cancelling it doesn’t end it sooner. So the","type":"text"},{"text":" ","type":"text"},{"text":"timer can hold the thread before the upstream runs, then count that wait against it and throw even","type":"text"},{"text":" ","type":"text"},{"text":"though elements were ready. A test clock is unaffected.","type":"text"}]}],"name":"Note","style":"note","type":"aside"}]}],"references":{"doc://Afluent/documentation/Afluent/_Concurrency/AsyncSequence/timeout(_:clock:tolerance:customError:)":{"k