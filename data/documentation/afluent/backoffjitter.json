Active":true},{"type":"text","text":": anywhere from zero up to the nominal wait."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/equal(using:)","type":"reference","isActive":true},{"type":"text","text":": half the nominal wait, plus anywhere up to the other half."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/decorrelated(using:)"},{"text":": at least the nominal wait, and up to three times the previous wait","type":"text"},{"text":" ","type":"text"},{"text":"this jitter produced, so the waits spread further apart the longer they go on.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Each random kind draws from the generator it was given, one value per wait, so a seeded","type":"text"},{"text":" ","type":"text"},{"text":"generator makes the waits reproducible. A jitter value holds its generator, and for","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/decorrelated(using:)"},{"text":" the previous wait, by reference: copies of a value share them, and so","type":"text"},{"text":" ","type":"text"},{"text":"do the operators it is passed to. Make a new value for each operator that should have its own.","type":"text"}],"type":"paragraph"},{"anchor":"Example","level":2,"type":"heading","text":"Example"},{"syntax":"swift","code":["let backoff = ExponentialBackoffStrategy(base: 2, maxDelay: .seconds(60), jitter: .equal())","let heartbeat = TimerSequence.publish(every: .seconds(30), jitter: .full())"],"type":"codeListing"}]}],"references":{"doc://Afluent/documentation/Afluent/BackoffJitter":{"abstract":[{"type":"text","text":"How a wait is randomized, so many clients that started waiting together don’t all wake together."}],"role":"symbol","fragm