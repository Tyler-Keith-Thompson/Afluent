nd":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BackoffJitter"}],"languages":["swift"],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Jitter takes a nominal wait and picks the wait to use instead. It works on any clock’s"},{"type":"text","text":" "},{"code":"Duration","type":"codeVoice"},{"type":"text","text":", and the operators that wait take it as a "},{"code":"jitter:","type":"codeVoice"},{"type":"text","text":" parameter:"},{"type":"text","text":" "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/ExponentialBackoffStrategy","isActive":true,"type":"reference"},{"type":"text","text":" (each backoff delay), "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/TimerSequence","isActive":true,"type":"reference"},{"type":"text","text":" (where"},{"type":"text","text":" "},{"type":"text","text":"each tick falls inside its period) and "},{"code":"delay","type":"codeVoice"},{"type":"text","text":" on units of work and sequences (each wait)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The kinds follow “Exponential Backoff and Jitter” (AWS Architecture Blog):"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/none","isActive":true},{"type":"text","text":": the nominal wait, exactly."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/full(using:)"},{"type":"text","text":": anywhere from zero up to the nominal wait."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/equal(using:)","isActive":true},{"type":"text","text":": half the nominal wait, plus anywhere up to the other half."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/decorrelated(using:)","type":"reference"},{"text":": at least the nominal wait, and up to three times the previous wait","type":"text"},{"text":" ","type":"text"},{"text":"this jitter produced, so the waits spread further apart the longer they go on.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Each random kind draws from the generator it was given, one value per wait, so a seeded","type":"text"},{"text":" ","type":"text"},{"text":"generator makes the waits reproducible. A jitter value holds its generator, and for","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/decorrelated(using:)","type":"reference"},{"text":" the previous wait, by reference: copies of a value share them, and so","type":"text"},{"text":" ","type":"text"},{"text":"do the operators it is passed to. Make a new value for each operator that should have its own.","type":"text"}],"type":"paragraph"},{"text":"Example","level":2,"anchor":"Example","type":"heading"},{"code":["let backoff = ExponentialBackoffStrategy(base: 2, maxDelay: .seconds(60), jitter: .equal())","let heartbeat = TimerSequence.publish(every: .seconds(30), jitter: .full())"],"syntax":"swift","type":"codeListing"}]}],"variants":[{"paths":["\/documentation\/afluent\/backoffjitter"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"How a wait is randomized, so many clients that started waiting together don’t all wake together.","type":"text"}],"references":{"doc://Afluent/s16SendableMetatypeP":{"identifier":"doc:\/\/Afluent\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://Afluent/documentation/Afluent/BackoffJitter/decorrelated