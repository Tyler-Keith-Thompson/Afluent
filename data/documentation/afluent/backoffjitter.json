ext","text":" "},{"kind":"identifier","text":"BackoffJitter"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"Jitter takes a nominal wait and picks the wait to use instead. It works on any clock’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"Duration"},{"type":"text","text":", and the operators that wait take it as a "},{"type":"codeVoice","code":"jitter:"},{"type":"text","text":" parameter:"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/ExponentialBackoffStrategy"},{"type":"text","text":" (each backoff delay), "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/TimerSequence"},{"type":"text","text":" (where"},{"type":"text","text":" "},{"type":"text","text":"each tick falls inside its period) and "},{"type":"codeVoice","code":"delay"},{"type":"text","text":" on units of work and sequences (each wait)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The kinds follow “Exponential Backoff and Jitter” (AWS Architecture Blog):"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/none"},{"type":"text","text":": the nominal wait, exactly."}]}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/full(using:)"},{"type":"text","text":": anywhere from zero up to the nominal wait."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/equal(using:)","isActive":true,"type":"reference"},{"text":": half the nominal wait, plus anywhere up to the other half.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/decorrelated(using:)"},{"type":"text","text":": at least the nominal wait, and up to three times the previous wait"},{"type":"text","text":" "},{"type":"text","text":"this jitter produced, so the waits spread further apart the longer they go on."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Each random kind draws from the generator it was given, one value per wait, so a seeded","type":"text"},{"text":" ","type":"text"},{"text":"generator makes the waits reproducible. A jitter value holds its generator, and for","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/decorrelated(using:)","type":"reference"},{"text":" the previous wait, by reference: copies of a value share them, and so","type":"text"},{"text":" ","type":"text"},{"text":"do the operators it is passed to. Make a new value for each operator that should have its own.","type":"text"}],"type":"paragraph"},{"text":"Example","type":"heading","level":2,"anchor":"Example"},{"syntax":"swift","type":"codeListing","code":["let backoff = ExponentialBackoffStrategy(base: 2, maxDelay: .seconds(60), jitter: .equal())","let heartbeat = TimerSequence.publish(every: .seconds(30), jitter: .full())"]}]}],"sections":[],"abstract":[{"type":"text","text":"How a wait is randomized, so many clients that started waiting together don’t all wake together."}],"relationshipsSections":[{"identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://Afluent/documentation/Afluent/BackoffJitter/decorrelated(using:)":{"type":"topic","url":"\/documentation\/afluent\/backoffjitter\/decorrelated(using:)","role":"symbol","kind":"symbol","abstract":[{"type"