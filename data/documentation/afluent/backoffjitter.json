{"metadata":{"platforms":[{"unavailable":false,"beta":false,"introducedAt":"16.0","deprecated":false,"name":"iOS"},{"unavailable":false,"beta":false,"introducedAt":"16.0","deprecated":false,"name":"iPadOS"},{"unavailable":false,"beta":false,"introducedAt":"16.0","deprecated":false,"name":"Mac Catalyst"},{"unavailable":false,"beta":false,"introducedAt":"13.0","deprecated":false,"name":"macOS"},{"unavailable":false,"beta":false,"introducedAt":"16.0","deprecated":false,"name":"tvOS"},{"unavailable":false,"beta":false,"introducedAt":"9.0","deprecated":false,"name":"watchOS"}],"symbolKind":"struct","navigatorTitle":[{"text":"BackoffJitter","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BackoffJitter","kind":"identifier"}],"remoteSource":{"fileName":"BackoffJitter.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/RetryStrategies\/BackoffJitter.swift#L31"},"externalID":"s:7Afluent13BackoffJitterV","roleHeading":"Structure","title":"BackoffJitter","modules":[{"name":"Afluent"}]},"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"variants":[{"paths":["\/documentation\/afluent\/backoffjitter"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BackoffJitter"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Jitter takes a nominal wait and picks the wait to use instead. It works on any clock’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"Duration"},{"type":"text","text":", and the operators that wait take it as a "},{"type":"codeVoice","code":"jitter:"},{"type":"text","text":" parameter:"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/ExponentialBackoffStrategy"},{"type":"text","text":" (each backoff delay), "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/TimerSequence"},{"type":"text","text":" (where"},{"type":"text","text":" "},{"type":"text","text":"each tick falls inside its period) and "},{"type":"codeVoice","code":"delay"},{"type":"text","text":" on units of work and sequences (each wait)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The kinds follow “Exponential Backoff and Jitter” (AWS Architecture Blog):"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/none"},{"type":"text","text":": the nominal wait, exactly."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/full(using:)","type":"reference"},{"text":": anywhere from zero up to the nominal wait.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/equal(using:)"},{"type":"text","text":": half the nominal wait, plus anywhere up to the other half."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/decorrelated(using:)","type":"reference","isActive":true},{"type":"text","text":": at least the nominal wait, and up to three times the previous wait"},{"type":"text","text":" "},{"type":"text","text":"this jitter produced, so the waits spread further apart the longer they go on."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Each random kind draws from the generator it was given, one value per wait, so a seeded","type":"text"},{"text":" ","type":"text"},{"text":"generator makes the waits reproducible. A jitter value holds its generator, and for","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/decorrelated(using:)","isActive":true,"type":"reference"},{"text":" the previous wait, by reference: copies of a value share them, and so","type":"text"},{"text":" ","type":"text"},{"text":"do the operators it is passed to. Make a new value for each operator that should have its own.","type":"text"}],"type":"paragraph"},{"text":"Example","level":2,"anchor":"Example","type":"heading"},{"syntax":"swift","code":["let backoff = ExponentialBackoffStrategy(base: 2, maxDelay: .seconds(60), jitter: .equal())","let heartbeat = TimerSequence.publish(every: .seconds(30), jitter: .full())"],"type":"codeListing"}]}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP"]}],"topicSections":[{"title":"Type Properties","anchor":"Type-Properties","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/none"]},{"title":"Type Methods","anchor":"Type-Methods","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/decorrelated(using:)","doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/equal(using:)","doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/full(using:)"]}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"How a wait is randomized, so many clients that started waiting together don’t all wake together."}],"references":{"doc://Afluent/documentation/Afluent/BackoffJitter/none":{"role":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/none","abstract":[{"type":"text","text":"Waits exactly the nominal