xt":" ","kind":"text"},{"text":"BackoffJitter","kind":"identifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Jitter takes a nominal wait and picks the wait to use instead. It works on any clock’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"Duration"},{"type":"text","text":", and the operators that wait take it as a "},{"type":"codeVoice","code":"jitter:"},{"type":"text","text":" parameter:"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/ExponentialBackoffStrategy","isActive":true},{"type":"text","text":" (each backoff delay), "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/TimerSequence","isActive":true},{"type":"text","text":" (where"},{"type":"text","text":" "},{"type":"text","text":"each tick falls inside its period) and "},{"type":"codeVoice","code":"delay"},{"type":"text","text":" on units of work and sequences (each wait)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The kinds follow “Exponential Backoff and Jitter” (AWS Architecture Blog):"}]},{"items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/none"},{"type":"text","text":": the nominal wait, exactly."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/full(using:)","isActive":true},{"type":"text","text":": anywhere from zero up to the nominal wait."}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/equal(using:)","isActive":true,"type":"reference"},{"text":": half the nominal wait, plus anywhere up to the other half.","type":"text"}],"type":"paragraph"}]},{"c