{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter"},"abstract":[{"text":"How a wait is randomized, so many clients that started waiting together don’t all wake together.","type":"text"}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"BackoffJitter"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Jitter takes a nominal wait and picks the wait to use instead. It works on any clock’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Duration"},{"text":", and the operators that wait take it as a ","type":"text"},{"type":"codeVoice","code":"jitter:"},{"text":" parameter:","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/ExponentialBackoffStrategy","type":"reference","isActive":true},{"text":" (each backoff delay), ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/TimerSequence","type":"reference","isActive":true},{"text":" (where","type":"text"},{"text":" ","type":"text"},{"text":"each tick falls inside its period) and ","type":"text"},{"type":"codeVoice","code":"delay"},{"text":" on units of work and sequences (each wait).","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The kinds follow “Exponential Backoff and Jitter” (AWS Architecture Blog):"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/none"},{"type":"text","text":": the nominal wait, exactly."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/full(using:)","type":"reference","isActive":true},{"type":"text","text":": anywhere from zero up to the nominal wait."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/equal(using:)"},{"type":"text","text":": half the nominal wait, plus anywhere up to the other half."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/decorrelated(using:)"},{"type":"text","text":": at least the nominal wait, and up to three times the previous wait"},{"type":"text","text":" "},{"type":"text","text":"this jitter produced, so the waits spread further apart the longer they go on."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each random kind draws from the generator it was given, one value per wait, so a seeded"},{"type":"text","text":" "},{"type":"text","text":"generator makes the waits reproducible. A jitter value holds its generator, and for"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/decorrelated(using:)","isActive":true},{"type":"text","text":" the previous wait, by reference: copies of a value share them, and so"},{"type":"text","text":" "},{"type":"text","text":"do the operators it is passed to. Make a new value for each operator that should have its own."}]},{"anchor":"Example","level":2,"type":"heading","text":"Example"},{"code":["let backoff = ExponentialBackoffStrategy(base: 2, maxDelay: .seconds(60), jitter: .equal())","let heartbeat = TimerSequence.publish(every: .seconds(30), jitter: .full())"],"type":"codeListing","syntax":"swift"}]}],"metadata":{"title":"BackoffJitter","modules":[{"name":"Afluent"}],"symbolKind":"struct","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/RetryStrategies\/BackoffJitter.swift#L31","fileName":"BackoffJitter.swift"},"externalID":"s:7Afluent13BackoffJitterV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BackoffJitter","kind":"identifier"}],"roleHeading":"Structure","role":"symbol","platforms":[{"deprecated":false,"beta":false,"introducedAt":"16.0","unavailable":false,"name":"iOS"},{"deprecated":false,"beta":false,"introducedAt":"16.0","unavailable":false,"name":"iPadOS"},{"deprecated":false,"beta":false,"introducedAt":"16.0","unavailable":false,"name":"Mac Catalyst"},{"deprecated":false,"beta":false,"introducedAt":"13.0","unavailable":false,"name":"macOS"},{"deprecated":false,"beta":false,"introducedAt":"16.0","unavailable":false,"name":"tvOS"},{"deprecated":false,"beta":false,"introducedAt":"9.0","unavailable":false,"name":"watchOS"}],"navigatorTitle":[{"text":"BackoffJitter","kind":"identifier"}]},"variants":[{"paths":["\/documentation\/afluent\/backoffjitter"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"generated":true,"title":"Type Properties","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/none"],"anchor":"Type-Properties"},{"generated":true,"title":"Type Methods","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/decorrelated(using:)","doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/equal(using:)","doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/full(using:)"],"anchor":"Type-Methods"}],"references":{"doc://Afluent/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/Afluent\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://Afluent/documentation/Afluent/AsyncSequences/TimerSequen