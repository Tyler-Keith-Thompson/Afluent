{"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BackoffJitter","kind":"identifier"}]}]},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Jitter takes a nominal wait and picks the wait to use instead. It works on any clock’s"},{"type":"text","text":" "},{"code":"Duration","type":"codeVoice"},{"type":"text","text":", and the operators that wait take it as a "},{"code":"jitter:","type":"codeVoice"},{"type":"text","text":" parameter:"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/ExponentialBackoffStrategy","type":"reference"},{"type":"text","text":" (each backoff delay), "},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/TimerSequence","type":"reference"},{"type":"text","text":" (where"},{"type":"text","text":" "},{"type":"text","text":"each tick falls inside its period) and "},{"code":"delay","type":"codeVoice"},{"type":"text","text":" on units of work and sequences (each wait)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The kinds follow “Exponential Backoff and Jitter” (AWS Architecture Blog):"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/none","type":"reference","isActive":true},{"text":": the nominal wait, exactly.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/full(using:)"},{"type":"text","text":": anywhere from zero up to the nominal wait."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/equal(using:)","type":"reference"},{"text":": half the nominal wait, plus anywhere up to the other half.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/decorrelated(using:)"},{"text":": at least the nominal wait, and up to three times the previous wait","type":"text"},{"text":" ","type":"text"},{"text":"this jitter produced, so the waits spread further apart the longer they go on.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each random kind draws from the generator it was given, one value per wait, so a seeded"},{"type":"text","text":" "},{"type":"text","text":"generator makes the waits reproducible. A jitter value holds its generator, and for"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/decorrelated(using:)","isActive":true},{"type":"text","text":" the previous wait, by reference: copies of a value share them, and so"},{"type":"text","text":" "},{"type":"text","text":"do the operators it is passed to. Make a new value for each operator that should have its own."}]},{"text":"Example","level":2,"type":"heading","anchor":"Example"},{"type":"codeListing","code":["let backoff = ExponentialBackoffStrategy(base: 2, maxDelay: .seconds(60), jitter: .equal())","let heartbeat = TimerSequence.publish(every: .seconds(30), jitter: .full())"],"syntax":"swift"}]}],"sections":[],"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter","interfaceLanguage":"swift"},"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP"]}],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","te