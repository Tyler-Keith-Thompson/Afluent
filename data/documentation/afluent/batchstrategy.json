uilt-in ones in "},{"type":"codeVoice","code":".either(_:_:)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" is the batched sequence’s element: name it in "},{"type":"codeVoice","code":"flushes(pending:)"},{"type":"text","text":", or make the"},{"type":"text","text":" "},{"type":"text","text":"strategy generic over it when only "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/run(_:)","isActive":true},{"type":"text","text":" matters."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/\/ Flushes after each line, so every batch ends at a line break.","struct LineBatchStrategy: BatchStrategy {","    func flushes(pending: [Character]) -> Bool {","        pending.last == \"\\n\"","    }","}","","\/\/ A batch per line, or whatever has arrived after a second without one.","let lines = characters.batch(strategy: .either(","    LineBatchStrategy(),","    .time(interval: .seconds(1), clock: ContinuousClock())))"]},{"inlineContent":[{"type":"text","text":"Batching needs iOS 16, Mac Catalyst 16, macOS 13, tvOS 16, watchOS 9 or visionOS 1."}],"type":"paragraph"}]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/batchstrategy"]}],"topicSections":[{"anchor":"Associated-Types","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/Element"],"title":"Associated Types"},{"anchor":"Instance-Methods","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/flushes(pending:)","doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/run(_:)"],"title":"Instance Methods"},{"anchor":"Type-Methods","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/count(_:)","doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/either(_:_:)","doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/signal(_:)-5o