{"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy"},"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"metadata":{"symbolKind":"protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchStrategy","kind":"identifier"}],"remoteSource":{"fileName":"BatchStrategy.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SequenceOperators\/BatchStrategy.swift#L56"},"navigatorTitle":[{"text":"BatchStrategy","kind":"identifier"}],"modules":[{"name":"Afluent"}],"role":"symbol","roleHeading":"Protocol","title":"BatchStrategy","platforms":[{"unavailable":false,"beta":false,"name":"iOS","introducedAt":"16.0","deprecated":false},{"unavailable":false,"beta":false,"name":"iPadOS","introducedAt":"16.0","deprecated":false},{"unavailable":false,"beta":false,"name":"Mac Catalyst","introducedAt":"16.0","deprecated":false},{"unavailable":false,"beta":false,"name":"macOS","introducedAt":"13.0","deprecated":false},{"unavailable":false,"beta":false,"name":"tvOS","introducedAt":"16.0","deprecated":false},{"unavailable":false,"beta":false,"name":"visionOS","introducedAt":"1.0","deprecated":false},{"unavailable":false,"beta":false,"name":"watchOS","introducedAt":"9.0","deprecated":false}],"externalID":"s:7Afluent13BatchStrategyP"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchStrategy"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Element","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/Element","preciseIdentifier":"s:7Afluent13BatchStrategyP7ElementQa"},{"kind":"text","text":"> : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}]}]},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A strategy flushes the pending elements as one array in either of two ways: when an element"},{"type":"text","text":" "},{"type":"text","text":"arrives, by returning "},{"type":"codeVoice","code":"true"},{"type":"text","text":" from "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/flushes(pending:)","isActive":true},{"type":"text","text":", or on events of its own (a timer, a"},{"type":"text","text":" "},{"type":"text","text":"signal), by calling "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchFlusher\/flush()","isActive":true},{"type":"text","text":" from "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/run(_:)","isActive":true},{"type":"text","text":". After every flush, whatever its"},{"type":"text","text":" "},{"type":"text","text":"cause, each strategy starts over. A flush with nothing pending emits nothing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The built-in strategies are "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/CountBatchStrategy","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/TimeBatchStrategy","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","type":"reference","isActive":true},{"type":"text","text":" (over a sequence or a unit of work) and "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/EitherBatchStrategy","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"spelled "},{"code":".count(_:)","type":"codeVoice"},{"type":"text","text":", "},{"code":".time(interval:clock:tolerance:)","type":"codeVoice"},{"type":"text","text":", "},{"code":".signal(_:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":".either(_:_:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"where a strategy is expected."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Up to 100 events per upload, and at least one upload every 5 seconds while events arrive.","let events = analyticsEvents.batch(strategy: .either(","    .count(100),","    .time(interval: .seconds(5), clock: ContinuousClock())))","for try await batch in events {","    try await upload(batch)","}"]},{"level":2,"anchor":"Writing-a-strategy","text":"Writing a strategy","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Conform a type to ","type":"text"},{"code":"BatchStrategy","type":"codeVoice"},{"text":" and implement either requirement, or both; each has a","type":"text"},{"text":" ","type":"text"},{"text":"default that never flushes. Implement ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/flushes(pending:)","type":"reference"},{"text":" to decide from the pending","type":"text"},{"text":" ","type":"text"},{"text":"elements, after each one arrives. Implement ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/run(_:)","type":"reference"},{"text":" to flush on events of your own: it","type":"text"},{"text":" ","type":"text"},{"text":"runs in a task of its own while the batched sequence is iterated, and is cancelled when the","type":"text"},{"text":" ","type":"text"},{"text":"batched sequence ends. A custom strategy composes with the built-in ones in ","type":"text"},{"code":".either(_:_:)","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" is the batched sequence’s element: name it in ","type":"text"},{"code":"flushes(pending:)","type":"codeVoice"},{"text":", or make the","type":"text"},{"text":" ","type":"text"},{"text":"strategy generic over it when only ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/run(_:)","type":"reference"},{"text":" matters.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/\/ Flushes after each line, so every batch ends at a line break.","struct LineBatchStrategy: BatchStrategy {","    func flushes(pending: [Character]) -> Bool {","        pending.last == \"\\n\"","    }","}","","\/\/ A batch per line, or whatever has arrived after a second without one.","let lines = characters.batch(strategy: .either(","    LineBatchStrategy(),","    .time(interval: .seconds(1), clock: ContinuousClock())))"]},{"type":"paragraph","inlineContent":[{"text":"Batching needs iOS 16, Mac Catalyst 16, macOS 13, tvOS 16, watchOS 9 or visionOS 1.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/batchstrategy"]}],"relationshipsSections":[{"type":"inheritsFrom","kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP"]},{"type":"conformingTypes","kind":"relationships","title":"Conforming Types","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/CountBatchStrategy","doc:\/\/Afluent\/documentation\/Afluent\/EitherBatchStrategy","doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","doc:\/\/Afluent\/documentation\/Afluent\/TimeBatchStrategy"]}],"sections":[],"kind":"symbol","topicSections":[{"generated":true,"title":"Associated Types","anchor":"Associated-Types","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/Element"]},{"generated":true,"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/flushes(pending:)","doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/run(_:)"]},{"generated":true,"title":"Type Methods","anchor":"Type-Methods","identifier