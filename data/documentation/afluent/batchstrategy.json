eVoice","code":".signal(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":".either(_:_:)"},{"type":"text","text":" "},{"type":"text","text":"where a strategy is expected."}]},{"type":"codeListing","code":["\/\/ Up to 100 events per upload, and at least one upload every 5 seconds while events arrive.","let events = analyticsEvents.batch(strategy: .either(","    .count(100),","    .time(interval: .seconds(5), clock: ContinuousClock())))","for try await batch in events {","    try await upload(batch)","}"],"syntax":"swift"},{"anchor":"Writing-a-strategy","type":"heading","text":"Writing a strategy","level":2},{"type":"paragraph","inlineContent":[{"text":"Conform a type to ","type":"text"},{"code":"BatchStrategy","type":"codeVoice"},{"text":" and implement either requirement, or both; each has a","type":"text"},{"text":" ","type":"text"},{"text":"default that never flushes. Implement ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/flushes(pending:)","isActive":true,"type":"reference"},{"text":" to decide from the pending","type":"text"},{"text":" ","type":"text"},{"text":"elements, after each one arrives. Implement ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/run(_:)","isActive":true,"type":"reference"},{"text":" to flush on events of your own: it","type":"text"},{"text":" ","type":"text"},{"text":"runs in a task of its own while the batched sequence is iterated, and is cancelled when the","type":"text"},{"text":" ","type":"text"},{"text":"batched sequence ends. A custom strategy composes with the built-in ones in ","type":"text"},{"code":".either(_:_:)","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" is the batched sequence’s element: name it in ","type":"text"},{"code":"flushes(pending:)","type":"codeVoice"},{"text":", or make the","type":"text"},{"text":" ","type":"text"},{"text":"strategy generic over it when only ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/run(_:)","isActive":true,"type":"reference"},{"text":" matters.","type":"text"}]},{"type":"codeListing","code":["\/\/\/ Flushes after each line, so every batch ends at a line break.","struct LineBatchStrategy: BatchStrategy {","    func flushes(pending: [Character]) -> Bool {","        pending.last == \"\\n\"","    }","}","","\/\/ A batch per line, or whatever has arrived after a second without one.","let lines = characters.batch(strategy: .either(","    LineBatchStrategy(),","    .time(interval: .seconds(1), clock: ContinuousClock())))"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Batching needs iOS 16, Mac Catalyst 16, macOS 13, tvOS 16, watchOS 9 or visionOS 1."}]}],"kind":"content"}],"metadata":{"symbolKind":"protocol","externalID":"s:7Afluent13BatchStrategyP","platforms":[{"introducedAt":"16.0","deprecated":false,"beta":false,"unavailable":false,"name":"iOS"},{"introducedAt":"16.0","deprecated":false,"beta":false,"unavailable":false,"name":"iPadOS"},{"introducedAt":"16.0","deprecated":false,"beta":false,"unavailable":false,"name":"Mac Catalyst"},{"introducedAt":"13.0","deprecated":false,"beta":false,"unavailable":false,"name":"macOS"},{"introducedAt":"16.0","deprecated":false,"beta":false,"unavailable":false,"name":"tvOS"},{"introducedAt":"1.0","deprecated":false,"beta":false,"unavailable":false,"name":"visionOS"},{"introducedAt":"9.0","deprecated":false,"beta":false,"unavailable":false,"name":"watchOS"}],"title":"BatchStrategy","navigatorTitle":[{"text":"BatchStrategy","kind":"identifier"}],"roleHeading":"Protocol","role":"symbol","modules":[{"name":"Afluent"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SequenceOperators\/BatchStrategy.swift#L56","fileName":"BatchStrategy.swift"},"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text