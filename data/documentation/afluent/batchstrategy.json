 A custom strategy composes with the built-in ones in "},{"type":"codeVoice","code":".either(_:_:)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" is the batched sequence’s element: name it in "},{"type":"codeVoice","code":"flushes(pending:)"},{"type":"text","text":", or make the"},{"type":"text","text":" "},{"type":"text","text":"strategy generic over it when only "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/run(_:)"},{"type":"text","text":" matters."}],"type":"paragraph"},{"code":["\/\/\/ Flushes after each line, so every batch ends at a line break.","struct LineBatchStrategy: BatchStrategy {","    func flushes(pending: [Character]) -> Bool {","        pending.last == \"\\n\"","    }","}","","\/\/ A batch per line, or whatever has arrived after a second without one.","let lines = characters.batch(strategy: .either(","    LineBatchStrategy(),","    .time(interval: .seconds(1), clock: ContinuousClock())))"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Batching needs iOS 16, Mac Catalyst 16, macOS 13, tvOS 16, watchOS 9 or visionOS 1."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"BatchStrategy"}],"title":"BatchStrategy","platforms":[{"deprecated":false,"unavailable":false,"name":"iOS","introducedAt":"16.0","beta":false},{"deprecated":false,"unavailable":false,"name":"iPadOS","introducedAt":"16.0","beta":false},{"deprecated":false,"unavailable":false,"name":"Mac Catalyst","introducedAt":"16.0","beta":false},{"deprecated":false,"unavailable":false,"name":"macOS","introducedAt":"13.0","beta":false},{"deprecated":false,"unavailable":false,"name":"tvOS","introducedAt":"16.0","beta":false},{"deprecated":false,"unavailable":false,"name":"visionOS","introducedAt":"1.0","beta":false},{"deprecated":false,"unavailable":false,"name":"watchOS","introducedAt":