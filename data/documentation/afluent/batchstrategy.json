{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy"},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchStrategy"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/Element","preciseIdentifier":"s:7Afluent13BatchStrategyP7ElementQa","text":"Element"},{"kind":"text","text":"> : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A strategy flushes the pending elements as one array in either of two ways: when an element"},{"type":"text","text":" "},{"type":"text","text":"arrives, by returning "},{"code":"true","type":"codeVoice"},{"type":"text","text":" from "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/flushes(pending:)","isActive":true,"type":"reference"},{"type":"text","text":", or on events of its own (a timer, a"},{"type":"text","text":" "},{"type":"text","text":"signal), by calling "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchFlusher\/flush()","isActive":true,"type":"reference"},{"type":"text","text":" from "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/run(_:)","isActive":true,"type":"reference"},{"type":"text","text":". After every flush, whatever its"},{"type":"text","text":" "},{"type":"text","text":"cause, each strategy starts over. A flush with nothing pending emits nothing."}],"type":"paragraph"},{"inlineContent":[{"text":"The built-in strategies are ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/CountBatchStrategy"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/TimeBatchStrategy"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy"},{"text":" (over a sequence or a unit of work) and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/EitherBatchStrategy"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"spelled ","type":"text"},{"type":"codeVoice","code":".count(_:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":".time(interval:clock:tolerance:)"},{"text":", ","type":"text"},{"type":"codeVoice","code":".signal(_:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".either(_:_:)"},{"text":" ","type":"text"},{"text":"where a strategy is expected.","type":"text"}],"type":"paragraph"},{"code":["\/\/ Up to 100 events per upload, and at least one upload every 5 seconds while events arrive.","let events = analyticsEvents.batch(strategy: .either(","    .count(100),","    .time(interval: .seconds(5), clock: ContinuousClock())))","for try await batch in events {","    try await upload(batch)","}"],"syntax":"swift","type":"codeListing"},{"text":"Writing a strategy","level":2,"anchor":"Writing-a-strategy","type":"heading"},{"inlineContent":[{"text":"Conform a type to ","type":"text"},{"type":"codeVoice","code":"BatchStrategy"},{"text":" and implement either requirement, or both; each has a","type":"text"},{"text":" ","type":"text"},{"text":"default that never flushes. Implement ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/flushes(pending:)"},{"text":" to decide from the pending","type":"text"},{"text":" ","type":"text"},{"text":"elements, after each one arrives. Implement ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/r