lusher\/flush()","isActive":true,"type":"reference"},{"text":" from ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/run(_:)","isActive":true,"type":"reference"},{"type":"text","text":". After every flush, whatever its"},{"type":"text","text":" "},{"type":"text","text":"cause, each strategy starts over. A flush with nothing pending emits nothing."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The built-in strategies are "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/CountBatchStrategy","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/TimeBatchStrategy","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","isActive":true},{"type":"text","text":" (over a sequence or a unit of work) and "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/EitherBatchStrategy","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"spelled "},{"type":"codeVoice","code":".count(_:)"},{"type":"text","text":", "},{"type":"codeVoice","code":".time(interval:clock:tolerance:)"},{"type":"text","text":", "},{"type":"codeVoice","code":".signal(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":".either(_:_:)"},{"type":"text","text":" "},{"type":"text","text":"where a strategy is expected."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Up to 100 events per upload, and at least one upload every 5 seconds while events arrive.","let events = analyticsEvents.batch(strategy: .either(","    .count(100),","    .time(interval: .seconds(5), clock: ContinuousClock())))","for try await batch in events {","    try await upload(batch)","}"],"type":"codeListing"},{"anchor":"Writing-a-strategy","text":"Writing a strategy","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Conform a type to "},{"type":"codeVoice","code":"BatchStrategy"},{"type":"text","text":" and implement either requirement, or both; each has a"},{"type":"text","text":" "},{"type":"text","text":"default that never flushes. Implement "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/flushes(pending:)"},{"type":"text","text":" to decide from the pending"},{"type":"text","text":" "},{"type":"text","text":"elements, after each one arrives. Implement "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/run(_:)"},{"type":"text","text":" to flush on events of your own: it"},{"type":"text","text":" "},{"type":"text","text":"runs in a task of its own while the batched sequence is iterated, and is cancelled when the"},{"type":"text","text":" "},{"type":"text","text":"batched sequence ends. A custom strategy composes with the built-in ones in "},{"type":"codeVoice","code":".either(_:_:)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" is the batched sequence’s element: name it in "},{"type":"codeVoice","code":"flushes(pending:)"},{"type":"text","text":", or make the"},{"type":"text","text":" "},{"type":"text","text":"strategy generic over it when only "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/run(_:)"},{"type":"text","text":" matters."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/\/ Flushes after each line, so every batch ends at a line break.","struct LineBatchStrategy: BatchStrategy {","    func flushes(pending: [Character]) -> Bool {","        pending.last == \"\\n\"","    }","}","","\/\/ A batch per line, or whatever has arrived after a second without one.","let lines = characters.batch(strategy: .either(","    LineBatchStrategy(),","    .time(interval: .seconds(1), clock: ContinuousClock())))"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Batching needs iOS 16, Mac Catalyst 16, macOS 13, tvOS 16, watchOS 9 or visionOS 1."}],"type":"paragraph"}]}],"relationshipsSections":[{"title":"Inherits From","kind":"relationships","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP"],"type":"inheritsFrom"},{"title":"Conforming Types","kind":"relationships","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/CountBatchStrategy","doc:\/\/Afluent\/documentation\/Afluent\/EitherBatchStrategy","doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","doc:\/\/Afluent\/documentation\/Afluent\/TimeBatchStrategy"],"type":"conformingTypes"}],"references":{"doc://Afluent/documentation/Afluent/BatchStrategy":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchStrategy","kind":"identifier"}],"url":"\/documentation\/afluent\/batchstrategy","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","abstract":[{"type":"text","text":"When "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/batch(strategy:)","type":"reference","isActive":true},{"type":"text","text":" emits the elements it has gathered."}],"navigatorTitle":[{"text":"BatchStrategy","kind":"identifier"}],"type":"topic","role":"symbol","title":"BatchStrategy","kind":"symbol"},"doc://Afluent/documentation/Afluent/SignalBatchStrategy":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SignalBatchStrategy"}],"url":"\/documentation\/afluent\/signalbatchstrategy","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","abstract":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","type":"reference"},{"text":" that flushes each time a sequence produces an element.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"SignalBatchStr