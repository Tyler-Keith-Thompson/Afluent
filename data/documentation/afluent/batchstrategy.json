{"abstract":[{"type":"text","text":"When "},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/batch(strategy:)","type":"reference"},{"type":"text","text":" emits the elements it has gathered."}],"relationshipsSections":[{"type":"inheritsFrom","title":"Inherits From","kind":"relationships","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP"]},{"type":"conformingTypes","title":"Conforming Types","kind":"relationships","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/CountBatchStrategy","doc:\/\/Afluent\/documentation\/Afluent\/EitherBatchStrategy","doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","doc:\/\/Afluent\/documentation\/Afluent\/TimeBatchStrategy"]}],"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchStrategy"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:7Afluent13BatchStrategyP7ElementQa","kind":"typeIdentifier","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/Element","text":"Element"},{"kind":"text","text":"> : "},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"A strategy flushes the pending elements as one array in either of two ways: when an element","type":"text"},{"text":" ","type":"text"},{"text":"arrives, by returning ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" from ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/flushes(pending:)","isActive":true,"type":"reference"},{"text":", or on events of its own (a timer, a","type":"text"},{"text":" ","type":"text"},{"text":"signal), by calling ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchFlusher\/flush()","isActive":true,"type":"reference"},{"text":" from ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/run(_:)","isActive":true,"type":"reference"},{"text":". After every flush, whatever its","type":"text"},{"text":" ","type":"text"},{"text":"cause, each strategy starts over. A flush with nothing pending emits nothing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The built-in strategies are ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/CountBatchStrategy","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/TimeBatchStrategy","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","isActive":true,"type":"reference"},{"text":" (over a sequence or a unit of work) and ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/EitherBatchStrategy","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"spelled ","type":"text"},{"code":".count(_:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":".time(interval:clock:tolerance:)","type":"codeVoice"},{"text":", ","type":"text"},{"code":".signal(_:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".either(_:_:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"where a strategy is expected.","type":"text"}]},{"code":["\/\/ Up to 100 events per upload, and at least one upload every 5 seconds while events arrive.","let events = analyticsEvents.batch(strategy: .either(","    .count(100),","    .time(interval: .seconds(5), clock: ContinuousClock())))","for try await batch in events {","    try await upload(batch)","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Writing-a-strategy","type":"heading","text":"Writing a strategy","lev