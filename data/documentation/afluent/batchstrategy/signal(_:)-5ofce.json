ject alone. Each batched sequence iterated with this strategy runs the unit","type":"text"},{"text":" ","type":"text"},{"text":"anew and fires once when it completes.","type":"text"}]},{"type":"heading","text":"Example","level":2,"anchor":"Example"},{"type":"codeListing","syntax":"swift","code":["let reachable = DeferredTask { try await server.waitUntilReachable() }","for try await requests in outbox.batch(strategy: .either(.count(20), .signal(reachable))) {","    try await send(requests)","}"]}],"kind":"content"}],"sections":[],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/batchstrategy\/signal(_:)-5ofce"]}],"references":{"doc://Afluent/documentation/Afluent/SingleValueSubject":{"role":"symbol","abstract":[{"text":"A subject for bridging callback-based APIs to async\/await, emitting a single value or error.","type":"text"}],"url":"\/documentation\/afluent\/singlevaluesubject","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SingleValueSubject","kind":"identifier"}],"navigatorTitle":[{"text":"SingleValueSubject","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SingleValueSubject","title":"SingleValueSubject"},"doc://Afluent/documentation/Afluent/BatchStrategy":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchStrategy","kind":"identifier"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","type":"topic","url":"\/documentation\/afluent\/batchstrategy","role":"symbol","abstract":[{"type":"text","text":"When "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/batch(strategy:)","isActive":true,"type":"reference"},{"type":"text","text":" emits the elements it has gathered."}],"navigatorTitle":[{"text":"BatchStrategy","kind":"identifier"}],"title":"BatchStrategy","kind":"symbol"},"doc://Afluent/documentation/Afluent/SignalBa