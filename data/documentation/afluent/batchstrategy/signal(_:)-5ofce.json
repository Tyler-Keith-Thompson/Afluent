:)-88w9i","isActive":true,"type":"reference"},{"text":" instead, which","type":"text"},{"text":" ","type":"text"},{"text":"leaves the subject alone. Each batched sequence iterated with this strategy runs the unit","type":"text"},{"text":" ","type":"text"},{"text":"anew and fires once when it completes.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Example","level":2,"text":"Example"},{"type":"codeListing","syntax":"swift","code":["let reachable = DeferredTask { try await server.waitUntilReachable() }","for try await requests in outbox.batch(strategy: .either(.count(20), .signal(reachable))) {","    try await send(requests)","}"]}],"kind":"content"}],"references":{"doc://Afluent/documentation/Afluent/BatchStrategy/signal(_:)-5ofce":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/signal(_:)-5ofce","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"signal","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Batched","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Unit","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"Unit","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:7Afluent19SignalBatchStrategyV","text":"SignalBatchStrategy","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Batched","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO","text":"AsyncSequences","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO8DeferredV","text":"Deferred","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:Scs","text":"AsyncThrowingStream","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Unit","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP7SuccessQa","text":"S