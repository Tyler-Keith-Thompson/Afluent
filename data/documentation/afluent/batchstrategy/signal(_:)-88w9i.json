leP","text":"Sendable","kind":"typeIdentifier"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The subject whose value flushes the batch."}]}],"name":"subject"}]},{"content":[{"text":"Return Value","level":2,"type":"heading","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy"},{"type":"text","text":" over a stream of the subject’s one value, made afresh"},{"type":"text","text":" "},{"type":"text","text":"for each iteration."}]}],"kind":"content"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The batched sequence listens to the subject without owning it: when the batched sequence"},{"type":"text","text":" "},{"type":"text","text":"ends or is cancelled, its wait ends at once and the subject stays pending for its other"},{"type":"text","text":" "},{"type":"text","text":"awaiters. A subject sent an error ends the batched sequence with that error, except"},{"type":"text","text":" "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" (as when another awaiter cancels the subject): then the signal stops"},{"type":"text","text":" "},{"type":"text","text":"firing and the batches go on. A subject sent a value before iteration begins fires when the"},{"type":"text","text":" "},{"type":"text","text":"signal’s task starts, which may come after elements have arrived, so the first batch may be"},{"type":"text","text":" "},{"type":"text","text":"short. Each batched sequence iterated with this strategy listens anew, so a subject"},{"type":"text","text":" "},{"type":"text","text":"already sent a value fires again when a later batched sequence’s signal task starts."}]},{"level":2,"type":"heading","text":"Example","anchor":"Example"},{"type":"codeListing","code":["let shutdown = SingleValueSubject<Void>()","for try await messages in inbox.batch(strategy: .either(.count(50), .signal(shutdown))) {","    store(messages)","}","\/\/ Elsewhere: flush whatever is pending before shutting down.","try shutdown.send()"],"syntax":"swift"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/signal(_:)-88w9i"},"references":{"doc://Afluent/documentation/Afluent/SingleValueSubject":{"role":"symbol","abstract":[{"text":"A subject for bridging callback-based APIs to async\/await, emitting a single value or error.","type":"text"}],"url":"\/documentation\/afluent\/singlevaluesubject","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SingleValueSubject","kind":"identifier"}],"navigatorTitle":[{"text":"SingleValueSubject","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SingleValueSubject","title":"SingleValueSubject"},"doc://Afluent/documentation/Afluent/BatchStrategy/signal(_:)-88w9i":{"title":"signal(_:)","url":"\/documentation\/afluent\/batchstrategy\/signal(_:)-88w9i","type":"topic","abstract":[{"text":"Flushes once, when the given subject is sent a value.","type":"text"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"signal","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Batched","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Success","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"SingleValueSubject","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent18SingleValueSubjectC"},{"text":"<","kind":"text"},{"text":"Success","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"SignalBatchStrategy","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent19SignalBatchStrategyV"},{"text":"<","kind":"text"},{"text":"Batched","kind"