 starts."}],"type":"paragraph"},{"level":2,"anchor":"Example","type":"heading","text":"Example"},{"type":"codeListing","syntax":"swift","code":["let shutdown = SingleValueSubject<Void>()","for try await messages in inbox.batch(strategy: .either(.count(50), .signal(shutdown))) {","    store(messages)","}","\/\/ Elsewhere: flush whatever is pending before shutting down.","try shutdown.send()"]}],"kind":"content"}],"references":{"doc://Afluent/documentation/Afluent":{"title":"Afluent","kind":"symbol","type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent","url":"\/documentation\/afluent","role":"collection","abstract":[]},"doc://Afluent/documentation/Afluent/_Concurrency/AsyncSequence/batch(strategy:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"batch"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Strategy"},{"kind":"text","text":">("},{"kind":"externalParam","text":"strategy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO","text":"AsyncSequences"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO5BatchV","text":"Batch"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":">"}],"url":"\/documentation\/afluent\/_concurrency\/asyncsequence\/batch(strategy:)","abstract":[{"type":"text","text":"Gathers elements into arrays and emits each array when the strategy says to flush."}],"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/batch(strategy:)","title":"batch(strategy:)"},"doc://Afluent/documentation/Afluent/BatchStrategy/signal(_:)-88w9i":{"role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Flushes once