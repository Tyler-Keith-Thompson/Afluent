:[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"text":"The batched sequence listens to the subject without owning it: when the batched sequence","type":"text"},{"text":" ","type":"text"},{"text":"ends or is cancelled, its wait ends at once and the subject stays pending for its other","type":"text"},{"text":" ","type":"text"},{"text":"awaiters. A subject sent an error ends the batched sequence with that error, except","type":"text"},{"text":" ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":" (as when another awaiter cancels the subject): then the signal stops","type":"text"},{"text":" ","type":"text"},{"text":"firing and the batches go on. A subject sent a value before iteration begins fires when the","type":"text"},{"text":" ","type":"text"},{"text":"signal’s task starts, which may come after elements have arrived, so the first batch may be","type":"text"},{"text":" ","type":"text"},{"text":"short. Each batched sequence iterated with this strategy listens anew, so a subject","type":"text"},{"text":" ","type":"text"},{"text":"already sent a value fires again when a later batched sequence’s signal task starts.","type":"text"}],"type":"paragraph"},{"text":"Example","type":"heading","level":2,"anchor":"Example"},{"type":"codeListing","syntax":"swift","code":["let shutdown = SingleValueSubject<Void>()","for try await messages in inbox.batch(strategy: .either(.count(50), .signal(shutdown))) {","    store(messages)","}","\/\/ Elsewhere: flush whatever is pending before shutting down.","try shutdown.send()"]}]}],"metadata":{"extendedModule":"Afluent","title":"signal(_:)","platforms":[{"introducedAt":"16.0","unavailable":false,"deprecated":false,"beta":false,"name":"iOS"},{"introducedAt":"16.0","unavailable":false,"deprecated":false,"beta":false,"name":"iPadOS"},{"introducedAt":"16.0","unavailable":false,"deprecated":false,"beta":false,"name":"Mac Catalyst"},{"introducedAt":"13.0","unavailable":false,"depr