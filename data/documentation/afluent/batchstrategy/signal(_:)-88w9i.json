uent\/AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO","kind":"typeIdentifier","text":"AsyncSequences"},{"kind":"text","text":"."},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Deferred","preciseIdentifier":"s:7Afluent14AsyncSequencesO8DeferredV","kind":"typeIdentifier","text":"Deferred"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:Scs","kind":"typeIdentifier","text":"AsyncThrowingStream"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Success"},{"kind":"text","text":", any "},{"preciseIdentifier":"s:s5ErrorP","kind":"typeIdentifier","text":"Error"},{"kind":"text","text":">>> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":" == "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","preciseIdentifier":"s:7Afluent19SignalBatchStrategyV","kind":"typeIdentifier","text":"SignalBatchStrategy"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Batched"},{"kind":"text","text":", "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO","kind":"typeIdentifier","text":"AsyncSequences"},{"kind":"text","text":"."},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Deferred","preciseIdentifier":"s:7Afluent14AsyncSequencesO8DeferredV","kind":"typeIdentifier","text":"Deferred"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:Scs","kind":"typeIdentifier","text":"AsyncThrowingStream"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Success"},{"kind":"text","text":", any "},{"preciseIdentifier":"s:s5ErrorP","kind":"typeIdentifier","text":"Error"},{"kind":"text","text":">>>, "},{"kind":"typeIdentifier","text":"Success"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"subject","content":[{"inlineContent":[{"text":"The subject whose value flushes the batch.","type":"text"}],"type":"paragraph"}]}]},{"content":[{"anchor":"return-value","type":"heading","text":"Return Value","level":2},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","type":"reference"},{"text":" over a stream of the subject’s one value, made afresh","type":"text"},{"text":" ","type":"text"},{"text":"for each iteration.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The batched sequence listens to the subject without owning it: when the batched sequence"},{"type":"text","text":" "},{"type":"text","text":"ends or is cancelled, its wait ends at once and the subject stays pending for its other"},{"type":"text","text":" "},{"type":"text","text":"awaiters. A subject sent an error ends the batched sequence with that error, except"},{"type":"text","text":" "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" (as when another awaiter cancels the subject): then the signal stops"},{"type":"text","text":" "},{"type":"text","text":"firing and the batches go on. A subject sent a value before iteration begins fires when the"},{"type":"text","text":" "},{"type":"text","text":"signal’s task starts, which may come after elements have arrived, so the first batch may be"},{"type":"text","text":" "},{"type":"text","text":"short. Each batched sequence iterated with this strategy listens anew, so a subject"},{"type":"text","text":" "},{"type":"text","text":"already sent a value fires again when a later batched sequence’s signal task starts."}],"type":"paragraph"},{"level":2,"anchor":"Example","text":"Example","type":"heading"},{"code":["let shutdown = SingleValueSubject<Void>()","for try await messages in inbox.batch(strategy: .either(.count(50), .signal(shutdown))) {","    store(messages)","}","\/\/ Elsewhere: flush whatever is pending before shutting down.","try shutdown.send()"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/batchstrategy\/signal(_:)-88w9i"]}],"kind":"symbol","abstract":[{"type":"text","text":"Flushes once, when the given subject is sent a value."}],"references":{"doc://Afluent/documentation/Afluent/BatchStrategy":{"title":"BatchStrategy","navigatorTitle":[{"text":"BatchStrategy","kind":"identifier"}],"type":"topic","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchStrategy","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","abstract":[{"type":"text","text":"When "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/batch(strategy:)","isActive":true},{"type":"text","text":" emits the elements it has gathered."}],"url":"\/documentation\/afluent\/batchstrategy"},"doc://Afluent/documentation/Afluent/AsyncSequences":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncSequences","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/afluent\/asyncsequences","abstract":[{"text":"A namespace for grouping related AsyncSequence operations.","type":"text"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","role":"symbol","navigatorTitle":[{"text":"AsyncSequences","kind":"identifier"}],"title":"AsyncSequences"},"doc://Afluent/documentation/Afluent":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent","title":"Afluent","role":"collection","abstract":[],"url":"\/documentation\/afluent","kind":"symbol","type":"topic"},"doc://Afluent/documentation/Afluent/AsyncSequences/Deferred":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Deferred","url":"\/do