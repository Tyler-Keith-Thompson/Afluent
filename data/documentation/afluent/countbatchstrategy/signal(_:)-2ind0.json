xt":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"text":"SignalBatchStrategy","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent19SignalBatchStrategyV"},{"text":"<","kind":"text"},{"text":"Batched","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"AsyncSequences","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO"},{"text":".","kind":"text"},{"text":"Deferred","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Deferred","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO8DeferredV"},{"text":"<","kind":"text"},{"text":"AsyncThrowingStream","kind":"typeIdentifier","preciseIdentifier":"s:Scs"},{"text":"<","kind":"text"},{"text":"Success","kind":"typeIdentifier"},{"text":", any ","kind":"text"},{"text":"Error","kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP"},{"text":">>>, ","kind":"text"},{"text":"Success","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"subject","content":[{"type":"paragraph","inlineContent":[{"text":"The subject whose value flushes the batch.","type":"text"}]}]}]},{"content":[{"text":"Return Value","level":2,"type":"heading","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","isActive":true,"type":"reference"},{"text":" over a stream of the subject’s one value, made afresh","type":"text"},{"text":" ","type":"text"},{"text":"for each iteration.","type":"text"}]}],"kind":"content"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"The batched sequence listens to the subject without owning it: when the batched sequence","type":"text"},{"text":" ","type":"text"},{"text":"ends or is cancelled, its wait ends at once and the subject stays pending for its other","type":"text"},{"text":" ","type":"text"},{"text":"awaiters. A subject sent an error ends the batched sequence with that error, except","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"CancellationError"},{"text":" (as when another awaiter cancels the subject): then the signal stops","type":"text"},{"text":" ","type":"text"},{"text":"firing and the batches go on. A subject sent a value before iteration begins fires when the","type":"text"},{"text":" ","type":"text"},{"text":"signal’s task starts, which may come after elements have arrived, so the first batch may be","type":"text"},{"text":" ","type":"text"},{"text":"short. Each batched sequence iterated with this strategy listens anew, so a subject","type":"text"},{"text":" ","type":"text"},{"text":"already sent a value fires again when a later batched sequence’s signal task starts.","type":"text"}],"type":"paragraph"},{"text":"Example","level":2,"anchor":"Example","type":"heading"},{"syntax":"swift","code":["let shutdown = SingleValueSubject<Void>()","for try await messages in inbox.batch(strategy: .either(.count(50), .signal(shutdown))) {","    store(messages)","}","\/\/ Elsewhere: flush whatever is pending before shutting down.","try shutdown.send()"],"type":"codeListing"}],"kind":"content"}],"metadata":{"remoteSource":{"fileName":"SignalBatchStrategy.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SequenceOperators\/SignalBatchStrategy.swift#L140"},"platforms":[{"introducedAt":"16.0","name":"iOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"16.0","name":"iPadOS","deprecated":false,"unavailable":false,"beta":false},{"introducedAt":"16.0","name":"Mac Catalyst","deprecated":false,"unavailable":false,"beta":false},{"in