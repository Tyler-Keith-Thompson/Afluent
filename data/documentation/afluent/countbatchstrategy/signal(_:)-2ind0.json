ype":"text"},{"text":" ","type":"text"},{"text":"for each iteration.","type":"text"}]}],"kind":"content"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The batched sequence listens to the subject without owning it: when the batched sequence"},{"type":"text","text":" "},{"type":"text","text":"ends or is cancelled, its wait ends at once and the subject stays pending for its other"},{"type":"text","text":" "},{"type":"text","text":"awaiters. A subject sent an error ends the batched sequence with that error, except"},{"type":"text","text":" "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" (as when another awaiter cancels the subject): then the signal stops"},{"type":"text","text":" "},{"type":"text","text":"firing and the batches go on. A subject sent a value before iteration begins fires when the"},{"type":"text","text":" "},{"type":"text","text":"signal’s task starts, which may come after elements have arrived, so the first batch may be"},{"type":"text","text":" "},{"type":"text","text":"short. Each batched sequence iterated with this strategy listens anew, so a subject"},{"type":"text","text":" "},{"type":"text","text":"already sent a value fires again when a later batched sequence’s signal task starts."}]},{"level":2,"type":"heading","text":"Example","anchor":"Example"},{"syntax":"swift","type":"codeListing","code":["let shutdown = SingleValueSubject<Void>()","for try await messages in inbox.batch(strategy: .either(.count(50), .signal(shutdown))) {","    store(messages)","}","\/\/ Elsewhere: flush whatever is pending before shutting down.","try shutdown.send()"]}],"kind":"content"}],"metadata":{"role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"signal","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Batched","kind":"genericParame