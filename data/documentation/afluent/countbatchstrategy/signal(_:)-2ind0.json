 task starts."}]},{"text":"Example","type":"heading","level":2,"anchor":"Example"},{"syntax":"swift","code":["let shutdown = SingleValueSubject<Void>()","for try await messages in inbox.batch(strategy: .either(.count(50), .signal(shutdown))) {","    store(messages)","}","\/\/ Elsewhere: flush whatever is pending before shutting down.","try shutdown.send()"],"type":"codeListing"}]}],"abstract":[{"type":"text","text":"Flushes once, when the given subject is sent a value."}],"references":{"doc://Afluent/documentation/Afluent/AsyncSequences/Deferred":{"role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Deferred","kind":"identifier"}],"navigatorTitle":[{"text":"Deferred","kind":"identifier"}],"abstract":[{"text":"An asynchronous sequence that defers the execution of another asynchronous sequence until iteration.","type":"text"}],"title":"AsyncSequences.Deferred","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Deferred","url":"\/documentation\/afluent\/asyncsequences\/deferred"},"doc://Afluent/documentation/Afluent/CountBatchStrategy/signal(_:)-2ind0":{"title":"signal(_:)","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/CountBatchStrategy\/signal(_:)-2ind0","kind":"symbol","abstract":[{"text":"Flushes once, when the given subject is sent a value.","type":"text"}],"url":"\/documentation\/afluent\/countbatchstrategy\/signal(_:)-2ind0","type":"topic","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"signal","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Batched","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Success","kind":"genericParameter"},{"text":">(","kind":"text"},{"preciseIdentifier":"s:7Afluent18SingleValueSubjectC","text":"SingleValueSubject","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Success","kind":"type