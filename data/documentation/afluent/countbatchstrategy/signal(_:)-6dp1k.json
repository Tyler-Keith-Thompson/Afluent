":" ","type":"text"},{"text":"leaves the subject alone. Each batched sequence iterated with this strategy runs the unit","type":"text"},{"text":" ","type":"text"},{"text":"anew and fires once when it completes.","type":"text"}]},{"type":"heading","anchor":"Example","level":2,"text":"Example"},{"type":"codeListing","code":["let reachable = DeferredTask { try await server.waitUntilReachable() }","for try await requests in outbox.batch(strategy: .either(.count(20), .signal(reachable))) {","    try await send(requests)","}"],"syntax":"swift"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/countbatchstrategy\/signal(_:)-6dp1k"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","references":{"doc://Afluent/documentation/Afluent":{"url":"\/documentation\/afluent","type":"topic","kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent","title":"Afluent","abstract":[],"role":"collection"},"doc://Afluent/documentation/Afluent/BatchStrategy":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BatchStrategy","kind":"identifier"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","type":"topic","url":"\/documentation\/afluent\/batchstrategy","role":"symbol","abstract":[{"type":"text","text":"When "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/batch(strategy:)","isActive":true,"type":"reference"},{"type":"text","text":" emits the elements it has gathered."}],"navigatorTitle":[{"text":"BatchStrategy","kind":"identifier"}],"title":"BatchStrategy","kind":"symbol"},"doc://Afluent/documentation/Afluent/CountBatchStrategy/signal(_:)-2ind0":{"abstract":[{"text":"Flushes once, when the given subject is sent a value.","type":"text"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/CountBatchStrategy\/signal(_:)-2ind0","type":"topic","title":"signal(_:)","kind":"symbol","url":"\/documentation\/afluent\/countbatchst