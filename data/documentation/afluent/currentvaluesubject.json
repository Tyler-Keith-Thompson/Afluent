t) begins. It first receives the value that is current at that moment,","type":"text"},{"text":" ","type":"text"},{"text":"then every value sent afterwards, in order; values are buffered for it until it consumes them. Values sent","type":"text"},{"text":" ","type":"text"},{"text":"before it subscribed are not replayed. A consumer that subscribes after completion receives only the completion.","type":"text"},{"text":" ","type":"text"},{"text":"To subscribe before the consumer’s task runs, make the iterator now and hand it over as an","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncIteratorSequence","type":"reference","isActive":true},{"text":". Cancelling a task waiting for the next value ends that consumer’s subscription.","type":"text"}]},{"text":"Example","type":"heading","anchor":"Example","level":2},{"code":["let subject = CurrentValueSubject(0)","let subscribed = SingleValueSubject<Void>()","","subject.send(1) \/\/ Becomes the current value; no one is subscribed yet.","","Task {","    for try await value in subject.handleEvents(receiveMakeIterator: { try? subscribed.send() }) {","        print(\"Received value: \\(value)\") \/\/ prints 1, then 2, then 3","    }","}","","try await subscribed.execute()","subject.send(2)","subject.send(3)","subject.send(completion: .finished)"],"syntax":"swift","type":"codeListing"}]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/currentvaluesubject"]}],"kind":"symbol","references":{"doc://Afluent/documentation/Afluent":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent","abstract":[],"title":"Afluent","role":"collection","kind":"symbol","url":"\/documentation\/afluent","type":"topic"},"doc://Afluent/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/Afluent\/s8SendableP","title":"Swift.Sendable"},"doc://Afluent/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/Afluent\/s16Sendabl