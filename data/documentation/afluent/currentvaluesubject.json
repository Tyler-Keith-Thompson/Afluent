it subscribed are not replayed. A consumer that subscribes after completion receives only the completion."},{"type":"text","text":" "},{"type":"text","text":"To subscribe before the consumer’s task runs, make the iterator now and hand it over as an"},{"type":"text","text":" "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncIteratorSequence","type":"reference","isActive":true},{"type":"text","text":". Cancelling a task waiting for the next value ends that consumer’s subscription."}]},{"type":"heading","level":2,"anchor":"Example","text":"Example"},{"type":"codeListing","syntax":"swift","code":["let subject = CurrentValueSubject(0)","let subscribed = SingleValueSubject<Void>()","","subject.send(1) \/\/ Becomes the current value; no one is subscribed yet.","","Task {","    for try await value in subject.handleEvents(receiveMakeIterator: { try? subscribed.send() }) {","        print(\"Received value: \\(value)\") \/\/ prints 1, then 2, then 3","    }","}","","try await subscribed.execute()","subject.send(2)","subject.send(3)","subject.send(completion: .finished)"]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"sections":[],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP","doc:\/\/Afluent\/Sci"],"title":"Conforms To","type":"conformsTo"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/currentvaluesubject"]}],"references":{"doc://Afluent/documentation/Afluent/CurrentValueSubject/value":{"abstract":[{"type":"text","text":"The current value of the subject. This property is thread-safe."},{"type":"text","text":" "},{"type":"text","text":"Updating this property will also broadcast the new value to all active consumers."}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/value","type":"topic","kind":"symbol","role":"symbol","url":"\/docu