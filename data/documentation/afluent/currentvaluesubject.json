:"Example","level":2},{"type":"codeListing","syntax":"swift","code":["let subject = CurrentValueSubject(0)","let subscribed = SingleValueSubject<Void>()","","subject.send(1) \/\/ Becomes the current value; no one is subscribed yet.","","Task {","    for try await value in subject.handleEvents(receiveMakeIterator: { try? subscribed.send() }) {","        print(\"Received value: \\(value)\") \/\/ prints 1, then 2, then 3","    }","}","","try await subscribed.execute()","subject.send(2)","subject.send(3)","subject.send(completion: .finished)"]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/currentvaluesubject"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"A subject that broadcasts its current value and all subsequent values to multiple consumers."},{"type":"text","text":" "},{"type":"text","text":"It can also handle completion events, including normal termination and failure with an error."},{"type":"text","text":" "},{"type":"text","text":"This is an "},{"code":"AsyncSequence","type":"codeVoice"},{"type":"text","text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s CurrentValueSubject."}],"sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP","doc:\/\/Afluent\/Sci"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"references":{"doc://Afluent/documentation/Afluent/CurrentValueSubject/send()":{"url":"\/documentation\/afluent\/currentvaluesubject\/send()","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/send()","title":"send()","type":"topic","abstract":[{"text":"Sends a value to consumers when the subject’s ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Void","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"This is useful for signaling purp