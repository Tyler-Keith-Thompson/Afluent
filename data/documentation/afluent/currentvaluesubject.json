{"abstract":[{"text":"A subject that broadcasts its current value and all subsequent values to multiple consumers.","type":"text"},{"text":" ","type":"text"},{"text":"It can also handle completion events, including normal termination and failure with an error.","type":"text"},{"text":" ","type":"text"},{"text":"This is an ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s CurrentValueSubject.","type":"text"}],"sections":[],"topicSections":[{"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/Iterator"],"generated":true},{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/init()","doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/init(_:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/value"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/makeAsyncIterator()","doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/send()","doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/send(_:)","doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/send(completion:)"],"generated":true},{"anchor":"Enumerations","title":"Enumerations","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/Completion"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/AsyncSequence-Implementations","doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/AsyncSequence-Implementations"],"generated":true}],"relationshipsSections":[{"kind":"relationships","type":"confo