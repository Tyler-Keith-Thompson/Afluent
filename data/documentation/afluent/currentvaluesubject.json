entValueSubject\/Completion"],"anchor":"Enumerations","generated":true},{"title":"Default Implementations","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/AsyncSequence-Implementations","doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/AsyncSequence-Implementations"],"anchor":"Default-Implementations","generated":true}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A subject that broadcasts its current value and all subsequent values to multiple consumers."},{"type":"text","text":" "},{"type":"text","text":"It can also handle completion events, including normal termination and failure with an error."},{"type":"text","text":" "},{"type":"text","text":"This is an "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s CurrentValueSubject."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"CurrentValueSubject"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}]}]},{"content":[{"anchor":"Subscribing","type":"heading","level":2,"text":"Subscribing"},{"type":"paragraph","inlineContent":[{"text":"A consumer subscribes when its iterator is created, which is when a ","type":"text"},{"code":"for try await","type":"codeVoice"},{"text":" loop over the subject","type":"text"},{"text":" ","type":"text"},{"text":"(or over an operator chain built on it) begins. It first receives the value that is current at that moment,","type":"text"},{"text":" ","type":"text"},{"text":"then every value sent afterwards, in order; values are buffered for it until it consumes them. Values sent","type":"text"},{"text":" ","type":"text"},{"text":"before it subscribed are not replayed. A consumer that subscribes after completion receives only the completion.","type":"text"},{"text":" ","type":"text"},{"text":"To subscribe before the consumer’s task runs, make the iterator now and hand it over as an","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncIteratorSequence","isActive":true,"type":"reference"},{"text":". Cancelling a task waiting for the next value ends that consumer’s subscription.","type":"text"}]},{"anchor":"Example","type":"heading","level":2,"text":"Example"},{"syntax":"swift","type":"codeListing","code":["let subject = CurrentValueSubject(0)","let subscribed = SingleValueSubject<Void>()","","subject.send(1) \/\/ Becomes the current value; no one is subscribed yet.","","Task {","    for try await value in subject.handleEvents(receiveMakeIterator: { try? subscribed.send() }) {","        print(\"Received value: \\(value)\") \/\/ prints 1, then 2, then 3","    }","}","","try await subscribed.execute()","subject.send(2)","subject.send(3)","subject.send(completion: .finished)"]}],"kind":"content"}],"references":{"doc://Afluent/documentation/Afluent/CurrentValueSubject/Iterator":{"kind":"symbol","role":"symbol","type":"topic","title":"CurrentValueSubject.Iterator","navigatorTitle":[{"kind":"identifier","text":"Iterator"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/Iterator","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Iterator"}],"url":"\/documentation\/aflue