{"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"kind":"symbol","identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Class","modules":[{"name":"Afluent"}],"role":"symbol","externalID":"s:7Afluent19CurrentValueSubjectC","navigatorTitle":[{"kind":"identifier","text":"CurrentValueSubject"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"CurrentValueSubject"}],"title":"CurrentValueSubject","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/CurrentValueSubject.swift#L36","fileName":"CurrentValueSubject.swift"},"symbolKind":"class"},"sections":[],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP","doc:\/\/Afluent\/Sci"],"type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CurrentValueSubject","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"Subscribing","level":2,"text":"Subscribing"},{"type":"paragraph","inlineContent":[{"text":"A consumer subscribes when its iterator is created, which is when a ","type":"text"},{"type":"codeVoice","code":"for try await"},{"text":" loop over the subject","type":"text"},{"text":" ","type":"text"},{"text":"(or over an operator chain built on it) begins. It first receives the value that is current at that moment,","type":"text"},{"text":" ","type":"text"},{"text":"then every value sent afterwards, in order; values are buffered for it until it consumes them. Values sent","type":"text"},{"text":" ","type":"text"},{"text":"before it subscribed are not replayed. A consumer that subscribes after completion receives only the completion.","type":"text"}]},{"type":"heading","anchor":"Example","level":2,"text":"Example"},{"syntax":"swift","type":"codeListing","code":["let subject = CurrentValueSubject(0)","let subscribed = SingleValueSubject<Void>()","","subject.send(1) \/\/ Becomes the current value; no one is subscribed yet.","","Task {","    for try await value in subject.handleEvents(receiveMakeIterator: { try? subscribed.send() }) {","        print(\"Received value: \\(value)\") \/\/ prints 1, then 2, then 3","    }","}","","try await subscribed.execute()","subject.send(2)","subject.send(3)","subject.send(completion: .finished)"]}]}],"abstract":[{"type":"text","text":"A subject that broadcasts its current value and all subsequent values to multiple consumers."},{"type":"text","text":" "},{"type":"text","text":"It can also handle completion events, including normal termination and failure with an error."},{"type":"text","text":" "},{"type":"text","text":"This is an "},{"code":"AsyncSequence","type":"codeVoice"},{"type":"text","text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s CurrentValueSubject."}],"topicSections":[{"title":"Structures","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/Iterator"],"anchor":"Structures","generated":true},{"title":"Initializers","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/init()","doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/init(_:)"],"anchor":"Initializers","generated":true},{"title":"Instance Properties","identifiers":["doc:\/\/Afluent\