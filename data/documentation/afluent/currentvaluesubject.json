{"abstract":[{"type":"text","text":"A subject that broadcasts its current value and all subsequent values to multiple consumers."},{"type":"text","text":" "},{"type":"text","text":"It can also handle completion events, including normal termination and failure with an error."},{"type":"text","text":" "},{"type":"text","text":"This is an "},{"type":"codeVoice","code":"AsyncSequence"},{"text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s CurrentValueSubject.","type":"text"}],"sections":[],"topicSections":[{"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/Iterator"],"generated":true},{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/init()","doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/init(_:)"],"generated":true},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/value"],"generated":true},{"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/makeAsyncIterator()","doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/send()","doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/send(_:)","doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/send(completion:)"],"generated":true},{"title":"Enumerations","anchor":"Enumerations","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/Completion"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/AsyncSequence-Implementations","doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/AsyncSequence-Implementations"],"generated":true}],"variants":[{"paths":["\/documentation\/afluent\/currentvalues