\/ prints 1, then 2, then 3","    }","}","","try await subscribed.execute()","subject.send(2)","subject.send(3)","subject.send(completion: .finished)"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"abstract":[{"text":"A subject that broadcasts its current value and all subsequent values to multiple consumers.","type":"text"},{"text":" ","type":"text"},{"text":"It can also handle completion events, including normal termination and failure with an error.","type":"text"},{"text":" ","type":"text"},{"text":"This is an ","type":"text"},{"type":"codeVoice","code":"AsyncSequence"},{"text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s CurrentValueSubject.","type":"text"}],"kind":"symbol","topicSections":[{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/Iterator"],"anchor":"Structures","generated":true,"title":"Structures"},{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/init()","doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/init(_:)"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/value"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/makeAsyncIterator()","doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/send()","doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/send(_:)","doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/send(completion:)"],"anchor":"Instance-Methods","generated":true,"title":"Instance Methods"},{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/Completion"],"anchor":"Enumerations","generated":true,"title":"Enumerations"},{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/AsyncSequence-Implementations","doc:\/\/Afluent\/documentation\/