. A consumer that subscribes after completion receives only the completion."}],"type":"paragraph"},{"level":2,"anchor":"Example","type":"heading","text":"Example"},{"syntax":"swift","code":["let subject = CurrentValueSubject(0)","let subscribed = SingleValueSubject<Void>()","","subject.send(1) \/\/ Becomes the current value; no one is subscribed yet.","","Task {","    for try await value in subject.handleEvents(receiveMakeIterator: { try? subscribed.send() }) {","        print(\"Received value: \\(value)\") \/\/ prints 1, then 2, then 3","    }","}","","try await subscribed.execute()","subject.send(2)","subject.send(3)","subject.send(completion: .finished)"],"type":"codeListing"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/currentvaluesubject"]}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject"},"kind":"symbol","references":{"doc://Afluent/documentation/Afluent/CurrentValueSubject":{"navigatorTitle":[{"text":"CurrentValueSubject","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CurrentValueSubject","kind":"identifier"}],"abstract":[{"type":"text","text":"A subject that broadcasts its current value and all subsequent values to multiple consumers."},{"type":"text","text":" "},{"type":"text","text":"It can also handle completion events, including normal termination and failure with an error."},{"type":"text","text":" "},{"type":"text","text":"This is an "},{"code":"AsyncSequence","type":"codeVoice"},{"type":"text","text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s CurrentValueSubject."}],"type":"topic","role":"symbol","url":"\/documentation\/afluent\/currentvaluesubject","title":"CurrentValueSubject"},"doc://Afluent/documentation/Afluent/CurrentValueSubject/send()":{"title":"send()","abstract":[{"type":"text","text":"Sends a value to consumers when the subject’s "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Void"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This is useful for signaling purposes rather than data transmission."}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/send()","url":"\/documentation\/afluent\/currentvaluesubject\/send()","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"send","kind":"identifier"},{"text":"()","kind":"text"}],"type":"topic"},"doc://Afluent/documentation/Afluent/CurrentValueSubject/init(_:)":{"kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":")"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Creates a "},{"type":"codeVoice","code":"CurrentValueSubject"},{"type":"text","text":" with an initial value."}],"url":"\/documentation\/afluent\/currentvaluesubject\/init(_:)","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/init(_:)","title":"init(_:)"},"doc://Afluent/documentation/Afluent/CurrentValueSubject/send(completion:)":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/send(completion:)","type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Completes the subject, preventing any further values from being sent."},{"type":"text","text":" "},{"type":"text","text":"Current consumers receive the completion after any values already buffered for them, and consumers that"},{"type":"text","text":" "},{"type":"text","text":"start iterating afterwards receive it immediately."}],"url":"\/documentation\/af