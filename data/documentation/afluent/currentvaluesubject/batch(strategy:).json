{"sections":[],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject"]]},"abstract":[{"text":"Gathers elements into arrays and emits each array when the strategy says to flush.","type":"text"}],"variants":[{"paths":["\/documentation\/afluent\/currentvaluesubject\/batch(strategy:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"role":"symbol","extendedModule":"_Concurrency","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"batch"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Strategy"},{"kind":"text","text":">("},{"kind":"externalParam","text":"strategy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO","kind":"typeIdentifier","text":"AsyncSequences"},{"kind":"text","text":"."},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO5BatchV","kind":"typeIdentifier","text":"Batch"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":">"}],"roleHeading":"Instance Method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SequenceOperators\/BatchSequence.swift#L221","fileName":"BatchSequence.swift"},"platforms":[{"beta":false,"introducedAt":"16.0","deprecated":false,"name":"iOS","unavailable":false},{"beta":false,"introducedAt":"16.0","deprecated":false,"name":"iPadOS","unavailable":false},{"beta":false,"introducedAt":"16.0","deprecated":false,"name":"Mac Catalyst","unavailable":false},{"beta":false,"introducedAt":"13.0","deprecated":false,"name":"macOS","unavailable":false},{"beta":false,"introducedAt":"16.0","deprecated":false,"name":"tvOS","unavailable":false},{"beta":false,"introducedAt":"1.0","deprecated":false,"name":"visionOS","unavailable":false},{"beta":false,"introducedAt":"9.0","deprecated":false,"name":"watchOS","unavailable":false}],"symbolKind":"method","title":"batch(strategy:)","modules":[{"name":"Afluent","relatedModules":["_Concurrency"]}],"externalID":"s:Sci7Afluents8SendableRzsAB7ElementRpzrlE5batch8strategyAA14AsyncSequencesO5BatchVy_xqd__Gqd___tAA0H8StrategyRd__ACQyd__ADRSlF::SYNTHESIZED::s:7Afluent19CurrentValueSubjectC"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"batch"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Strategy"},{"kind":"text","text":">("},{"kind":"externalParam","text":"strategy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Batch","preciseIdentifier":"s:7Afluent14AsyncSequencesO5BatchV","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Batch"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"BatchStrategy","preciseIdentifier":"s:7Afluent13BatchStrategyP","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:Sci7ElementQa"},{"kind":"text","text":" == "},{"kind":"typeIdentifier","text":"Strategy"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Element","preciseIdentifier":"s:7Afluent13BatchStrategyP7ElementQa","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/Element"}],"languages":["swift"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When to emit the gathered elements; its "},{"type":"codeVoice","code":"Element"},{"type":"text","text":" is this"},{"type":"text","text":" "},{"type":"text","text":"sequence’s, inferred from the call."}]}],"name":"strategy"}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"A sequence of the upstream’s elements, in order, in arrays of one or more.","type":"text"}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"The strategy decides when the pending elements are flushed: every so many elements","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/count(_:)","type":"reference","isActive":true},{"text":"), every interval","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/time(interval:clock:tolerance:)","type":"reference","isActive":true},{"text":"), on a signal or a unit of work","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","type":"reference","isActive":true},{"text":"), whenever any of several does","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/either(_:_:)","type":"reference","isActive":true},{"text":"), or by a rule of your own (","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","type":"reference","isActive":true},{"text":"). After every","type":"text"},{"text":" ","type":"text"},{"text":"flush, each strategy starts over. A flush with nothing pending emits nothing; the","type":"text"},{"text":" ","type":"text"},{"text":"sequence never emits an empty array.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When the upstream finishes, the pending elements, if any, are emitted as a last array and","type":"text"},{"text":" ","type":"text"},{"text":"the sequence finishes. When the upstream throws, the pending elements are dropped and the","type":"text"},{"text":" ","type":"text"},{"text":"sequence throws the same error. A signal that finishes stops firing while the batches go","type":"text"},{"text":" ","type":"text"},{"text":"on; a signal that throws ends the sequence with its error.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The upstream and the strategy run in tasks of their own, started when iteration begins,"},{"type":"text","text":" "},{"type":"text","text":"so the upstream is read ahead of the consumer, and arrays the consumer hasn’t taken yet"},{"type":"text","text":" "},{"type":"text","text":"are buffered. Cancelling the consumer, or dropping its iterator, cancels both. An"},{"type":"text","text":" "},{"type":"text","text":"upstream or signal that ignores cancellation keeps the internal task alive until its"},{"type":"text","text":" "},{"type":"text","text":"pending "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" returns, and is not read again after that; the batched sequence itself"},{"type":"text","text":" "},{"type":"text","text":"ends at once."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Batching needs iOS 16, Mac Catalyst 16, macOS 13, tvOS 16, watchOS 9 or visionOS 1."}],"type":"paragraph"},{"level":2,"text":"Example","anchor":"Example","type":"heading"},{"syntax":"swift","code":["for try await batch in [1, 2, 3, 4].async.batch(strategy: .either(.count(3), .time(interval: .seconds(1), clock: ContinuousClock()))) {","    print(batch) \/\/ Prints [1, 2, 3], then [4]","}"],"type":"codeListing"},{"style":"note","name":"Throws","content":[{"inlineContent":[{"type":"text","text":"Any error the upstream or the strategy throws."}],"type":"paragraph"}],"type":"aside"}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/batch(strategy:)"},"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://Afluent/documentation/Afluent/AsyncSequences/Batch":{"kind":"symbol","title":"AsyncSequences.Batch","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Batch"}],"navigatorTitle":[{"kind":"identifier","text":"Batch"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Batch","type":"topic","url":"\/documentation\/afluent\/asyncsequences\/batch","abstract":[{"type":"text","text":"Used as the implementation detail for the "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/batch(strategy:)","isActive":true,"type":"reference"},{"type":"text","text":" operator."}]},"doc://Afluent/documentation/Afluent/CurrentValueSubject":{"title":"CurrentValueSubject","navigatorTitle":[{"kind":"identifier","text":"CurrentValueSubject"}],"type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject","url":"\/documentation\/afluent\/currentvaluesubject","abstract":[{"type":"text","text":"A subject that broadcasts its current value and all subsequent values to multiple consumers."},{"type":"text","text":" "},{"type":"text","text":"It can also handle completion events, including normal termination and failure with an error."},{"type":"text","text":" "},{"type":"text","text":"This is an "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s CurrentValueSubject."}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"CurrentValueSubject"}]},"doc://Afluent/documentation/Afluent/CurrentValueSubject/batch(strategy:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"batch","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Strategy","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"strategy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Strategy","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Batch","preciseIdentifier":"s:7Afluent14AsyncSequencesO5BatchV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Strategy","kind":"typeIdentifier"},{"text":">","kind":"text"}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"Self","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Element","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":"."}]},"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject\/batch(strategy:)","type":"topic","url":"\/documentation\/afluent\/currentvaluesubject\/batch(strategy:)","role":"symbol","abstract":[{"type":"text","text":"Gathers elements into arrays and emits each array when the strategy says to flush."}],"title":"batch(strategy:)","kind":"symbol"},"doc://Afluent/documentation/Afluent/BatchStrategy/either(_:_:)":{"title":"either(_:_:)","type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy\/either(_:_:)","url":"\/documentation\/afluent\/batchstrategy\/either(_:_:)","abstract":[{"type":"text","text":"Flushes when any of the given strategies does."}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"either"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Batched"},{"kind":"text","text":">(any "},{"preciseIdentifier":"s:7Afluent13BatchStrategyP","kind":"typeIdentifier","text":"BatchStrategy"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Batched"},{"kind":"text","text":">, any "},{"preciseIdentifier":"s:7Afluent13BatchStrategyP","kind":"typeIdentifier","text":"BatchStrategy"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Batched"},{"kind":"text","text":">...) -> "},{"preciseIdentifier":"s:7Afluent19EitherBatchStrategyV","kind":"typeIdentifier","text":"EitherBatchStrategy"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Batched"},{"kind":"text","text":">"}]},"doc://Afluent/documentation/Afluent":{"url":"\/documentation\/afluent","type":"topic","kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent","title":"Afluent","abstract":[],"role":"collection"},"doc://Afluent/documentation/Afluent/BatchStrategy/time(interval:clock:tolerance:)":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"time","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Batched",