 when the asynchronous work begins, supporting scenarios where you want to set up an async operation ahead of time and","type":"text"},{"text":" ","type":"text"},{"text":"trigger its execution at a chosen moment.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This type conforms to the ","type":"text"},{"code":"AsynchronousUnitOfWork","type":"codeVoice"},{"text":" protocol and is useful for wrapping async computations, network requests, or any other asynchronous operation","type":"text"},{"text":" ","type":"text"},{"text":"that may throw an error and returns a value.","type":"text"}],"type":"paragraph"},{"text":"Example","level":2,"type":"heading","anchor":"Example"},{"inlineContent":[{"text":"Basic usage with ","type":"text"},{"code":"execute()","type":"codeVoice"},{"text":" to start and await the operation:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let deferred = DeferredTask<Int> {","    try await Task.sleep(nanoseconds: 1_000_000_000)","    return 42","}","let result = try await deferred.execute()","print(\"Result is \\(result)\")"]},{"inlineContent":[{"type":"text","text":"Accessing the result via the "},{"type":"codeVoice","code":"result"},{"type":"text","text":" property (an async property that awaits completion):"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let deferred = DeferredTask<Int> {","    10 * 5","}","let value = await deferred.result","print(\"Value is \\(value)\")"]},{"inlineContent":[{"type":"text","text":"Running the operation without awaiting its result immediately, via "},{"code":"run()","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let deferred = DeferredTask<Int> {","    7 + 3","}","deferred.run()","\/\/ Later, you may await the result property or handle completion otherwise"]},{"inlineContent":[{"text":"Subscribing to the task’s events using ","type":"text"},{"code":"subscribe()","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let deferred = DeferredTask<String> {","    \"Hello, World!\"","}","let cancellable = deferred.subscribe { event in","    switch event {","    case .success(let value):","        print(\"Completed with value: \\(value)\")","    case .failure(let error):","        print(\"Failed with error: \\(error)\")","    }","}"]},{"inlineContent":[{"text":"Storing the subscription in a collection for lifecycle management:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var cancellables = Set<AnyCancellable>()","let deferred = DeferredTask<Void> {","    print(\"Task executed\")","}","deferred.subscribe().store(in: &cancellables)"]},{"inlineContent":[{"type":"text","text":"Chaining with operators:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let result = try await DeferredTask { 21 }","    .map { $0 * 2 }","    .execute() \/\/ result is 42"]}],"kind":"content"}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/DeferredTask\/init(operation:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/DeferredTask\/state"],"generated":true,"anchor":"Instance-Properties"},{"title":"Default Implementations","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/DeferredTask\/Actor-Implementations","doc:\/\/Afluent\/documentation\/Afluent\/DeferredTask\/AsynchronousUnitOfWork-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"abstract":[{"type":"text","text":"A deferred unit of asynchronous work that produces a result of type "},{"type":"codeVoice","code":"Success"},{"type":"text","text":"."}],"sections":[],"kind":"symbol","references":{"doc://Afluent/documentation/Afluent":{"url":"\/documentation\/afluent","identifier":"doc:\/\/Afluent\/documentation\/Afluent","abstract":[],