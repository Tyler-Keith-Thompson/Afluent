{"topicSections":[{"title":"Initializers","anchor":"Initializers","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/DeferredTask\/init(operation:)"]},{"title":"Instance Properties","anchor":"Instance-Properties","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/DeferredTask\/state"]},{"title":"Default Implementations","anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/DeferredTask\/Actor-Implementations","doc:\/\/Afluent\/documentation\/Afluent\/DeferredTask\/AsynchronousUnitOfWork-Implementations"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DeferredTask","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Success","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Success","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s8SendableP","text":"Sendable","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["Linux"]}]},{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"DeferredTask"},{"type":"text","text":" represents an asynchronous operation that is defined but does not start executing until it is explicitly started."},{"type":"text","text":" "},{"type":"text","text":"This allows precise control over when the asynchronous work begins, supporting scenarios where you want to set up an async operation ahead of time and"},{"type":"text","text":" "},{"type":"text","text":"trigger its execution at a chosen moment."}],"type":"paragraph"},{"inlineContent":[{"text":"This type conforms to the ","type":"text"},{"code":"AsynchronousUnitOfWork","type":"codeVoice"},{"text":" protocol and is useful for wrapping async computations, network requests, or any other asynchronous operation","type":"text"},{"text":" ","type":"text"},{"text":"that may throw an error and returns a value.","type":"text"}],"type":"paragraph"},{"text":"Example","anchor":"Example","level":2,"type":"heading"},{"inlineContent":[{"text":"Basic usage with ","type":"text"},{"code":"execute()","type":"codeVoice"},{"text":" to start and await the operation:","type":"text"}],"type":"paragraph"},{"code":["let deferred = DeferredTask<Int> {","    try await Task.sleep(nanoseconds: 1_000_000_000)","    return 42","}","let result = try await deferred.execute()","print(\"Result is \\(result)\")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Accessing the result via the "},{"type":"codeVoice","code":"result"},{"type":"text","text":" property (an async property that awaits completion):"}],"type":"paragraph"},{"code":["let deferred = DeferredTask<Int> {","    10 * 5","}","let value = await deferred.result","print(\"Value is \\(value)\")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Running the operation without awaiting its result immediately, via ","type":"text"},{"code":"run()","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let deferred = DeferredTask<Int> {","    7 + 3","}","deferred.run()","\/\/ Later, you may await the result property or handle completion otherwise"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Subscribing to the task’s events using ","type":"text"},{"type":"codeVoice","code":"subscribe()"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let deferred = DeferredTask<String> {","    \"Hello, World!\"","}","let cancellable = deferred.subscribe { event in","    switch event {","    case .success(let value):","        print(\"Completed with value: \\(value)\")","    case .failure(let error):","        print(\"Failed with error: \\(error)\")","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Storing the subscription in a collection for lifecycle management:"}],"type":"paragraph"},{"code":["var cancellables = Set<AnyCancellable>()","let deferred = DeferredTask<Void> {","    print(\"Task executed\")","}","deferred.subscribe().store(in: &cancellables)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Chaining with operators:"}],"type":"paragraph"},{"code":["let result = try await DeferredTask { 21 }","    .map { $0 * 2 }","    .execute() \/\/ result is 42"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/DeferredTask"},"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork","doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP","doc:\/\/Afluent\/ScA"]}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/deferredtask"]}],"metadata":{"symbolKind":"class","externalID":"s:7Afluent12DeferredTaskC","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"DeferredTask"}],"modules":[{"name":"Afluent"}],"navigatorTitle":[{"text":"DeferredTask","kind":"identifier"}],"title":"DeferredTask","roleHeading":"Class","role":"symbol","remoteSource":{"fileName":"DeferredTask.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/DeferredTask.swift#L79"}},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"kind":"symbol","abstract":[{"text":"A deferred unit of asynchronous work that produces a result of type ","type":"text"},{"code":"Success","type":"codeVoice"},{"text":".","type":"text"}],"references":{"doc://Afluent/documentation/Afluent/DeferredTask/Actor-Implementations":{"kind":"article","url":"\/documentation\/afluent\/deferredtask\/act