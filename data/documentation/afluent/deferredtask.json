"text":" ","type":"text"},{"text":"that may throw an error and returns a value.","type":"text"}]},{"anchor":"Example","type":"heading","text":"Example","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Basic usage with "},{"code":"execute()","type":"codeVoice"},{"type":"text","text":" to start and await the operation:"}]},{"code":["let deferred = DeferredTask<Int> {","    try await Task.sleep(nanoseconds: 1_000_000_000)","    return 42","}","let result = try await deferred.execute()","print(\"Result is \\(result)\")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Accessing the result via the ","type":"text"},{"code":"result","type":"codeVoice"},{"text":" property (an async property that awaits completion):","type":"text"}]},{"code":["let deferred = DeferredTask<Int> {","    10 * 5","}","let value = await deferred.result","print(\"Value is \\(value)\")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Running the operation without awaiting its result immediately, via ","type":"text"},{"code":"run()","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["let deferred = DeferredTask<Int> {","    7 + 3","}","deferred.run()","\/\/ Later, you may await the result property or handle completion otherwise"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Subscribing to the task’s events using "},{"type":"codeVoice","code":"subscribe()"},{"type":"text","text":":"}]},{"code":["let deferred = DeferredTask<String> {","    \"Hello, World!\"","}","let cancellable = deferred.subscribe { event in","    switch event {","    case .success(let value):","        print(\"Completed with value: \\(value)\")","    case .failure(let error):","        print(\"Failed with error: \\(error)\")","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Storing the subscription in a collection for lifecycle m