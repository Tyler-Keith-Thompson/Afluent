{"abstract":[{"type":"text","text":"A deferred unit of asynchronous work that produces a result of type "},{"type":"codeVoice","code":"Success"},{"type":"text","text":"."}],"kind":"symbol","topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/DeferredTask\/init(operation:)"],"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/DeferredTask\/state"],"anchor":"Instance-Properties"},{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/DeferredTask\/Actor-Implementations","doc:\/\/Afluent\/documentation\/Afluent\/DeferredTask\/AsynchronousUnitOfWork-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations","generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DeferredTask","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Success","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Success","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"DeferredTask"},{"text":" represents an asynchronous operation that is defined but does not start executing until it is explicitly started.","type":"text"},{"text":" ","type":"text"},{"text":"This allows precise control over when the asynchronous work begins, supporting scenarios where you want to set up an async operation ahead of time and","type":"text"},{"text":" ","type":"text"},{"text":"trigger its execution at a chosen moment.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This type conforms to the ","type":"text"},{"code":"AsynchronousUnitOfWork","type":"codeVoice"},{"text":" protocol and is useful for wrapping async computations, network requests, or any other asynchronous operation","type":"text"},{"text":" ","type":"text"},{"text":"that may throw an error and returns a value.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Example","anchor":"Example","type":"heading"},{"inlineContent":[{"text":"Basic usage with ","type":"text"},{"code":"execute()","type":"codeVoice"},{"text":" to start and await the operation:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let deferred = DeferredTask<Int> {","    try await Task.sleep(nanoseconds: 1_000_000_000)","    return 42","}","let result = try await deferred.execute()","print(\"Result is \\(result)\")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Accessing the result via the "},{"type":"codeVoice","code":"result"},{"type":"text","text":" property (an async property that awaits completion):"}],"type":"paragraph"},{"syntax":"swift","code":["let deferred = DeferredTask<Int> {","    10 * 5","}","let value = await deferred.result","print(\"Value is \\(value)\")"],"type":"codeListing"},{"inlineContent":[{"text":"Running the operation without awaiting its result immediately, via ","type":"text"},{"type":"codeVoice","code":"run()"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let deferred = DeferredTask<Int> {","    7 + 3","}","deferred.run()","\/\/ Later, you may await the result property or handle completion otherwise"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Subscribing to the task’s events using "},{"type":"codeVoice","code":"subscribe()"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["let deferred = DeferredTask<String> {","    \"Hello, World!\"","}","let cancellable = deferred.subscribe { event in","    switch event {","    case .success(let value):","        print(\"Completed with value: \\(value)\")","    case .failure(let error):","        print(\"Failed with error: \\(error)\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Storing the subscription in a collection for lifecycle management:"}],"type":"paragraph"},{"syntax":"swift","code":["var cancellables = Set<AnyCancellable>()","let deferred = DeferredTask<Void> {","    print(\"Task executed\")","}","deferred.subscribe().store(in: &cancellables)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Chaining with operators:"}],"type":"paragraph"},{"syntax":"swift","code":["let result = try await DeferredTask { 21 }","    .map { $0 * 2 }","    .execute() \/\/ result is 42"],"type":"codeListing"}]}],"relationshipsSections":[{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork","doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP","doc:\/\/Afluent\/ScA"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/deferredtask"]}],"metadata":{"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"DeferredTask"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/DeferredTask.swift#L79","fileName":"DeferredTask.swift"},"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DeferredTask"}],"title":"DeferredTask","symbolKind":"class","roleHeading":"Class","modules":[{"name":"Afluent"}],"externalID":"s:7Afluent12DeferredTaskC"},"sections":[],"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/DeferredTask","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://Afluent/s16SendableMetatypeP":{"identifier":"doc:\/\/Afluent\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetat