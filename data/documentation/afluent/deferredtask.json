{"sections":[],"metadata":{"externalID":"s:7Afluent12DeferredTaskC","symbolKind":"class","modules":[{"name":"Afluent"}],"role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/DeferredTask.swift#L79","fileName":"DeferredTask.swift"},"navigatorTitle":[{"text":"DeferredTask","kind":"identifier"}],"title":"DeferredTask","roleHeading":"Class","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"DeferredTask"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/deferredtask"]}],"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/DeferredTask","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DeferredTask","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Success","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Success","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"DeferredTask"},{"type":"text","text":" represents an asynchronous operation that is defined but does not start executing until it is explicitly started."},{"type":"text","text":" "},{"type":"text","text":"This allows precise control over when the asynchronous work begins, supporting scenarios where you want to set up an async operation ahead of time and"},{"type":"text","text":" "},{"type":"text","text":"trigger its execution at a chosen moment."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This type conforms to the "},{"type":"codeVoice","code":"AsynchronousUnitOfWork"},{"type":"text","text":" protocol and is useful for wrapping async computations, network requests, or any other asynchronous operation"},{"type":"text","text":" "},{"type":"text","text":"that may throw an error and returns a value."}],"type":"paragraph"},{"anchor":"Example","level":2,"type":"heading","text":"Example"},{"inlineContent":[{"text":"Basic usage with ","type":"text"},{"code":"execute()","type":"codeVoice"},{"text":" to start and await the operation:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let deferred = DeferredTask<Int> {","    try await Task.sleep(nanoseconds: 1_000_000_000)","    return 42","}","let result = try await deferred.execute()","print(\"Result is \\(result)\")"]},{"inlineContent":[{"type":"text","text":"Accessing the result via the "},{"type":"codeVoice","code":"result"},{"type":"text","text":" property (an async property that awaits completion):"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let deferred = DeferredTask<Int> {","    10 * 5","}","let value = await deferred.result","print(\"Value is \\(value)\")"]},{"inlineContent":[{"text":"Running the operation without awaiting its result immediately, via ","type":"text"},{"type":"codeVoice","code":"run()"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let deferred = DeferredTask<Int> {","    7 + 3","}","deferred.run()","\/\/ Later, you may await the result property or handle completion otherwise"]},{"inlineContent":[{"type":"text","text":"Subscribing to the task’s events using "},{"type":"codeVoice","code":"subscribe()"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let deferred = DeferredTask<String> {","    \"Hello, World!\"","}","let cancellable = deferred.subscribe { event in","    switch event {","    case .success(let value):","        print(\"Completed with value: \\(value)\")","    case .failure(let error):","        print(\"Failed with error: \\(error)\")","    }","}"]},{"inlineContent":[{"text":"Storing the subscription in a collection for lifecycle management:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var cancellables = Set<AnyCancellable>()","let deferred = DeferredTask<Void> {","    print(\"Task executed\")","}","deferred.subscribe().store(in: &cancellables)"]},{"inlineContent":[{"type":"text","text":"Chaining with operators:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let result = try await DeferredTask { 21 }","    .map { $0 * 2 }","    .execute() \/\/ result is 42"]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"A deferred unit of asynchronous work that produces a result of type "},{"code":"Success","type":"codeVoice"},{"type":"text","text":"."}],"topicSections":[{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/DeferredTask\/init(operation:)"],"generated":true},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/DeferredTask\/state"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/DeferredTask\/Actor-Implementations","doc:\/\/Afluent\/documentation\/Afluent\/DeferredTask\/AsynchronousUnitOfWork-Implementations"],"generated":true}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork","doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP","doc:\/\/Afluent\/ScA"]}],"kind":"symbol","references":{"doc://Afluent/ScA":{"type":"unresolvable","identifier":"doc:\/\/Afluent\/ScA","title":"_Concurrency.Actor"},"doc://Afluent/documentation/Afl