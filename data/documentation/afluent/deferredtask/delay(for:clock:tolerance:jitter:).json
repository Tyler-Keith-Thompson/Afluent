ontent":[{"type":"text","text":"How the delay is randomized. Defaults to "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/none","isActive":true},{"type":"text","text":". Decorrelated"},{"type":"text","text":" "},{"type":"text","text":"jitter waits at most three times "},{"code":"duration","type":"codeVoice"},{"type":"text","text":"."}]}],"name":"jitter"}],"kind":"parameters"},{"content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"AsynchronousUnitOfWork"},{"type":"text","text":" that emits the upstream output after the specified delay."}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"This operator suspends the emission of output for the specified duration according to the provided clock."}],"type":"paragraph"},{"anchor":"Discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Delaying work using a custom clock is beneficial when you need precise control over timing behavior,"},{"type":"text","text":" "},{"type":"text","text":"such as testing with test clocks or synchronizing work with specific time sources."},{"type":"text","text":" "},{"type":"text","text":"Use this operator to implement retry backoff, throttling, or scheduled tasks that depend on a particular clock implementation."}],"type":"paragraph"},{"anchor":"Example","text":"Example","level":2,"type":"heading"},{"syntax":"swift","code":["let start = Date()","let clock = SuspendingClock()","let delayedTask = DeferredTask {","    \"Delayed with custom clock\"","}.delay(for: .seconds(1), clock: clock, tolerance: .milliseconds(100))","let result = try await delayedTask.execute()","let elapsed = Date().timeIntervalSince(start)","print(\"Result: \\(result) after \\(elapsed) seconds\")"],"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Availability: macOS 13.0, iOS 16.0, watchOS 9.0, tvOS 16.0, visionOS 1.0 and above."}],"type":"paragraph"}]}],"type":"unorderedList"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"On WASI, a sleep on a real clock ("},{"code":"ContinuousClock","type":"codeVoice"},{"type":"text","text":", "},{"code":"SuspendingClock","type":"codeVoice"},{"type":"text","text":") holds the one thread"},{"type":"text","text":" "},{"type":"text","text":"until its deadline, even when other work is ready, and cancelling it doesn’t end it sooner. So the"},{"type":"text","text":" "},{"type":"text","text":"delay always waits out its whole duration, even when cancelled. A test clock is unaffected."}]}],"type":"aside"}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/DeferredTask"]]},"references":{"doc://Afluent/documentation/Afluent/AsynchronousUnitOfWork/Success":{"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Success","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}],"type":"topic","role":"symbol","required":true,"abstract":[{"type":"text","text":"The type of data the unit of work will produce if it succeeds."}],"url":"\/documentation\/afluent\/asynchronousunitofwork\/success","title":"Success","kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork\/Success"},"doc://Afluent/documentation/Afluent/BackoffJitter":{"kind":"symbol","url":"\/documentation\/afluent\/backoffjitter","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BackoffJitter","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"BackoffJitter","kind":"identifier"}],"abstract":[{"text":"How a wait is randomized, so m