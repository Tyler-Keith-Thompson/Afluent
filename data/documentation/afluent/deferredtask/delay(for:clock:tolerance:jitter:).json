: ","kind":"text"},{"text":"Clock","kind":"typeIdentifier","preciseIdentifier":"s:12_Concurrency5ClockP"},{"text":"\n","kind":"text"}],"platforms":["Linux"]}]},{"parameters":[{"name":"duration","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The duration to delay the output, conforming to the clock’s associated "},{"type":"codeVoice","code":"Duration"},{"type":"text","text":" type."}]}]},{"name":"clock","content":[{"type":"paragraph","inlineContent":[{"text":"The clock used for timekeeping.","type":"text"}]}]},{"name":"tolerance","content":[{"type":"paragraph","inlineContent":[{"text":"An optional tolerance for the delay. Defaults to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}]},{"name":"jitter","content":[{"type":"paragraph","inlineContent":[{"text":"How the delay is randomized. Defaults to ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/none","isActive":true,"type":"reference"},{"text":". Decorrelated","type":"text"},{"text":" ","type":"text"},{"text":"jitter waits at most three times ","type":"text"},{"code":"duration","type":"codeVoice"},{"text":".","type":"text"}]}]}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"code":"AsynchronousUnitOfWork","type":"codeVoice"},{"text":" that emits the upstream output after the specified delay.","type":"text"}]}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"This operator suspends the emission of output for the specified duration according to the provided clock."}],"type":"paragraph"},{"text":"Discussion","anchor":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Delaying work using a custom clock is beneficial when you need precise control over timing behavior,"},{"type":"text","text":" "},{"type":"text","text":"such as testing with test clocks or synchronizing work with specific time sources."},{"type":"text","text":" "},{"type":"text","text":"Use this operator to implement retry backoff, throttling, or scheduled tasks that depend on a particular clock implementation."}],"type":"paragraph"},{"text":"Example","anchor":"Example","level":2,"type":"heading"},{"code":["let start = Date()","let clock = SuspendingClock()","let delayedTask = DeferredTask {","    \"Delayed with custom clock\"","}.delay(for: .seconds(1), clock: clock, tolerance: .milliseconds(100))","let result = try await delayedTask.execute()","let elapsed = Date().timeIntervalSince(start)","print(\"Result: \\(result) after \\(elapsed) seconds\")"],"type":"codeListing","syntax":"swift"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Availability: macOS 13.0, iOS 16.0, watchOS 9.0, tvOS 16.0, visionOS 1.0 and above.","type":"text"}]}]}],"type":"unorderedList"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"On WASI, a sleep on a real clock (","type":"text"},{"code":"ContinuousClock","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SuspendingClock","type":"codeVoice"},{"text":") holds the one thread","type":"text"},{"text":" ","type":"text"},{"text":"until its deadline, even when other work is ready, and cancelling it doesn’t end it sooner. So the","type":"text"},{"text":" ","type":"text"},{"text":"delay always waits out its whole duration, even when cancelled. A test clock is unaffected.","type":"text"}]}],"type":"aside","style":"note"}],"kind":"content"}],"abstract":[{"type":"text","text":"Delays the emission of output from the upstream "},{"type":"codeVoice","code":"AsynchronousUnitOfWork"},{"type":"text","text":" by a specified duration using a given clock."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/deferredtask\/delay(for:clock:tolerance:jitter:)"]}],"hierarchy":{"paths":