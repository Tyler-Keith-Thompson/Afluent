tforms":["Linux"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The duration to delay the output."}],"type":"paragraph"}],"name":"duration"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"How the delay is randomized. Defaults to "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/none","type":"reference","isActive":true},{"type":"text","text":". Decorrelated"},{"type":"text","text":" "},{"type":"text","text":"jitter waits at most three times "},{"code":"duration","type":"codeVoice"},{"type":"text","text":"."}]}],"name":"jitter"}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"type":"codeVoice","code":"AsynchronousUnitOfWork"},{"text":" that emits the upstream output after the specified delay.","type":"text"}]}],"kind":"content"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This operator suspends the emission of output for the given duration before returning the value."}]},{"level":2,"type":"heading","text":"Discussion","anchor":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Delayed work is useful in scenarios such as throttling requests, implementing retry backoff strategies,","type":"text"},{"text":" ","type":"text"},{"text":"or scheduling work to occur after a fixed interval. By delaying the emission, you can control timing","type":"text"},{"text":" ","type":"text"},{"text":"behavior in asynchronous workflows in a straightforward and composable manner.","type":"text"}]},{"level":2,"type":"heading","text":"Example","anchor":"Example"},{"code":["let start = Date()","let delayedTask = DeferredTask {","    \"Hello, world!\"","}.delay(for: .seconds(2))","let result = try await delayedTask.execute()","let elapsed = Date().timeIntervalSince(start)","print(\"Result: \\(result) after \\(elapsed) seconds\")"],"type":"codeListing","syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Availability: macOS 13.0, iOS 16.0, watchOS 9.0, tvOS 16.0, visionOS 1.0 and above."}]}]}]},{"name":"Note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"On WASI, a sleep on a real clock ("},{"code":"ContinuousClock","type":"codeVoice"},{"type":"text","text":", "},{"code":"SuspendingClock","type":"codeVoice"},{"type":"text","text":") holds the one thread"},{"type":"text","text":" "},{"type":"text","text":"until its deadline, even when other work is ready, and cancelling it doesn’t end it sooner. So the"},{"type":"text","text":" "},{"type":"text","text":"delay always waits out its whole duration, even when cancelled. A test clock is unaffected."}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"references":{"doc://Afluent/documentation/Afluent/BackoffJitter":{"kind":"symbol","url":"\/documentation\/afluent\/backoffjitter","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BackoffJitter","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"BackoffJitter","kind":"identifier"}],"abstract":[{"text":"How a wait is randomized, so many clients that started waiting together don’t all wake together.","type":"text"}],"type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter","title":"BackoffJitter"},"doc://Afluent/documentation/Afluent":{"kind":"symbol","role":"collection","abstract":[],"url":"\/documentation\/afluent","type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent","title":"Afluent"},"doc://Afluent/documentation/Afluent/AsynchronousUnitOfWork/Success":{"fragments":[{"text":"associatedtype","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Success","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8Sendab