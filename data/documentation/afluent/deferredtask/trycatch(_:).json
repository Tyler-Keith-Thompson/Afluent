text","text":"\n"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"handler","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that takes the caught "},{"code":"Error","type":"codeVoice"},{"type":"text","text":" and asynchronously throws or returns an "},{"code":"AsynchronousUnitOfWork","type":"codeVoice"},{"type":"text","text":" to recover with."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"An "},{"code":"AsynchronousUnitOfWork","type":"codeVoice"},{"type":"text","text":" that tries to catch and replace any error with the unit of work returned by the handler."}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The handler receives the caught error and can throw. If the handler throws, the error is rethrown."}],"type":"paragraph"},{"inlineContent":[{"text":"This operator is useful when recovery logic itself can throw asynchronously.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Example","anchor":"Example","type":"heading"},{"syntax":"swift","type":"codeListing","code":["struct FallbackError: Error {}","","let primaryTask = DeferredTask<Int> {","    throw FallbackError()","}","","let fallbackTask = DeferredTask<Int> {","    return 42","}","","let recoveredTask = primaryTask.tryCatch { error in","    print(\"Caught error: \\(error), attempting recovery\")","    \/\/ Recovery could fail, so handler can throw","    if Bool.random() {","        return fallbackTask","    } else {","        throw error","    }","}","","let result = try await recoveredTask.operation().value"]}]}],"abstract":[{"type":"text","text":"Returns an asynchronous unit of work that tries to catch any errors emitted by the upstream asynchronous unit of work"},{"type":"text","text":" "},{"type":"text","text":"and recovers by replacing the failure with a new unit of work produced by the given throwing handler."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/deferredtask\/trycatch(_:)"]}],"references":{"doc://Afluent/documentation/Afluent/AsynchronousUnitOfWork":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork","role":"symbol","title":"AsynchronousUnitOfWork","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsynchronousUnitOfWork","kind":"identifier"}],"navigatorTitle":[{"text":"AsynchronousUnitOfWork","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"text":"Represents an asynchronous unit of work.","type":"text"}],"url":"\/documentation\/afluent\/asynchronousunitofwork"},"doc://Afluent/documentation/Afluent/DeferredTask/tryCatch(_:)":{"abstract":[{"type":"text","text":"Returns an asynchronous unit of work that tries to catch any errors emitted by the upstream asynchronous unit of work"},{"type":"text","text":" "},{"type":"text","text":"and recovers by replacing the failure with a new unit of work produced by the given throwing handler."}],"title":"tryCatch(_:)","kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/DeferredTask\/tryCatch(_:)","url":"\/documentation\/afluent\/deferredtask\/trycatch(_:)","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"tryCatch"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"D"},{"kind":"text","text":">((any "},{"preciseIdentifier":"s:s5ErrorP","kind":"typeIdentifier","text":"Error"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"D"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseId