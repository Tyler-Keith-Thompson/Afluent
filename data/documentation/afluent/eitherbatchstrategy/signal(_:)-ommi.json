chor":"Example","type":"heading"},{"code":["let shutdown = SingleValueSubject<Void>()","for try await messages in inbox.batch(strategy: .either(.count(50), .signal(shutdown))) {","    store(messages)","}","\/\/ Elsewhere: flush whatever is pending before shutting down.","try shutdown.send()"],"syntax":"swift","type":"codeListing"}]}],"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/EitherBatchStrategy\/signal(_:)-ommi","interfaceLanguage":"swift"},"sections":[],"references":{"doc://Afluent/documentation/Afluent/EitherBatchStrategy/signal(_:)-ommi":{"role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"signal","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Batched","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Success","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"SingleValueSubject","preciseIdentifier":"s:7Afluent18SingleValueSubjectC","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Success","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"SignalBatchStrategy","preciseIdentifier":"s:7Afluent19SignalBatchStrategyV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Batched","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Deferred","preciseIdentifier":"s:7Afluent14AsyncSequencesO8DeferredV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"AsyncThrowingStream","preciseIdentifier":"s:Scs","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Success","kind":"typeIdentifier"},{"text":", any ","kind":"text"},{"text":"Error","preciseIdentifier":"s:s5ErrorP","kind":"typeIdentifier"},{"text":">>>","kind":"text"}],"title":"signal(_:)","kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/EitherBatchSt