t\/documentation\/Afluent\/SignalBatchStrategy","preciseIdentifier":"s:7Afluent19SignalBatchStrategyV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Batched","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"AsyncSequences","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Deferred","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Deferred","preciseIdentifier":"s:7Afluent14AsyncSequencesO8DeferredV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"AsyncThrowingStream","preciseIdentifier":"s:Scs","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Success","kind":"typeIdentifier"},{"text":", any ","kind":"text"},{"text":"Error","preciseIdentifier":"s:s5ErrorP","kind":"typeIdentifier"},{"text":">>>, ","kind":"text"},{"text":"Success","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The subject whose value flushes the batch.","type":"text"}]}],"name":"subject"}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","type":"reference","isActive":true},{"text":" over a stream of the subject’s one value, made afresh","type":"text"},{"text":" ","type":"text"},{"text":"for each iteration.","type":"text"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"inlineContent":[{"type":"text","text":"The batched sequence listens to the subject without owning it: when the batched sequence"},{"type":"text","text":" "},{"type":"text","text":"ends or is cancelled, its wait ends at once and the subject stays pending for its other"},{"type":"text","text":" "},{"type":"text","text":"awaiters. A subject sent an error ends the batched sequence with that error, except"},{"type":"text","text":" "},{"code":"CancellationError","type":"codeVoice"},{"type":"text","text":" (as when another awaiter cancels the subject): then the signal stops"},{"type":"text","text":" "},{"type":"text","text":"firing and the batches go on. A subject sent a value before iteration begins fires when the"},{"type":"text","text":" "},{"type":"text","text":"signal’s task starts, which may come after elements have arrived, so the first batch may be"},{"type":"text","text":" "},{"type":"text","text":"short. Each batched sequence iterated with this strategy listens anew, so a subject"},{"type":"text","text":" "},{"type":"text","text":"already sent a value fires again when a later batched sequence’s signal task starts."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Example","text":"Example"},{"code":["let shutdown = SingleValueSubject<Void>()","for try await messages in inbox.batch(strategy: .either(.count(50), .signal(shutdown))) {","    store(messages)","}","\/\/ Elsewhere: flush whatever is pending before shutting down.","try shutdown.send()"],"syntax":"swift","type":"codeListing"}]}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/EitherBatchStrategy"]]},"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/EitherBatchStrategy\/signal(_:)-ommi","interfaceLanguage":"swift"},"sections":[],"metadata":{"role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"signal","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Batched","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Success","kind":"genericParameter"},{"text":">(","