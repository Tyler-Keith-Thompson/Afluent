e"},{"type":"codeListing","syntax":"swift","code":["let shutdown = SingleValueSubject<Void>()","for try await messages in inbox.batch(strategy: .either(.count(50), .signal(shutdown))) {","    store(messages)","}","\/\/ Elsewhere: flush whatever is pending before shutting down.","try shutdown.send()"]}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Flushes once, when the given subject is sent a value."}],"kind":"symbol","references":{"doc://Afluent/documentation/Afluent/EitherBatchStrategy":{"title":"EitherBatchStrategy","navigatorTitle":[{"kind":"identifier","text":"EitherBatchStrategy"}],"type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/EitherBatchStrategy","url":"\/documentation\/afluent\/eitherbatchstrategy","abstract":[{"type":"text","text":"A "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","type":"reference","isActive":true},{"type":"text","text":" that flushes when any of several strategies does."}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EitherBatchStrategy"}]},"doc://Afluent/documentation/Afluent/EitherBatchStrategy/signal(_:)-ommi":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"signal","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Batched","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Success","kind":"genericParameter"},{"text":">(","kind":"text"},{"preciseIdentifier":"s:7Afluent18SingleValueSubjectC","text":"SingleValueSubject","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Success","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"preciseIdentifier":"s:7Afluent19SignalBatchStrategyV","text":"SignalBatchStrategy","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Batched","kind":"typeIdentifier"},{"text":