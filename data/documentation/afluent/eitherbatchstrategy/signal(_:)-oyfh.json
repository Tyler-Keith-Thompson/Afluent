":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"preciseIdentifier":"s:7Afluent19SignalBatchStrategyV","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","text":"SignalBatchStrategy","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Batched","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","text":"AsyncSequences","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:7Afluent14AsyncSequencesO8DeferredV","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Deferred","text":"Deferred","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:Scs","text":"AsyncThrowingStream","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Unit","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP7SuccessQa","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork\/Success","text":"Success","kind":"typeIdentifier"},{"text":", any ","kind":"text"},{"preciseIdentifier":"s:s5ErrorP","text":"Error","kind":"typeIdentifier"},{"text":">>>, ","kind":"text"},{"text":"Unit","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork","text":"AsynchronousUnitOfWork","kind":"typeIdentifier"}]}]},{"kind":"parameters","parameters":[{"name":"unit","content":[{"type":"paragraph","inlineContent":[{"text":"The unit of work whose completion flushes the batch.","type":"text"}]}]}]},{"content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","type":"reference","isActive":true},{"text":" over a stream of the unit’s one value, made afresh","type":"text"},{"text":" ","type":"text"},{"text":"for each iteration.","type":"text"}]}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The unit’s work runs in the signal’s task each time iteration begins; a unit that fails"},{"type":"text","text":" "},{"type":"text","text":"ends the batched sequence with its error. When the batched sequence ends first, the unit’s"},{"type":"text","text":" "},{"type":"text","text":"work is cancelled; a unit whose work ignores cancellation keeps the batch’s internal task"},{"type":"text","text":" "},{"type":"text","text":"alive until it returns, though the batched sequence itself ends at once. A"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SingleValueSubject","type":"reference"},{"type":"text","text":" takes "},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/EitherBatchStrategy\/signal(_:)-ommi","type":"reference"},{"type":"text","text":" instead, which"},{"type":"text","text":" "},{"type":"text","text":"leaves the subject alone. Each batched sequence iterated with this strategy runs the unit"},{"type":"text","text":" "},{"type":"text","text":"anew and fires once when it completes."}],"type":"paragraph"},{"level":2,"text":"Example","type":"heading","anchor":"Example"},{"type":"codeListing","syntax":"swift","code":["let reachable = DeferredTask { try await server.waitUntilReachable() }","for try await requests in outbox.batch(strategy: .either(.count(20), .signal(reachable))) {","    try await send(requests)","}"]}],"kind":"content"}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/afluent\/eitherbatchstrategy\/signal(_:)-oyfh"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent