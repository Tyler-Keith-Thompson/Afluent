","text":" takes "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/EitherBatchStrategy\/signal(_:)-ommi","isActive":true},{"type":"text","text":" instead, which"},{"type":"text","text":" "},{"type":"text","text":"leaves the subject alone. Each batched sequence iterated with this strategy runs the unit"},{"type":"text","text":" "},{"type":"text","text":"anew and fires once when it completes."}]},{"type":"heading","level":2,"text":"Example","anchor":"Example"},{"type":"codeListing","code":["let reachable = DeferredTask { try await server.waitUntilReachable() }","for try await requests in outbox.batch(strategy: .either(.count(20), .signal(reachable))) {","    try await send(requests)","}"],"syntax":"swift"}]}],"references":{"doc://Afluent/documentation/Afluent/BatchStrategy":{"abstract":[{"type":"text","text":"When "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/batch(strategy:)","isActive":true},{"type":"text","text":" emits the elements it has gathered."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchStrategy"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"BatchStrategy"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","title":"BatchStrategy","url":"\/documentation\/afluent\/batchstrategy"},"doc://Afluent/documentation/Afluent/EitherBatchStrategy/signal(_:)-oyfh":{"role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"signal","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Batched","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Unit","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"Unit","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"SignalBatchStrategy","kind":"typeIdentifier","precis