{"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PassthroughSubject","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"Subscribing","type":"heading","text":"Subscribing","level":2},{"inlineContent":[{"text":"A consumer subscribes when its iterator is created, which is when a ","type":"text"},{"type":"codeVoice","code":"for try await"},{"text":" loop over the subject","type":"text"},{"text":" ","type":"text"},{"text":"(or over an operator chain built on it) begins. From then on, every value sent is buffered for that consumer","type":"text"},{"text":" ","type":"text"},{"text":"until it is consumed, so a consumer that is slower than the sender still sees every value, in order.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Values sent while there are no subscribers are discarded; they are never replayed to a later consumer.","type":"text"}],"type":"paragraph"},{"style":"important","content":[{"inlineContent":[{"text":"Starting a ","type":"text"},{"type":"codeVoice","code":"Task"},{"text":" that iterates the subject does not mean it has subscribed yet. If values must","type":"text"},{"text":" ","type":"text"},{"text":"not be missed, subscribe before starting it: make the iterator now and hand it to the consumer as an","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncIteratorSequence","type":"reference","isActive":true},{"text":" (","type":"text"},{"type":"codeVoice","code":"AsyncIteratorSequence(subject.makeAsyncIterator())"},{"text":"). Or wait until the consumer","type":"text"},{"text":" ","type":"text"},{"text":"has subscribed before sending, for example with ","type":"text"},{"type":"codeVoice","code":"handleEvents(receiveMakeIterator:)"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Important"},{"inlineContent":[{"text":"Cancelling a task waiting for the subject’s next value ends that consumer’s subscription; values sent afterwards","type":"text"},{"text":" ","type":"text"},{"text":"are not delivered to it. To read the subject again, make a new iterator.","type":"text"}],"type":"paragraph"},{"anchor":"Example","type":"heading","text":"Example","level":2},{"code":["let subject = PassthroughSubject<Int>()","let subscribed = SingleValueSubject<Void>()","","subject.send(0) \/\/ No subscribers yet, so this value is discarded.","","Task {","    for try await value in subject.handleEvents(receiveMakeIterator: { try? subscribed.send() }) {","        print(\"Received value: \\(value)\") \/\/ prints 1, then 2","    }","}","","try await subscribed.execute()","subject.send(1)","subject.send(2)","subject.send(completion: .finished)"],"type":"codeListing","syntax":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"sections":[],"kind":"symbol","metadata":{"symbolKind":"class","roleHeading":"Class","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PassthroughSubject"}],"externalID":"s:7Afluent18PassthroughSubjectC","remoteSource":{"fileName":"PassthroughSubject.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/PassthroughSubject.swift#L45"},"modules":[{"name":"Afluent"}],"navigatorTitle":[{"text":"PassthroughSubject","kind":"identifier"}],"title":"PassthroughSubject"},"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","interfaceLanguage":"swift"},"abstract":[{"text":"A subject that broadcasts values to multiple consumers without storing a current value.","type":"text"},{"text":" ","type":"text"},{"text":"Unlike ","type":"text"},{"code":"CurrentValueSubject","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PassthroughSubject","type":"codeVoice"},{"text":" does not retain the most recent value.","type":"text"},{"text":" ","type":"text"},{"text":"This is an ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s PassthroughSubject.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/Iterator"],"title":"Structures","generated":true,"anchor":"Structures"},{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/init()"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/makeAsyncIterator()","doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/makeSubscription()","doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/send()","doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/send(_:)","doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/send(completion:)"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"},{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/Completion"],"title":"Enumerations","generated":true,"anchor":"Enumerations"},{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/AsyncSequence-Implementations","doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/AsyncSequence-Implementations"],"title":"Default Implementations","generated":true,"anchor":"Default-Implementations"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Afluent\/s8SendableP","doc: