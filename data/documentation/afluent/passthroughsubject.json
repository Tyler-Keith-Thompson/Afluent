d":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s8SendableP","text":"Sendable","kind":"typeIdentifier"}],"platforms":["Linux"]}]},{"kind":"content","content":[{"anchor":"Subscribing","text":"Subscribing","level":2,"type":"heading"},{"inlineContent":[{"text":"A consumer subscribes when its iterator is created, which is when a ","type":"text"},{"type":"codeVoice","code":"for try await"},{"text":" loop over the subject","type":"text"},{"text":" ","type":"text"},{"text":"(or over an operator chain built on it) begins. From then on, every value sent is buffered for that consumer","type":"text"},{"text":" ","type":"text"},{"text":"until it is consumed, so a consumer that is slower than the sender still sees every value, in order.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Values sent while there are no subscribers are discarded; they are never replayed to a later consumer."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"Starting a "},{"type":"codeVoice","code":"Task"},{"type":"text","text":" that iterates the subject does not mean it has subscribed yet. If values must"},{"type":"text","text":" "},{"type":"text","text":"not be missed, wait until the consumer has subscribed before sending, for example with"},{"type":"text","text":" "},{"type":"codeVoice","code":"handleEvents(receiveMakeIterator:)"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"Important","style":"important","type":"aside"},{"anchor":"Example","text":"Example","level":2,"type":"heading"},{"syntax":"swift","code":["let subject = PassthroughSubject<Int>()","let subscribed = SingleValueSubject<Void>()","","subject.send(0) \/\/ No subscribers yet, so this value is discarded.","","Task {","    for try await value in subject.handleEvents(receiveMakeIterator: { try? subscribed.send() }) {","        print(\"Received value: \\(value)\") \/\/ prints 1, then 2","    }","}","","try await subscribed.execute()","subject.send(1)","subject.send(2)","subject.send(completion: .finished)"],"type":"codeListing"}]}],"metadata":{"modules":[{"name":"Afluent"}],"externalID":"s:7Afluent18PassthroughSubjectC","remoteSource":{"fileName":"PassthroughSubject.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/PassthroughSubject.swift#L41"},"roleHeading":"Class","role":"symbol","title":"PassthroughSubject","symbolKind":"class","navigatorTitle":[{"kind":"identifier","text":"PassthroughSubject"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PassthroughSubject","kind":"identifier"}]},"abstract":[{"type":"text","text":"A subject that broadcasts values to multiple consumers without storing a current value."},{"type":"text","text":" "},{"type":"text","text":"Unlike "},{"type":"codeVoice","code":"CurrentValueSubject"},{"type":"text","text":", "},{"type":"codeVoice","code":"PassthroughSubject"},{"type":"text","text":" does not retain the most recent value."},{"type":"text","text":" "},{"type":"text","text":"This is an "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s PassthroughSubject."}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","interfaceLanguage":"swift"},"references":{"doc://Afluent/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/Afluent\/s8SendableP","title":"Swift.Sendable"},"doc://Afluent/documentation/Afluent/PassthroughSubject/Iterator":{"navigatorTitle":[{"kind":"identifier","text":"Iterator"}],"abstract":[],"url":"\/documentation\/afluent\/passthroughsubject\/iterator","kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/Iterator","role":"symbol","title":"PassthroughSubject.Iterator","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text"