d":"symbol","abstract":[{"text":"A subject that broadcasts values to multiple consumers without storing a current value.","type":"text"},{"text":" ","type":"text"},{"text":"Unlike ","type":"text"},{"type":"codeVoice","code":"CurrentValueSubject"},{"text":", ","type":"text"},{"type":"codeVoice","code":"PassthroughSubject"},{"text":" does not retain the most recent value.","type":"text"},{"text":" ","type":"text"},{"text":"This is an ","type":"text"},{"type":"codeVoice","code":"AsyncSequence"},{"text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s PassthroughSubject.","type":"text"}],"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/afluent\/passthroughsubject"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PassthroughSubject"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Subscribing","anchor":"Subscribing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A consumer subscribes when its iterator is created, which is when a "},{"type":"codeVoice","code":"for try await"},{"type":"text","text":" loop over the subject"},{"type":"text","text":" "},{"type":"text","text":"(or over an operator chain built on it) begins. From then on, every value sent is buffered for that consumer"},{"type":"text","text":" "},{"type":"text","text":"until it is consumed, so a consumer that is slower than the sender still sees every value, in order."}]},{"type":"paragraph","inlineContent":[{"text":"Values sent while there are no subscribers are discarded; they are never replayed to a later consumer.","type":"text"}]},{"type":"aside","name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"Starting a ","type":"text"},{"code":"Task","type":"codeVoice"},{"text":" that iterates the subject does not mean it has subscribed yet. If values must","type":"text"},{"text":" ","type":"text"},{"text":"not be missed, subscribe before starting it: make the iterator now and hand it to the consumer as an","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncIteratorSequence","isActive":true,"type":"reference"},{"text":" (","type":"text"},{"code":"AsyncIteratorSequence(subject.makeAsyncIterator())","type":"codeVoice"},{"text":"). Or wait until the consumer","type":"text"},{"text":" ","type":"text"},{"text":"has subscribed before sending, for example with ","type":"text"},{"code":"handleEvents(receiveMakeIterator:)","type":"codeVoice"},{"text":".","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cancelling a task waiting for the subject’s next value ends that consumer’s subscription; values sent afterwards"},{"type":"text","text":" "},{"type":"text","text":"are not delivered to it. To read the subject again, make a new iterator."}]},{"level":2,"type":"heading","text":"Example","anchor":"Example"},{"type":"codeListing","syntax":"swift","code":["let subject = PassthroughSubject<Int>()","let subscribed = SingleValueSubject<Void>()","","subject.send(0) \/\/ No subscribers yet, so this value is discarded.","","Task {","    for try await value in subject.handleEvents(receiveMakeIterator: { try? subscribed.send() }) {","        print(\"Received value: \\(value)\") \/\/ prints 1, then 2","    }","}","","try await subscribed.execute()","subject.send(1)","subject.send(2)","subject.send(completion: .finished)"]}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://Afluent/documentation/Afluent/PassthroughSubject":{"type":"topic","title":"PassthroughSubject","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PassthroughSubject"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","navigatorTitle":[{"kind":"identifier","text":"PassthroughSubject"}],"abstract":[{"type":"text","text":"A subject that broadcasts values to multiple consumers without storing a current value."},{"type":"text","text":" "},{"type":"text","text":"Unlike "},{"type":"codeVoice","code":"CurrentValueSubject"},{"type":"text","text":", "},{"type":"codeVoice","code":"PassthroughSubject"},{"type":"text","text":" does not retain the most recent value."},{"type":"text","text":" "},{"type":"text","text":"This is an "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s PassthroughSubject."}],"kind":"symbol","url":"\/documentation\/afluent\/passthroughsubject","role":"symbol"},"doc://Afluent/documentation/Afluent/PassthroughSubject/makeSubscription()":{"url":"\/documentation\/afluent\/passthroughsubject\/makesubscription()","title":"makeSubscription()","abstract":[{"type":"text","text":"Subscribes a new consumer that keeps its place when a wait for the next value is cancelled. Values sent from now on are buffered for it until it reads them."}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"makeSubscription","kind":"identifier"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:7Afluent19SubjectSubscriptionV","text":"SubjectSubscription","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Element","k