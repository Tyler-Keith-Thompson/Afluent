fluent/documentation/Afluent/PassthroughSubject/send(_:)":{"role":"symbol","abstract":[{"text":"Sends a new value to every current subscriber. If there are no subscribers, the value is discarded.","type":"text"}],"url":"\/documentation\/afluent\/passthroughsubject\/send(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"send"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":")"}],"type":"topic","title":"send(_:)","kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/send(_:)"},"doc://Afluent/documentation/Afluent/PassthroughSubject/init()":{"url":"\/documentation\/afluent\/passthroughsubject\/init()","kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/init()","fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}],"type":"topic","title":"init()","abstract":[{"type":"text","text":"Creates a "},{"type":"codeVoice","code":"PassthroughSubject"},{"type":"text","text":"."}],"role":"symbol"},"doc://Afluent/documentation/Afluent/PassthroughSubject/send(completion:)":{"type":"topic","url":"\/documentation\/afluent\/passthroughsubject\/send(completion:)","role":"symbol","abstract":[{"text":"Completes the subject, preventing any further values from being sent.","type":"text"},{"text":" ","type":"text"},{"text":"Current subscribers receive the completion after any values already buffered for them, and consumers that","type":"text"},{"text":" ","type":"text"},{"text":"start iterating afterwards receive it immediately.","type":"text"}],"kind":"symbol","title":"send(completion:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"send"},{"kind":"text","text":"("},{"kind":"externalParam","text":"completion"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7Afluent18PassthroughSubjectC","kind":"typeIdentifier","text":"PassthroughSubje