:" that iterates the subject does not mean it has subscribed yet. If values must","type":"text"},{"text":" ","type":"text"},{"text":"not be missed, wait until the consumer has subscribed before sending, for example with","type":"text"},{"text":" ","type":"text"},{"code":"handleEvents(receiveMakeIterator:)","type":"codeVoice"},{"text":".","type":"text"}]}],"type":"aside","name":"Important"},{"text":"Example","type":"heading","anchor":"Example","level":2},{"type":"codeListing","code":["let subject = PassthroughSubject<Int>()","let subscribed = SingleValueSubject<Void>()","","subject.send(0) \/\/ No subscribers yet, so this value is discarded.","","Task {","    for try await value in subject.handleEvents(receiveMakeIterator: { try? subscribed.send() }) {","        print(\"Received value: \\(value)\") \/\/ prints 1, then 2","    }","}","","try await subscribed.execute()","subject.send(1)","subject.send(2)","subject.send(completion: .finished)"],"syntax":"swift"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/passthroughsubject"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"sections":[],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP","doc:\/\/Afluent\/Sci"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://Afluent/documentation/Afluent/PassthroughSubject/send()":{"kind":"symbol","url":"\/documentation\/afluent\/passthroughsubject\/send()","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"send"},{"kind":"text","text":"()"}],"abstract":[{"text":"Sends a value to every current subscriber when the subject’s ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Void","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text