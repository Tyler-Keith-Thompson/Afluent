type":"conformsTo","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP","doc:\/\/Afluent\/Sci"],"kind":"relationships","title":"Conforms To"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PassthroughSubject"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"Subscribing","text":"Subscribing","type":"heading","level":2},{"inlineContent":[{"text":"A consumer subscribes when its iterator is created, which is when a ","type":"text"},{"type":"codeVoice","code":"for try await"},{"text":" loop over the subject","type":"text"},{"text":" ","type":"text"},{"text":"(or over an operator chain built on it) begins. From then on, every value sent is buffered for that consumer","type":"text"},{"text":" ","type":"text"},{"text":"until it is consumed, so a consumer that is slower than the sender still sees every value, in order.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Values sent while there are no subscribers are discarded; they are never replayed to a later consumer.","type":"text"}],"type":"paragraph"},{"style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Starting a "},{"code":"Task","type":"codeVoice"},{"type":"text","text":" that iterates the subject does not mean it has subscribed yet. If values must"},{"type":"text","text":" "},{"type":"text","text":"not be missed, wait until the consumer has subscribed before sending, for example with"},{"type":"text","text":" "},{"code":"handleEvents(receiveMakeIterator:)","type":"codeVoice"},{"type":"text","text":"."}]}],"type":"aside"},{"anchor":"Example","text":"Example","type":"heading","level":2},{"code":["let subject = PassthroughSubject<Int>()","let subscribed = SingleValueSubject<Void>()","","subject.send(0) \/\/ No subscribers yet, so this value is discarded.","","Task {","    for try await value in subject.handleEvents(receiveMakeIterator: { try? subscribed.send() }) {","        print(\"Received value: \\(value)\") \/\/ prints 1, then 2","    }","}","","try await subscribed.execute()","subject.send(1)","subject.send(2)","subject.send(completion: .finished)"],"syntax":"swift","type":"codeListing"}]}],"sections":[],"metadata":{"roleHeading":"Class","title":"PassthroughSubject","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PassthroughSubject","kind":"identifier"}],"remoteSource":{"fileName":"PassthroughSubject.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/PassthroughSubject.swift#L41"},"modules":[{"name":"Afluent"}],"externalID":"s:7Afluent18PassthroughSubjectC","symbolKind":"class","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PassthroughSubject"}]},"references":{"doc://Afluent/documentation/Afluent/PassthroughSubject/Completion":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/Completion","title":"PassthroughSubject.Completion","role":"symbol","abstract":[{"type":"text","text":"Represents the completion event of a subject, which can either succeed or fail with an error."}],"conformance":{"constraints":[{"type":"codeVoice","code":"Element"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":