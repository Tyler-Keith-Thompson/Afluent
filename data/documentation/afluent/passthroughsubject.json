{"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PassthroughSubject"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Subscribing","anchor":"Subscribing","type":"heading"},{"inlineContent":[{"text":"A consumer subscribes when its iterator is created, which is when a ","type":"text"},{"code":"for try await","type":"codeVoice"},{"text":" loop over the subject","type":"text"},{"text":" ","type":"text"},{"text":"(or over an operator chain built on it) begins. From then on, every value sent is buffered for that consumer","type":"text"},{"text":" ","type":"text"},{"text":"until it is consumed, so a consumer that is slower than the sender still sees every value, in order.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Values sent while there are no subscribers are discarded; they are never replayed to a later consumer."}],"type":"paragraph"},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Starting a "},{"code":"Task","type":"codeVoice"},{"type":"text","text":" that iterates the subject does not mean it has subscribed yet. If values must"},{"type":"text","text":" "},{"type":"text","text":"not be missed, wait until the consumer has subscribed before sending, for example with"},{"type":"text","text":" "},{"code":"handleEvents(receiveMakeIterator:)","type":"codeVoice"},{"type":"text","text":"."}]}],"style":"important","type":"aside"},{"level":2,"text":"Example","anchor":"Example","type":"heading"},{"syntax":"swift","code":["let subject = PassthroughSubject<Int>()","let subscribed = SingleValueSubject<Void>()","","subject.send(0) \/\/ No subscribers yet, so this value is discarded.","","Task {","    for try await value in subject.handleEvents(receiveMakeIterator: { try? subscribed.send() }) {","        print(\"Received value: \\(value)\") \/\/ prints 1, then 2","    }","}","","try await subscribed.execute()","subject.send(1)","subject.send(2)","subject.send(completion: .finished)"],"type":"codeListing"}]}],"abstract":[{"text":"A subject that broadcasts values to multiple consumers without storing a current value.","type":"text"},{"text":" ","type":"text"},{"text":"Unlike ","type":"text"},{"type":"codeVoice","code":"CurrentValueSubject"},{"text":", ","type":"text"},{"type":"codeVoice","code":"PassthroughSubject"},{"text":" does not retain the most recent value.","type":"text"},{"text":" ","type":"text"},{"text":"This is an ","type":"text"},{"type":"codeVoice","code":"AsyncSequence"},{"text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s PassthroughSubject.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject"},"metadata":{"navigatorTitle":[{"kind":"identifier","text":"PassthroughSubject"}],"title":"PassthroughSubject","role":"symbol","symbolKind":"class","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PassthroughSubject"}],"remoteSource":{"fileName":"PassthroughSubject.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/PassthroughSubject.swift#L41"},"roleHeading":"Class","externalID":"s:7Afluent18PassthroughSubjectC","modules":[{"name":"Afluent"}]},"topicSections":[{"title":"Structures","identifiers":["doc:\/\/Afluent