{"sections":[],"abstract":[{"type":"text","text":"A subject that broadcasts values to multiple consumers without storing a current value."},{"type":"text","text":" "},{"type":"text","text":"Unlike "},{"type":"codeVoice","code":"CurrentValueSubject"},{"type":"text","text":", "},{"type":"codeVoice","code":"PassthroughSubject"},{"type":"text","text":" does not retain the most recent value."},{"type":"text","text":" "},{"type":"text","text":"This is an "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s PassthroughSubject."}],"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP","doc:\/\/Afluent\/Sci"],"kind":"relationships","title":"Conforms To"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PassthroughSubject"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/PassthroughSubject.swift#L41","fileName":"PassthroughSubject.swift"},"roleHeading":"Class","title":"PassthroughSubject","role":"symbol","modules":[{"name":"Afluent"}],"externalID":"s:7Afluent18PassthroughSubjectC","symbolKind":"class","navigatorTitle":[{"text":"PassthroughSubject","kind":"identifier"}]},"topicSections":[{"generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/Iterator"],"anchor":"Structures","title":"Structures"},{"generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/init()"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/makeAsyncIterator()","doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/send()","doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/send(_:)","doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/send(completion:)"],"anchor":"Instance-Methods","title":"Instance Methods"},{"generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/Completion"],"anchor":"Enumerations","title":"Enumerations"},{"generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/AsyncSequence-Implementations","doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/AsyncSequence-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PassthroughSubject"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"Subscribing","type":"heading","text":"Subscribing"},{"inlineContent":[{"type":"text","text":"A consumer subscribes when its iterator is created, which is when a "},{"code":"for try await","type":"codeVoice"},{"type":"text","text":" loop over the subject"},{"type":"text","text":" "},{"type":"text","text":"(or over an operator chain built on it) begins. From then on, every value sent is buffered for that consumer"},{"type":"text","text":" "},{"type":"text","text":"until it is consumed, so a consumer that is slower than the sender still sees every value, in order."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Values sent while there are no subscribers are discarded; they are never replayed to a later consumer."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Starting a "},{"type":"codeVoice","code":"Task"},{"type":"text","text":" that iterates the subject does not mean it has subscribed yet. If values must"},{"type":"text","text":" "},{"type":"text","text":"not be missed, wait until the consumer has subscribed before sending, for example with"},{"type":"text","text":" "},{"type":"codeVoice","code":"handleEvents(receiveMakeIterator:)"},{"type":"text","text":"."}]}],"style":"important","type":"aside","name":"Important"},{"level":2,"anchor":"Example","type":"heading","text":"Example"},{"syntax":"swift","type":"codeListing","code":["let subject = PassthroughSubject<Int>()","let subscribed = SingleValueSubject<Void>()","","subject.send(0) \/\/ No subscribers yet, so this value is discarded.","","Task {","    for try await value in subject.handleEvents(receiveMakeIterator: { try? subscribed.send() }) {","        print(\"Received value: \\(value)\") \/\/ prints 1, then 2","    }","}","","try await subscribed.execute()","subject.send(1)","subject.send(2)","subject.send(completion: .finished)"]}]}],"variants":[{"paths":["\/documentation\/afluent\/passthroughsubject"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject"},"references":{"doc://Afluent/documentation/Afluent/PassthroughSubject/init()":{"kind":"symbol","type":"topic","title":"init()","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"()"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/init()","abstract":[{"text":"Creates a ","type":"text"},{"type":"codeVoice","code":"PassthroughSubject"},{"text":".","type":"text"}],"url":"\/documentation\/afluent\/passthroughsubject\/init()","role":"symbol"},"doc://Afluent/s16SendableMetatypeP":{"title":"Swift.SendableMetatype",