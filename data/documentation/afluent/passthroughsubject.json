{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"A subject that broadcasts values to multiple consumers without storing a current value.","type":"text"},{"text":" ","type":"text"},{"text":"Unlike ","type":"text"},{"code":"CurrentValueSubject","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PassthroughSubject","type":"codeVoice"},{"text":" does not retain the most recent value.","type":"text"},{"text":" ","type":"text"},{"text":"This is an ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s PassthroughSubject.","type":"text"}],"metadata":{"modules":[{"name":"Afluent"}],"title":"PassthroughSubject","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/PassthroughSubject.swift#L45","fileName":"PassthroughSubject.swift"},"symbolKind":"class","role":"symbol","externalID":"s:7Afluent18PassthroughSubjectC","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PassthroughSubject","kind":"identifier"}],"navigatorTitle":[{"text":"PassthroughSubject","kind":"identifier"}],"roleHeading":"Class"},"topicSections":[{"title":"Structures","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/Iterator"],"anchor":"Structures"},{"title":"Initializers","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/init()"],"anchor":"Initializers"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/makeAsyncIterator()","doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/makeSubscription()","doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/send()","doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/send(_:)","doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/send(completion:)"],"anchor":"Instance-Methods"},{"title":"Enumerations","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/Completion"],"anchor":"Enumerations"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/AsyncSequence-Implementations","doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/AsyncSequence-Implementations"],"anchor":"Default-Implementations"}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP","doc:\/\/Afluent\/Sci"]}],"variants":[{"paths":["\/documentation\/afluent\/passthroughsubject"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PassthroughSubject"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Subscribing","anchor":"Subscribing","type":"heading"},{"inlineContent":[{"type":"text","text":"A consumer subscribes when its iterator is created, which is when a "},{"type":"codeVoice","code":"for try await"},{"type":"text","text":" loop over the subject"},{"type":"text","text":" "},{"type":"text","text":"(or over an operator chain built on it) begins. From then on, every value sent is buffered for that consumer"},{"type":"text","text":" "},{"type":"text","text":"until it is consumed, so a consumer that is slower than the sender still sees every value, in order."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Values sent while there are no subscribers are discarded; they are never replayed to a later consumer."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Starting a ","type":"text"},{"code":"Task","type":"codeVoice"},{"text":" that iterates the subject does not mean it has subscribed yet. If values must","type":"text"},{"text":" ","type":"text"},{"text":"not be missed, subscribe before starting it: make the iterator now and hand it to the consumer as an","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncIteratorSequence","type":"reference"},{"text":" (","type":"text"},{"code":"AsyncIteratorSequence(subject.makeAsyncIterator())","type":"codeVoice"},{"text":"). Or wait until the consumer","type":"text"},{"text":" ","type":"text"},{"text":"has subscribed before sending, for example with ","type":"text"},{"code":"handleEvents(receiveMakeIterator:)","type":"codeVoice"},{"text":".","type":"text"}]}],"name":"Important","style":"important","type":"aside"},{"inlineContent":[{"text":"Cancelling a task waiting for the subject’s next value ends that consumer’s subscription; values sent afterwards","type":"text"},{"text":" ","type":"text"},{"text":"are not delivered to it. To read the subject again, make a new iterator.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Example","anchor":"Example","type":"heading"},{"syntax":"swift","code":["let subject = PassthroughSubject<Int>()","let subscribed = SingleValueSubject<Void>()","","subject.send(0) \/\/ No subscribers yet, so this value is discarded.","","Task {","    for try await value in subject.handleEvents(receiveMakeIterator: { try? subscribed.send() }) {","        print(\"Received value: \\(value)\") \/\/ prints 1, then 2","    }","}","","try await subscribed.execute()","subject.send(1)","subject.send(2)","subject.send(completion: .finished)"],"type":"codeListing"}]}],"sections":[],"references":{"doc://Afluent/documentation/Afluent/PassthroughSubject/Iterator":{"abstract":[],"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Iterator"}],"role":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/Iterator","url":"\/documentation\/afluent\/passthroughsubject\/iterator","title":"PassthroughSubject.Iterator","navigatorTitle":[{"kind":"identifier","text":"Iterator"}]},"doc://Afluent/documentation/Afluent/PassthroughSubject/send()":{"abstract":[{"text":"Sends a value to every current subscriber when the subject’s ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Void","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"This is useful for signaling purposes rather than data transmission.","type":"text"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/send()","type":"topic","kind":"symbol","role":"symbol","url":"\/documentation\/afluent\/passthroughsubject\/send()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"send"},{"kind":"text","text":"()"}],"title":"send()"},"doc://Afluent/documentation/Afluent/PassthroughSubject":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PassthroughSubject"}],"abstract":[{"type":"text","text":"A subject that broadcasts values to multiple consumers without storing a current value."},{"type":"text","text":" "},{"type":"text","text":"Unlike "},{"type":"codeVoice","code":"CurrentValueSubject"},{"type":"text","text":", "},{"type":"codeVoice","code":"PassthroughSubject"},{"type":"text","text":" does not retain the most recent value."},{"type":"text","text":" "},{"type":"text","text":"This is an "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s PassthroughSubject."}],"url":"\/documentation\/afluent\/passthroughsubject","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"PassthroughSubject"}],"title":"PassthroughSubject","role":"symbol","type":"topic"},"doc://Afluent/documentation/Afluent/PassthroughSubject/send(completion:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"send","kind":"identifier"},{"text":"(","kind":"text"},{"text":"completion","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7Afluent18PassthroughSubjectC","text":"PassthroughSubject","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"preciseIdentifier":"s:7Afluent18PassthroughSubjectC10CompletionO","text":"Completion","kind":"typeIdentifier"},{"text":"<any ","kind":"text"},{"preciseIdentifier":"s:s5ErrorP","text":"Error","kind":"typeIdentifier"},{"text":">)","kind":"text"}],"abstract":[{"type":"text","text":"Completes the subject, preventing any further values from being sent."},{"type":"text","text":" "},{"type":"text","text":"Current subscribers receive the completion after any values already buffered for them, and consumers that"},{"type":"text","text":" "},{"type":"text","text":"start iterating afterwards receive it immediately."}],"url":"\/documentation\/afluent\/passthroughsubject\/send(completion:)","kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/send(completion:)","title":"send(completion:)"},"doc://Afluent/documentation/Afluent/PassthroughSubject/Completion":{"identifier":"doc:\/\/Afluent