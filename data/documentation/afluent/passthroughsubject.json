{"sections":[],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject"},"topicSections":[{"title":"Structures","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/Iterator"],"anchor":"Structures"},{"title":"Initializers","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/init()"],"anchor":"Initializers"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/makeAsyncIterator()","doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/makeSubscription()","doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/send()","doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/send(_:)","doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/send(completion:)"],"anchor":"Instance-Methods"},{"title":"Enumerations","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/Completion"],"anchor":"Enumerations"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/AsyncSequence-Implementations","doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/AsyncSequence-Implementations"],"anchor":"Default-Implementations"}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"metadata":{"externalID":"s:7Afluent18PassthroughSubjectC","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PassthroughSubject"}],"navigatorTitle":[{"text":"PassthroughSubject","kind":"identifier"}],"modules":[{"name":"Afluent"}],"title":"PassthroughSubject","roleHeading":"Class","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/PassthroughSubject.swift#L45","fileName":"PassthroughSubject.swift"},"symbolKind":"class"},"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP","doc:\/\/Afluent\/Sci"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PassthroughSubject","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s8SendableP","text":"Sendable","kind":"typeIdentifier"}],"platforms":["Linux"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Subscribing","anchor":"Subscribing","type":"heading"},{"inlineContent":[{"type":"text","text":"A consumer subscribes when its iterator is created, which is when a "},{"code":"for try await","type":"codeVoice"},{"type":"text","text":" loop over the subject"},{"type":"text","text":" "},{"type":"text","text":"(or over an operator chain built on it) begins. From then on, every value sent is buffered for that consumer"},{"type":"text","text":" "},{"type":"text","text":"until it is consumed, so a consumer that is slower than the sender still sees every value, in order."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Values sent while there are no subscribers are discarded; they are never replayed to a later consumer."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"Starting a "},{"type":"codeVoice","code":"Task"},{"type":"text","text":" that iterates the subject does not mean it has subscribed yet. If values must"},{"type":"text","text":" "},{"type":"text","text":"not be missed, subscribe before starting it: make the iterator now and hand it to the consumer as an"},{"type":"text","text":" "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncIteratorSequence","type":"reference","isActive":true},{"type":"text","text":" ("},{"type":"codeVoice","code":"AsyncIteratorSequence(subject.makeAsyncIterator())"},{"type":"text","text":"). Or wait until the consumer"},{"type":"text","text":" "},{"type":"text","text":"has subscribed before sending, for example with "},{"type":"codeVoice","code":"handleEvents(receiveMakeIterator:)"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"Important","type":"aside","style":"important"},{"inlineContent":[{"text":"Cancelling a task waiting for the subject’s next value ends that consumer’s subscription; values sent afterwards","type":"text"},{"text":" ","type":"text"},{"text":"are not delivered to it. To read the subject again, make a new iterator.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Example","anchor":"Example","type":"heading"},{"code":["let subject = PassthroughSubject<Int>()","let subscribed = SingleValueSubject<Void>()","","subject.send(0) \/\/ No subscribers yet, so this value is discarded.","","Task {","    for try await value in subject.handleEvents(receiveMakeIterator: { try? subscribed.send() }) {","        print(\"Received value: \\(value)\") \/\/ prints 1, then 2","    }","}","","try await subscribed.execute()","subject.send(1)","subject.send(2)","subject.send(completion: .finished)"],"syntax":"swift","type":"codeListing"}]}],"variants":[{"paths":["\/documentation\/afluent\/passthroughsubject"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"A subject that broadcasts values to multiple consumers without storing a current value.","type":"text"},{"text":" ","type":"text"},{"text":"Unlike ","type":"text"},{"code":"CurrentValueSubject","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PassthroughSubject","type":"codeVoice"},{"type":"text","text":" does not retain the most recent value."},{"type":"text","text":" "},{"type":"text","text":"This is an "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s PassthroughSubject."}],"references":{"doc://Afluent/documentation/Afluent/PassthroughSubject/send(_:)":{"kind":"symbol","url":"\/documentation\/afluent\/passthroughsubject\/send(_:)","abstract":[{"text":"Sends a new value to every current subscriber. If there are no subscribers, the value is discarded.","type":"text"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/send(_:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"send","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":")","kind":"text"}],"title":"send(_:)","role":"symbol"},"doc://Afluent/Sci":{"identifier":"doc:\/\/Afluent\/Sci","title":"_Concurrency.AsyncSequence","type":"unresolvable"},"doc://Afluent/documentation/Afluent/PassthroughSubject/send(completion:)":{"abstract":[{"type":"text","text":"Completes the subject, preventing any further values from being sent."},{"type":"text","text":" "},{"type":"text","text":"Current subscribers receive the completion after any values already buffered for them, and consumers that"},{"type":"text","text":" "},{"type":"text","text":"start iterating afterwards receive it immediately."}],"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/send(completion:)","title":"send(completion:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"send","kind":"identifier"},{"text":"(","kind":"text"},{"text":"completion","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7Afluent18PassthroughSubjectC","text":"PassthroughSubject","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":">.","kind":"text"},{"preciseIdentifier":"s:7Afluent18PassthroughSubjectC10CompletionO","text":"Completion","kind":"typeIdentifier"},{"kind":"text","text":"<any "},{"kind":"typeIdentifier","text":"Error","preciseIdentifier":"s:s5ErrorP"},{"kind":"text","text":">)"}],"url":"\/documentation\/afluent\/passthroughsubject\/send(completion:)"},"doc://Afluent/documentation/Afluent/PassthroughSubject/send()":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/send()","kind":"symbol","url":"\/documentation\/afluent\/passthroughsubject\/send()","abstract":[{"text":"Sends a value to every current subscriber when the subject’s ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Void","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"This is useful for signaling purposes rather than data transmission.","type":"text"}],"type":"topic","title":"send()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"send","kind":"identifier"},{"text":"()","kind":"text"}]},"doc://Afluent/documentation/Afluent/PassthroughSubject":{"title":"PassthroughSubject","navigatorTitle":[{"kind":"identifier","text":"PassthroughSubject"}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PassthroughSubject"}],"kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","abstract":[{"type":"text","text":"A subject that broadcasts values to multiple consumers without storing a current value."},{"type":"text","text":" "},{"type":"text","text":"Unlike "},{"code":"CurrentValueSubject","type":"codeVoice"},{"type":"text","text":", "},{"code":"PassthroughSubject","type":"codeVoice"},{"type":"text","text":" does not retain the most recent value."},{"type":"text","text":" "},{"type":"text","text":"This is an "},{"code":"AsyncSequence","type":"codeVoice"},{"type":"text","text":" th