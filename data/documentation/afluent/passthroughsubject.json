.","","Task {","    for try await value in subject.handleEvents(receiveMakeIterator: { try? subscribed.send() }) {","        print(\"Received value: \\(value)\") \/\/ prints 1, then 2","    }","}","","try await subscribed.execute()","subject.send(1)","subject.send(2)","subject.send(completion: .finished)"],"type":"codeListing"}]}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP","doc:\/\/Afluent\/Sci"],"type":"conformsTo"}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"variants":[{"paths":["\/documentation\/afluent\/passthroughsubject"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PassthroughSubject"}],"remoteSource":{"fileName":"PassthroughSubject.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/PassthroughSubject.swift#L41"},"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PassthroughSubject"}],"title":"PassthroughSubject","symbolKind":"class","roleHeading":"Class","modules":[{"name":"Afluent"}],"externalID":"s:7Afluent18PassthroughSubjectC"},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject"},"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://Afluent/documentation/Afluent/PassthroughSubject/send()":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"send","kind":"identifier"},{"text":"()","kind":"text"}],"title":"send()","url":"\/documentation\/afluent\/passthroughsubject\/send()","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/send()","abstract":[{"text":"Sends a value to every current subscriber when the subject’s ","type":"text"},{"type":"codeVoice","code":"Element"},{"text":" is ","type":"text"},{