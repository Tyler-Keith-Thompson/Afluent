xt":"This method returns an ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":" which retries the upstream sequence on any failure, up to the specified number of retries.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Not all "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":"s can be retried. For example, "},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AsyncThrowingStream"},{"type":"text","text":" cannot be retried on their own."}]},{"text":"Example","type":"heading","anchor":"Example","level":2},{"code":["actor CallCounter {","    private(set) var count = 0","    func increment() -> Int {","        count += 1","        return count","    }","}","","struct ExampleError: Error {}","","let counter = CallCounter()","","let sequence = DeferredTask {","    let attempt = await counter.increment()","    if attempt < 2 {","        throw ExampleError()","    }","    return 100","}",".toAsyncSequence()",".retry(3)","","for try await value in sequence {","    print(value) \/\/ prints 100 after retries","}"],"type":"codeListing","syntax":"swift"},{"style":"important","type":"aside","name":"Important","content":[{"inlineContent":[{"text":"Not every ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":" can be retried, for this to work the sequence has to implement an iterator that doesn’t preserve state across various creations.","type":"text"}],"type":"paragraph"}]},{"style":"note","type":"aside","name":"Note","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"AsyncStream","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"AsyncThrowingStream","type":"codeVoice"},{"text":" are notable sequences which cannot be retried on their own.","type":"text"}],"type":"paragraph"}]}]}],"abstract":[{"type":"text","text":"Retries the upstream "},{"code":"AsyncSequence","type":"codeVoice"},{"type":"text","text":" up to a specified n