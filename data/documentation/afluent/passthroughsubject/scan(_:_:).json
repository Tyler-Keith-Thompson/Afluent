not retain the most recent value."},{"type":"text","text":" "},{"type":"text","text":"This is an "},{"code":"AsyncSequence","type":"codeVoice"},{"type":"text","text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s PassthroughSubject."}],"navigatorTitle":[{"text":"PassthroughSubject","kind":"identifier"}],"url":"\/documentation\/afluent\/passthroughsubject","title":"PassthroughSubject","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PassthroughSubject","kind":"identifier"}]},"doc://Afluent/documentation/Afluent/AsyncSequences/Scan":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Scan","abstract":[],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Scan"}],"role":"symbol","url":"\/documentation\/afluent\/asyncsequences\/scan","title":"AsyncSequences.Scan","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Scan"}]}}}