,"    }","    \/\/ prints the values the shared sequence reads after this consumer subscribed","}","","async let secondConsumer = Task {","    for await value in sharedSequence {","        print(\"Second consumer received \\(value)\")","    }","    \/\/ prints the values the shared sequence reads after this consumer subscribed","}","","\/\/ A consumer that subscribes after the shared sequence has handed out values misses them.","await firstConsumer.value","await secondConsumer.value"],"type":"codeListing"}]}],"abstract":[{"type":"text","text":"Returns a sequence that multicasts elements to multiple concurrent consumers."}],"references":{"doc://Afluent/documentation/Afluent/PassthroughSubject/share()":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/share()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"share","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"AsyncBroadcastSequence","preciseIdentifier":"s:7Afluent22AsyncBroadcastSequenceV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":">","kind":"text"}],"url":"\/documentation\/afluent\/passthroughsubject\/share()","title":"share()","abstract":[{"type":"text","text":"Returns a sequence that multicasts elements to multiple concurrent consumers."}],"type":"topic","kind":"symbol","role":"symbol","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Self"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"Element"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":".","type":"text"}]}},"doc://Afluent/documentation/Afluent/PassthroughSubject":{"url":"\/documentation\/afluent\/passthroughsubject","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PassthroughSubject"}],"abstract":[{"type":"text","text":"A subject that broadcasts values to multiple consumers without storing a current value."},{"type":"text","text":" "},{"type":"text","text":"Unlike "},{"code":"CurrentValueSubject","type":"codeVoice"},{"type":"text","text":", "},{"code":"PassthroughSubject","type":"codeVoice"},{"type":"text","text":" does not retain the most recent value."},{"type":"text","text":" "},{"type":"text","text":"This is an "},{"code":"AsyncSequence","type":"codeVoice"},{"type":"text","text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s PassthroughSubject."}],"title":"PassthroughSubject","navigatorTitle":[{"kind":"identifier","text":"PassthroughSubject"}],"role":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject"},"doc://Afluent/documentation/Afluent":{"kind":"symbol","url":"\/documentation\/afluent","type":"topic","abstract":[],"title":"Afluent","role":"collection","identifier":"doc:\/\/Afluent\/documentation\/Afluent"},"doc://Afluent/documentation/Afluent/AsyncBroadcastSequence":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncBroadcastSequence","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AsyncBroadcastSequence","kind":"identifier"}],"url":"\/documentation\/afluent\/asyncbroadcastsequence","title":"AsyncBroadcastSequence","abstract":[{"text":"An async sequence that multicasts elements from an upstream sequence to multiple concurrent consumers.","type":"text"}],"type":"topic","kind":"symbol","navigatorTitle":[{"text":"AsyncBroadcastSequence","kind":"identifier"}],"role":"symbol"}}}