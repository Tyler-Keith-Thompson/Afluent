BroadcastSequence","abstract":[{"type":"text","text":"An async sequence that multicasts elements from an upstream sequence to multiple concurrent consumers."}],"type":"topic","url":"\/documentation\/afluent\/asyncbroadcastsequence"},"doc://Afluent/documentation/Afluent":{"url":"\/documentation\/afluent","title":"Afluent","abstract":[],"identifier":"doc:\/\/Afluent\/documentation\/Afluent","type":"topic","role":"collection","kind":"symbol"},"doc://Afluent/documentation/Afluent/PassthroughSubject":{"title":"PassthroughSubject","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PassthroughSubject","kind":"identifier"}],"type":"topic","role":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","navigatorTitle":[{"text":"PassthroughSubject","kind":"identifier"}],"abstract":[{"text":"A subject that broadcasts values to multiple consumers without storing a current value.","type":"text"},{"text":" ","type":"text"},{"text":"Unlike ","type":"text"},{"type":"codeVoice","code":"CurrentValueSubject"},{"text":", ","type":"text"},{"type":"codeVoice","code":"PassthroughSubject"},{"text":" does not retain the most recent value.","type":"text"},{"text":" ","type":"text"},{"text":"This is an ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s PassthroughSubject.","type":"text"}],"url":"\/documentation\/afluent\/passthroughsubject"}}}