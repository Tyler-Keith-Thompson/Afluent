er":"s:s4Voida"},{"kind":"text","text":")?) -> "},{"kind":"typeIdentifier","text":"AnyCancellable","preciseIdentifier":"s:7Afluent14AnyCancellableC"}],"symbolKind":"method","modules":[{"relatedModules":["_Concurrency"],"name":"Afluent"}],"roleHeading":"Instance Method","extendedModule":"_Concurrency"},"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject\/sink(receiveCompletion:receiveOutput:)","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/passthroughsubject\/sink(receivecompletion:receiveoutput:)"]}],"sections":[],"abstract":[{"type":"text","text":"Starts processing the elements of this async sequence, handling output and completion events,"},{"type":"text","text":" "},{"type":"text","text":"and returns an "},{"type":"codeVoice","code":"AnyCancellable"},{"type":"text","text":" token that can be used to cancel the subscription."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sink"},{"kind":"text","text":"("},{"kind":"externalParam","text":"receiveCompletion"},{"kind":"text","text":": ("},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" ("},{"kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO","text":"AsyncSequences","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO10CompletionO","text":"Completion","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Completion"},{"kind":"text","text":"<any "},{"kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP","text":"Error"},{"kind":"text","text":">