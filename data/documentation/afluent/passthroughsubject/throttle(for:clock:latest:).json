intervals and perform sleeps."}]}]},{"name":"latest","content":[{"inlineContent":[{"type":"text","text":"A Boolean flag determining which element to emit during each interval:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"false"},{"text":" emits the first element seen in the interval.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"true","type":"codeVoice"},{"type":"text","text":" emits the latest element seen during the interval."}]}]}],"type":"unorderedList"}]}]},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"inlineContent":[{"text":"An async sequence that emits throttled elements from the upstream sequence.","type":"text"}],"type":"paragraph"}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"This operator suppresses elements from the upstream async sequence during each interval, emitting only one element per interval:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"latest"},{"type":"text","text":" is "},{"type":"codeVoice","code":"false"},{"type":"text","text":", it emits the first element received immediately and then ignores subsequent elements until the interval completes."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If ","type":"text"},{"code":"latest","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", it emits the first element immediately, then during the interval it tracks element updates, emitting only the most recent one at the interval’s end.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Elements arriving during an interval beyond the emitted one are suppressed, allowing controlled pacing of element emission.","type":"text"}]},{"text":"Example","type":"heading","anchor":"Example","level":2},{"type":"paragraph","inlineContent":[{"text":"The following example creates an ","type":"text"},{"code":"AsyncStream","type":"codeVoice"},{"text":" that emits the current date every second,","type":"text"},{"text":" ","type":"text"},{"text":"then applies a throttle with a 3-second interval, showing both ","type":"text"},{"code":"latest: false","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"latest: true","type":"codeVoice"},{"text":".","type":"text"}]},{"code":["import Foundation","import _Concurrency","","let stream = AsyncStream<Date> { continuation in","    Task {","        while true {","            continuation.yield(Date())","            try await Task.sleep(nanoseconds: 1_000_000_000) \/\/ 1 second","        }","    }","}","","\/\/ Throttle with latest: false (emit the first element immediately, then suppress others during the interval)","Task {","    print(\"Throttle with latest: false\")","    for await date in stream.throttle(for: .seconds(3), clock: ContinuousClock(), latest: false) {","        print(\"Emitted (first): \\(date)\")","    }","}","","\/\/ Throttle with latest: true (emit the first element immediately, then emit the latest element at interval end)","Task {","    print(\"Throttle with latest: true\")","    for await date in stream.throttle(for: .seconds(3), clock: ContinuousClock(), latest: true) {","        print(\"Emitted (latest): \\(date)\")","    }","}","","\/*","Sample output for latest: false:","Throttle with latest: false","Emitted (first): 2025-07-04 12:00:00 +0000","Emitted (first): 2025-07-04 12:00:03 +0000","Emitted (first): 2025-07-04 12:00:06 +0000","","Sample output for latest: true:","Throttle with latest: true","Emitted (latest): 2025-07-04 12:00:00 +0000","Emitted (latest): 2025-07-04 12:00:02 +0000","Emitted (latest): 2025-07-04 12:00:05 +0000","*\/"],"type":"codeListing","syntax":"swift"}]}],"identifier":{"url":"doc:\/\/Afluent\/docume