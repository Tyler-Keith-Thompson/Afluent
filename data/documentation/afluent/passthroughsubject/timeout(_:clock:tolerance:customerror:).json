eVoice","code":"PassthroughSubject"},{"type":"text","text":" does not retain the most recent value."},{"type":"text","text":" "},{"type":"text","text":"This is an "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s PassthroughSubject."}],"kind":"symbol","url":"\/documentation\/afluent\/passthroughsubject","role":"symbol"},"doc://Afluent/documentation/Afluent/AsyncSequences/Timeout":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Timeout","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"Timeout","kind":"identifier"}],"url":"\/documentation\/afluent\/asyncsequences\/timeout","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Timeout","kind":"symbol","title":"AsyncSequences.Timeout","abstract":[{"type":"text","text":"Used as the implementation detail for the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/timeout(_:clock:tolerance:customError:)"},{"type":"text","text":" operator."}],"role":"symbol"},"doc://Afluent/documentation/Afluent":{"title":"Afluent","type":"topic","abstract":[],"identifier":"doc:\/\/Afluent\/documentation\/Afluent","role":"collection","kind":"symbol","url":"\/documentation\/afluent"},"doc://Afluent/documentation/Afluent/PassthroughSubject/timeout(_:clock:tolerance:customError:)":{"url":"\/documentation\/afluent\/passthroughsubject\/timeout(_:clock:tolerance:customerror:)","title":"timeout(_:clock:tolerance:customError:)","abstract":[{"text":"Fails if the sequence goes the given duration without producing an element, measured on","type":"text"},{"text":" ","type":"text"},{"text":"the given clock.","type":"text"}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"timeout"},{"kind":"text","text":"<"},{"kind":"genericParameter