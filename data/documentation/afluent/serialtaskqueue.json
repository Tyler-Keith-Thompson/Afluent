nchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"This class manages a queue of asynchronous tasks, executing each task sequentially to prevent concurrent execution.","type":"text"},{"text":" ","type":"text"},{"text":"It is useful when tasks must run in order or when you want to avoid race conditions by ensuring only one task runs at any given time.","type":"text"}]},{"text":"Example","type":"heading","level":2,"anchor":"Example"},{"code":["let queue = SerialTaskQueue()","","async let first = queue.enqueue {","    try await Task.sleep(nanoseconds: 2_000_000_000)","    return \"first\"","}","async let second = queue.enqueue {","    try await Task.sleep(nanoseconds: 1_000_000_000)","    return \"second\"","}","","\/\/ The results are delivered in order: [\"first\", \"second\"], even though the second task sleeps less","let results = try await [first, second]","print(results)","","\/\/ To cancel all tasks:","queue.cancelAll()"],"type":"codeListing","syntax":"swift"}]}],"abstract":[{"type":"text","text":"A serial task queue that ensures tasks are executed one at a time."}],"references":{"doc://Afluent/documentation/Afluent/SerialTaskQueue/cancelAll()":{"kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SerialTaskQueue\/cancelAll()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancelAll","kind":"identifier"},{"text":"()","kind":"text"}],"url":"\/documentation\/afluent\/serialtaskqueue\/cancelall()","type":"topic","title":"cancelAll()","abstract":[{"type":"text","text":"Cancels the running task and every queued task that hasn’t started; those throw "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" to their"},{"type":"text","text":" "},{"type":"text","text":"awaiters, as does any task queued afterwards."}]},"doc://Afluent/s16SendableMetatypeP":{"identifier":"doc:\/\/Afluent\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://Afl