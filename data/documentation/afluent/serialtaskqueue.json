{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SerialTaskQueue"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This class manages a queue of asynchronous tasks, executing each task sequentially to prevent concurrent execution."},{"type":"text","text":" "},{"type":"text","text":"It is useful when tasks must run in order or when you want to avoid race conditions by ensuring only one task runs at any given time."}]},{"type":"heading","level":2,"text":"Example","anchor":"Example"},{"type":"codeListing","syntax":"swift","code":["let queue = SerialTaskQueue()","","async let first = queue.enqueue {","    try await Task.sleep(nanoseconds: 2_000_000_000)","    return \"first\"","}","async let second = queue.enqueue {","    try await Task.sleep(nanoseconds: 1_000_000_000)","    return \"second\"","}","","\/\/ The results are delivered in order: [\"first\", \"second\"], even though the second task sleeps less","let results = try await [first, second]","print(results)","","\/\/ To cancel all tasks:","queue.cancelAll()"]}],"kind":"content"}],"metadata":{"role":"symbol","symbolKind":"class","externalID":"s:7Afluent15SerialTaskQueueC","title":"SerialTaskQueue","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SerialTaskQueue","kind":"identifier"}],"modules":[{"name":"Afluent"}],"roleHeading":"Class","navigatorTitle":[{"kind":"identifier","text":"SerialTaskQueue"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SerialTaskQueue.swift#L35","fileName":"SerialTaskQueue.swift"}},"relationshipsSections":[{"identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMe