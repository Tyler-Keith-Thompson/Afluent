{"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Linux"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SerialTaskQueue"}]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"This class manages a queue of asynchronous tasks, executing each task sequentially to prevent concurrent execution.","type":"text"},{"text":" ","type":"text"},{"text":"It is useful when tasks must run in order or when you want to avoid race conditions by ensuring only one task runs at any given time.","type":"text"}]},{"text":"Example","type":"heading","anchor":"Example","level":2},{"code":["let queue = SerialTaskQueue()","","async let first = queue.enqueue {","    try await Task.sleep(nanoseconds: 2_000_000_000)","    return \"first\"","}","async let second = queue.enqueue {","    try await Task.sleep(nanoseconds: 1_000_000_000)","    return \"second\"","}","","\/\/ The results are delivered in order: [\"first\", \"second\"], even though the second task sleeps less","let results = try await [first, second]","print(results)","","\/\/ To cancel all tasks:","queue.cancelAll()"],"type":"codeListing","syntax":"swift"}]}],"sections":[],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP"],"type":"conformsTo"}],"variants":[{"paths":["\/documentation\/afluent\/serialtaskqueue"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"metadata":{"modules":[{"name":"Afluent"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SerialTaskQueue","kind":"identifier"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\