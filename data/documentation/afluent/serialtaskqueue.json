,"type":"heading"},{"inlineContent":[{"type":"text","text":"This class manages a queue of asynchronous tasks, executing each task sequentially to prevent concurrent execution."},{"type":"text","text":" "},{"type":"text","text":"It is useful when tasks must run in order or when you want to avoid race conditions by ensuring only one task runs at any given time."}],"type":"paragraph"},{"text":"Example","level":2,"anchor":"Example","type":"heading"},{"code":["let queue = SerialTaskQueue()","","async let first = queue.enqueue {","    try await Task.sleep(nanoseconds: 2_000_000_000)","    return \"first\"","}","async let second = queue.enqueue {","    try await Task.sleep(nanoseconds: 1_000_000_000)","    return \"second\"","}","","\/\/ The results are delivered in order: [\"first\", \"second\"], even though the second task sleeps less","let results = try await [first, second]","print(results)","","\/\/ To cancel all tasks:","queue.cancelAll()"],"syntax":"swift","type":"codeListing"}]}],"abstract":[{"text":"A serial task queue that ensures tasks are executed one at a time.","type":"text"}],"references":{"doc://Afluent/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/Afluent\/s16SendableMetatypeP"},"doc://Afluent/documentation/Afluent/SerialTaskQueue/cancelAll()":{"url":"\/documentation\/afluent\/serialtaskqueue\/cancelall()","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SerialTaskQueue\/cancelAll()","type":"topic","abstract":[{"type":"text","text":"Cancels the running task and every queued task that hasn’t started; those throw "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" to their"},{"type":"text","text":" "},{"type":"text","text":"awaiters, as does any task queued afterwards."}],"kind":"symbol","title":"cancelAll()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancelAll"},{"kind":"text","text":"()"}],"role":"symbol"},"doc://Afl