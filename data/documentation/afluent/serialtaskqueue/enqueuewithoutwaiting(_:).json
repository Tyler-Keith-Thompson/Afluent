","text":"Discussion"},{"inlineContent":[{"type":"text","text":"If no task is currently running, the provided task is executed immediately."},{"type":"text","text":" "},{"type":"text","text":"If a task is running, the provided task is added to the queue and will be executed once the current task completes."},{"type":"text","text":" "},{"type":"text","text":"This method returns immediately without waiting for the task to complete."},{"type":"text","text":" "},{"type":"text","text":"Any errors thrown by the task are silently ignored, and a task queued after "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SerialTaskQueue\/cancelAll()","isActive":true},{"type":"text","text":" doesn’t run."}],"type":"paragraph"},{"inlineContent":[{"text":"Use this spelling from synchronous and asynchronous code alike; to wait for the result, use","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SerialTaskQueue\/enqueue(_:)-2sey2","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Example","text":"Example"},{"syntax":"swift","type":"codeListing","code":["actor Log {","    let queue = SerialTaskQueue()","    func record(_ line: String) {","        queue.enqueueWithoutWaiting { await writeToDisk(line) }","    }","}"]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/SerialTaskQueue\/enqueueWithoutWaiting(_:)"},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/serialtaskqueue\/enqueuewithoutwaiting(_:)"]}],"abstract":[{"type":"text","text":"Queues a task to be executed serially without waiting for completion (fire-and-forget)."}],"references":{"doc://Afluent/documentation/Afluent/SerialTaskQueue/enqueueWithoutWaiting(_:)":{"kind":"symbol","title":"enqueueWithoutWaiting(_:)","fragments":[{"kind":"key