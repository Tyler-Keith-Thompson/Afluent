ows ends the batched sequence with"},{"type":"text","text":" "},{"type":"text","text":"its error, except "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" while the batched sequence is still running (a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SingleValueSubject","isActive":true},{"type":"text","text":" someone else cancelled): then the signal stops firing and the batches go"},{"type":"text","text":" "},{"type":"text","text":"on."}],"type":"paragraph"},{"level":2,"text":"Example","anchor":"Example","type":"heading"},{"code":["let flush = PassthroughSubject<Void>()","for try await lines in logLines.batch(strategy: .signal(flush)) {","    write(lines)","}","\/\/ Elsewhere, when the app moves to the background:","flush.send()"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"topicSections":[{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy\/init(_:)"],"anchor":"Initializers","title":"Initializers","generated":true},{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy\/signal"],"anchor":"Instance-Properties","title":"Instance Properties","generated":true},{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy\/run(_:)"],"anchor":"Instance-Methods","title":"Instance Methods","generated":true},{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy\/BatchStrategy-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations","generated":true}],"sections":[],"references":{"doc://Afluent/documentation/Afluent/SignalBatchStrategy/run(_:)":{"kind":"symbol","abstract":[{"type":"text","text":"Flushes on the strategy’s own events, for as long as the batched sequence is iterated."}],"title":"run(_:)","role":"symbol","type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy\/run(_:)","fragments":[{"kind":"keyword","text":"func"},{"k