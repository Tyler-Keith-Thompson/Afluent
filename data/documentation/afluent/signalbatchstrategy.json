":"heading","text":"Example"},{"type":"codeListing","syntax":"swift","code":["let flush = PassthroughSubject<Void>()","for try await lines in logLines.batch(strategy: .signal(flush)) {","    write(lines)","}","\/\/ Elsewhere, when the app moves to the background:","flush.send()"]}]}],"variants":[{"paths":["\/documentation\/afluent\/signalbatchstrategy"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"sections":[],"kind":"symbol","topicSections":[{"anchor":"Initializers","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy\/init(_:)"],"generated":true,"title":"Initializers"},{"anchor":"Instance-Properties","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy\/signal"],"generated":true,"title":"Instance Properties"},{"anchor":"Instance-Methods","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy\/run(_:)"],"generated":true,"title":"Instance Methods"},{"anchor":"Default-Implementations","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy\/BatchStrategy-Implementations"],"generated":true,"title":"Default Implementations"}],"abstract":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","isActive":true},{"type":"text","text":" that flushes each time a sequence produces an element."}],"references":{"doc://Afluent/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/Afluent\/s8SendableP"},"doc://Afluent/documentation/Afluent/SignalBatchStrategy/run(_:)":{"kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy\/run(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"run","kind":"identif