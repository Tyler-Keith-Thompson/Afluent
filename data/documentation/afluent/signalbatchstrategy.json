{"abstract":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy"},{"type":"text","text":" that flushes each time a sequence produces an element."}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo","title":"Conforms To"}],"variants":[{"paths":["\/documentation\/afluent\/signalbatchstrategy"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"metadata":{"roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SignalBatchStrategy"}],"modules":[{"name":"Afluent"}],"remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SequenceOperators\/SignalBatchStrategy.swift#L30","fileName":"SignalBatchStrategy.swift"},"role":"symbol","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"SignalBatchStrategy"}],"externalID":"s:7Afluent19SignalBatchStrategyV","title":"SignalBatchStrategy","platforms":[{"name":"iOS","unavailable":false,"deprecated":false,"introducedAt":"16.0","beta":false},{"name":"iPadOS","unavailable":false,"deprecated":false,"introducedAt":"16.0","beta":false},{"name":"Mac Catalyst","unavailable":false,"deprecated":false,"introducedAt":"16.0","beta":false},{"name":"macOS","unavailable":false,"deprecated":false,"introducedAt":"13.0","beta":false},{"name":"tvOS","unavailable":false,"deprecated":false,"introducedAt":"16.0","beta":false},{"name":"visionOS","unavailable":false,"deprecated":false,"introducedAt":"1.0","beta":false},{"name":"watchOS","unavailable":false,"deprecated":false,"introducedAt":"9.0","beta":false}]},"identifier":{"url":"doc:\/\/Afluent\/documentati