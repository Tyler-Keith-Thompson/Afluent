ocumentation\/Afluent\/SignalBatchStrategy","text":"SignalBatchStrategy","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent19SignalBatchStrategyV"},{"text":"<","kind":"text"},{"text":"Batched","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","text":"AsyncSequences","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO"},{"text":".","kind":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Deferred","text":"Deferred","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent14AsyncSequencesO8DeferredV"},{"text":"<","kind":"text"},{"text":"AsyncThrowingStream","kind":"typeIdentifier","preciseIdentifier":"s:Scs"},{"text":"<","kind":"text"},{"text":"Unit","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork\/Success","text":"Success","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP7SuccessQa"},{"text":", any ","kind":"text"},{"text":"Error","kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP"},{"text":">>>, ","kind":"text"},{"text":"Unit","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork","text":"AsynchronousUnitOfWork","kind":"typeIdentifier","preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The unit of work whose completion flushes the batch."}],"type":"paragraph"}],"name":"unit"}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"return-value","text":"Return Value"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","isActive":true},{"type":"text","text":" over a stream of the unit’s one value, made afresh"},{"type":"text","text":" "},{"type":"text","text":"for each iteration."}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The unit’s work runs in the signal’s task each time iteration begins; a unit that fails"},{"type":"text","text":" "},{"type":"text","text":"ends the batched sequence with its error. When the batched sequence ends first, the unit’s"},{"type":"text","text":" "},{"type":"text","text":"work is cancelled; a unit whose work ignores cancellation keeps the batch’s internal task"},{"type":"text","text":" "},{"type":"text","text":"alive until it returns, though the batched sequence itself ends at once. A"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SingleValueSubject","isActive":true},{"type":"text","text":" takes "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy\/signal(_:)-7c9kk","isActive":true},{"type":"text","text":" instead, which"},{"type":"text","text":" "},{"type":"text","text":"leaves the subject alone. Each batched sequence iterated with this strategy runs the unit"},{"type":"text","text":" "},{"type":"text","text":"anew and fires once when it completes."}]},{"level":2,"type":"heading","text":"Example","anchor":"Example"},{"code":["let reachable = DeferredTask { try await server.waitUntilReachable() }","for try await requests in outbox.batch(strategy: .either(.count(20), .signal(reachable))) {","    try await send(requests)","}"],"syntax":"swift","type":"codeListing"}]}],"abstract":[{"type":"text","text":"Flushes once, when the given unit of work completes."}],"sections":[],"kind":"symbol","identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy\/signal(_:)-6il3i","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/signalbatchstrateg