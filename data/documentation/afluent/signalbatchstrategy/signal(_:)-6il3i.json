"kind":"keyword"},{"text":" ","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":" == ","kind":"text"},{"text":"SignalBatchStrategy","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","preciseIdentifier":"s:7Afluent19SignalBatchStrategyV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Batched","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"AsyncSequences","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","preciseIdentifier":"s:7Afluent14AsyncSequencesO","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Deferred","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Deferred","preciseIdentifier":"s:7Afluent14AsyncSequencesO8DeferredV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"AsyncThrowingStream","preciseIdentifier":"s:Scs","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Unit","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Success","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork\/Success","preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP7SuccessQa","kind":"typeIdentifier"},{"text":", any ","kind":"text"},{"text":"Error","preciseIdentifier":"s:s5ErrorP","kind":"typeIdentifier"},{"text":">>>, ","kind":"text"},{"text":"Unit","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"AsynchronousUnitOfWork","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork","preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP","kind":"typeIdentifier"}],"platforms":["Linux"]}]},{"kind":"parameters","parameters":[{"name":"unit","content":[{"inlineContent":[{"text":"The unit of work whose completion flushes the batch.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy"},{"type":"text","text":" over a stream of the unit’s one value, made afresh"},{"type":"text","text":" "},{"type":"text","text":"for each iteration."}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The unit’s work runs in the signal’s task each time iteration begins; a unit that fails"},{"type":"text","text":" "},{"type":"text","text":"ends the batched sequence with its error. When the batched sequence ends first, the unit’s"},{"type":"text","text":" "},{"type":"text","text":"work is cancelled; a unit whose work ignores cancellation keeps the batch’s internal task"},{"type":"text","text":" "},{"type":"text","text":"alive until it returns, though the batched sequence itself ends at once. A"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SingleValueSubject"},{"type":"text","text":" takes "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy\/signal(_:)-7c9kk"},{"type":"text","text":" instead, which"},{"type":"text","text":" "},{"type":"text","text":"leaves the subject alone. Each batched sequence iterated with this strategy runs the unit"},{"type":"text","text":" "},{"type":"text","text":"anew and fires once when it completes."}]},{"anchor":"Example","text":"Example","type":"heading","level":2},{"syntax":"swift","type":"codeListing","code":["let reachable = DeferredTask { try await server.waitUntilReachable() }","for try await requests in outbox.batch(strategy: .either(.count(20), .signal(reachable))) {","    try await send(requests)","}"]}]}],"abstract":[{"type":"text","text":"Flushes once, when the given unit of work completes."}],"sections":[],"metadata":{"role":"symbol","title":"signal(_:)","platforms":[{"name":"iOS","introducedAt":"16.0","depreca