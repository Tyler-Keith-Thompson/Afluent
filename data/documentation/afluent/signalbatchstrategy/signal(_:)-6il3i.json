],"kind":"declarations"},{"parameters":[{"name":"unit","content":[{"type":"paragraph","inlineContent":[{"text":"The unit of work whose completion flushes the batch.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"anchor":"return-value","text":"Return Value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","isActive":true},{"type":"text","text":" over a stream of the unit’s one value, made afresh"},{"type":"text","text":" "},{"type":"text","text":"for each iteration."}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The unit’s work runs in the signal’s task each time iteration begins; a unit that fails"},{"type":"text","text":" "},{"type":"text","text":"ends the batched sequence with its error. When the batched sequence ends first, the unit’s"},{"type":"text","text":" "},{"type":"text","text":"work is cancelled; a unit whose work ignores cancellation keeps the batch’s internal task"},{"type":"text","text":" "},{"type":"text","text":"alive until it returns, though the batched sequence itself ends at once. A"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SingleValueSubject"},{"type":"text","text":" takes "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy\/signal(_:)-7c9kk"},{"type":"text","text":" instead, which"},{"type":"text","text":" "},{"type":"text","text":"leaves the subject alone. Each batched sequence iterated with this strategy runs the unit"},{"type":"text","text":" "},{"type":"text","text":"anew and fires once when it completes."}]},{"anchor":"Example","type":"heading","level":2,"text":"Example"},{"type":"codeListing","syntax":"swift","code":["let reachable = DeferredTask { try await server.waitUntilReachable() }","for try await requests in outbox.batch(strategy: .either(.count(20), .signal(reachable))) {","    try await send(requests)","}"]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Flushes once, when the given unit of work completes."}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy"]]},"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy\/signal(_:)-6il3i","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/afluent\/signalbatchstrategy\/signal(_:)-6il3i"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://Afluent/documentation/Afluent/AsynchronousUnitOfWork":{"navigatorTitle":[{"kind":"identifier","text":"AsynchronousUnitOfWork"}],"kind":"symbol","url":"\/documentation\/afluent\/asynchronousunitofwork","title":"AsynchronousUnitOfWork","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsynchronousUnitOfWork","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsynchronousUnitOfWork"}],"type":"topic","abstract":[{"type":"text","text":"Represents an asynchronous unit of work."}]},"doc://Afluent/documentation/Afluent/SignalBatchStrategy/signal(_:)-7c9kk":{"abstract":[{"type":"text","text":"Flushes once, when the given subject is sent a value."}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy\/signal(_:)-7c9kk","type":"topic","url":"\/documentation\/afluent\/signalbatchstrategy\/signal(_:)-7c9kk","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"signal","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Batched","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Success","kind":"genericParameter"},{"text":