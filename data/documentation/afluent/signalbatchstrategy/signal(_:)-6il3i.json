value, made afresh"},{"type":"text","text":" "},{"type":"text","text":"for each iteration."}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The unit’s work runs in the signal’s task each time iteration begins; a unit that fails"},{"type":"text","text":" "},{"type":"text","text":"ends the batched sequence with its error. When the batched sequence ends first, the unit’s"},{"type":"text","text":" "},{"type":"text","text":"work is cancelled; a unit whose work ignores cancellation keeps the batch’s internal task"},{"type":"text","text":" "},{"type":"text","text":"alive until it returns, though the batched sequence itself ends at once. A"},{"type":"text","text":" "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SingleValueSubject","type":"reference","isActive":true},{"type":"text","text":" takes "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy\/signal(_:)-7c9kk","type":"reference","isActive":true},{"type":"text","text":" instead, which"},{"type":"text","text":" "},{"type":"text","text":"leaves the subject alone. Each batched sequence iterated with this strategy runs the unit"},{"type":"text","text":" "},{"type":"text","text":"anew and fires once when it completes."}]},{"level":2,"type":"heading","text":"Example","anchor":"Example"},{"code":["let reachable = DeferredTask { try await server.waitUntilReachable() }","for try await requests in outbox.batch(strategy: .either(.count(20), .signal(reachable))) {","    try await send(requests)","}"],"type":"codeListing","syntax":"swift"}]}],"variants":[{"paths":["\/documentation\/afluent\/signalbatchstrategy\/signal(_:)-6il3i"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/Afl