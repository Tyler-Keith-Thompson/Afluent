ent":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The subject whose value flushes the batch."}]}],"name":"subject"}],"kind":"parameters"},{"content":[{"anchor":"return-value","text":"Return Value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy"},{"type":"text","text":" over a stream of the subject’s one value, made afresh"},{"type":"text","text":" "},{"type":"text","text":"for each iteration."}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The batched sequence listens to the subject without owning it: when the batched sequence","type":"text"},{"text":" ","type":"text"},{"text":"ends or is cancelled, its wait ends at once and the subject stays pending for its other","type":"text"},{"text":" ","type":"text"},{"text":"awaiters. A subject sent an error ends the batched sequence with that error, except","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"CancellationError"},{"text":" (as when another awaiter cancels the subject): then the signal stops","type":"text"},{"text":" ","type":"text"},{"text":"firing and the batches go on. A subject sent a value before iteration begins fires when the","type":"text"},{"text":" ","type":"text"},{"text":"signal’s task starts, which may come after elements have arrived, so the first batch may be","type":"text"},{"text":" ","type":"text"},{"text":"short. Each batched sequence iterated with this strategy listens anew, so a subject","type":"text"},{"text":" ","type":"text"},{"text":"already sent a value fires again when a later batched sequence’s signal task starts.","type":"text"}]},{"anchor":"Example","type":"heading","level":2,"text":"Example"},{"code":["let shutdown = SingleValueSubject<Void>()","for try await messages in inbox.batch(strategy: .either(.count(50), .signal(shutdown))) {","    store(messages)","}","\/\/ Elsewhere: flush whatever is pending before shutting down.","try shutdown.send()"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/signalbatchstrategy\/signal(_:)-7c9kk"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy\/signal(_:)-7c9kk"},"references":{"doc://Afluent/documentation/Afluent":{"title":"Afluent","kind":"symbol","type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent","url":"\/documentation\/afluent","role":"collection","abstract":[]},"doc://Afluent/documentation/Afluent/BatchStrategy":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"BatchStrategy"}],"abstract":[{"type":"text","text":"When "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/batch(strategy:)","isActive":true},{"type":"text","text":" emits the elements it has gathered."}],"url":"\/documentation\/afluent\/batchstrategy","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"BatchStrategy"}],"title":"BatchStrategy","role":"symbol","type":"topic"},"doc://Afluent/documentation/Afluent/SignalBatchStrategy/signal(_:)-7c9kk":{"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"signal"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Batched"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"Success"},{"kind":"text","text":">("},{"preciseIdentifier":"s:7Afluent18SingleValueSubjectC","kind":"typeIdentifier","text":"SingleValueSubject"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Success"},{"kind":"text","tex