"text":"already sent a value fires again when a later batched sequence’s signal task starts."}]},{"type":"heading","text":"Example","level":2,"anchor":"Example"},{"type":"codeListing","code":["let shutdown = SingleValueSubject<Void>()","for try await messages in inbox.batch(strategy: .either(.count(50), .signal(shutdown))) {","    store(messages)","}","\/\/ Elsewhere: flush whatever is pending before shutting down.","try shutdown.send()"],"syntax":"swift"}],"kind":"content"}],"references":{"doc://Afluent/documentation/Afluent":{"title":"Afluent","type":"topic","abstract":[],"identifier":"doc:\/\/Afluent\/documentation\/Afluent","role":"collection","kind":"symbol","url":"\/documentation\/afluent"},"doc://Afluent/documentation/Afluent/SingleValueSubject":{"kind":"symbol","abstract":[{"type":"text","text":"A subject for bridging callback-based APIs to async\/await, emitting a single value or error."}],"title":"SingleValueSubject","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SingleValueSubject","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SingleValueSubject","kind":"identifier"}],"type":"topic","url":"\/documentation\/afluent\/singlevaluesubject","role":"symbol","navigatorTitle":[{"text":"SingleValueSubject","kind":"identifier"}]},"doc://Afluent/documentation/Afluent/SignalBatchStrategy":{"abstract":[{"text":"A ","type":"text"},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","isActive":true},{"text":" that flushes each time a sequence produces an element.","type":"text"}],"url":"\/documentation\/afluent\/signalbatchstrategy","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SignalBatchStrategy","kind":"identifier"}],"navigatorTitle":[{"text":"SignalBatchStrategy","kind":"identifier"}],"role":"symbol","title":"SignalBatchStrategy"},"doc://Aflue