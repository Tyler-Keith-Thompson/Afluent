":"heading","text":"Example","level":2,"anchor":"Example"},{"type":"codeListing","code":["class MyModel: Sendable {","    var value: Int = 0","}","","let model = MyModel()","let unitOfWork: AsynchronousUnitOfWork<Int> = ...","","Task {","    try await unitOfWork.assign(to: \\.value, on: model)","    print(\"Model value updated to \\(model.value)\")","}"],"syntax":"swift"},{"style":"note","type":"aside","content":[{"inlineContent":[{"text":"Rethrows any error thrown by the asynchronous unit of work.","type":"text"}],"type":"paragraph"}],"name":"Throws"},{"style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"This method is asynchronous and will complete when the assignment has been made or the operation fails.","type":"text"}]}],"name":"Note"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/SingleValueChannel"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/singlevaluechannel\/assign(to:on:)"]}],"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/SingleValueChannel\/assign(to:on:)","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://Afluent/documentation/Afluent/SingleValueChannel/assign(to:on:)":{"kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SingleValueChannel\/assign(to:on:)","abstract":[{"type":"text","text":"Assigns the output of an asynchronous unit of work to a key path on an object when the work completes successfully."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"assign"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Root"},{"kind":"text","text":">("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s24ReferenceWritableKeyPathC","kind":"typeIdentifier","text":"ReferenceWritableKeyPath"},{"kind":"text","text":"<"},