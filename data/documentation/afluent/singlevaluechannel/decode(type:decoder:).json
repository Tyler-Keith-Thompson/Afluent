 output must be compatible with the input type expected by the provided decoder (e.g., "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" for "},{"type":"codeVoice","code":"JSONDecoder"},{"type":"text","text":")."}]},{"anchor":"Discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"This is typically used to decode raw data (such as JSON ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":") emitted by an upstream asynchronous unit of work into a strongly typed model.","type":"text"},{"text":" ","type":"text"},{"text":"It simplifies chaining asynchronous operations that involve fetching raw encoded data and decoding it into usable Swift types.","type":"text"}]},{"anchor":"Example","type":"heading","text":"Example","level":2},{"type":"codeListing","syntax":"swift","code":["struct User: Decodable, Sendable {","    let id: Int","    let name: String","}","","let jsonDataTask: DeferredTask<Data> = DeferredTask {","    \/\/ Imagine this fetches JSON data asynchronously","    Data(\"\"\"{\"id\": 1, \"name\": \"Alice\"}\"\"\".utf8)","}","","let userTask = jsonDataTask.decode(type: User.self, decoder: JSONDecoder())","","let user = try await userTask.operation()","print(user.name) \/\/ prints \"Alice\""]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The generic constraint ","type":"text"},{"type":"codeVoice","code":"Success == D.Input"},{"text":" ensures that the upstream unit of work emits a compatible type for the decoder.","type":"text"}]}],"type":"aside","style":"note","name":"Note"}]}],"metadata":{"modules":[{"name":"Afluent"}],"roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"decode"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"D"},{"kind":"text","text":">("},{"kind":"externalParam","text":"type"},{"kind":"text","text":":