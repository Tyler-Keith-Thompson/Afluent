ccess"},{"kind":"text","text":"\n"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that takes the caught "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" and asynchronously throws or returns an "},{"type":"codeVoice","code":"AsynchronousUnitOfWork"},{"type":"text","text":" to recover with."}]}],"name":"handler"}]},{"kind":"content","content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"An "},{"code":"AsynchronousUnitOfWork","type":"codeVoice"},{"type":"text","text":" that tries to catch and replace any error with the unit of work returned by the handler."}],"type":"paragraph"}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The handler receives the caught error and can throw. If the handler throws, the error is rethrown.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This operator is useful when recovery logic itself can throw asynchronously."}]},{"anchor":"Example","type":"heading","level":2,"text":"Example"},{"code":["struct FallbackError: Error {}","","let primaryTask = DeferredTask<Int> {","    throw FallbackError()","}","","let fallbackTask = DeferredTask<Int> {","    return 42","}","","let recoveredTask = primaryTask.tryCatch { error in","    print(\"Caught error: \\(error), attempting recovery\")","    \/\/ Recovery could fail, so handler can throw","    if Bool.random() {","        return fallbackTask","    } else {","        throw error","    }","}","","let result = try await recoveredTask.operation().value"],"type":"codeListing","syntax":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/SingleValueChannel"]]},"abstract":[{"text":"Returns an