ld weakly to avoid retain cycles, so if the object is deallocated before the asynchronous work completes, the assignment will not occur.","type":"text"}]},{"type":"heading","level":2,"text":"Example","anchor":"Example"},{"type":"codeListing","syntax":"swift","code":["class MyModel: Sendable {","    var value: Int = 0","}","","let model = MyModel()","let unitOfWork: AsynchronousUnitOfWork<Int> = ...","","Task {","    try await unitOfWork.assign(to: \\.value, on: model)","    print(\"Model value updated to \\(model.value)\")","}"]},{"type":"aside","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Rethrows any error thrown by the asynchronous unit of work."}]}],"style":"note"},{"type":"aside","name":"Note","content":[{"inlineContent":[{"type":"text","text":"This method is asynchronous and will complete when the assignment has been made or the operation fails."}],"type":"paragraph"}],"style":"note"}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/SingleValueSubject"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/SingleValueSubject\/assign(to:on:)"},"references":{"doc://Afluent/documentation/Afluent":{"kind":"symbol","role":"collection","abstract":[],"url":"\/documentation\/afluent","type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent","title":"Afluent"},"doc://Afluent/documentation/Afluent/SingleValueSubject":{"kind":"symbol","title":"SingleValueSubject","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SingleValueSubject"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SingleValueSubject","type":"topic","navigatorTitle":[{"kind":"identifier","text":"SingleValueSubject"}],"role":"symbol","url":"\/documentation\/afluent\/singlevaluesubject","abstract":[{"text":"A subject for bridging callback-based APIs to async\/await,