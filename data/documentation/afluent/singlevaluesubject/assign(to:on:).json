on"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method allows you to bind the result of the asynchronous operation to a property of an object, updating that property automatically upon completion."},{"type":"text","text":" "},{"type":"text","text":"The object is held weakly to avoid retain cycles, so if the object is deallocated before the asynchronous work completes, the assignment will not occur."}]},{"level":2,"type":"heading","text":"Example","anchor":"Example"},{"code":["class MyModel: Sendable {","    var value: Int = 0","}","","let model = MyModel()","let unitOfWork: AsynchronousUnitOfWork<Int> = ...","","Task {","    try await unitOfWork.assign(to: \\.value, on: model)","    print(\"Model value updated to \\(model.value)\")","}"],"type":"codeListing","syntax":"swift"},{"style":"note","content":[{"inlineContent":[{"text":"Rethrows any error thrown by the asynchronous unit of work.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Throws"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"This method is asynchronous and will complete when the assignment has been made or the operation fails.","type":"text"}]}],"type":"aside","name":"Note"}],"kind":"content"}],"references":{"doc://Afluent/documentation/Afluent/SingleValueSubject":{"kind":"symbol","title":"SingleValueSubject","navigatorTitle":[{"kind":"identifier","text":"SingleValueSubject"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SingleValueSubject","role":"symbol","type":"topic","url":"\/documentation\/afluent\/singlevaluesubject","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SingleValueSubject"}],"abstract":[{"text":"A subject for bridging callback-based APIs to async\/await, emitting a single value or error.","type":"text"}]},"doc://Afluent/documentation/Afluent/SingleValueSubject/assign(to:on:)":{"title":"assign(to:on:)","type":"topic","abstract":[{"type":"text","text":"Assigns th