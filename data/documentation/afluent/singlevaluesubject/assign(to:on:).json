you to bind the result of the asynchronous operation to a property of an object, updating that property automatically upon completion.","type":"text"},{"text":" ","type":"text"},{"text":"The object is held weakly to avoid retain cycles, so if the object is deallocated before the asynchronous work completes, the assignment will not occur.","type":"text"}],"type":"paragraph"},{"anchor":"Example","level":2,"text":"Example","type":"heading"},{"syntax":"swift","code":["class MyModel: Sendable {","    var value: Int = 0","}","","let model = MyModel()","let unitOfWork: AsynchronousUnitOfWork<Int> = ...","","Task {","    try await unitOfWork.assign(to: \\.value, on: model)","    print(\"Model value updated to \\(model.value)\")","}"],"type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Rethrows any error thrown by the asynchronous unit of work.","type":"text"}]}],"name":"Throws","style":"note","type":"aside"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This method is asynchronous and will complete when the assignment has been made or the operation fails."}]}],"name":"Note","style":"note","type":"aside"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/SingleValueSubject\/assign(to:on:)"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/singlevaluesubject\/assign(to:on:)"]}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"externalID":"s:7Afluent22AsynchronousUnitOfWorkPAAE6assign2to2onys24ReferenceWritableKeyPathCyqd__7SuccessQzG_qd__tYaKRld__Cs8SendableRd__lF::SYNTHESIZED::s:7Afluent18SingleValueSubjectC","extendedModule":"Afluent","role":"symbol","title":"assign(to:on:)","roleHeading":"Instance Method","symbolKind":"method","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/Workers\/Assign.swift#L36","fileName":"Assign.swi