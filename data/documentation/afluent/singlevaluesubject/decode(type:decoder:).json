er to convert the data into a ","type":"text"},{"code":"Decodable","type":"codeVoice"},{"text":" type.","type":"text"},{"text":" ","type":"text"},{"text":"The upstream’s output must be compatible with the input type expected by the provided decoder (e.g., ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"JSONDecoder","type":"codeVoice"},{"text":").","type":"text"}]},{"text":"Discussion","type":"heading","anchor":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is typically used to decode raw data (such as JSON "},{"type":"codeVoice","code":"Data"},{"type":"text","text":") emitted by an upstream asynchronous unit of work into a strongly typed model."},{"type":"text","text":" "},{"type":"text","text":"It simplifies chaining asynchronous operations that involve fetching raw encoded data and decoding it into usable Swift types."}]},{"text":"Example","type":"heading","anchor":"Example","level":2},{"type":"codeListing","code":["struct User: Decodable, Sendable {","    let id: Int","    let name: String","}","","let jsonDataTask: DeferredTask<Data> = DeferredTask {","    \/\/ Imagine this fetches JSON data asynchronously","    Data(\"\"\"{\"id\": 1, \"name\": \"Alice\"}\"\"\".utf8)","}","","let userTask = jsonDataTask.decode(type: User.self, decoder: JSONDecoder())","","let user = try await userTask.operation()","print(user.name) \/\/ prints \"Alice\""],"syntax":"swift"},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"The generic constraint ","type":"text"},{"type":"codeVoice","code":"Success == D.Input"},{"text":" ensures that the upstream unit of work emits a compatible type for the decoder.","type":"text"}]}]}],"kind":"content"}],"metadata":{"extendedModule":"Afluent","roleHeading":"Instance Method","role":"symbol","modules":[{"name":"Afluent"}],"symbolKind":"method","remoteSource":{"fileName":"Decode.swift","url":"https:\/\/github.com\