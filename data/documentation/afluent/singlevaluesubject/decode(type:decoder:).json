or "},{"type":"codeVoice","code":"JSONDecoder"},{"type":"text","text":")."}],"type":"paragraph"},{"text":"Discussion","type":"heading","level":2,"anchor":"Discussion"},{"inlineContent":[{"type":"text","text":"This is typically used to decode raw data (such as JSON "},{"type":"codeVoice","code":"Data"},{"type":"text","text":") emitted by an upstream asynchronous unit of work into a strongly typed model."},{"type":"text","text":" "},{"type":"text","text":"It simplifies chaining asynchronous operations that involve fetching raw encoded data and decoding it into usable Swift types."}],"type":"paragraph"},{"text":"Example","type":"heading","level":2,"anchor":"Example"},{"type":"codeListing","syntax":"swift","code":["struct User: Decodable, Sendable {","    let id: Int","    let name: String","}","","let jsonDataTask: DeferredTask<Data> = DeferredTask {","    \/\/ Imagine this fetches JSON data asynchronously","    Data(\"\"\"{\"id\": 1, \"name\": \"Alice\"}\"\"\".utf8)","}","","let userTask = jsonDataTask.decode(type: User.self, decoder: JSONDecoder())","","let user = try await userTask.operation()","print(user.name) \/\/ prints \"Alice\""]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The generic constraint "},{"type":"codeVoice","code":"Success == D.Input"},{"type":"text","text":" ensures that the upstream unit of work emits a compatible type for the decoder."}]}],"type":"aside","style":"note","name":"Note"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"symbol","symbolKind":"method","externalID":"s:7Afluent22AsynchronousUnitOfWorkPAAE6decode4type7decoderQrqd__m_qd_0_tSeRd__s8SendableRd__AA15TopLevelDecoderRd_0_5InputQyd_0_7SuccessRtzr0_lF::SYNTHESIZED::s:7Afluent18SingleValueSubjectC","roleHeading":"Instance Method","remoteSource":{"fileName":"Decode.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/Workers\/Decode.swift#L73"},"modules":[{"name":"Afluent"