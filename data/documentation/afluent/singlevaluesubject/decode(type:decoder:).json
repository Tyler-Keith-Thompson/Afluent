nd":"typeIdentifier"},{"text":" == ","kind":"text"},{"text":"D","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"Input","preciseIdentifier":"s:7Afluent15TopLevelDecoderP5InputQa","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/TopLevelDecoder\/Input","kind":"typeIdentifier"},{"text":"\n","kind":"text"}],"platforms":["Linux"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"type","content":[{"inlineContent":[{"text":"The type ","type":"text"},{"type":"codeVoice","code":"T"},{"text":" to decode into, conforming to the ","type":"text"},{"type":"codeVoice","code":"Decodable"},{"text":" protocol.","type":"text"}],"type":"paragraph"}]},{"name":"decoder","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The top-level decoder "},{"type":"codeVoice","code":"D"},{"type":"text","text":" used for decoding the upstream data."}]}]}],"kind":"parameters"},{"content":[{"level":2,"anchor":"return-value","type":"heading","text":"Return Value"},{"inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"AsynchronousUnitOfWork"},{"type":"text","text":" whose output is the decoded "},{"type":"codeVoice","code":"T"},{"type":"text","text":" type object."}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"This operator transforms the upstream’s output by applying the specified decoder to convert the data into a ","type":"text"},{"code":"Decodable","type":"codeVoice"},{"text":" type.","type":"text"},{"text":" ","type":"text"},{"text":"The upstream’s output must be compatible with the input type expected by the provided decoder (e.g., ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"JSONDecoder","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"anchor":"Discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"text":"This is typically used to decode raw data (such as JSON ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":") emitted by an upstream asynchronous unit of work into a strongly typed model.","type":"text"},{"text":" ","type":"text"},{"text":"It simplifies chaining asynchronous operations that involve fetching raw encoded data and decoding it into usable Swift types.","type":"text"}],"type":"paragraph"},{"anchor":"Example","level":2,"text":"Example","type":"heading"},{"syntax":"swift","code":["struct User: Decodable, Sendable {","    let id: Int","    let name: String","}","","let jsonDataTask: DeferredTask<Data> = DeferredTask {","    \/\/ Imagine this fetches JSON data asynchronously","    Data(\"\"\"{\"id\": 1, \"name\": \"Alice\"}\"\"\".utf8)","}","","let userTask = jsonDataTask.decode(type: User.self, decoder: JSONDecoder())","","let user = try await userTask.operation()","print(user.name) \/\/ prints \"Alice\""],"type":"codeListing"},{"content":[{"inlineContent":[{"type":"text","text":"The generic constraint "},{"type":"codeVoice","code":"Success == D.Input"},{"type":"text","text":" ensures that the upstream unit of work emits a compatible type for the decoder."}],"type":"paragraph"}],"style":"note","name":"Note","type":"aside"}],"kind":"content"}],"kind":"symbol","references":{"doc://Afluent/documentation/Afluent/SingleValueSubject":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SingleValueSubject","kind":"identifier"}],"navigatorTitle":[{"text":"SingleValueSubject","kind":"identifier"}],"title":"SingleValueSubject","abstract":[{"type":"text","text":"A subject for bridging callback-based APIs to async\/await, emitting a single value or error."}],"role":"symbol","url":"\/documentation\/afluent\/singlevaluesubject","type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SingleValueSubject","kind":"symbol"},"doc://Afluent/documentation/Afluent/SingleValueSubject/decode(type:decoder:)":{"role":"symbol","title":"decode(type: