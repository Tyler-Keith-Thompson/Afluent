"inlineContent":[{"text":"The duration to delay the output.","type":"text"}],"type":"paragraph"}]},{"name":"jitter","content":[{"type":"paragraph","inlineContent":[{"text":"How the delay is randomized. Defaults to ","type":"text"},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BackoffJitter\/none","isActive":true},{"text":". Decorrelated","type":"text"},{"text":" ","type":"text"},{"text":"jitter waits at most three times ","type":"text"},{"type":"codeVoice","code":"duration"},{"text":".","type":"text"}]}]}]},{"content":[{"type":"heading","level":2,"anchor":"return-value","text":"Return Value"},{"inlineContent":[{"text":"An ","type":"text"},{"code":"AsynchronousUnitOfWork","type":"codeVoice"},{"text":" that emits the upstream output after the specified delay.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"This operator suspends the emission of output for the given duration before returning the value.","type":"text"}]},{"type":"heading","level":2,"anchor":"Discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Delayed work is useful in scenarios such as throttling requests, implementing retry backoff strategies,"},{"type":"text","text":" "},{"type":"text","text":"or scheduling work to occur after a fixed interval. By delaying the emission, you can control timing"},{"type":"text","text":" "},{"type":"text","text":"behavior in asynchronous workflows in a straightforward and composable manner."}]},{"type":"heading","level":2,"anchor":"Example","text":"Example"},{"type":"codeListing","syntax":"swift","code":["let start = Date()","let delayedTask = DeferredTask {","    \"Hello, world!\"","}.delay(for: .seconds(2))","let result = try await delayedTask.execute()","let elapsed = Date().timeIntervalSince(start)","print(\"Result: \\(result) after \\(elapsed) seconds\")"]},{"typ