 recovery\")","    \/\/ Recovery could fail, so handler can throw","    if Bool.random() {","        return fallbackTask","    } else {","        throw error","    }","}","","let result = try await recoveredTask.operation().value"]}],"kind":"content"}],"abstract":[{"type":"text","text":"Returns an asynchronous unit of work that tries to catch any errors emitted by the upstream asynchronous unit of work"},{"type":"text","text":" "},{"type":"text","text":"and recovers by replacing the failure with a new unit of work produced by the given throwing handler."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/singlevaluesubject\/trycatch(_:)"]}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/SingleValueSubject\/tryCatch(_:)","interfaceLanguage":"swift"},"metadata":{"title":"tryCatch(_:)","externalID":"s:7Afluent22AsynchronousUnitOfWorkPAAE8tryCatchyQrqd__s5Error_pYaYbKcAaBRd__7SuccessQyd__AFRtzlF::SYNTHESIZED::s:7Afluent18SingleValueSubjectC","extendedModule":"Afluent","symbolKind":"method","modules":[{"name":"Afluent"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"tryCatch"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"D"},{"kind":"text","text":">((any "},{"kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP","text":"Error"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"D"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Afluent22AsynchronousUnitOfWorkP","text":"AsynchronousUnitOfWork"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:7Aflue