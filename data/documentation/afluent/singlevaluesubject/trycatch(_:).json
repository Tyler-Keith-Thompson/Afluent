paragraph","inlineContent":[{"text":"A closure that takes the caught ","type":"text"},{"type":"codeVoice","code":"Error"},{"text":" and asynchronously throws or returns an ","type":"text"},{"type":"codeVoice","code":"AsynchronousUnitOfWork"},{"text":" to recover with.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"inlineContent":[{"text":"An ","type":"text"},{"code":"AsynchronousUnitOfWork","type":"codeVoice"},{"text":" that tries to catch and replace any error with the unit of work returned by the handler.","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"The handler receives the caught error and can throw. If the handler throws, the error is rethrown.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This operator is useful when recovery logic itself can throw asynchronously."}],"type":"paragraph"},{"anchor":"Example","type":"heading","level":2,"text":"Example"},{"type":"codeListing","syntax":"swift","code":["struct FallbackError: Error {}","","let primaryTask = DeferredTask<Int> {","    throw FallbackError()","}","","let fallbackTask = DeferredTask<Int> {","    return 42","}","","let recoveredTask = primaryTask.tryCatch { error in","    print(\"Caught error: \\(error), attempting recovery\")","    \/\/ Recovery could fail, so handler can throw","    if Bool.random() {","        return fallbackTask","    } else {","        throw error","    }","}","","let result = try await recoveredTask.operation().value"]}],"kind":"content"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/singlevaluesubject\/trycatch(_:)"]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent","doc:\/\/Afluent\/documentation\/Afluent\/SingleValueSubject"]]},"abstract":[{"type":"text","tex