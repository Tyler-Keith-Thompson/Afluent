{"metadata":{"externalID":"s:7Afluent19SubjectSubscriptionV","roleHeading":"Structure","title":"SubjectSubscription","remoteSource":{"url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SubjectSubscription.swift#L40","fileName":"SubjectSubscription.swift"},"symbolKind":"struct","modules":[{"name":"Afluent"}],"navigatorTitle":[{"kind":"identifier","text":"SubjectSubscription"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SubjectSubscription","kind":"identifier"}]},"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP","doc:\/\/Afluent\/ScI"],"title":"Conforms To"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"A place in a "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","isActive":true,"type":"reference"},{"type":"text","text":" or "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject","isActive":true,"type":"reference"},{"type":"text","text":" that a consumer can stop waiting on and come back"},{"type":"text","text":" "},{"type":"text","text":"to, keeping every value sent in between."}],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SubjectSubscription","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s8SendableP","text":"Sendable","kind":"typeIdentifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Make one with the subject’s ","type":"text"},{"code":"makeSubscription()","type":"codeVoice"},{"text":". It subscribes when it is made, exactly like the subject’s","type":"text"},{"text":" ","type":"text"},{"text":"iterator: a ","type":"text"},{"code":"CurrentValueSubject","type":"codeVoice"},{"text":"’s subscription starts with the current value, and every value sent after that","type":"text"},{"text":" ","type":"text"},{"text":"is buffered for it, without limit, until ","type":"text"},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription\/next()","isActive":true},{"text":" returns it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The difference is cancellation. Cancelling a task waiting in an iterator’s "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" ends that iterator’s"},{"type":"text","text":" "},{"type":"text","text":"subscription and discards its buffer. Cancelling a task waiting in a subscription’s "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription\/next()","type":"reference","isActive":true},{"type":"text","text":" throws"},{"type":"text","text":" "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" from that call only: the subscription stays subscribed, and a later "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription\/next()","type":"reference","isActive":true},{"type":"text","text":" returns the"},{"type":"text","text":" "},{"type":"text","text":"values sent before and after the cancellation, in order. That suits a consumer that runs in rounds, such as a"},{"type":"text","text":" "},{"type":"text","text":"batch run that is cancelled and started again, and must not miss what was sent between rounds."}]},{"type":"paragraph","inlineContent":[{"text":"The subscription unsubscribes when its last copy is released. It conforms to ","type":"text"},{"code":"AsyncIteratorProtocol","type":"codeVoice"},{"text":", so an","type":"text"},{"text":" ","type":"text"},{"text":"operator can read it through ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncIteratorSequence","type":"reference"},{"text":"; a cancelled read then ends that operator’s run with","type":"text"},{"text":" ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":" and leaves the subscription for the next run.","type":"text"}]},{"type":"heading","level":2,"text":"Example","anchor":"Example"},{"code":["let events = PassthroughSubject<String>()","let subscription = events.makeSubscription()","","let firstRound = Task { try await subscription.next() }","firstRound.cancel() \/\/ Throws CancellationError from that wait; nothing is lost.","_ = await firstRound.result","","events.send(\"launch\")","events.send(\"login\")","let first = try await subscription.next()  \/\/ \"launch\"","let second = try await subscription.next() \/\/ \"login\""],"type":"codeListing","syntax":"swift"},{"name":"Important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Wait on a subscription from one task at a time. Calling "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription\/next()","isActive":true},{"type":"text","text":" while another call on the same"},{"type":"text","text":" "},{"type":"text","text":"subscription is still waiting traps."}]}],"style":"important"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/subjectsubscription"]}],"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription","interfaceLanguage":"swift"},"topicSections":[{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription\/next()"],"title":"Instance Methods"},{"generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription\/AsyncIteratorProtocol-Implementations"],"title":"Default Implementations"}],"references":{"doc://Afluent/documentation/Afluent":{"type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent","role":"collection","title":"Afluent","url":"\/documentation\/afluent","abstract":[],"kind":"symbol"},"doc://Afluent/documentation/Afluent/AsyncIteratorSequence":{"abstract":[],"url":"\/documentation\/afluent\/asynciteratorsequence","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncIteratorSequence","type":"topic","title":"AsyncIteratorSequence","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncIteratorSequence"}],"navigatorTitle":[{"kind":"identifier","text":"AsyncIteratorSequence"}]},"doc://Afluent/ScI":{"title":"_Concurrency.AsyncIteratorProtocol","identifier":"doc:\/\/Afluent\/ScI","type":"unresolvable"},"doc://Afluent/documentation/Afluent/SubjectSubscription":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription","abstract":[{"text":"A place in a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","type":"reference"},{"text":" or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject","type":"reference"},{"text":" that a consumer can stop waiting on and come back","type":"text"},{"text":" ","type":"text"},{"text":"to, keeping every value sent in between.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SubjectSubscription","kind":"identifier"}],"role":"symbol","url":"\/documentation\/afluent\/subjectsubscription","title":"SubjectSubscription","type":"topic","kind":"symbol","navigatorTitle":[{"text":"SubjectSubscription","kind":"identifier"}]},"doc://Afluent/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/Afluent\/s8SendableP"},"doc://Afluent/s16SendableMetatypeP":{"identifier":"doc:\/\/Afluent\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://Afluent/documentation/Afluent/SubjectSubscription/next()":{"abstract":[{"type":"text","text":"Waits for the next value sent to the subject."}],"type":"topic","role":"symbol","url":"\/documentation\/afluent\/subjectsubscription\/next()","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription\/next()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"next","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","title":"next()"},"doc://Afluent/documentation/Afluent/SubjectSubscription/AsyncIteratorProtocol-Implementations":{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription\/AsyncIteratorProtocol-Implementations","abstract":[],"role":"collectionGroup","url":"\/documentation\/afluent\/subjectsubscription\/asynciteratorprotocol-implementations","title":"AsyncIteratorProtocol Implementations","type":"topic","kind":"article"},"doc://Afluent/documentation/Afluent/CurrentValueSubject":{"navigatorTitle":[{"kind":"identifier","text":"CurrentValueSubject"}],"url":"\/documentation\/afluent\/currentvaluesubject","kind":"symbol","title":"CurrentValueSubject","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"CurrentValueSubject"}],"type":"topic","abstract":[{"text":"A subject that broadcasts its current value and all subsequent values to multiple consumers.","type":"text"},{"text":" ","type":"text"},{"text":"It can also handle completion events, including normal termination and failure with an error.","type":"text"},{"text":" ","type":"text"},{"text":"This is an ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s CurrentValueSubject.","type":"text"}]},"doc://Afluent/documentation/Afluent/PassthroughSubject":{"kind":"symbol","role":"symbol","type":"topic","abstract":[{"type":"text","text":"A subject that broadcasts values to multiple consumers without storing a current value."},{"type":"text","text":" "},{"type":"text","text":"Unlike "},{"code":"CurrentValueSubject","type":"codeVoice"},{"type":"text","text":", "},{"code":"PassthroughSubject","type":"codeVoice"},{"type":"text","text":" does not retain the most recent value."},{"type":"text","text":" "},{"type":"text","text":"This is an "},{"code":"AsyncSequence","type":"codeVoice"},{"type":"text","text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s PassthroughSubject."}],"navigatorTitle":[{"text":"PassthroughSubject","kind":"identifier"}],"url":"\/documentation\/afluent\/passthroughsubject","title":"PassthroughSubject","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PassthroughSubject","kind":"identifier"}]}}}