{"metadata":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SubjectSubscription"}],"title":"SubjectSubscription","roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"SubjectSubscription"}],"modules":[{"name":"Afluent"}],"externalID":"s:7Afluent19SubjectSubscriptionV","symbolKind":"struct","remoteSource":{"fileName":"SubjectSubscription.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SubjectSubscription.swift#L40"}},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/Afluent\/s8SendableP","doc:\/\/Afluent\/s16SendableMetatypeP","doc:\/\/Afluent\/ScI"],"type":"conformsTo"}],"variants":[{"paths":["\/documentation\/afluent\/subjectsubscription"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["Linux"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SubjectSubscription"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Element"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Make one with the subject’s "},{"type":"codeVoice","code":"makeSubscription()"},{"type":"text","text":". It subscribes when it is made, exactly like the subject’s"},{"type":"text","text":" "},{"type":"text","text":"iterator: a "},{"type":"codeVoice","code":"CurrentValueSubject"},{"type":"text","text":"’s subscription starts with the current value, and every value sent after that"},{"type":"text","text":" "},{"type":"text","text":"is buffered for it, without limit, until "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription\/next()","isActive":true},{"type":"text","text":" returns it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The difference is cancellation. Cancelling a task waiting in an iterator’s "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" ends that iterator’s"},{"type":"text","text":" "},{"type":"text","text":"subscription and discards its buffer. Cancelling a task waiting in a subscription’s "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription\/next()","type":"reference","isActive":true},{"type":"text","text":" throws"},{"type":"text","text":" "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" from that call only: the subscription stays subscribed, and a later "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription\/next()","type":"reference","isActive":true},{"type":"text","text":" returns the"},{"type":"text","text":" "},{"type":"text","text":"values sent before and after the cancellation, in order. That suits a consumer that runs in rounds, such as a"},{"type":"text","text":" "},{"type":"text","text":"batch run that is cancelled and started again, and must not miss what was sent between rounds."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The subscription unsubscribes when its last copy is released. It conforms to "},{"code":"AsyncIteratorProtocol","type":"codeVoice"},{"type":"text","text":", so an"},{"type":"text","text":" "},{"type":"text","text":"operator can read it through "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncIteratorSequence","isActive":true,"type":"reference"},{"type":"text","text":"; a cancelled read then ends that operator’s run with"},{"type":"text","text":" "},{"code":"CancellationError","type":"codeVoice"},{"type":"text","text":" and leaves the subscription for the next run."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Example","anchor":"Example"},{"code":["let events = PassthroughSubject<String>()","let subscription = events.makeSubscription()","","let firstRound = Task { try await subscription.next() }","firstRound.cancel() \/\/ Throws CancellationError from that wait; nothing is lost.","_ = await firstRound.result","","events.send(\"launch\")","events.send(\"login\")","let first = try await subscription.next()  \/\/ \"launch\"","let second = try await subscription.next() \/\/ \"login\""],"type":"codeListing","syntax":"swift"},{"name":"Important","type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Wait on a subscription from one task at a time. Calling "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription\/next()","type":"reference","isActive":true},{"type":"text","text":" while another call on the same"},{"type":"text","text":" "},{"type":"text","text":"subscription is still waiting traps."}]}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription","interfaceLanguage":"swift"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"abstract":[{"type":"text","text":"A place in a "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject","type":"reference","isActive":true},{"type":"text","text":" that a consumer can stop waiting on and come back"},{"type":"text","text":" "},{"type":"text","text":"to, keeping every value sent in between."}],"topicSections":[{"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription\/next()"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription\/AsyncIteratorProtocol-Implementations"],"generated":true}],"references":{"doc://Afluent/documentation/Afluent/SubjectSubscription":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SubjectSubscription","kind":"identifier"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"SubjectSubscription","kind":"identifier"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription","title":"SubjectSubscription","role":"symbol","url":"\/documentation\/afluent\/subjectsubscription","abstract":[{"type":"text","text":"A place in a "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject","isActive":true},{"type":"text","text":" that a consumer can stop waiting on and come back"},{"type":"text","text":" "},{"type":"text","text":"to, keeping every value sent in between."}]},"doc://Afluent/s8SendableP":{"identifier":"doc:\/\/Afluent\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://Afluent/ScI":{"identifier":"doc:\/\/Afluent\/ScI","title":"_Concurrency.AsyncIteratorProtocol","type":"unresolvable"},"doc://Afluent/documentation/Afluent/PassthroughSubject":{"type":"topic","title":"PassthroughSubject","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PassthroughSubject"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","navigatorTitle":[{"kind":"identifier","text":"PassthroughSubject"}],"abstract":[{"type":"text","text":"A subject that broadcasts values to multiple consumers without storing a current value."},{"type":"text","text":" "},{"type":"text","text":"Unlike "},{"type":"codeVoice","code":"CurrentValueSubject"},{"type":"text","text":", "},{"type":"codeVoice","code":"PassthroughSubject"},{"type":"text","text":" does not retain the most recent value."},{"type":"text","text":" "},{"type":"text","text":"This is an "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s PassthroughSubject."}],"kind":"symbol","url":"\/documentation\/afluent\/passthroughsubject","role":"symbol"},"doc://Afluent/documentation/Afluent/SubjectSubscription/next()":{"abstract":[{"text":"Waits for the next value sent to the subject.","type":"text"}],"role":"symbol","url":"\/documentation\/afluent\/subjectsubscription\/next()","type":"topic","kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription\/next()","title":"next()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"next"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Element"},{"kind":"text","text":"?"}]},"doc://Afluent/documentation/Afluent/CurrentValueSubject":{"type":"topic","url":"\/documentation\/afluent\/currentvaluesubject","kind":"symbol","abstract":[{"text":"A subject that broadcasts its current value and all subsequent values to multiple consumers.","type":"text"},{"text":" ","type":"text"},{"text":"It can also handle completion events, including normal termination and failure with an error.","type":"text"},{"text":" ","type":"text"},{"text":"This is an ","type":"text"},{"code":"AsyncSequence","type":"codeVoice"},{"text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s CurrentValueSubject.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"CurrentValueSubject"}],"title":"CurrentValueSubject","role":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject","navigatorTitle":[{"kind":"identifier","text":"CurrentValueSubject"}]},"doc://Afluent/documentation/Afluent/SubjectSubscription/AsyncIteratorProtocol-Implementations":{"url":"\/documentation\/afluent\/subjectsubscription\/asynciteratorprotocol-implementations","kind":"article","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription\/AsyncIteratorProtocol-Implementations","title":"AsyncIteratorProtocol Implementations","type":"topic","abstract":[],"role":"collectionGroup"},"doc://Afluent/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/Afluent\/s16SendableMetatypeP"},"doc://Afluent/documentation/Afluent":{"title":"Afluent","type":"topic","abstract":[],"identifier":"doc:\/\/Afluent\/documentation\/Afluent","role":"collection","kind":"symbol","url":"\/documentation\/afluent"},"doc://Afluent/documentation/Afluent/AsyncIteratorSequence":{"abstract":[],"role":"symbol","url":"\/documentation\/afluent\/asynciteratorsequence","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AsyncIteratorSequence"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncIteratorSequence","title":"AsyncIteratorSequence","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncIteratorSequence"}]}}}