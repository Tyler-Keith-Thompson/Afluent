ext":"This is an "},{"code":"AsyncSequence","type":"codeVoice"},{"type":"text","text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s CurrentValueSubject."}],"navigatorTitle":[{"kind":"identifier","text":"CurrentValueSubject"}],"title":"CurrentValueSubject","url":"\/documentation\/afluent\/currentvaluesubject","type":"topic"},"doc://Afluent/documentation/Afluent/SubjectSubscription/ConcurrentNext":{"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"ConcurrentNext","kind":"identifier"}],"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription\/ConcurrentNext","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ConcurrentNext","kind":"identifier"}],"abstract":[{"text":"The error ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription\/next()","isActive":true,"type":"reference"},{"text":" throws when another call on the same subscription is already waiting.","type":"text"}],"url":"\/documentation\/afluent\/subjectsubscription\/concurrentnext","type":"topic","title":"SubjectSubscription.ConcurrentNext"},"doc://Afluent/documentation/Afluent/PassthroughSubject":{"title":"PassthroughSubject","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject","type":"topic","role":"symbol","url":"\/documentation\/afluent\/passthroughsubject","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PassthroughSubject","kind":"identifier"}],"abstract":[{"text":"A subject that broadcasts values to multiple consumers without storing a current value.","type":"text"},{"text":" ","type":"text"},{"text":"Unlike ","type":"text"},{"code":"CurrentValueSubject","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PassthroughSubject","type":"codeVoice"},{"text":" does not retain the most recent value.","type":"text"},{"text":" ","type":"text"},{"text":"This is an ","type":"text"},{"code":"AsyncSequence","ty