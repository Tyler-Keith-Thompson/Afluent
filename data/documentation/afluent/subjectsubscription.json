"},{"type":"text","text":", "},{"type":"codeVoice","code":"PassthroughSubject"},{"type":"text","text":" does not retain the most recent value."},{"type":"text","text":" "},{"type":"text","text":"This is an "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s PassthroughSubject."}],"url":"\/documentation\/afluent\/passthroughsubject","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"PassthroughSubject"}],"title":"PassthroughSubject","role":"symbol","type":"topic"},"doc://Afluent/documentation/Afluent":{"title":"Afluent","kind":"symbol","type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent","url":"\/documentation\/afluent","role":"collection","abstract":[]},"doc://Afluent/ScI":{"title":"_Concurrency.AsyncIteratorProtocol","type":"unresolvable","identifier":"doc:\/\/Afluent\/ScI"},"doc://Afluent/documentation/Afluent/CurrentValueSubject":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"CurrentValueSubject"}],"abstract":[{"type":"text","text":"A subject that broadcasts its current value and all subsequent values to multiple consumers."},{"type":"text","text":" "},{"type":"text","text":"It can also handle completion events, including normal termination and failure with an error."},{"type":"text","text":" "},{"type":"text","text":"This is an "},{"type":"codeVoice","code":"AsyncSequence"},{"type":"text","text":" that allows multiple tasks to asynchronously consume values and mimics Combine’s CurrentValueSubject."}],"url":"\/documentation\/afluent\/currentvaluesubject","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CurrentValueSubject"}],"type":"topic","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject","title":"CurrentValueSubject"},"doc://Afluent/documentation/Afluent/SubjectSubscription/AsyncIteratorProtocol-Implementations":{"identifier