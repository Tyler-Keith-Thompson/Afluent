{"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"A place in a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/PassthroughSubject"},{"type":"text","text":" or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/CurrentValueSubject"},{"type":"text","text":" that a consumer can stop waiting on and come back"},{"type":"text","text":" "},{"type":"text","text":"to, keeping every value sent in between."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SubjectSubscription","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Element","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Element","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}],"platforms":["Linux"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Make one with the subject’s ","type":"text"},{"code":"makeSubscription()","type":"codeVoice"},{"text":". It subscribes when it is made, exactly like the subject’s","type":"text"},{"text":" ","type":"text"},{"text":"iterator: a ","type":"text"},{"code":"CurrentValueSubject","type":"codeVoice"},{"text":"’s subscription starts with the current value, and every value sent after that","type":"text"},{"text":" ","type":"text"},{"text":"is buffered for it, without limit, until ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription\/next()","isActive":true,"type":"reference"},{"text":" returns it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The difference is cancellation. Cancelling a task waiting in an iterator’s "},{"type":"codeVoice","code":"next()"},{"type":"text","text":" ends that iterator’s"},{"type":"text","text":" "},{"type":"text","text":"subscription and discards its buffer. Cancelling a task waiting in a subscription’s "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription\/next()"},{"type":"text","text":" throws"},{"type":"text","text":" "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" from that call only: the subscription stays subscribed, and a later "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription\/next()"},{"type":"text","text":" returns the"},{"type":"text","text":" "},{"type":"text","text":"values sent before and after the cancellation, in order. That suits a consumer that runs in rounds, such as a"},{"type":"text","text":" "},{"type":"text","text":"batch run that is cancelled and started again, and must not miss what was sent between rounds."}]},{"type":"paragraph","inlineContent":[{"text":"The subscription unsubscribes when its last copy is released. It conforms to ","type":"text"},{"code":"AsyncIteratorProtocol","type":"codeVoice"},{"text":", so an","type":"text"},{"text":" ","type":"text"},{"text":"operator can read it through ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncIteratorSequence","isActive":true,"type":"reference"},{"text":"; a cancelled read then ends that operator’s run with","type":"text"},{"text":" ","type":"text"},{"code":"CancellationError","type":"codeVoice"},{"text":" and leaves the subscription for the next run.","type":"text"}]},{"type":"heading","text":"Example","anchor":"Example","level":2},{"syntax":"swift","type":"codeListing","code":["let events = PassthroughSubject<String>()","let subscription = events.makeSubscription()","","let firstRound = Task { try await subscription.next() }","firstRound.cancel() \/\/ Throws CancellationError from that wait; nothing is lost.","_ = await firstRound.result","","events.send(\"launch\")","events.send(\"login\")","let first = try await subscription.next()  \/\/ \"launch\"","let second = try await subscription.next() \/\/ \"login\""]},{"name":"Important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Wait on a subscription from one task at a time. Calling "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription\/next()"},{"type":"text","text":" while another call on the same"},{"type":"text","text":" "},{"type":"text","text":"subscription is still waiting traps."}]}],"style":"important"}]}],"metadata":{"symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SubjectSubscription"}],"role":"symbol","remoteSource":{"fileName":"SubjectSubscription.swift","url":"https:\/\/github.com\/Tyler-Keith-Thompson\/Afluent\/blob\/main\/Sources\/Afluent\/SubjectSubscription.swift#L40"},"roleHeading":"Structure","title":"SubjectSubscription","externalID":"s:7Afluent19SubjectSubscriptionV","navigatorTitle":[{"kind":"identifier","text":"SubjectSubscription"}],"modules":[{"name":"Afluent"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription"},"hierarchy":{"paths":[["doc:\/\/Afluent\/documentation\/Afluent"]]},"topicSections":[{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription\/next()"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/Afluent\/documentation\/Afluent\/SubjectSubscription\/AsyncIteratorProtocol-Implementations"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/subjectsubscription"]}],"relationshipsSections":[{"title":"Conforms