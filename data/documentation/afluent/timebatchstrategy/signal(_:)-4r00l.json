ext","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"}]}]},{"parameters":[{"name":"subject","content":[{"type":"paragraph","inlineContent":[{"text":"The subject whose value flushes the batch.","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","anchor":"return-value","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","isActive":true,"type":"reference"},{"text":" over a stream of the subject’s one value, made afresh","type":"text"},{"text":" ","type":"text"},{"text":"for each iteration.","type":"text"}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The batched sequence listens to the subject without owning it: when the batched sequence"},{"type":"text","text":" "},{"type":"text","text":"ends or is cancelled, its wait ends at once and the subject stays pending for its other"},{"type":"text","text":" "},{"type":"text","text":"awaiters. A subject sent an error ends the batched sequence with that error, except"},{"type":"text","text":" "},{"type":"codeVoice","code":"CancellationError"},{"type":"text","text":" (as when another awaiter cancels the subject): then the signal stops"},{"type":"text","text":" "},{"type":"text","text":"firing and the batches go on. A subject sent a value before iteration begins fires when the"},{"type":"text","text":" "},{"type":"text","text":"signal’s task starts, which may come after elements have arrived, so the first batch may be"},{"type":"text","text":" "},{"type":"text","text":"short. Each batched sequence iterated with this strategy listens anew, so a subject"},{"type":"text","text":" "},{"type":"text","text":"already sent a value fires again when a later batched sequence’s signal task starts."}]},{"type":"heading","text":"Example","anchor":"Example","level":2},{"type":"codeListing","code":["let shutdown = SingleValueSubject<Void>()","for try await messages in inbox.batch(strategy: .either(.count(50), .signal(shutdown))) {","    store(messages)","}","\/\/ Elsewhere: flush whatever is pending before shutting down.","try shutdown.send()"],"syntax":"swift"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/afluent\/timebatchstrategy\/signal(_:)-4r00l"]}],"references":{"doc://Afluent/documentation/Afluent":{"type":"topic","title":"Afluent","kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent","url":"\/documentation\/afluent","role":"collection","abstract":[]},"doc://Afluent/documentation/Afluent/TimeBatchStrategy":{"abstract":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","type":"reference"},{"text":" that flushes each time an interval passes on a clock.","type":"text"}],"url":"\/documentation\/afluent\/timebatchstrategy","navigatorTitle":[{"text":"TimeBatchStrategy","kind":"identifier"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/TimeBatchStrategy","title":"TimeBatchStrategy","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TimeBatchStrategy","kind":"identifier"}]},"doc://Afluent/documentation/Afluent/AsyncSequences/Deferred":{"navigatorTitle":[{"kind":"identifier","text":"Deferred"}],"role":"symbol","abstract":[{"type":"text","text":"An asynchronous sequence that defers the execution of another asynchronous sequence until iteration."}],"kind":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences\/Deferred","type":"topic","url":"\/documentation\/afluent\/asyncsequences\/deferred","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Deferred"}],"title":"AsyncSequences.Deferred"},"doc://Afluent/document