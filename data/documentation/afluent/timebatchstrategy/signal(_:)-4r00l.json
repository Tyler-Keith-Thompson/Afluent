already sent a value fires again when a later batched sequence’s signal task starts."}]},{"anchor":"Example","type":"heading","level":2,"text":"Example"},{"syntax":"swift","type":"codeListing","code":["let shutdown = SingleValueSubject<Void>()","for try await messages in inbox.batch(strategy: .either(.count(50), .signal(shutdown))) {","    store(messages)","}","\/\/ Elsewhere: flush whatever is pending before shutting down.","try shutdown.send()"]}],"kind":"content"}],"references":{"doc://Afluent/documentation/Afluent/TimeBatchStrategy":{"kind":"symbol","abstract":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","isActive":true,"type":"reference"},{"text":" that flushes each time an interval passes on a clock.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"TimeBatchStrategy"}],"role":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/TimeBatchStrategy","title":"TimeBatchStrategy","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TimeBatchStrategy"}],"url":"\/documentation\/afluent\/timebatchstrategy"},"doc://Afluent/documentation/Afluent/AsyncSequences":{"kind":"symbol","url":"\/documentation\/afluent\/asyncsequences","abstract":[{"text":"A namespace for grouping related AsyncSequence operations.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncSequences"}],"title":"AsyncSequences","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","navigatorTitle":[{"kind":"identifier","text":"AsyncSequences"}],"type":"topic"},"doc://Afluent/documentation/Afluent/BatchStrategy":{"abstract":[{"text":"When ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Afluent\/documentation\/Afluent\/_Concurrency\/AsyncSequence\/batch(strategy:)","type":"reference"},{"text":" emits the elements it has gathered.","type":"text"}],"role"