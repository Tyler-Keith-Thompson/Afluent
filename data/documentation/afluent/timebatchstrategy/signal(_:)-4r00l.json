ready sent a value fires again when a later batched sequence’s signal task starts."}],"type":"paragraph"},{"anchor":"Example","text":"Example","level":2,"type":"heading"},{"syntax":"swift","code":["let shutdown = SingleValueSubject<Void>()","for try await messages in inbox.batch(strategy: .either(.count(50), .signal(shutdown))) {","    store(messages)","}","\/\/ Elsewhere: flush whatever is pending before shutting down.","try shutdown.send()"],"type":"codeListing"}]}],"references":{"doc://Afluent/documentation/Afluent/AsyncSequences":{"title":"AsyncSequences","abstract":[{"text":"A namespace for grouping related AsyncSequence operations.","type":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/afluent\/asyncsequences","role":"symbol","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/AsyncSequences","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AsyncSequences"}],"navigatorTitle":[{"kind":"identifier","text":"AsyncSequences"}]},"doc://Afluent/documentation/Afluent/SignalBatchStrategy":{"navigatorTitle":[{"text":"SignalBatchStrategy","kind":"identifier"}],"url":"\/documentation\/afluent\/signalbatchstrategy","abstract":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/BatchStrategy","isActive":true},{"type":"text","text":" that flushes each time a sequence produces an element."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SignalBatchStrategy","kind":"identifier"}],"title":"SignalBatchStrategy","identifier":"doc:\/\/Afluent\/documentation\/Afluent\/SignalBatchStrategy","role":"symbol","type":"topic","kind":"symbol"},"doc://Afluent/documentation/Afluent/TimeBatchStrategy/signal(_:)-4r00l":{"abstract":[{"type":"text","text":"Flushes once, when the given subject is sent a value."}],"title":"signal(_:)","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func