#!/usr/bin/env bash
# Bazelisk runs this in place of Bazel ($BAZEL_REAL is the Bazel it picked).
#
# With a BuildBuddy API key in the login Keychain (`just buildbuddy-key`), every command reads
# tools/buildbuddy.bazelrc: BuildBuddy's remote cache and build results, authorized by a credential
# helper that reads the key from the Keychain, so it is never written to a file. Without a key,
# and on Linux (CI writes its own user.bazelrc from the repository secret), Bazel runs unchanged.
#
# On macOS, at most once a day, it also starts tools/sweep-output-bases in the background: Bazel
# never deletes an output base, so every deleted checkout and idle one would keep its gigabytes
# under the output user root. The sweep is detached, with its output in a log beside the stamp, so
# it never delays the command or changes its exit status. CI's containers start empty and are
# thrown away, so on Linux there is nothing to sweep.
set -euo pipefail

workspace="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ "${OSTYPE:-}" == darwin* ]]; then
    # Bazel's default output user root on macOS.
    output_user_root="$HOME/Library/Caches/bazel/_bazel_${USER:-$(id -un)}"
    stamp="$output_user_root/.sweep-output-bases"
    if [ -d "$output_user_root" ] && [ -z "$(find "$stamp" -mmin -1440 2>/dev/null)" ] \
        && command -v python3 >/dev/null 2>&1; then
        # The stamp is touched before the sweep starts, so commands run meanwhile start no other.
        touch "$stamp" 2>/dev/null \
            && (nohup python3 "$workspace/tools/sweep-output-bases" \
                --output-user-root "$output_user_root" --workspace "$workspace" \
                </dev/null >"$stamp.log" 2>&1 &) \
            || true
    fi
fi

startup=()
if command -v security >/dev/null 2>&1 \
    && security find-generic-password -s buildbuddy -a api-key >/dev/null 2>&1; then
    # A --bazelrc replaces the user rc, so the user's own is named too.
    if [ -f "$HOME/.bazelrc" ]; then
        startup+=("--bazelrc=$HOME/.bazelrc")
    fi
    startup+=("--bazelrc=$workspace/tools/buildbuddy.bazelrc")
fi
exec "$BAZEL_REAL" ${startup[@]+"${startup[@]}"} "$@"
