#!/usr/bin/env bash
# A Bazel credential helper (https://github.com/EngFlow/credential-helper-spec) for BuildBuddy:
# answers `get` with the API key from the login Keychain, which `just buildbuddy-key` stores.
# tools/buildbuddy.bazelrc scopes it to remote.buildbuddy.io.
set -euo pipefail

if [ "${1:-}" != get ]; then
    echo "usage: $0 get  (a Bazel credential helper; the request arrives on stdin)" >&2
    exit 2
fi
# The request names the URI; the helper's scope has already matched it to BuildBuddy.
cat >/dev/null
if key="$(security find-generic-password -s buildbuddy -a api-key -w 2>/dev/null)" && [ -n "$key" ]; then
    printf '{"headers":{"x-buildbuddy-api-key":["%s"]}}\n' "$key"
else
    printf '{"headers":{}}\n'
fi
