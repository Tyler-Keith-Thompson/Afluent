"""A module's resources under Bazel, in the bundle SwiftPM builds for them, found by `Bundle.module`.

SwiftPM builds a target's `resources:` into `<Package>_<Target>.bundle` and generates
`Bundle.module` to find it. `module_resources` does both for a `swift_library` (RESOURCES in
scripts/modules.py writes the call, and the library's `srcs` and `data`):

  * `<name>`: the bundle, laid out as SwiftPM lays it out, in the runfiles of whatever links the
    module (`bazel test` and `bazel run`, on macOS and Linux). A `process` entry's files land at the
    bundle's root, flattened (a localization keeps its `.lproj` directory); a `copy` entry lands by
    its last path component, a directory with everything under it. Files are copied as they are,
    as SwiftPM does off Apple platforms.
  * `<name>Bundle`: an `apple_resource_bundle` of the same name and contents, which rules_apple nests
    in the resources of an app or a test bundle that links the module. It processes `process`
    files as Xcode does (strings, asset catalogs, storyboards) and copies `copy` ones.
    `module_resources_data` names it on Apple platforms alone.
  * `<name>Accessor`: the source of `Bundle.module`, which the module compiles. It looks where an
    app, a test bundle, a command-line tool and Bazel's runfiles keep the bundle, and traps when
    none holds it, as SwiftPM's accessor does.

`<name>` offers the bundle as runfiles alone, never as its files: rules_apple copies the files of a
`swift_library`'s `data` into the root of the app or test bundle, where they would sit beside the
nested bundle.
"""

load("@rules_apple//apple:resources.bzl", "apple_resource_bundle")

ModuleResourcesInfo = provider(
    doc = "A module's resources: their source files, for tools that stage the SwiftPM package (tools/benchmarks.bzl), and their entries, for the manifest check (tools/swiftpm.bzl).",
    fields = {
        "files": "depset of the resources' source files",
        "entries": "list of (rule, path) pairs, as `module_resources` was given them and Package.swift's `resources:` spells them",
    },
)

# The Apple operating systems, as Package.swift's applePlatforms: only their bundles nest resources.
_APPLE_OSES = ["macos", "ios", "tvos", "watchos", "visionos"]

# The `//` comments keep the accessor out of the docs' symbol graph checks, which want a source
# location for every documented symbol, and a generated file has none in the module's sources.
_ACCESSOR = """\
// GENERATED by //tools:resources.bzl for Bazel; SwiftPM generates its own `Bundle.module`.

import Foundation

private final class BundleFinder {{}}

extension Foundation.Bundle {{
    // The module's resource bundle, {bundle}.bundle, as SwiftPM names it.
    static let module: Bundle = {{
        let name = "{bundle}.bundle"
        // An app or a test bundle holds it among its resources (rules_apple nests it there), a
        // command-line tool beside itself.
        let bundled = [Bundle.main.resourceURL, Bundle(for: BundleFinder.self).resourceURL, Bundle.main.bundleURL]
            .compactMap {{ $0?.appendingPathComponent(name) }}
        // `bazel test` and `bazel run`: the runfiles tree.
        let environment = ProcessInfo.processInfo.environment
        let runfiles = [environment["RUNFILES_DIR"], environment["TEST_SRCDIR"], ProcessInfo.processInfo.arguments.first.map {{ $0 + ".runfiles" }}]
            .compactMap {{ $0 }}
            .map {{ URL(fileURLWithPath: $0).appendingPathComponent("{runfiles_path}") }}
        for candidate in bundled + runfiles {{
            var isDirectory: ObjCBool = false
            if FileManager.default.fileExists(atPath: candidate.path, isDirectory: &isDirectory), isDirectory.boolValue,
               let bundle = Bundle(url: candidate) {{
                return bundle
            }}
        }}
        // A trap, as in SwiftPM's accessor: a module built without its resources can't do its job,
        // and no caller could recover from the bundle missing.
        fatalError("could not load resource bundle \\(name)")
    }}()
}}
"""

def _package_relative(file, label):
    prefix = ("../" + label.workspace_name + "/" if label.workspace_name else "") + (label.package + "/" if label.package else "")
    if not file.short_path.startswith(prefix):
        fail("{} is outside the package of {}".format(file.short_path, label))
    return file.short_path[len(prefix):]

def _processed_path(path):
    # SwiftPM flattens processed resources into the bundle's root, but keeps a localization's
    # `.lproj` directory.
    parts = path.split("/")
    for index in range(len(parts) - 1, -1, -1):
        if parts[index].endswith(".lproj"):
            return "/".join(parts[index:])
    return parts[-1]

def _module_resources_impl(ctx):
    root = "_{}/{}.bundle".format(ctx.label.name, ctx.attr.bundle_name)
    sources = {}
    copied = []

    def place(file, destination):
        if destination in sources:
            fail("{} and {} both land at {} in {}.bundle".format(sources[destination].short_path, file.short_path, destination, ctx.attr.bundle_name))
        sources[destination] = file
        output = ctx.actions.declare_file(root + "/" + destination)
        ctx.actions.symlink(output = output, target_file = file)
        return output

    placed = [place(file, _processed_path(_package_relative(file, ctx.label))) for file in ctx.files.process]
    for target, parent in ctx.attr.copy.items():
        for file in target.files.to_list():
            path = _package_relative(file, ctx.label)
            copied.append(place(file, path[len(parent) + 1:] if parent else path))

    accessor = ctx.actions.declare_file("_{}/resource_bundle_accessor.swift".format(ctx.label.name))
    workspace = ctx.label.workspace_name or ctx.workspace_name
    runfiles_path = "/".join([part for part in [workspace, ctx.label.package, root] if part])
    ctx.actions.write(accessor, _ACCESSOR.format(bundle = ctx.attr.bundle_name, runfiles_path = runfiles_path))
    return [
        DefaultInfo(files = depset(), runfiles = ctx.runfiles(files = placed + copied)),
        OutputGroupInfo(accessor = depset([accessor]), copied = depset(copied)),
        ModuleResourcesInfo(
            files = depset(sources.values()),
            entries = [("process", entry) for entry in ctx.attr.process_entries] + [("copy", entry) for entry in ctx.attr.copy_entries],
        ),
    ]

_module_resources = rule(
    implementation = _module_resources_impl,
    attrs = {
        "bundle_name": attr.string(mandatory = True, doc = "The bundle's name without `.bundle`: `<Package>_<Module>`."),
        "process": attr.label_list(allow_files = True, doc = "The files of the `.process` entries."),
        "copy": attr.label_keyed_string_dict(
            allow_files = True,
            doc = "The files of the `.copy` entries, each keyed to the directory holding its entry, which the copy leaves out of its path.",
        ),
        # The entries themselves, before globbing: `process` and `copy` hold a directory's files,
        # and the manifest check compares entries with Package.swift's.
        "process_entries": attr.string_list(doc = "The `.process` entries as written."),
        "copy_entries": attr.string_list(doc = "The `.copy` entries as written."),
    },
    doc = "A module's resource bundle in runfiles, and the source of its `Bundle.module`.",
)

def _entry_files(entry):
    """The files of resource entry `entry`: everything under it when it is a directory, else itself."""
    return native.glob([entry + "/**"], allow_empty = True) or [entry]

def _under(directory, entry):
    return directory + "/" + entry if directory else entry

def _parent(entry):
    return entry.rpartition("/")[0]

def module_resources(name, bundle_name, bundle_id, process = [], copy = [], directory = "", **kwargs):
    """A module's resources: `<name>` in runfiles, `<name>Bundle` for Apple bundles, and
    `<name>Accessor`, the source of `Bundle.module`.

    Args:
        name: The runfiles target's name; the others add a suffix to it.
        bundle_name: `<Package>_<Module>`, the name SwiftPM gives the module's bundle.
        bundle_id: `<package>.<Module>.resources`, the identifier SwiftPM gives it.
        process: The `.process` entries, files or directories, relative to the package.
        copy: The `.copy` entries, files or directories, relative to the package.
        directory: Where the entries sit inside the package, when the SwiftPM target's path is a
            directory of it (a speed-reliant test target's `Performance`); the entries are written
            relative to it, as Package.swift writes them.
        **kwargs: Attributes common to all of them (`tags`, `visibility`).
    """
    processed = [file for entry in process for file in _entry_files(_under(directory, entry))]
    copied = {file: _parent(_under(directory, entry)) for entry in copy for file in _entry_files(_under(directory, entry))}
    _module_resources(
        name = name,
        bundle_name = bundle_name,
        process = processed,
        copy = copied,
        process_entries = process,
        copy_entries = copy,
        **kwargs
    )
    native.filegroup(name = name + "Accessor", srcs = [":" + name], output_group = "accessor", **kwargs)
    native.filegroup(name = name + "Copied", srcs = [":" + name], output_group = "copied", **kwargs)
    apple_resource_bundle(
        name = name + "Bundle",
        bundle_id = bundle_id,
        bundle_name = bundle_name,
        infoplists = ["//tools:ResourceBundleInfo.plist"],
        resources = processed,
        # The copies as laid out in `<name>`, so they keep the same paths in the bundle.
        structured_resources = [":" + name + "Copied"],
        strip_structured_resources_prefixes = ["_{}/{}.bundle".format(name, bundle_name)],
        **kwargs
    )

    # For checks outside the package that compare what a bundle holds with its sources.
    native.exports_files(processed + copied.keys())

def module_resources_data(name):
    """A `swift_library`'s `data` for `module_resources(name = name)`: the runfiles bundle, and on
    Apple platforms the bundle rules_apple nests."""
    return [":" + name] + select({
        "@platforms//os:" + os: [":" + name + "Bundle"]
        for os in _APPLE_OSES
    } | {"//conditions:default": []})
